  fileName        String    @unique @map("file_name")
  engineer        String?
  deviceName      String?   @map("device_name")
  meshNodeId      String?   @map("mesh_node_id")
  meshGroupId     String?   @map("mesh_group_id")
  customerId      Int?      @map("customer_id")
  agentDeviceId   Int?      @map("agent_device_id")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  sizeBytes       BigInt?   @map("size_bytes")
  filePresent     Boolean?  @default(true) @map("file_present")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([startedAt(sort: Desc)])
  @@index([engineer])
  @@index([customerId])
  @@map("remote_sessions")
}

// Pending Windows Updates per device, reported on the agent's daily inventory pass.
// Rows are upserted so first_seen survives — "missing for 40 days" is the number that matters.
model DevicePatch {
  id         Int       @id @default(autoincrement())
  deviceId   Int       @map("device_id")
  updateId   String    @map("update_id")
  title      String?
  kb         String?
  severity   String?
  categories String?
  sizeMb     Decimal?  @map("size_mb") @db.Decimal(10, 1)
  downloaded Boolean?  @default(false)
  // Windows Update, WinGet or Chocolatey. One table, because "what is out of date on this
  // machine" is one question and nobody wants to look at three screens to answer it.
  source           String?   @default("windows")
  currentVersion   String?   @map("current_version")   // third-party only
  availableVersion String?   @map("available_version") // third-party only
  firstSeen  DateTime? @default(now()) @map("first_seen")
  lastSeen   DateTime? @default(now()) @map("last_seen")

  @@unique([deviceId, updateId])
  @@index([deviceId])
  @@index([severity])
  @@index([source])
  @@map("device_patches")
}

// Patch policies are a LIBRARY of named templates, not rows welded to a customer. Two ship
// as defaults ("Default Windows Desktop", "Default Windows Server"); anything unusual is a
// clone. A device resolves: its own override, then its customer's policy for its class,
// then the default. Everything is created disabled, so the end of that chain does nothing.
model PatchPolicy {
  id                  Int       @id @default(autoincrement())
  name                String
  deviceClass         String    @default("workstation") @map("device_class")
  isDefault           Boolean?  @default(false) @map("is_default")
  enabled             Boolean?  @default(false)
  installScope        String?   @default("security") @map("install_scope")
  windowDays          String?   @default("0") @map("window_days")
  windowStart         String?   @default("02:00") @map("window_start")
  windowMinutes       Int?      @default(180) @map("window_minutes")
  rebootMode          String?   @default("never") @map("reboot_mode")
  rebootDeferrals     Int?      @default(3) @map("reboot_deferrals")
  rebootDeadlineHours Int?      @default(72) @map("reboot_deadline_hours")
  notifyMinutes       Int?      @default(15) @map("notify_minutes")
  notifyMessage       String?   @map("notify_message")
  createdBy           Int?      @map("created_by")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedBy           Int?      @map("updated_by")
  updatedAt           DateTime? @default(now()) @map("updated_at")

  @@index([deviceClass])
  @@map("patch_policies")
}

// ── Cyber Essentials ────────────────────────────────────────────────────────────
// The agent collects facts; everything below is the Portal's judgement of them. That
// split is deliberate: the standard changes yearly and the software list changes
// weekly, and neither should mean pushing a new agent to every customer machine.

// The hand-maintained end-of-life list. Vendors publish these dates inconsistently and
// change them, so this is a table we own rather than a feed we trust — one row per
// thing that stops being supported, with the practical action attached.
model EolProduct {
  id          Int       @id @default(autoincrement())
  category    String    @default("app") // os | dotnet | runtime | browser | app | database | server
  vendor      String?
  name        String                     // as shown in the report
  matchType   String    @default("contains") @map("match_type") // contains | exact | regex | os_build | dotnet_release
  matchValue  String    @map("match_value")
  versionMax  String?   @map("version_max")  // matches only when the installed version is at or below this
  eolDate     DateTime? @map("eol_date") @db.Date
  severity    String    @default("fail")     // fail | warn
  action      String    @default("upgrade")  // remove | upgrade | replace | isolate
  replacement String?                        // what to move to
  guidance    String?                        // the practical sentence an engineer acts on
  ceControl   String    @default("patch") @map("ce_control") // firewall | config | access | malware | patch
  active      Boolean   @default(true)
  notes       String?
  // Where the row came from. 'endoflife.date' rows are rewritten by the nightly sync;
  // 'manual' rows are ours and are never touched by it. Ticking overridden freezes an
  // automatic row in place - for when a vendor announces an extension before the feed
  // catches up, which is the only reason anyone should be editing one.
  source      String    @default("manual")
  externalKey String?   @map("external_key")   // e.g. dotnet:6.0 — the sync's upsert key
  overridden  Boolean   @default(false)
  syncedAt    DateTime? @map("synced_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")

  @@unique([source, externalKey])
  @@index([category])
  @@index([active])
  @@map("eol_products")
}

// One run of the tool: a single device, a customer, or the whole estate.
model CeAssessment {
  id           Int       @id @default(autoincrement())
  scope        String    @default("device") // device | customer | all
  customerId   Int?      @map("customer_id")
  deviceId     Int?      @map("device_id")
  label        String?
  status       String    @default("running") // running | complete | partial | failed
  devicesTotal Int?      @default(0) @map("devices_total")
  devicesDone  Int?      @default(0) @map("devices_done")
  failCount    Int?      @default(0) @map("fail_count")
  warnCount    Int?      @default(0) @map("warn_count")
  passCount    Int?      @default(0) @map("pass_count")
  score        Int?
  startedBy    Int?      @map("started_by")
  startedAt    DateTime? @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  @@index([customerId])
  @@index([startedAt])
  @@map("ce_assessments")
}

// One machine's part of a run. The raw facts are kept so a rule added next month can be
// re-run against last month's evidence without going back to the machine.
model CeDeviceResult {
  id           Int       @id @default(autoincrement())
  assessmentId Int       @map("assessment_id")
  deviceId     Int       @map("device_id")
  commandId    Int?      @map("command_id")
  status       String    @default("queued") // queued | complete | failed | offline
  facts        Json?
  score        Int?
  failCount    Int?      @default(0) @map("fail_count")
  warnCount    Int?      @default(0) @map("warn_count")
  passCount    Int?      @default(0) @map("pass_count")
  error        String?
  collectedAt  DateTime? @map("collected_at")

  @@unique([assessmentId, deviceId])
  @@index([deviceId])
  @@map("ce_device_results")
}

// One judgement about one machine. Remediation is stored with the finding rather than
// generated at render time, so a report printed today still says what we told them.
model CeFinding {
  id           Int      @id @default(autoincrement())
  assessmentId Int      @map("assessment_id")
  deviceId     Int      @map("device_id")
  control      String   // firewall | config | access | malware | patch
  rule         String   // stable id, e.g. cfg.autorun
  title        String
  status       String   @default("fail") // fail | warn | pass
  action       String?  // remove | upgrade | configure | review | none
  detail       String?  // what we found
  remediation  String?  // what to do about it, in enough detail to act on
  evidence     String?  // the raw value behind the judgement
  eolDate      DateTime? @map("eol_date") @db.Date
  createdAt    DateTime? @default(now()) @map("created_at")

  @@index([assessmentId, status])
  @@index([deviceId])
  @@map("ce_findings")
}

// ── Servers ─────────────────────────────────────────────────────────────────────
// The same agent, in server mode. One row per machine, holding the whole collected
// picture as JSON rather than fifty columns: what a domain controller reports and what a
// SQL box reports have almost nothing in common, and a rule added next month can be run
// against last month's evidence without going back to the machine.
//
// The few things worth filtering and sorting on are lifted out into real columns.
model ServerFact {
  id          Int       @id @default(autoincrement())
  deviceId    Int       @unique @map("device_id")
  serverRole  String?   @map("server_role")   // domain controller | member server
  roles       String?                          // comma-separated Windows roles, for filtering
  domain      String?                          // AD domain this machine serves or belongs to
  sqlInstances Int?     @default(0) @map("sql_instances")
  vmCount     Int?      @default(0) @map("vm_count")
  alerts      Int?      @default(0)            // things the Portal judged worth a look
  facts       Json?
  commandId   Int?      @map("command_id")
  error       String?
  collectedAt DateTime? @default(now()) @map("collected_at")

  @@index([serverRole])
  @@map("server_facts")
}

// ── Networks a customer actually has ────────────────────────────────────────────
// Seeded by the server agent from the interfaces it can see, and added to by hand in its
// console when there are subnets the server does not sit on. Discovery reads this list;
// nothing is ever scanned that is not in it.
model CustomerNetwork {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  cidr       String                            // 192.168.10.0/24
  label      String?
  source     String    @default("manual")      // manual | detected
  deviceId   Int?      @map("device_id")       // which server reported it, when detected
  scan       Boolean   @default(true)          // include it when we look for unmanaged machines
  createdBy  Int?      @map("created_by")
  createdAt  DateTime? @default(now()) @map("created_at")

  @@unique([customerId, cidr])
  @@index([customerId])
  @@map("customer_networks")
}

// Group Policy inventory, collected read-only from the customer's AD agent. One row per
// GPO per customer, replaced wholesale on each collection — a GPO that has been deleted in
// the domain should disappear here too, and diffing to achieve that buys nothing.
/// A node the mesh bridge reported that matched no device in the Portal. Replaced
/// wholesale on every bridge run. This exists so "remote control is not ready" can say
/// WHY - the node is in a group no customer owns, or under a name we do not have.
model MeshUnmatchedNode {
  id        Int      @id @default(autoincrement())
  nodeId    String   @unique @map("node_id")
  groupId   String?  @map("group_id")
  hostname  String?
  osName    String?  @map("os_name")
  online    Boolean  @default(false)
  seenAt    DateTime @default(now()) @map("seen_at")

  @@index([hostname])
  @@map("mesh_unmatched_nodes")
}

model CustomerGpo {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id")
  gpoId        String   @map("gpo_id")        // the domain's own GUID for it
  name         String
  status       String?                        // AllSettingsEnabled | UserSettingsDisabled | ...
  description  String?
  domain       String?
  createdOn    String?  @map("created_on")
  modifiedOn   String?  @map("modified_on")
  linkCount    Int      @default(0) @map("link_count")
  linkedEnabled Int     @default(0) @map("linked_enabled")
  enforced     Boolean  @default(false)
  settingCount Int      @default(0) @map("setting_count")
  // How many extension blocks the report contained. A policy with extension data we could
  // not interpret is NOT an empty policy - and must never be flagged as one next to a
  // Delete button. -1 means the collector predates this and we simply do not know.
  extensionCount Int    @default(-1) @map("extension_count")
  appliesTo    Json?    @map("applies_to")    // security groups the policy filters to
  links        Json?                          // [{target,enabled,enforced,order}]
  settings     Json?                          // the reduced setting list (capped agent-side)
  reportError  String?  @map("report_error")

  // What Claude made of this policy, kept against the policy so a review survives a page
  // reload and can be filtered on. Cleared whenever the policy's settings change, because
  // a verdict about settings nobody has now is worse than no verdict.
  aiVerdict    String?  @map("ai_verdict")     // good | watch | broken
  aiSummary    String?  @map("ai_summary")
  aiFindings   Json?    @map("ai_findings")    // [{level,title,detail,fix}]
  aiAt         DateTime? @map("ai_at")
  aiFingerprint String? @map("ai_fingerprint") // settings hash the verdict was formed on

  collectedAt  DateTime @default(now()) @map("collected_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([customerId, gpoId])
  @@index([customerId])
  @@map("customer_gpos")
}

/// Every Group Policy Object the Portal has removed from a domain, and the backup the
/// agent took in the same breath.
///
/// This exists because "recoverable" was only true on paper. The agent has always backed
/// a policy up before removing it and returned the backup id - and the Portal wrote that
/// id to a console log and deleted the row. Undoing a deletion therefore meant remoting
/// into the domain controller and guessing which backup folder was which, which is the
/// same as not being able to undo it.
///
/// The settings snapshot is kept deliberately: once the object is gone from the domain,
/// this row is the only remaining answer to "what was actually in it".
model GpoDeletion {
  id           Int       @id @default(autoincrement())
  customerId   Int       @map("customer_id")
  deviceId     Int?      @map("device_id")     // the DC the delete ran on
  commandId    Int?      @map("command_id")
  gpoId        String    @map("gpo_id")        // the domain's own GUID - restore reuses it
  name         String
  domain       String?
  hostname     String?
  backupId     String?   @map("backup_id")     // Restore-GPO -BackupId
  backupPath   String?   @map("backup_path")   // ...-Path. Null means no way back.
  settingCount Int       @default(0) @map("setting_count")
  linkSnapshot Json?     @map("link_snapshot") // where it used to apply - restore drops links
  snapshot     Json?                            // the customer_gpos row as it stood
  deletedBy    Int?      @map("deleted_by")
  deletedAt    DateTime  @default(now()) @map("deleted_at")
  restoredAt   DateTime? @map("restored_at")
  restoredBy   Int?      @map("restored_by")

  @@index([customerId, deletedAt])
  @@index([customerId, gpoId])
  @@map("gpo_deletions")
}
