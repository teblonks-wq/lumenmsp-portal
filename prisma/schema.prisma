generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// â”€â”€ Users (Lumen staff + future customer-scoped external users) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model User {
  id           Int       @id @default(autoincrement())
  customerId   Int?      @map("customer_id") // null = Lumen staff; set = customer-scoped external user
  email        String    @unique
  displayName  String    @map("display_name")
  passwordHash String?   @map("password_hash")
  entraOid     String?   @unique @map("entra_oid")
  role           String    @default("staff") // staff | admin | customer
  isActive       Boolean   @default(true) @map("is_active")
  inSupportGroup Boolean   @default(false) @map("support_group") // receives helpdesk/new-case alerts; also gates the password vault
  inSalesGroup   Boolean   @default(false) @map("sales_group")   // receives quote/lead alerts
  inFinanceGroup Boolean   @default(false) @map("finance_group") // gates invoices + the dashboard invoices card
  hiddenFromLookups Boolean @default(false) @map("hidden_from_lookups") // break-glass/login accounts: hide from engineer + assignee pickers
  lastLoginAt    DateTime? @map("last_login_at")
  oneboardPrefs  Json?     @map("oneboard_prefs") // OneBoard: per-user saved site selection {"sites":[ids]}
  theme          String?   // V4 portal colour theme: aurora | carbon | solstice (null = aurora default)
  // Public self-registration (2026-08-19). MUST live here: `prisma db push` runs on every
  // deploy and drops any column it does not know about.
  companyClaimed  String?   @map("company_claimed")   // what they TYPED. Never matched against customers.
  emailVerified   Boolean   @default(false) @map("email_verified")
  verifyTokenHash String?   @map("verify_token_hash") // sha256 of the link token, single use
  verifySentAt    DateTime? @map("verify_sent_at")
  signupSource    String?   @map("signup_source")     // password | microsoft (null = staff-created)
  signupIp        String?   @map("signup_ip")         // per-IP signup throttle + forensics
  signupAt        DateTime? @map("signup_at")
  // Mobile Pulse: per-user push preferences {"muted":[kinds],"quiet":{"start","end"}}.
  pushPrefs       Json?     @map("push_prefs")
  createdAt    DateTime  @default(now()) @map("created_at")

  customer     Customer? @relation(fields: [customerId], references: [id])

  @@map("users")
}

// â”€â”€ Customers (the anchor entity — everything attaches to a customer) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Customer {
  id                   Int       @id @default(autoincrement())
  accountNumber        String?   @unique @map("account_number") // e.g. lar-001
  name                 String
  status               String    @default("lead") // lead | active | inactive
  website              String?
  domain               String?
  phone                String?
  email                String?
  isItsm               Boolean   @default(false) @map("is_itsm")
  isPlaceholder        Boolean   @default(false) @map("is_placeholder") // system catch-all records (e.g. "Unassigned")
  hasInternet          Boolean   @default(false) @map("has_internet")
  hasPhones            Boolean   @default(false) @map("has_phones")
  hasCloud             Boolean   @default(false) @map("has_cloud")
  addressLine1         String?   @map("address_line_1")
  addressLine2         String?   @map("address_line_2")
  city                 String?
  county               String?
  postcode             String?
  logoPath             String?   @map("logo_path")
  notes                String?
  leadSource           String?   @map("lead_source")
  leadStatus           String?   @map("lead_status") // sales pipeline: new | open | proposed | won | lost
  entraTenantId        String?   @map("entra_tenant_id") // customer's Microsoft 365 / Entra tenant for directory sync
  lastReviewedAt       DateTime? @map("last_reviewed_at") // last Customer A-Z review
  ateraCustomerId      String?   @map("atera_customer_id")
  agentSiteKey         String?   @unique @map("agent_site_key") // LumenMSP Agent install key (MSI SITEKEY=...) — null disables new enrollments
  rmmInstallerUrl      String?   @map("rmm_installer_url") // per-customer RMM MSI for the agent's Reinstall RMM tool (null = global default)
  // MeshCentral remote access. The bridge on mesh01 creates a device group per customer
  // and writes these back. Must live in the schema or `prisma db push` drops them each deploy.
  meshGroupId          String?   @map("mesh_group_id")           // MeshCentral device group, e.g. "mesh//abc…"
  meshGroupName        String?   @map("mesh_group_name")
  meshAgentPackageId   Int?      @map("mesh_agent_package_id")   // → agent_packages.id: that group's Windows agent
  meshEnabled          Boolean?  @default(true) @map("mesh_enabled") // false = never deploy remote access here
  // Patch policy this customer inherits, per device class. Null = the built-in default.
  patchPolicyWorkstationId Int? @map("patch_policy_workstation_id")
  patchPolicyServerId      Int? @map("patch_policy_server_id")
  quickbooksCustomerId String?   @map("quickbooks_customer_id")
  gocardlessMandateId  String?   @map("gocardless_mandate_id")
  // The GoCardless CUSTOMER this company is, independent of any one mandate. A mandate is
  // cancelled and re-signed often (bank change, failed DD, re-signup) and its id changes with
  // it; the GC customer id does not. Match on this and the link survives mandate churn --
  // gocardlessMandateId is then just a cache of their CURRENT active mandate.
  gocardlessCustomerId String?   @map("gocardless_customer_id")
  principalContactId   Int?      @map("principal_contact_id") // → customer_contacts.id (resolved in app, not a FK relation)
  billingContactId     Int?      @map("billing_contact_id")
  serviceContactId     Int?      @map("service_contact_id")
  portalEnabled        Boolean   @default(false) @map("portal_enabled") // customer-portal login master switch (must live in the schema or `prisma db push` drops it each deploy)
  // Onboarding / legal details (collected via the emailed onboarding form)
  legalName            String?   @map("legal_name")
  companyNumber        String?   @map("company_number")
  vatNumber            String?   @map("vat_number")
  billingAddressLine1  String?   @map("billing_address_line_1")
  billingAddressLine2  String?   @map("billing_address_line_2")
  billingCity          String?   @map("billing_city")
  billingCounty        String?   @map("billing_county")
  billingPostcode      String?   @map("billing_postcode")
  onboardingToken      String?   @unique @map("onboarding_token")
  onboardingStatus     String?   @map("onboarding_status")        // sent | submitted | applied
  onboardingSentAt     DateTime? @map("onboarding_sent_at")
  onboardingSubmittedAt DateTime? @map("onboarding_submitted_at")
  onboardingData       Json?     @map("onboarding_data")          // raw submission, pending review
  createdBy            Int?      @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at") // soft delete
  deletedByUserId      Int?      @map("deleted_by_user_id")

  contacts    Contact[]
  sites       Site[]
  domains     CustomerDomain[]
  externalIds CustomerExternalId[]
  users       User[]
  quotes      Quote[]
  invoices    Invoice[]
  contracts   Contract[]
  tickets     Ticket[]
  leads       Lead[]
  credentials CustomerCredential[]
  credits     CustomerCredit[]
  assets      CustomerAsset[]
  licences    CustomerLicence[]

  @@index([status])
  @@index([deletedAt])
  @@map("customers")
}

// â”€â”€ Leads (first-class sales-pipeline object) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// A lead points at a prospect Customer so contacts/comms/quotes live on the customer
// and persist through conversion. The lead itself survives won/lost for pipeline history.
model Lead {
  id                 Int       @id @default(autoincrement())
  customerId         Int       @map("customer_id")   // the prospect customer
  status             String    @default("new") // new | open | proposed | won | lost
  source             String?                          // where the lead came from
  servicesInterested String?   @map("services_interested") // free text — what they're after
  details            String?                          // free-text notes / context
  reference          String?   @unique                 // website order ref - idempotency key (one per order)
  product            String?                            // e.g. simply_voip | broadband
  monthly            Decimal?  @db.Decimal(12, 2)       // GBP ex-VAT recurring
  oneoff             Decimal?  @db.Decimal(12, 2)       // GBP ex-VAT one-off
  estimatedValue     Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  ownerUserId        Int?      @map("owner_user_id")
  followUpAt         DateTime? @map("follow_up_at")    // next chase date for this lead
  followUpNote       String?   @map("follow_up_note")  // what the follow-up is for
  wonAt              DateTime? @map("won_at")
  lostAt             DateTime? @map("lost_at")
  lostReason         String?   @map("lost_reason")
  createdBy          Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  deletedByUserId    Int?      @map("deleted_by_user_id")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
  @@map("leads")
}

// â”€â”€ Customer credentials (per-customer password vault) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// The password is encrypted at rest (AES-256-GCM) in secret_encrypted; everything
// else is searchable metadata. Decryption happens server-side only, on an explicit
// reveal/copy request, and every reveal is written to the activity log.
model CustomerCredential {
  id              Int       @id @default(autoincrement())
  customerId      Int       @map("customer_id")
  name            String
  loginUrl        String?   @map("login_url")
  username        String?
  secretEncrypted String?   @map("secret_encrypted") // AES-256-GCM blob (iv:tag:ciphertext, base64)
  domain          String?
  category        String?
  extraValue      String?   @map("extra_value")
  note            String?
  createdBy       Int?      @map("created_by")
  // Put here by the server agent's console rather than typed into the Portal. The username
  // is fixed once set: the agent looks this credential up by account name to know which
  // one is "the" domain credential for this customer, and letting someone rename it would
  // quietly orphan it. The password can be changed, and the whole row can be deleted.
  systemManaged   Boolean   @default(false) @map("system_managed")
  validatedAt     DateTime? @map("validated_at")
  validationState String?   @map("validation_state") // valid | invalid | unchecked
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId Int?      @map("deleted_by_user_id")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_credentials")
}

// ── Software licences ─────────────────────────────────────────────────────────────
// What software this customer has bought, which machine it went on, and the key. The
// key is treated exactly like a vault password: AES-256-GCM at rest via lib/vault, only
// decrypted on an explicit reveal/copy, and every reveal is written to the activity log.
// A licence may name a real asset OR just a free-text machine name — plenty of licences
// live on things we do not manage (a cloud app, a customer's own server), and refusing
// to record those would make the list a lie by omission.
model CustomerLicence {
  id            Int       @id @default(autoincrement())
  customerId    Int       @map("customer_id")
  assetId       Int?      @map("asset_id")      // → customer_assets.id when the machine is one we hold
  deviceName    String?   @map("device_name")   // free text, used when assetId is null
  licenceType   String?   @map("licence_type")  // free text on the row, chosen from licence_types
  keyEncrypted  String?   @map("key_encrypted") // AES-256-GCM blob (iv:tag:ciphertext, base64)
  url           String?
  installedOn   DateTime? @map("installed_on") @db.Date
  note          String?
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedByUserId Int?    @map("deleted_by_user_id")

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset    CustomerAsset? @relation(fields: [assetId], references: [id])

  @@index([customerId])
  @@index([assetId])
  @@map("customer_licences")
}

// The Licence Type dropdown. A lookup table rather than a hard-coded list so a new
// product can be added from the form itself without a deploy. Names are unique and
// retired by `active=false`, never deleted — a licence row stores the NAME, so deleting
// a type would leave old rows pointing at nothing.
model LicenceType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("licence_types")
}

// Per-customer documents — uploaded files with a title + description, shown on the customer card
// next to the password vault. Files live PRIVATELY under uploads/customer-docs and are streamed
// via an auth-gated route (never the public static dir).
model CustomerDocument {
  id               Int       @id @default(autoincrement())
  customerId       Int       @map("customer_id")
  title            String
  description      String?
  uploadedByUserId Int?      @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  deletedByUserId  Int?      @map("deleted_by_user_id")

  @@index([customerId])
  @@map("customer_documents")
}

// Website logins for a supplier (multiple per supplier). Mirrors customer_credentials — the
// password is AES-256-GCM encrypted at rest and only decrypted on an explicit reveal.
model SupplierCredential {
  id              Int       @id @default(autoincrement())
  supplierId      Int       @map("supplier_id")
  name            String
  loginUrl        String?   @map("login_url")
  username        String?
  secretEncrypted String?   @map("secret_encrypted")
  note            String?
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([supplierId])
  @@map("supplier_credentials")
}

// Files attached to a CustomerDocument — a document can hold many photos/files (resolved in app).
model CustomerDocumentFile {
  id          Int      @id @default(autoincrement())
  documentId  Int      @map("document_id")
  fileName    String   @map("file_name")    // original filename
  filePath    String   @map("file_path")    // absolute path on disk (private)
  contentType String?  @map("content_type")
  fileSize    Int?     @map("file_size")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("customer_document_files")
}

// â”€â”€ Customer credits (overpayments / goodwill, applied against a later invoice) â”€â”€
model CustomerCredit {
  id               Int       @id @default(autoincrement())
  customerId       Int       @map("customer_id")
  amount           Decimal   @db.Decimal(12, 2) // positive = credit owed to the customer
  reason           String?
  sourceInvoiceId  Int?      @map("source_invoice_id")  // the over-paid / amended invoice
  appliedInvoiceId Int?      @map("applied_invoice_id") // the invoice it was used against
  quickbooksCreditId String? @map("quickbooks_credit_id") // QB CreditMemo id once submitted
  status           String    @default("open") // open | applied | void
  createdBy        Int?      @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  appliedAt        DateTime? @map("applied_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("customer_credits")
}

// â”€â”€ Customer contacts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Contact {
  id             Int      @id @default(autoincrement())
  customerId     Int      @map("customer_id")
  ateraContactId String?  @map("atera_contact_id")
  entraOid       String?  @map("entra_oid")   // Azure AD object id (directory sync match)
  archived       Boolean  @default(false)     // user left/disabled in directory — hidden from lists
  fullName       String   @map("full_name")
  email          String?
  phone          String?
  mobilePhone    String?  @map("mobile_phone")
  jobTitle       String?  @map("job_title")
  department     String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  isThirdParty   Boolean  @default(false) @map("is_third_party") // 3rd party (covered by the customer's support agreement)
  isServiceContact Boolean @default(false) @map("is_service_contact") // named SERVICE CONTACT on the service agreement; may view and sign agreements
  protected      Boolean  @default(false)  // manually curated — directory sync must never update or archive this contact
  portalAccessLevel String? @map("portal_access_level") // customer-portal access: none|tickets|finance|service|full (null = none)
  insightsSites  Json?    @map("insights_sites") // site layer: insights site ids this contact may see in OneBoard/Wallboard/Insights (null = all)
  // Mass Mailer (Marketing): opt-out flag + one-click unsubscribe token. MUST live in the
  // schema -- `prisma db push` on deploy drops any column it doesn't know about.
  marketingOptOut   Boolean   @default(false) @map("marketing_opt_out") // excluded from all Mass Mailer sends
  marketingOptOutAt DateTime? @map("marketing_opt_out_at")
  unsubToken        String?   @unique @map("unsub_token") // public unsubscribe-link token
  // Case-feedback suppression. DELIBERATELY SEPARATE from marketingOptOut: asking how a
  // support case went is service, not marketing, so muting one must not mute the other.
  feedbackOptOut    Boolean   @default(false) @map("feedback_opt_out")
  feedbackOptOutAt  DateTime? @map("feedback_opt_out_at")
  lastFeedbackAskAt DateTime? @map("last_feedback_ask_at") // rate-limit: five closures in a day are not five emails
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
  @@index([fullName])
  @@map("customer_contacts")
}

// "Ask Claude" on a ticket — saved questions & answers so the team never asks twice.
model TicketAiQuery {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    Int?     @map("user_id")
  question  String
  answer    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_ai_queries")
}

model InvoiceAiQuery {
  id        Int      @id @default(autoincrement())
  invoiceId Int      @map("invoice_id")
  userId    Int?     @map("user_id")
  question  String
  answer    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_ai_queries")
}

model FinanceAiConversation {
  id         Int      @id @default(autoincrement())
  scope      String // 'invoice' | 'customer'
  invoiceId  Int?     @map("invoice_id")
  customerId Int?     @map("customer_id")
  title      String?
  userId     Int?     @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([customerId])
  @@map("finance_ai_conversations")
}

model FinanceAiMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  role           String // 'user' | 'assistant'
  content        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("finance_ai_messages")
}

// The Finance Agent's OWN durable memory ("second brain", Terry 2026-07-30): distilled
// facts / decisions / issues / follow_ups the agent saves after answers and reads back
// into every future conversation. customer_id NULL = portal-wide finance fact.
model FinanceAiMemory {
  id                   Int      @id @default(autoincrement())
  customerId           Int?     @map("customer_id")
  invoiceRef           String?  @map("invoice_ref")
  title                String
  body                 String
  kind                 String   @default("fact") // fact | decision | issue | follow_up
  status               String   @default("open") // open | resolved | archived
  sourceConversationId Int?     @map("source_conversation_id")
  createdBy            String?  @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("finance_ai_memories")
}

// â”€â”€ Customer sites â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Site {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id")
  siteName     String   @map("site_name")
  siteCode     String?  @map("site_code")
  addressLine1 String?  @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String?
  county       String?
  postcode     String?
  country      String?
  sitePhone    String?  @map("site_phone")
  siteEmail    String?  @map("site_email")
  notes        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, siteCode])
  @@index([customerId])
  @@map("customer_sites")
}

// â”€â”€ Customer domains â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model CustomerDomain {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  domain     String
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, domain])
  @@index([domain])
  @@map("customer_domains")
}

// â”€â”€ Customer external IDs (Atera, QuickBooks, etc.) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model CustomerExternalId {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id")
  sourceSystem String   @map("source_system") // atera | quickbooks | quickbooks_online | cli | ...
  externalId   String   @map("external_id")
  billingStart DateTime? @map("billing_start") @db.Date // CLI: date billing starts from (drives first-month prorata)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, externalId])
  @@index([customerId])
  @@map("customer_external_ids")
}

// â”€â”€ Customer assets / device inventory â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// v1: one-way sync FROM Atera (RMM agents). Read-only in the Portal until we confirm
// Atera's API accepts write-back — see lib/asset-sync.ts. `raw` keeps the full source
// payload so new spec fields can be surfaced later without re-syncing the schema.

// LumenMSP Agent (Windows tray + service) — one row per enrolled machine. The agent
// authenticates with a bearer token; only its SHA-256 hash is stored here. Revoking
// kills the token instantly; a reinstall with the customer site key re-enrolls.
model AgentDevice {
  id           Int       @id @default(autoincrement())
  customerId   Int?      @map("customer_id")
  hostname     String?
  serialNumber String?   @map("serial_number")
  os           String?
  osVersion    String?   @map("os_version")
  agentVersion String?   @map("agent_version")
  loggedInUser String?   @map("logged_in_user")
  localIps     String?   @map("local_ips")
  publicIp     String?   @map("public_ip")
  diskInfo     String?   @map("disk_info") // JSON: [{drive,total_gb,free_gb}]
  // Hardware inventory collected BY OUR AGENT (WMI), not by Atera. Every one of these
  // used to arrive only via the Atera sync, which is why the asset page showed two of
  // everything. Nullable: older agents do not send them and db push would drop a column
  // that is not declared here.
  manufacturer      String?
  model             String?
  cpu               String?
  ramGb             Float?    @map("ram_gb")
  macAddresses      String?   @map("mac_addresses")
  domainOrWorkgroup String?   @map("domain_or_workgroup")
  deviceType        String?   @map("device_type")   // Workstation | Laptop | Server
  lastBootAt        DateTime? @map("last_boot_at")
  updateRing   Int       @default(2) @map("update_ring") // 0=internal, 1=pilot, 2=general - staged self-update
  isAdAgent    Boolean   @default(false) @map("is_ad_agent") // this device runs the customer's AD actions (a DC or management server)
  // MeshCentral remote access. meshNodeId is written by the bridge, matched on hostname —
  // it is what the asset page's Remote control button deep-links to.
  meshNodeId     String?   @map("mesh_node_id")
  meshInstalled  Boolean?  @default(false) @map("mesh_installed")
  meshLastSeenAt DateTime? @map("mesh_last_seen_at")
  // Set the moment a mesh.install command comes back with exit 0. Distinct from
  // meshNodeId, which only arrives when the bridge matches the node - without this the
  // Portal cannot tell "never installed" from "installed but the bridge never saw it",
  // and re-queues the install on every heartbeat forever.
  meshInstalledAt DateTime? @map("mesh_installed_at")
  patchScanAt        DateTime? @map("patch_scan_at")
  patchPending       Int?      @map("patch_pending")
  patchCritical      Int?      @map("patch_critical")
  rebootRequired     Boolean?  @default(false) @map("reboot_required")
  patchLastInstalled String?   @map("patch_last_installed")
  // Patching. Every one of these has been dropped by `prisma db push` once already,
  // because it was created with raw SQL and never declared here. Declare first, always.
  patchExcluded      Boolean?  @default(false) @map("patch_excluded")
  // Security posture as the agent last reported it (Defender, Security Center products,
  // firewall profiles). JSON blob + timestamp: the Portal derives the verdicts at render
  // time, so what counts as "OK" can change without an agent rollout. Nullable - agents
  // below 1.0.24 never send it.
  securityJson       String?   @map("security_json")
  securityAt         DateTime? @map("security_at")
  patchClass         String?   @map("patch_class")        // force workstation|server, else inferred from the OS
  patchPolicyId      Int?      @map("patch_policy_id")    // per-device override; null = inherit the customer
  tokenHash    String    @unique @map("token_hash")
  revoked      Boolean   @default(false)
  enrolledAt   DateTime? @map("enrolled_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([hostname])
  bitlockerKeys AssetBitlockerKey[]

  @@map("agent_devices")
}

// BitLocker recovery keys, per volume, per agent device.
//
// Stored rather than fetched on demand for one reason: a machine at the BitLocker
// recovery screen has no OS, so no agent, so no network — nothing can ask it anything.
// The key has to already be here before that happens or the feature is useless at the
// only moment it matters.
//
// Because it is stored, it is the most sensitive row in the Portal: recovery_key_encrypted
// is an AES-256-GCM blob from lib/vault, decrypted only behind requireVaultAccess, and
// every reveal is written to the activity log.
model AssetBitlockerKey {
  id                   Int       @id @default(autoincrement())
  deviceId             Int       @map("device_id")           // -> agent_devices.id (the thing that reports)
  mountPoint           String    @map("mount_point")         // "C:"
  keyProtectorId       String    @map("key_protector_id")    // "" when the volume has no recovery password at all
  protectionStatus     String?   @map("protection_status")   // On | Off | Unknown
  lockStatus           String?   @map("lock_status")         // Locked | Unlocked
  encryptionMethod     String?   @map("encryption_method")
  volumeType           String?   @map("volume_type")         // OperatingSystem | Data
  recoveryKeyEncrypted String?   @map("recovery_key_encrypted")
  collectedAt          DateTime  @default(now()) @map("collected_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  device AgentDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, mountPoint, keyProtectorId])
  @@index([deviceId])
  @@map("asset_bitlocker_keys")
}

// Remote-tool command queue (Portal asset Tools tab -> agent). The agent long-polls for
// queued rows, runs them and posts the output back. `payload` is CLEARED on completion so
// transient secrets (a reset password) don't linger in the database.
// Cached software inventory, refreshed by the agent daily and on demand. Kept in the
// database so the list is searchable and viewable when the machine is OFF - uninstalling
// obviously still needs it online, but knowing what is installed should not.
model AgentSoftware {
  id           Int      @id @default(autoincrement())
  deviceId     Int      @map("device_id")
  name         String
  version      String?
  publisher    String?
  sizeMb       Float?   @map("size_mb")
  installDate  String?  @map("install_date")
  uninstallCmd String?  @map("uninstall_cmd")  // QuietUninstallString, else UninstallString
  productCode  String?  @map("product_code")   // MSI GUID when the registry key is one
  scope        String?  // machine | user
  collectedAt  DateTime @default(now()) @map("collected_at")

  @@index([deviceId])
  @@index([name])
  @@map("agent_software")
}

// The Run-script library: saved scripts any device's Manage menu can run. Execution goes
// through the same audited shell kinds as the console - this table is convenience, not a
// new execution path.
model AgentScript {
  id        Int      @id @default(autoincrement())
  name      String
  shell     String   @default("powershell") @map("shell") // powershell | cmd
  runAs     String   @default("system") @map("run_as")    // system | user
  script    String
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("agent_scripts")
}

// Official helpdesk reviews. Entering the review walk creates a dated, owned record;
// every case touched (reply, note, status change, skip) is logged against it with its
// time. Admin -> Helpdesk reviews reads these. Nullable/defaulted throughout - safe for
// prisma db push on a live database.
model HelpdeskReview {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  outcome   String?   // completed | exited | abandoned
  // Where this reviewer had got to. Pulling away mid-review (a phone call, a jump
  // into the full case screen) and coming back must resume HERE, not restart at the
  // oldest case — see /tickets/review.
  lastTicketId Int?   @map("last_ticket_id")

  @@index([startedAt])
  @@map("helpdesk_reviews")
}

model HelpdeskReviewItem {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  ticketId  Int      @map("ticket_id")
  action    String   // replied | side_convo | noted | status | skipped
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reviewId])
  @@index([ticketId])
  @@map("helpdesk_review_items")
}

// An MSI uploaded to the Portal (or a plain URL) that can be pushed to a device.
model AgentPackage {
  id          Int      @id @default(autoincrement())
  name        String
  version     String?
  fileName    String?  @map("file_name")   // null = url-only package
  url         String?                       // external URL instead of an upload
  sizeBytes   Int?     @map("size_bytes")
  sha256      String?
  installArgs String   @default("/qn /norestart") @map("install_args")
  uploadedBy  Int?     @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("agent_packages")
}

// ── The software catalogue Automation deploys from ──────────────────────────────
// A vetted list. Anything schedulable at a fleet has been added here on purpose, with a
// source that says HOW it installs: a WinGet id, a Chocolatey id, or one of our own
// uploaded MSIs. Nothing is deployable at scale that nobody put here.
//
// `protected` marks software that is managed by its OWN pipeline and must NEVER be pushed
// from here - Bitdefender (GravityZone deploy) and MeshCentral (its own installer) above
// all. That is enforced in code as well as by this flag; see lib/software-catalogue.ts.
model SoftwareCatalogueItem {
  id             Int      @id @default(autoincrement())
  name           String
  publisher      String?
  category       String   @default("General")
  source         String   // winget | choco | package
  packageRef     String?  @map("package_ref")        // WinGet/Chocolatey package id
  agentPackageId Int?     @map("agent_package_id")   // our own uploaded MSI, when source='package'
  installArgs    String?  @map("install_args")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  protected      Boolean  @default(false)            // managed elsewhere - never deployable here
  sortOrder      Int      @default(100) @map("sort_order")
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("software_catalogue")
}

model AgentCommand {
  id          Int       @id @default(autoincrement())
  deviceId    Int       @map("device_id")
  kind        String    // shell.powershell | shell.cmd | software.list | services.* | files.list | users.* | ad.user.*
  payload     Json?
  status      String    @default("queued") // queued | running | done | failed | expired
  // Set when a command is deliberately held back - an app update queued into a machine's
  // maintenance window. The agent is never told about it; the poll simply does not hand
  // the command over until the time passes, so an offline machine still behaves correctly.
  runAfter    DateTime? @map("run_after")
  // "After next reboot": armed at this moment, and the poll refuses to hand the command
  // over until agent_devices.last_boot_at is LATER than it. Portal-side on purpose -
  // the agent needs to know nothing, and a machine that is off simply picks it up on the
  // first check-in after it has actually restarted.
  runAfterBoot DateTime? @map("run_after_boot")
  // Live progress while a command runs. The agent streams the tail of the output as it
  // appears, and a script that knows how far along it is says so with a [[progress:n]]
  // marker — so a ten-minute install stops looking like a hung window.
  progress    String?                          // the last few lines, as they happen
  progressPct Int?      @map("progress_pct")   // 0-100 when the script can say
  progressAt  DateTime? @map("progress_at")
  exitCode    Int?      @map("exit_code")
  output      String?
  requestedBy Int?      @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([deviceId, status])
  @@index([requestedAt])
  @@map("agent_commands")
}

// ── Network discovery ────────────────────────────────────────────────────────
// Things on a customer's network that will NEVER have our agent - printers, switches,
// routers, NAS, cameras. Deliberately NOT customer_assets: every screen and every count
// in that table assumes an agent can eventually be installed, and a printer breaks all of
// them. They are found BY an agent (usually the server) and monitored through it.

model NetworkScanRange {
  id            Int       @id @default(autoincrement())
  customerId    Int       @map("customer_id")
  // Which agent does the looking. A range is only meaningful from a machine that can see
  // it, so the scanner is part of the range, not a setting somewhere else.
  agentDeviceId Int       @map("agent_device_id")
  cidr          String                          // 192.168.70.0/24
  label         String    @default("")
  enabled       Boolean   @default(true)
  lastScanAt    DateTime? @map("last_scan_at")
  lastResult    String?   @map("last_result")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     Int?      @map("created_by")
  @@index([customerId])
  @@map("network_scan_ranges")
}

model NetworkDevice {
  id            Int       @id @default(autoincrement())
  customerId    Int       @map("customer_id")
  // The agent that can reach it. This is also the route we proxy through, so losing it
  // means losing access, not just discovery.
  agentDeviceId Int?      @map("agent_device_id")
  ip            String
  mac           String?
  hostname      String?
  vendor        String?                          // from the MAC OUI, before SNMP says anything
  sysName       String?   @map("sys_name")       // SNMP sysName
  sysDescr      String?   @map("sys_descr")      // SNMP sysDescr - what it actually is
  kind          String    @default("unknown")    // printer | switch | router | nas | ap | camera | unknown
  // OURS, and the whole point: "Reception printer" beats 192.168.70.50 on every screen
  // and every phone call. Same argument as friendlyName on an asset.
  friendlyName  String?   @map("friendly_name")
  notes         String?
  monitored     Boolean   @default(false)        // are we polling it, or just aware of it
  webUrl        String?   @map("web_url")        // http://192.168.70.50 - what we proxy to
  snmpVersion   String?   @map("snmp_version")   // 1 | 2c | 3
  snmpCommunity String?   @map("snmp_community") // ENCRYPTED (lib/vault.ts) - never plaintext
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  lastPollAt    DateTime? @map("last_poll_at")
  lastPollError String?   @map("last_poll_error")
  archivedAt    DateTime? @map("archived_at")
  @@unique([customerId, ip])
  @@index([customerId, kind])
  @@map("network_devices")
}

// Web-interface logins for a network device. The blob is AES-256-GCM from lib/vault.ts and
// this table is the reason VAULT_KEY has to exist before any of this is switched on: the
// Portal holding a customer's switch password in plaintext would be a worse problem than
// the one this module solves. Never returned to a browser - the proxy uses it server side.
model NetworkDeviceCredential {
  id              Int      @id @default(autoincrement())
  networkDeviceId Int      @map("network_device_id")
  kind            String   @default("web")       // web | snmpv3
  username        String   @default("")
  secretEnc       String   @map("secret_enc")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       Int?     @map("created_by")
  @@index([networkDeviceId])
  @@map("network_device_credentials")
}

// One row per consumable per poll-of-record. Printer-MIB (RFC 3805) reports a level and a
// max capacity per supply; percentage is computed, not reported, and the specials matter -
// -2 means "unknown" and -3 means "some remaining", and rendering either as a number is
// how a dashboard claims 0% toner on a printer that is fine.
model NetworkPrinterSupply {
  id              Int      @id @default(autoincrement())
  networkDeviceId Int      @map("network_device_id")
  name            String                              // "Black Toner Cartridge"
  colour          String?
  level           Int?
  maxCapacity     Int?     @map("max_capacity")
  percent         Int?                                // null when the device says unknown
  at              DateTime @default(now())
  @@index([networkDeviceId, at])
  @@map("network_printer_supplies")
}

model NetworkDeviceAlert {
  id              Int       @id @default(autoincrement())
  networkDeviceId Int       @map("network_device_id")
  code            String?
  severity        String    @default("info")
  description     String
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  clearedAt       DateTime? @map("cleared_at")
  @@index([networkDeviceId, clearedAt])
  @@map("network_device_alerts")
}

// ── Asset tags ───────────────────────────────────────────────────────────────
// TAGS, not smart groups. Terry, 20 Aug: "the groups will be sort of tags - think Dell
// computers, Larkmead Desktops and Larkmead Laptops, Clinical devices, Servers - we would
// filter all devices by basically anything we have on record, then select, add to group
// and name it."
//
// So membership is a deliberate act recorded once, NOT a rule re-evaluated forever. That
// is the right call and worth defending: a filter can find every Dell OptiPlex, but no
// hardware field on earth knows which machines are CLINICAL. The filter is how you build
// the list quickly; the tag is a human judgement about what the machine is FOR, and it
// must not silently change because someone swapped a motherboard or moved a subnet.
//
// A machine can carry as many tags as you like - a clinical Dell laptop at Larkmead is
// all four of those things at once, and every one of them is a list somebody will want.
model AssetTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  colour    String?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy Int?     @map("created_by")
  @@map("asset_tags")
}

model AssetTagMember {
  tagId   Int      @map("tag_id")
  assetId Int      @map("asset_id")
  addedAt DateTime @default(now()) @map("added_at")
  addedBy Int?     @map("added_by")
  @@id([tagId, assetId])
  @@index([assetId])
  @@map("asset_tag_members")
}

model CustomerAsset {
  id             Int       @id @default(autoincrement())
  customerId     Int?      @map("customer_id") // null = Atera agent not yet matched to a portal customer
  sourceSystem   String    @default("atera") @map("source_system")
  externalId     String    @map("external_id") // Atera AgentID
  deviceGuid     String?   @map("device_guid") // Atera's device GUID — used by the new Atera web UI's device URL
  hostname       String?
  // What a HUMAN calls this machine - "Cholsey Rec Left", "POD Computer", "Kim's laptop".
  // The hostname is what IT named it; this is what the customer says on the phone, and it
  // is therefore what somebody actually searches for. OURS, exactly like assignedContactId:
  // the Atera sync must never write it, and it survives every re-import.
  friendlyName   String?   @map("friendly_name")
  deviceType     String?   @map("device_type") // Workstation | Server | Mobile Device | Network Device | ...
  os             String?
  osVersion      String?   @map("os_version")
  manufacturer   String?
  model          String?
  serialNumber   String?   @map("serial_number")
  cpu            String?
  ramGb          Float?    @map("ram_gb")
  diskInfo       String?   @map("disk_info")
  ipAddresses    String?   @map("ip_addresses")
  macAddress     String?   @map("mac_address")
  domainOrWorkgroup String? @map("domain_or_workgroup")
  onlineStatus   Boolean   @default(false) @map("online_status")
  publicIp       String?   @map("public_ip") // the WAN IP Atera saw the agent report from
  agentVersion   String?   @map("agent_version")
  lastLoginUser  String?   @map("last_login_user")
  assignedContactId Int?   @map("assigned_contact_id") // Portal-side allocation to a customer contact - OUR data: editable despite the Atera read-only lock, survives every sync (Atera's API exposes no contact assignment)
  addedAt        DateTime? @map("added_at") // when Atera first recorded this agent
  lastSeenAt     DateTime? @map("last_seen_at")
  lastRebootAt   DateTime? @map("last_reboot_at")
  // Portal is master of the RMM record. agentDeviceId binds this asset to the LumenMSP
  // Agent that reports it; once bound, dataSource flips to 'agent' and the Atera sync is
  // no longer allowed to write any of the fields below - it may only ADD machines we do
  // not have and stamp its own identifiers.
  agentDeviceId  Int?      @map("agent_device_id")
  ateraAgentId   String?   @map("atera_agent_id")  // Atera's AgentID for a row WE own (external_id is ours)
  dataSource     String?   @default("atera") @map("data_source") // agent | atera
  // Set when this row was found to be a SECOND copy of a machine we already had, and
  // merged into that one. The row is kept rather than deleted so a wrong merge can be
  // undone - it is simply filtered out of every list.
  mergedIntoId   Int?      @map("merged_into_id")
  mergedAt       DateTime? @map("merged_at")
  // Archived = "not ours to manage — never getting an agent" (e.g. an Atera import of a
  // machine we don't cover). Kept, not deleted, so the Atera sync's upsert can't resurrect
  // it and a mistake is reversible; filtered out of every list exactly like a merged row.
  archivedAt     DateTime? @map("archived_at")
  archivedReason String?   @map("archived_reason")
  // ── Warranty ──────────────────────────────────────────────────────────────
  // The HEADLINE warranty, denormalised onto the asset so a list can sort, filter and
  // badge on it without touching the entitlements table. The detail (a machine often
  // carries several concurrent entitlements — hardware support, accidental damage,
  // battery) lives in asset_warranty_entitlements.
  //
  // warrantyLocked is the whole contract between a human and the vendor APIs: a person
  // who types a warranty in has seen the paperwork, and no nightly job is allowed to
  // overwrite that. Everything else is refreshable and disposable.
  warrantyProvider  String?   @map("warranty_provider")   // dell | hp | lenovo | aggregator | <supplier name>
  warrantyLevel     String?   @map("warranty_level")      // "ProSupport Plus NBD", "3Y Onsite"
  warrantyStart     DateTime? @map("warranty_start")
  warrantyEnd       DateTime? @map("warranty_end")        // the LATEST end date across entitlements
  warrantyShipDate  DateTime? @map("warranty_ship_date")  // manufacturer ship date, where the vendor gives it
  warrantySupplier  String?   @map("warranty_supplier")   // who we bought it from
  warrantyNotes     String?   @map("warranty_notes")
  warrantySource    String?   @map("warranty_source")     // manual | api:dell | api:hp | api:lenovo | api:aggregator
  warrantyCheckedAt DateTime? @map("warranty_checked_at")
  warrantyError     String?   @map("warranty_error")      // last lookup failure, shown so a silent gap is visible
  warrantyLocked    Boolean   @default(false) @map("warranty_locked") // a human typed it — no API may overwrite
  raw            Json?     // full source payload, for fields not yet promoted to columns
  syncedAt       DateTime  @default(now()) @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  licences CustomerLicence[]

  @@unique([sourceSystem, externalId])
  @@index([customerId])
  @@index([hostname])
  @@index([assignedContactId])
  @@index([agentDeviceId])
  @@index([mergedIntoId])
  @@index([warrantyEnd])
  @@map("customer_assets")
}

// One warranty entitlement as a vendor reports it. A machine normally has SEVERAL running
// at once (hardware support, accidental damage, battery, keep-your-drive), with different
// end dates — collapsing them to one row on the asset would throw away the answer to
// "is the ACCIDENTAL DAMAGE cover still live?", which is the question that gets asked.
//
// Rows are REPLACED wholesale per asset on each successful lookup, never merged: a vendor
// dropping an entitlement is information, and a merge would keep a dead one alive forever.
model AssetWarrantyEntitlement {
  id            Int       @id @default(autoincrement())
  assetId       Int       @map("asset_id")
  serviceCode   String?   @map("service_code")        // vendor's own code, e.g. "PS4AM"
  description   String?                               // "ProSupport Plus: Next Business Day Onsite"
  entitlementType String? @map("entitlement_type")    // INITIAL | EXTENDED | ...
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  source        String?                               // api:dell | api:hp | api:lenovo | api:aggregator
  collectedAt   DateTime  @default(now()) @map("collected_at")

  @@index([assetId])
  @@index([endDate])
  @@map("asset_warranty_entitlements")
}

// "Ask Portal" findings — the logic file.
//
// Every answer an engineer chooses to keep is a row here, and every future Ask on the same
// machine (and on that customer's other machines) reads them back in as evidence. That is
// the whole point of the feature: the second person to look at a machine starts where the
// first one finished instead of from nothing.
//
// The QUESTION is stored as well as the answer. Without it a finding is unreadable six
// months later — "the NIC is dropping under load" means something quite different if the
// question was about Teams calls than if it was about a backup failing.
model DeviceFinding {
  id         Int      @id @default(autoincrement())
  assetId    Int      @map("asset_id")            // customer_assets.id — the machine
  customerId Int?     @map("customer_id")         // denormalised so a customer-wide read needs no join
  deviceId   Int?     @map("device_id")           // agent_devices.id at the time, if any
  question   String
  summary    String?                              // the headline, used in lists and in future corpora
  answer     String
  ticketId   Int?     @map("ticket_id")           // the case that was attached as context
  userId     Int?     @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@index([customerId])
  @@index([createdAt])
  @@map("device_findings")
}

// Durable note against a comms CLI / ref (e.g. "line rental ceasing next month"). Kept in its own
// table because service_items are wiped & re-imported, so a note on the line itself would be lost.
model McpCallLog {
  id         Int      @id @default(autoincrement())
  method     String                              // JSON-RPC method (tools/call, tools/list, initialize…)
  tool       String?                             // the tool name for a tools/call
  args       Json?                               // the tool arguments, verbatim (audit — Terry: "log everything")
  ok         Boolean  @default(true)             // false = the tool returned an error result
  error      String?                             // error text when ok=false
  durationMs Int?     @map("duration_ms")
  ip         String?
  principal  String?                             // WHICH token made the call — "Owner (env token)" or an mcp_tokens label
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([tool])
  @@index([principal])
  @@map("mcp_call_log")
}

// A delegated MCP token — one per person, so the connector is no longer a single shared
// secret. The token itself is NEVER stored, only its sha256: a lost token is re-issued,
// not recovered. canWrite defaults false and the admin screen offers no way to set it
// true, so a delegated token can only ever reach read tools (see routes/mcp.ts).
model McpToken {
  id         Int       @id @default(autoincrement())
  label      String                                    // who this is for — stamped on every call in mcp_call_log
  tokenHash  String    @unique @map("token_hash")       // sha256 hex of the token
  prefix     String                                    // first 8 chars, so a row can be matched to a URL on sight
  canWrite   Boolean   @default(false) @map("can_write")
  note       String?
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  lastIp     String?   @map("last_ip")
  callCount  Int       @default(0) @map("call_count")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")

  @@map("mcp_tokens")
}

model CommsLineNote {
  id               Int      @id @default(autoincrement())
  customerId       Int?     @map("customer_id")
  productReference String   @map("product_reference") // the CLI / ref the note is about
  note             String
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([productReference])
  @@index([customerId])
  @@map("comms_line_notes")
}

// IT & Cloud change-ledger. Tracks the last-known Giacom state per (customer, product, buy price)
// so we can bill ADDS a month upfront and keep REMOVALS billing for a 30-day notice period — even
// though Giacom service_items are wiped & re-inserted nightly (no built-in history to diff).
model ItCloudServiceState {
  id                Int       @id @default(autoincrement())
  customerId        Int       @map("customer_id")
  description       String
  unitCost          Decimal   @map("unit_cost") @db.Decimal(12, 4)
  qty               Int       @default(0)
  saleEach          Decimal   @default(0) @map("sale_each") @db.Decimal(12, 2)
  upfrontPendingQty Int       @default(0) @map("upfront_pending_qty") // added qty not yet billed a month upfront
  firstSeen         DateTime  @default(now()) @map("first_seen")
  removedAt         DateTime? @map("removed_at") // set when it drops off Giacom; kept billing 30 days then purged
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([customerId, description, unitCost])
  @@index([customerId])
  @@map("it_cloud_service_state")
}

// Service history — every detected change to a customer's monthly IT&Cloud services, so staff can
// see exactly what Giacom sent (adds / removals / qty changes). Recorded by syncItCloudDeltas.
model ItCloudChangeLog {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  description String
  changeType  String   @map("change_type") // added | removed | qty_up | qty_down
  oldQty      Int?     @map("old_qty")
  newQty      Int?     @map("new_qty")
  detectedAt  DateTime @default(now()) @map("detected_at")

  @@index([customerId, detectedAt])
  @@map("it_cloud_change_log")
}

// Per-CLI extension/user label, derived OVERNIGHT from Insights call data (the extension that
// most handles that number). Display-only — shows next to the CLI on the comms asset list.
model CliExtensionLabel {
  id        Int      @id @default(autoincrement())
  cli       String   @unique // digits-only normalised number
  extName   String   @map("ext_name")
  calls     Int      @default(0) // calls seen for the winning extension (confidence)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("cli_extension_labels")
}

// Number ranges OWNED by a customer. Drive auto-allocation: any comms CLI / call record whose
// digits fall in a range is attributed to that customer (unless manually pinned elsewhere).
model CustomerNumberRange {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  rangeFrom  String   @map("range_from") // digits only
  rangeTo    String   @map("range_to")
  location   String?
  label      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_number_ranges")
}

// Per-customer call-type markup overrides. Absent row = use the global default
// (settings comms/call_markup_<type>). Markup only ever applies to chargeable calls.
model CustomerCallMarkup {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  callType   String   @map("call_type") // on_net | uk_geo | uk_mobile | nongeo_intl
  markupPct  Decimal  @map("markup_pct") @db.Decimal(6, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([customerId, callType])
  @@index([customerId])
  @@map("customer_call_markups")
}

// â”€â”€ Package Manager â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// A Package is a customer-facing sell product that hides one or more underlying Giacom cost
// lines behind one set price (e.g. Simply VoIP Seat, Simply Mobile — Unlimited). Cost comes
// from the live matched lines (tier floats); the customer sees the package name + set price.
model Package {
  id            Int      @id @default(autoincrement())
  name          String   // customer-facing, e.g. "Simply Mobile — Unlimited (EE) 24m"
  category      String   @default("voice") // internet|voice|mobile|additional (drives invoice bucket)
  kind          String   @default("per_cli") // per_cli (1 per matching CLI @ standard) | per_cli_priced (per-instance price) | flat (one per customer, manual price)
  matchPattern  String?  @map("match_pattern") // regex (case-insensitive) over the Giacom description; null = manual-only
  requiresSeat  Boolean  @default(false) @map("requires_seat") // add-on: only bills on a CLI that also carries a seat package
  standardPrice Decimal  @default(0) @map("standard_price") @db.Decimal(12, 2) // default sell (override per customer)
  termLabel     String?  @map("term_label") // e.g. "12m" / "24m"
  bundledNote   String?  @map("bundled_note") // what's included free (handset, Webex…) — display only
  sortOrder     Int      @default(100) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  prices   PackagePrice[]
  products PackageProduct[]
  @@map("packages")
}

// The Giacom core products that make up a package (intuitive pick-list). A CLI matches the
// package if one of its lines is one of these products (or the family pattern matches).
model PackageProduct {
  id          Int    @id @default(autoincrement())
  packageId   Int    @map("package_id")
  productName String @map("product_name") // Giacom description, e.g. "EE30ES2-Everyway Standard 2GB"

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  @@unique([packageId, productName])
  @@map("package_products")
}

// Per-customer price override for a package (the standard-with-override model).
model PackagePrice {
  id         Int      @id @default(autoincrement())
  packageId  Int      @map("package_id")
  customerId Int      @map("customer_id")
  salePrice  Decimal  @map("sale_price") @db.Decimal(12, 2)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  @@unique([packageId, customerId])
  @@map("package_prices")
}

// Manual override of auto-matching: force a CLI into a package, or exclude it (packageId null).
model PackageCliOverride {
  id        Int      @id @default(autoincrement())
  cli       String   @unique
  packageId Int?     @map("package_id") // null = exclude this CLI from all packages
  createdAt DateTime @default(now()) @map("created_at")
  @@map("package_cli_overrides")
}

// â”€â”€ Purchase Ledger — our managed list of accounts (bank / card) money is spent from â”€â”€
model BankAccountRef {
  id            Int      @id @default(autoincrement())
  name          String   // e.g. "Barclays Current", "Amex Business"
  qbAccountId   String?  @map("qb_account_id")   // maps to the QuickBooks bank/CC account for posting
  qbAccountName String?  @map("qb_account_name")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(100) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  @@map("bank_account_refs")
}

// â”€â”€ Purchase Ledger — bank transactions to reconcile into expenses â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model BankTransaction {
  id             Int       @id @default(autoincrement())
  source         String    @default("csv") // openbanking | csv | qb
  externalId     String?   @map("external_id") // bank/provider transaction id (dedupe key)
  accountRefId   Int?      @map("account_ref_id") // which of our managed accounts it belongs to
  accountName    String?   @map("account_name") // account label (denormalised for display)
  bookedAt       DateTime  @map("booked_at") // date + time of the transaction
  amount         Decimal   @db.Decimal(12, 2) // negative = money out (expense)
  currencyCode   String    @default("GBP") @map("currency_code")
  description    String?   // bank narrative
  counterparty   String?   // merchant / payee
  reference      String?   // bank reference
  qbAccountId    String?   @map("qb_account_id")   // chosen QB COS / expense account id
  qbAccountName  String?   @map("qb_account_name")
  attachmentPath String?   @map("attachment_path") // uploaded invoice/receipt
  attachmentName String?   @map("attachment_name")
  status         String    @default("new") // new | categorised | submitted | pushed
  // Match provenance — an auto-link must be distinguishable from a human one, and undoable.
  matchedBy      String?   @map("matched_by")      // rules | claude | human
  matchConfidence Int?     @map("match_confidence") // 0-100, Claude's own number
  matchReason    String?   @map("match_reason")
  matchedAt      DateTime? @map("matched_at")
  qbPurchaseId   String?   @map("qb_purchase_id")  // set when pushed to QuickBooks
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([source, externalId])
  @@index([status])
  @@index([bookedAt])
  @@map("bank_transactions")
}

// â”€â”€ Purchase Ledger — pooled supplier invoices (invoice@ mailbox + manual uploads) â”€
model PurchaseDocument {
  id                Int       @id @default(autoincrement())
  source            String    @default("email") // email | upload
  fromEmail         String?   @map("from_email")
  fromName          String?   @map("from_name")
  subject           String?
  receivedAt        DateTime? @map("received_at")
  fileName          String    @map("file_name")
  filePath          String    @map("file_path")   // on-disk path (private, streamed via auth route)
  contentType       String?   @map("content_type")
  sizeBytes         Int?      @map("size_bytes")
  status            String    @default("new") // new | attached
  bankTransactionId Int?      @map("bank_transaction_id") // set when attached to an expense
  graphMessageId    String?   @map("graph_message_id")
  // Extracted from the document text (PDF / HTML body) to power auto-matching.
  parsedAmount      Decimal?  @db.Decimal(12, 2) @map("parsed_amount") // invoice gross total
  parsedInvoiceNo   String?   @map("parsed_invoice_no")
  parsedDate        String?   @map("parsed_date")
  parseStatus       String?   @map("parse_status") // ok | no_text | error | null(=not tried)
  // Category chosen at capture (mobile receipt logger) — carried onto the matched txn.
  categoryId        String?   @map("category_id")
  categoryName      String?   @map("category_name")
  archivedAt        DateTime? @map("archived_at")   // hidden from the inbox; still findable on the Archived tab
  // Bulk upload + duplicate detection (Sep 2026). fileHash is the sha256 of the bytes —
  // the exact-duplicate key. relPath keeps the subfolder a bulk-uploaded file came from so a
  // folder tree stays readable; batchId groups one upload so its summary can be re-opened.
  fileHash          String?   @map("file_hash")
  relPath           String?   @map("rel_path")
  batchId           String?   @map("batch_id")
  // dupeStatus: null = clean | likely = same invoice arrived twice | paid = the earlier copy is
  // already attached to a payment | dismissed = a human said it is genuinely a separate bill.
  dupeStatus        String?   @map("dupe_status")
  dupeOfId          Int?      @map("dupe_of_id")
  dupePaidTxnId     Int?      @map("dupe_paid_txn_id")
  dupeReason        String?   @map("dupe_reason")
  // A match Claude proposed but was not confident enough to apply — one click accepts it.
  suggestTxnId      Int?      @map("suggest_txn_id")
  suggestConfidence Int?      @map("suggest_confidence")
  suggestReason     String?   @map("suggest_reason")
  aiReadStatus      String?   @map("ai_read_status")  // ok | failed | unreadable | null(=not tried)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([graphMessageId, fileName])
  @@index([status])
  @@index([archivedAt])
  @@index([fileHash])
  @@index([dupeStatus])
  @@map("purchase_documents")
}

// ── Purchase Ledger — what Claude read off an invoice it could SEE ───────────────
// Populated only when the free text parse came back empty (a scan or photo) or when a
// match was too ambiguous for the rules. `aiSupplier` is the supplier as it appears ON
// THE INVOICE, which is often not who the bank statement names.
model PurchaseDocAi {
  id           Int      @id @default(autoincrement())
  documentId   Int      @unique @map("document_id")
  aiSupplier   String?  @map("ai_supplier")
  aiInvoiceNo  String?  @map("ai_invoice_no")
  aiDate       String?  @map("ai_date")
  aiNet        Decimal? @db.Decimal(12, 2) @map("ai_net")
  aiVat        Decimal? @db.Decimal(12, 2) @map("ai_vat")
  aiGross      Decimal? @db.Decimal(12, 2) @map("ai_gross")
  aiCurrency   String?  @map("ai_currency")
  aiPeriod     String?  @map("ai_period")      // service period the bill covers, when stated
  aiSummary    String?  @map("ai_summary")     // one line: what was actually bought
  aiConcerns   String?  @map("ai_concerns")    // anything that looked wrong on the face of it
  readAt       DateTime @default(now()) @map("read_at")
  @@map("purchase_doc_ai")
}

// ── Purchase Ledger — what we have LEARNED about each supplier ───────────────────
// Grown from confirmed matches, not hand-written. This is the memory that lets the
// matcher recognise a supplier by the descriptor its processor puts on the statement,
// know how long it takes to collect, and notice when a bill is the wrong size or late.
model PurchaseSupplierProfile {
  id             Int       @id @default(autoincrement())
  supplierKey    String    @unique @map("supplier_key")  // normalised, the join key
  displayName    String?   @map("display_name")
  descriptors    String?   // JSON array of bank descriptors seen on confirmed matches
  qbAccountId    String?   @map("qb_account_id")
  qbAccountName  String?   @map("qb_account_name")
  matchCount     Int       @default(0) @map("match_count")
  lastAmount     Decimal?  @db.Decimal(12, 2) @map("last_amount")
  avgAmount      Decimal?  @db.Decimal(12, 2) @map("avg_amount")
  minAmount      Decimal?  @db.Decimal(12, 2) @map("min_amount")
  maxAmount      Decimal?  @db.Decimal(12, 2) @map("max_amount")
  avgLagDays     Int?      @map("avg_lag_days")   // invoice date -> money leaving the bank
  cadenceDays    Int?      @map("cadence_days")   // typical gap between bills (30 = monthly)
  lastInvoiceAt  DateTime? @map("last_invoice_at")
  lastPaidAt     DateTime? @map("last_paid_at")
  isFxBilled     Boolean   @default(false) @map("is_fx_billed")
  notes          String?
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  @@map("purchase_supplier_profiles")
}

// ── Purchase Ledger — the anomaly list Terry and Natalie work from ───────────────
// One row per open question about the ledger. Rules raise most of them; Claude raises the
// ones that need reading. `dedupeKey` keeps a recurring condition as ONE row that updates,
// so the list is a worklist and not a log.
model PurchaseAnomaly {
  id          Int       @id @default(autoincrement())
  dedupeKey   String    @unique @map("dedupe_key")
  kind        String    // already_paid | unpaid_invoice | payment_no_invoice | price_jump | missing_bill | new_supplier | vat_mismatch | ai_concern
  severity    String    @default("info") // high | medium | info
  title       String
  detail      String?
  amount      Decimal?  @db.Decimal(12, 2)
  documentId  Int?      @map("document_id")
  txnId       Int?      @map("txn_id")
  supplierKey String?   @map("supplier_key")
  status      String    @default("open") // open | dismissed | resolved
  dismissedBy Int?      @map("dismissed_by")
  dismissedAt DateTime? @map("dismissed_at")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @updatedAt @map("last_seen_at")
  @@index([status])
  @@index([kind])
  @@map("purchase_anomalies")
}

// â”€â”€ Purchase Ledger — split a single bank transaction across several categories â”€â”€â”€â”€â”€
model BankTransactionSplit {
  id             Int      @id @default(autoincrement())
  transactionId  Int      @map("transaction_id")
  amount         Decimal  @db.Decimal(12, 2) // positive magnitude of this allocation
  qbAccountId    String?  @map("qb_account_id")   // category (QB account id, or local:<name>)
  qbAccountName  String?  @map("qb_account_name")
  attachmentPath String?  @map("attachment_path") // invoice/receipt for this split
  attachmentName String?  @map("attachment_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([transactionId])
  @@map("bank_transaction_splits")
}

// â”€â”€ Service items (billing lines pulled from suppliers — Giacom now, Comms later) â”€
model ServiceItem {
  id                   Int       @id @default(autoincrement())
  source               String    @default("giacom") // giacom | comms | ...
  customerId           Int?      @map("customer_id") // null until the supplier account is matched to a portal customer
  externalCustomerId   String?   @map("external_customer_id")   // supplier's customer id (e.g. Giacom customerId)
  externalCustomerName String?   @map("external_customer_name")
  productId            String?   @map("product_id")
  productReference     String?   @map("product_reference")
  description          String?
  quantity             Decimal   @default(0) @db.Decimal(12, 2)
  unitCost             Decimal   @default(0) @map("unit_cost") @db.Decimal(12, 4) // costPerSeat
  totalCost            Decimal   @default(0) @map("total_cost") @db.Decimal(12, 2)
  billingDate          DateTime? @map("billing_date")
  billingFrom          DateTime? @map("billing_from") @db.Date // service start in period (mid-period = new = prorata)
  billingTo            DateTime? @map("billing_to") @db.Date
  billingPeriod        String?   @map("billing_period") // YYYY-MM of the line (from billing_from)
  isProrata            Boolean   @default(false) @map("is_prorata") // true = part-period (mid-month start/end), not a full recurring month
  location             String?   // customer-set label for a circuit/CLI (e.g. broadband site/office)
  isManual             Boolean   @default(false) @map("is_manual") // added by hand (not from Giacom) — survives the import wipe
  isProjected          Boolean   @default(false) @map("is_projected") // rolled forward from the last actual month (advance billing) — replaced when the supplier file lands
  isOneOff             Boolean   @default(false) @map("is_one_off") // install/cease/connection fee — bill once
  billedAt             DateTime? @map("billed_at") // when a one-off was billed; once set it drops off the rate card
  invoiceCategory      String?   @map("invoice_category") // internet|voice|mobile|additional|oneoff|call (override; else classified from description)
  vatStatus            String?   @map("vat_status") // supplier VAT flag (e.g. "VAT 20%" | "DRC 20%") — sell is always 20% standard
  syncedAt             DateTime  @default(now()) @map("synced_at") // last import that included this line ("live")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@index([source])
  @@index([externalCustomerId])
  @@index([billingPeriod]) // Phase 0: the comms engine filters on billing_period constantly
  @@map("service_items")
}

// Generic recycle store for rows that are removed from churny/synced tables (e.g. service_items,
// which is wiped + re-inserted nightly). The whole row is snapshotted as JSON so a delete is fully
// recoverable from /recycle-bin without scattering deleted_at filters through every billing query.
model RecycleItem {
  id              Int       @id @default(autoincrement())
  entityType      String    @map("entity_type")   // e.g. comms_line
  sourceTable     String    @map("source_table")  // table the row came from
  label           String?                          // headline for the recycle-bin list
  sublabel        String?                          // secondary text
  snapshot        Json                             // the full original row
  reason          String?
  deletedByUserId Int?      @map("deleted_by_user_id")
  deletedAt       DateTime  @default(now()) @map("deleted_at")
  restoredAt      DateTime? @map("restored_at")

  @@index([entityType, restoredAt])
  @@map("recycle_items")
}

// â”€â”€ DWS / Giacom bill-run files pulled over SFTP (leave-and-track ingest) â”€â”€â”€â”€â”€â”€â”€â”€
model DwsFile {
  id         Int      @id @default(autoincrement())
  filename   String   @unique
  remotePath String?  @map("remote_path")
  size       Int?
  hash       String?
  status     String   @default("downloaded") // downloaded | parsed | error
  rowsParsed Int      @default(0) @map("rows_parsed")
  columns    String?  // detected header columns (for mapping)
  error      String?
  ingestedAt DateTime @default(now()) @map("ingested_at")

  @@index([status])
  @@map("dws_files")
}

// â”€â”€ Itemized call records (CDRs) — for billing customers (cost + markup) â”€â”€â”€â”€â”€â”€â”€â”€â”€
model CallRecord {
  id            Int       @id @default(autoincrement())
  source        String    @default("landline") // landline | mobile
  sourceFile    String?   @map("source_file")
  cli           String?   // the customer's line (Customer CLI / mobile number)
  customerId    Int?      @map("customer_id") // resolved via the CLI directory
  dialled       String?   // number dialled
  callAt        DateTime? @map("call_at")
  durationSec   Int       @default(0) @map("duration_sec")
  description   String?
  cost          Decimal   @default(0) @db.Decimal(12, 4) // what the carrier charges us
  billingPeriod String?   @map("billing_period")          // YYYY-MM
  billedAt      DateTime? @map("billed_at") // stamped when the call went out on a sent invoice — billing selects by THIS flag, never period arithmetic
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@index([cli])
  @@index([billingPeriod])
  @@index([billedAt])
  @@map("call_records")
}

// â”€â”€ Durable sell prices for supplier service lines â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// service_items are refreshed from suppliers (Giacom is wiped & re-inserted nightly),
// so the SELL price can't live there. This table persists the sale price per
// customer + product + BUY PRICE — a different buy price for the same product is a
// distinct row (so it bills/reports on its own line). Billing & reports resolve sale
// here; a missing row means the service is uncosted (surfaces in the bureau queue).
model ServicePricing {
  id                 Int      @id @default(autoincrement())
  source             String   @default("giacom") // giacom | lumen | comms | ...
  customerId         Int?     @map("customer_id")
  productReference   String?  @map("product_reference")
  description        String?
  unitCost           Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 4) // buy price this pricing applies to
  salePrice          Decimal  @default(0) @map("sale_price") @db.Decimal(12, 4) // per-unit sell
  catalogueProductId Int?     @map("catalogue_product_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([source, customerId, productReference, unitCost], name: "uq_service_pricing", map: "uq_service_pricing")
  @@index([customerId])
  @@map("service_pricing")
}

// The Customer Register (billing register rebuild Phase 1) - one durable rate card per
// customer; the invoice becomes a monthly rendering of it. Raw-SQL managed by
// src/lib/register.ts but MUST stay declared here or `prisma db push` drops the tables.
model CustomerRegisterLine {
  id             Int       @id @default(autoincrement())
  customerId     Int       @map("customer_id")
  source         String // 'comms-feed' | 'cloud-feed' | 'lumen'
  sourceKey      String    @map("source_key") // identity within the source: comms 'cli|pN', cloud giacom code, lumen 'L<id>'
  cli            String? // comms lines - keeps per-CLI granularity
  productId      Int?      @map("product_id") // catalogue link (asset_products)
  description    String // supplier's latest label - display only, never identity
  invoiceCategory String?  @map("invoice_category")
  location       String?
  qty            Decimal   @default(1) @db.Decimal(12, 2)
  qtyMode        String    @default("fixed") @map("qty_mode") // 'fixed' | 'derived' (seats/rec auto-count at render)
  unitCost       Decimal   @default(0) @map("unit_cost") @db.Decimal(12, 4) // buy - latest from feed
  salePrice      Decimal?  @map("sale_price") @db.Decimal(12, 4) // sell per unit; NULL = unpriced amber, never bills
  vatRate        Decimal   @default(20) @map("vat_rate") @db.Decimal(5, 2)
  billingFrequency String  @default("monthly") @map("billing_frequency")
  status         String    @default("active") // 'active' | 'unpriced' | 'ceased'
  firstSeen      DateTime  @default(now()) @map("first_seen")
  lastSeen       DateTime  @default(now()) @map("last_seen")
  ceasedAt       DateTime? @map("ceased_at")
  ceaseEffective DateTime? @map("cease_effective") // cloud: cease + 30-day notice - bills until here
  contractLineId Int?      @map("contract_line_id")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([customerId, source, sourceKey])
  @@index([customerId])
  @@index([source])
  @@index([status])
  @@map("customer_register_lines")
}

model RegisterChange {
  id             Int      @id @default(autoincrement())
  registerLineId Int?     @map("register_line_id")
  customerId     Int      @map("customer_id")
  changeType     String   @map("change_type") // added|ceased|reinstated|qty|cost|price|desc|manual-edit
  oldValues      Json?    @map("old")
  newValues      Json?    @map("new")
  actor          String // 'comms-import' | 'cloud-sync' | 'migration' | 'user:<id>' | 'contract-push'
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([registerLineId])
  @@map("register_changes")
}

// â”€â”€ Quotes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Quote {
  id              Int       @id @default(autoincrement())
  customerId      Int?      @map("customer_id")
  inboxTicketId   Int?      @map("inbox_ticket_id") // → future helpdesk module (no FK yet)
  quoteNumber     String    @unique @map("quote_number")
  title           String
  status          String    @default("draft") // draft | sent | accepted | lost | invoiced
  acceptToken     String?   @unique @map("accept_token")
  viewCount       Int       @default(0) @map("view_count")
  issueDate       DateTime? @map("issue_date") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  currencyCode    String    @default("GBP") @map("currency_code")
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  total           Decimal   @default(0) @db.Decimal(12, 2)
  notes           String?
  terms           String?
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  acceptedByName  String?   @map("accepted_by_name")
  acceptedByEmail String?   @map("accepted_by_email")
  acceptedAt      DateTime? @map("accepted_at")
  approveNote     String?   @map("approve_note")
  rejectReason    String?   @map("reject_reason")
  sentTo          String?   @map("sent_to")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId Int?      @map("deleted_by_user_id")
  // Set when the quote became an invoice. The invoice itself is the record - this is
  // here so the quote list can say so without joining, and so "when did we bill it"
  // survives the invoice being voided later.
  invoicedAt      DateTime? @map("invoiced_at")

  customer Customer?   @relation(fields: [customerId], references: [id])
  items    QuoteItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
  @@map("quotes")
}

model QuoteItem {
  id           Int      @id @default(autoincrement())
  quoteId      Int      @map("quote_id")
  productId    Int?     @map("product_id")  // → future catalogue (no FK yet)
  supplierId   Int?     @map("supplier_id")
  sortOrder    Int      @default(1) @map("sort_order")
  description  String
  quantity     Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  taxRate      Decimal  @default(20) @map("tax_rate") @db.Decimal(6, 2)
  lineTotal    Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  buyPrice     Decimal  @default(0) @map("buy_price") @db.Decimal(12, 2)
  supplierName String?  @map("supplier_name")
  supplierUrl  String?  @map("supplier_url")
  createdAt    DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

// â”€â”€ Invoices â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Invoice {
  id                  Int       @id @default(autoincrement())
  // Public per-invoice view link. Without a page of our own to land on, an invoice "open"
  // could only ever be a tracking-pixel guess; this makes it evidence, as it already is
  // for quotes and contracts.
  viewToken           String?   @unique @map("view_token")
  customerId          Int?      @map("customer_id")
  // "FAO <person>" on the invoice address block. The CUSTOMER stays the bill-to and the
  // debtor - this only names who at that company the invoice is for. Stored as TEXT, not a
  // contact FK, on purpose: an invoice is a historical document, so renaming or deleting a
  // contact must not change or blank what a already-sent PDF says.
  faoName             String?   @map("fao_name")
  quoteId             Int?      @map("quote_id")
  quickbooksInvoiceId String?   @map("quickbooks_invoice_id")
  gocardlessPaymentId String?   @map("gocardless_payment_id")
  gocardlessPayoutRef String?   @map("gocardless_payout_ref")  // bank-statement ref of the GC payout that included this payment
  gocardlessPaidOutAt DateTime? @db.Date @map("gocardless_paid_out_at") // payout arrival date
  paymentStatus       String    @default("unpaid") @map("payment_status") // unpaid | pending | paid | failed
  invoiceNumber       String?   @unique @map("invoice_number") // NULL while staged — allocated at Complete
  staged              Boolean   @default(false) // staged in Bureau (no number, hidden from Invoices list) until completed
  approvedAt          DateTime? @map("approved_at") // ticked off in Bureau, ready to complete
  invoiceScheme       String    @default("IT") @map("invoice_scheme") // IT | CS
  title               String
  paymentMethod       String    @default("upfront") @map("payment_method")
  status              String    @default("draft") // draft | issued | paid | void
  emailedAt           DateTime? @map("emailed_at")
  isLocked            Boolean   @default(false) @map("is_locked")
  issueDate           DateTime? @map("issue_date") @db.Date
  dueDate             DateTime? @map("due_date") @db.Date
  currencyCode        String    @default("GBP") @map("currency_code")
  subtotal            Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  total               Decimal   @default(0) @db.Decimal(12, 2)
  balance             Decimal   @default(0) @db.Decimal(12, 2) // outstanding, synced from QuickBooks
  paymentSyncedAt     DateTime? @map("payment_synced_at")      // last time payment state was pulled from QB
  syncedAt            DateTime? @map("synced_at")              // last IT&Cloud Giacom sync run for this invoice
  // Recurring billing — any invoice can become a monthly template.
  isRecurring         Boolean   @default(false) @map("is_recurring")
  contractType        String?   @map("contract_type") // IT | Comms | Cloud — the customer's contract invoice (one per type)
  billingPeriod       String?   @map("billing_period") // YYYY-MM the bill run produced this for (comms)
  recurringName       String?   @map("recurring_name")
  recurringActive     Boolean   @default(true)  @map("recurring_active")
  recurringParentId   Int?      @map("recurring_parent_id")  // set on generated invoices → their template
  sendDay             Int?      @map("send_day")  // day of month it generates/sends/collects (e.g. 23)
  dueDay              Int?      @map("due_day")   // day of month due / issue date (e.g. 1, next month)
  autoSend            Boolean   @default(false) @map("auto_send")
  autoQb              Boolean   @default(false) @map("auto_qb")
  autoGc              Boolean   @default(false) @map("auto_gc")
  lastGeneratedAt     DateTime? @map("last_generated_at")
  notes               String?
  terms               String?
  createdBy           Int?      @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  deletedByUserId     Int?      @map("deleted_by_user_id")

  customer Customer?     @relation(fields: [customerId], references: [id])
  quote    Quote?        @relation(fields: [quoteId], references: [id])
  items    InvoiceItem[]

  @@index([customerId])
  @@index([quoteId])
  @@index([status])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  productId   Int?     @map("product_id")
  source      String   @default("manual") // manual | giacom | contract | product — drives selective refresh
  invoiceCategory String? @map("invoice_category") // internet|voice|mobile|additional|oneoff|call — page-1 summary bucket
  sortOrder   Int      @default(1) @map("sort_order")
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  taxRate     Decimal  @default(20) @map("tax_rate") @db.Decimal(6, 2)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  isOneOff    Boolean  @default(false) @map("is_one_off") // ad-hoc one-off — stripped on template roll-over
  // â”€â”€ Hybrid IT&Cloud sync (source='giacom' = synced line) â”€â”€
  syncLocked  Boolean  @default(false) @map("sync_locked")  // manually edited synced line — sync won't overwrite
  syncRef     String?  @map("sync_ref")                     // Giacom match key (product_reference|unit_cost)
  syncDrift   String?  @map("sync_drift")                   // note when a locked override differs from current Giacom
  lastSyncedAt DateTime? @map("last_synced_at")
  // â”€â”€ Contract sync (source='contract') â”€â”€
  // Links a template line back to the contract line it came from, so pushing a contract to
  // billing updates the same rows instead of appending duplicates every time.
  contractLineId Int?   @map("contract_line_id")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([contractLineId])
  @@map("invoice_items")
}

// â”€â”€ Document activity â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// One timeline for quotes, contracts and invoices: what we sent, what the customer did
// with it, and when. Deliberately records HOW MUCH each event can be trusted --
// `confidence` separates things that happened on our own site (a page load, a download,
// a signature: evidence) from things inferred from an email client fetching an image
// (indicative at best, since Outlook blocks images and Apple Mail pre-fetches them).
model DocumentEvent {
  id         Int      @id @default(autoincrement())
  docType    String   @map("doc_type")   // quote | contract | invoice
  docId      Int      @map("doc_id")
  customerId Int?     @map("customer_id")
  event      String                       // sent | delivered | email_opened | opened | downloaded | printed | signed | countersigned | accepted | declined | reminder_sent
  confidence String   @default("evidence") // evidence | indicative
  actor      String?                      // email address or name this is attributed to
  ip         String?
  userAgent  String?  @map("user_agent")
  meta       Json?                        // recipient, version, prefetch flag, anything event-specific
  // Set on the 'sent' row; the tracking pixel URL carries it back so an open can be tied
  // to one specific send rather than the document in general.
  pixelToken String?  @unique @map("pixel_token")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([docType, docId])
  @@index([customerId])
  @@index([event])
  @@index([createdAt])
  @@map("document_events")
}

// â”€â”€ Tickets / Helpdesk / Inbox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Ticket {
  id                    Int       @id @default(autoincrement())
  ticketNumber          String    @unique @map("ticket_number")
  source                String    @default("email") // email | manual | phone | whatsapp | teams | atera_import
  customerId            Int?      @map("customer_id")
  siteId                Int?      @map("site_id")
  contactId             Int?      @map("contact_id")
  assignedUserId        Int?      @map("assigned_user_id")
  assignedByUserId      Int?      @map("assigned_by_user_id")
  status                String    @default("new") // new | open | in_progress | pending | resolved | closed
  priority              String    @default("normal") // normal | high | urgent
  stage                 String    @default("awaiting_triage")
  activityStatus        String    @default("unread") @map("activity_status") // unread | read | waiting_customer | awaiting_tech
  category              String    @default("incident") // incident | problem | service_request | change_request | enquiry | order | repair | warranty
  department            String?   // support | sales | repair_center | comms | quotes | invoices | leads | general
  subject               String
  description           String?
  mailbox               String    @default("portal@lumenmsp.co.uk")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  lastPublicReplyAt     DateTime? @map("last_public_reply_at")
  assignedAt            DateTime? @map("assigned_at")
  closedAt              DateTime? @map("closed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  isSpam                Boolean   @default(false) @map("is_spam")
  deletedAt             DateTime? @map("deleted_at")
  ateraTicketId         Int?      @map("atera_ticket_id")
  deletedByUserId       Int?      @map("deleted_by_user_id")
  deleteReason          String?   @map("delete_reason")
  escalatedAt           DateTime? @map("escalated_at")
  postponedUntil        DateTime? @map("postponed_until") // when a 'postponed' case auto-returns to awaiting_engineer
  escalatedToUserId     Int?      @map("escalated_to_user_id")
  teamsConversation     String?   @map("teams_conversation") // JSON: Bot Framework conversation reference for Teams replies
  prevStatus            String?   @map("prev_status")          // status before a Teams/WhatsApp message bumped the case — used to restore on "move message"
  prevActivityStatus    String?   @map("prev_activity_status")
  persistentCc          String?   @map("persistent_cc")        // CC kept for every reply on this case (engineer ticked "remember")
  persistentBcc         String?   @map("persistent_bcc")
  agentDeviceId         Int?      @map("agent_device_id") // LumenMSP Agent chat case — the enrolled device it came from
  // ── Waiting on a third party ───────────────────────────────────────────────────
  // Set together with status 'awaiting_3rd_party'. chaseBy is a 'YYYY-MM-DD' day key,
  // deliberately TEXT: node-pg hands back `date` columns as JS Dates and every string
  // comparison against one silently inverts (see the OneBoard day-key incident).
  thirdPartyId          Int?      @map("third_party_id")   // suppliers.id
  thirdPartyRef         String?   @map("third_party_ref")  // their reference for it
  chaseBy               String?   @map("chase_by")         // 'YYYY-MM-DD' — when we go back at them
  waitingSince          DateTime? @map("waiting_since")    // when the case was parked on them

  customer Customer?       @relation(fields: [customerId], references: [id])
  messages TicketMessage[]
  notes    TicketNote[]

  @@index([customerId])
  @@index([status])
  @@index([department])
  @@index([assignedUserId])
  @@index([deletedAt])
  @@index([agentDeviceId])
  @@index([thirdPartyId])
  @@map("inbox_tickets")
}

model TicketMessage {
  id                Int       @id @default(autoincrement())
  ticketId          Int?      @map("ticket_id")
  mailbox           String
  graphMessageId    String?   @unique @map("graph_message_id")
  internetMessageId String?   @map("internet_message_id")
  conversationId    String?   @map("conversation_id")
  messageDirection  String    @default("inbound") @map("message_direction") // inbound | outbound
  channel           String    @default("email") // email | teams | whatsapp — how this message travelled
  processingStatus  String    @default("new") @map("processing_status") // new | matched | unmatched | suppressed | error
  suppressionReason String?   @map("suppression_reason")
  autoReplyScore    Decimal?  @map("auto_reply_score") @db.Decimal(5, 2)
  isAutoReply       Boolean   @default(false) @map("is_auto_reply")
  isUnread          Boolean   @default(true) @map("is_unread")
  hasAttachments    Boolean   @default(false) @map("has_attachments")
  fromName          String?   @map("from_name")
  fromEmail         String?   @map("from_email")
  toRaw             String?   @map("to_raw")
  ccRaw             String?   @map("cc_raw")
  bccRaw            String?   @map("bcc_raw")
  subject           String?
  bodyHtml          String?   @map("body_html")
  bodyText          String?   @map("body_text")
  headersJson       Json?     @map("headers_json")
  parsedIntelligence Json?    @map("parsed_intelligence")
  receivedAt        DateTime? @map("received_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([receivedAt])
  @@map("inbox_messages")
}

model TicketNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    Int?     @map("user_id")
  noteType  String   @default("private_note") @map("note_type") // public_reply | private_note | system_log | bot | side_convo
  channel   String?  // email | teams | whatsapp — the rail an outbound reply used (null for internal/system)
  body      String
  toRaw     String?  @map("to_raw")
  ccRaw     String?  @map("cc_raw")
  bccRaw    String?  @map("bcc_raw")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("inbox_notes")
}

// â”€â”€ Contracts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Contract {
  id              Int       @id @default(autoincrement())
  customerId      Int?      @map("customer_id")
  quoteId         Int?      @map("quote_id")
  contractNumber  String    @unique @map("contract_number")
  title           String
  status          String    @default("draft") // draft | active | expired | cancelled
  serviceType     String    @default("IT") @map("service_type") // IT | Cloud | Comms | Hardware
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  noticeDays      Int       @default(30) @map("notice_days")
  autoRenew       Boolean   @default(true) @map("auto_renew")
  paymentMethod   String    @default("upfront") @map("payment_method") // upfront | delivery | direct_debit
  notes           String?

  // â”€â”€ Generated document â”€â”€
  templateId      Int?      @map("template_id")
  version         Int       @default(1)          // bumps on every regenerate-after-signature
  termMonths      Int?      @map("term_months")  // length of the ORIGINAL term; later terms live in contract_terms

  // â”€â”€ Renewal behaviour (decided per contract) â”€â”€
  renewalMode     String    @default("auto") @map("renewal_mode") // auto | signed_extension
  // Which document is currently in play. Once extended, the thing being signed is the
  // extension, not the original agreement — the renderer needs to know which to produce.
  currentDocKind  String    @default("agreement") @map("current_doc_kind") // agreement | extension
  // Support cover is a tiered offering, not a house standard — business hours, extended
  // hours or 24/7. It drives the helpdesk hours in the inclusions AND the Service Levels
  // section, so the two can never again disagree the way the manual template did.
  supportCover    String    @default("business") @map("support_cover") // business | extended | always

  // â”€â”€ Signature state. The portal owns this end to end; no third-party e-sign service. â”€â”€
  signStatus      String    @default("unsigned") @map("sign_status") // unsigned|sent|viewed|signed|countersigned|declined
  signToken       String?   @unique @map("sign_token")
  sentTo          String?   @map("sent_to")
  sentAt          DateTime? @map("sent_at")
  viewCount       Int       @default(0) @map("view_count")
  declinedReason  String?   @map("declined_reason")

  // Client signature + the audit trail that makes it defensible: who, when, from where,
  // and (via contract_documents.sha256) exactly which bytes they were shown.
  clientSignName      String?   @map("client_sign_name")
  clientSignPosition  String?   @map("client_sign_position")
  clientSignEmail     String?   @map("client_sign_email")
  clientSignedAt      DateTime? @map("client_signed_at")
  clientSignIp        String?   @map("client_sign_ip")
  clientSignUserAgent String?   @map("client_sign_user_agent")
  clientSignatureSvg  String?   @map("client_signature_svg") // drawn or typed mark, stored inline

  // Counter-signature (Lumen side)
  supplierSignName     String?   @map("supplier_sign_name")
  supplierSignPosition String?   @map("supplier_sign_position")
  supplierSignedAt     DateTime? @map("supplier_signed_at")
  supplierSignatureSvg String?   @map("supplier_signature_svg")

  createdBy       Int?      @map("created_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId Int?      @map("deleted_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  customer   Customer?           @relation(fields: [customerId], references: [id])
  template   ContractTemplate?   @relation(fields: [templateId], references: [id])
  lines      ContractLine[]
  terms      ContractTerm[]
  documents  ContractDocument[]
  amendments ContractAmendment[]

  @@index([customerId])
  @@index([status])
  @@index([signStatus])
  @@index([deletedAt])
  @@map("contracts")
}

model ContractLine {
  id               Int      @id @default(autoincrement())
  contractId       Int      @map("contract_id")
  productId        Int?     @map("product_id")
  description      String
  quantity         Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice        Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  billingFrequency String   @default("monthly") @map("billing_frequency") // monthly | annual | one_off
  section          String   @default("IT")  // IT | Cloud | Backup | Comms | Hardware — groups lines into document sections
  // Licence/backup blocks in the MSA carry their own annual term, which need not line up with the
  // contract term (Staybrook: contract 01/08, licences 01/07). Kept separate rather than flattened.
  termStart        DateTime? @map("term_start") @db.Date
  termEnd          DateTime? @map("term_end") @db.Date
  noticeDays       Int?      @map("notice_days")
  detail           String?   // e.g. "Unlimited" storage allocation, device count note
  lineTotal        Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  sortOrder        Int      @default(1) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_lines")
}

// â”€â”€ Contract document template â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// The ~70% of the Multi Service Agreement that is boilerplate, held as ordered editable
// sections so wording is changed once rather than per customer. Bumping `version` leaves
// already-signed documents untouched — those are frozen in contract_documents.
model ContractTemplate {
  id        Int      @id @default(autoincrement())
  code      String   @unique          // msa
  name      String
  version   Int      @default(1)
  active    Boolean  @default(true)
  sections  Json                      // [{ key, heading, body, needsReview, note }]
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  contracts Contract[]

  @@map("contract_templates")
}

// â”€â”€ Terms. Extending appends a term; it never edits the one before it. â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ContractTerm {
  id         Int       @id @default(autoincrement())
  contractId Int       @map("contract_id")
  seq        Int       @default(1)
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  months     Int
  source     String    @default("original") // original | auto_renew | signed_extension
  signedAt   DateTime? @map("signed_at")
  documentId Int?      @map("document_id")  // the extension document that created this term
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([endDate])
  @@map("contract_terms")
}

// â”€â”€ Immutable PDF snapshots. One row per generated/signed document; sha256 is what
// proves later exactly which bytes the customer was shown. The MSA's DOCUMENT CHANGE
// CONTROL table is rendered from these rows rather than typed by hand. â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ContractDocument {
  id            Int       @id @default(autoincrement())
  contractId    Int       @map("contract_id")
  version       Int
  kind          String    @default("agreement") // agreement | extension | amendment
  title         String
  filePath      String    @map("file_path")     // absolute path on disk (private)
  sha256        String
  fileSize      Int?      @map("file_size")
  changeSummary String?   @map("change_summary") // fills the change-control table
  generatedAt   DateTime  @default(now()) @map("generated_at")
  signedAt      DateTime? @map("signed_at")
  createdBy     Int?      @map("created_by")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_documents")
}

// â”€â”€ Amendments under the "verified digital communication" clause. Quantity changes are
// logged with their evidence and need no signature; term/price changes set
// requiresSignature and drive a new document. â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ContractAmendment {
  id                Int      @id @default(autoincrement())
  contractId        Int      @map("contract_id")
  type              String   // quantity | price | term | party | other
  description       String
  evidenceKind      String?  @map("evidence_kind") // email | ticket | meeting_note | other
  evidenceRef       String?  @map("evidence_ref")  // message id, ticket number, note reference
  requiresSignature Boolean  @default(false) @map("requires_signature")
  madeByUserId      Int?     @map("made_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_amendments")
}

// â”€â”€ Product catalogue (categories + products/services) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ProductCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  products  Product[]

  @@map("asset_categories")
}

model Product {
  id               Int      @id @default(autoincrement())
  categoryId       Int?     @map("category_id")
  quickbooksItemId String?  @map("quickbooks_item_id")
  code             String?
  name             String
  supplier         String?
  description      String?
  itemType         String   @default("service") @map("item_type") // product | service
  billingFrequency String   @default("monthly") @map("billing_frequency") // monthly | annual | one_off
  unitPrice        Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  costPrice        Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  vatRate          Decimal  @default(20) @map("vat_rate") @db.Decimal(6, 2)
  sourceTag        String?  @map("source_tag")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  category ProductCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive])
  @@map("asset_products")
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  url         String?                          // website
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  accountRef  String?  @map("account_ref")     // our account number with this supplier
  address     String?                          // free-text multi-line postal address
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  // ── Third parties ──────────────────────────────────────────────────────────────
  // The outside organisations a case can be WAITING ON — Openreach, a carrier, a
  // landlord's IT, a customer's own web developer. They live in this one table rather
  // than a second address book, because most of them are already suppliers and a case
  // that says "waiting on third party" with no name attached is the thing being fixed.
  isThirdParty   Boolean @default(false) @map("is_third_party")
  category       String?                       // see THIRD_PARTY_CATEGORIES in lib/third-party.ts
  supportEmail   String? @map("support_email") // where chases go, if not the main email
  supportPhone   String? @map("support_phone")
  portalUrl      String? @map("portal_url")    // their ticket portal
  typicalDays    Int?    @map("typical_days")  // how long they usually take — seeds the chase-by date
  escalationNote String? @map("escalation_note") // who to escalate to, and how
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("suppliers")
}

// â”€â”€ Tasks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Task {
  id                Int       @id @default(autoincrement())
  title             String
  description       String?
  assignedToUserId  Int?      @map("assigned_to_user_id")
  assignmentScope   String    @default("user") @map("assignment_scope") // user | team | company
  assignedToTeamId  Int?      @map("assigned_to_team_id")
  createdByUserId   Int       @map("created_by_user_id")
  priority          String    @default("medium") // low | medium | high
  status            String    @default("open") // open | in_progress | done | cancelled
  dueDate           DateTime? @map("due_date") @db.Date
  dueTime           String?   @map("due_time")
  deadline          DateTime? @db.Date
  recurrence        String    @default("none") // none | daily | weekly | fortnightly | monthly
  recurrenceEndDate DateTime? @map("recurrence_end_date") @db.Date
  reminderSent      Boolean   @default(false) @map("reminder_sent")
  completedAt       DateTime? @map("completed_at")
  completedByUserId Int?      @map("completed_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  relatedTicketId   Int?      @map("related_ticket_id")
  relatedCustomerId Int?      @map("related_customer_id")
  relatedContactId  Int?      @map("related_contact_id")

  @@index([assignedToUserId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// â”€â”€ Communications (email thread attached to a quote / invoice / customer) â”€â”€â”€â”€â”€â”€
model Communication {
  id            Int      @id @default(autoincrement())
  entityType    String   @map("entity_type") // quote | invoice | customer
  entityId      Int      @map("entity_id")
  direction     String   @default("outbound") // inbound | outbound
  channel       String   @default("email")
  fromName      String?  @map("from_name")
  fromEmail     String?  @map("from_email")
  toEmail       String?  @map("to_email")
  ccEmail       String?  @map("cc_email")
  bccEmail      String?  @map("bcc_email")
  subject       String?
  body          String?
  isUnread      Boolean  @default(false) @map("is_unread")
  sentByUserId  Int?     @map("sent_by_user_id")
  externalId    String?  @unique @map("external_id") // Graph message id (inbound dedupe)
  deletedAt     DateTime? @map("deleted_at")          // soft-delete from mail inbox
  attachments   String?                               // JSON array of { name, url }
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([isUnread])
  @@map("communications")
}

// Every outbound email send, logged at the mailer so nothing is silently lost.
model EmailLog {
  id        Int      @id @default(autoincrement())
  toEmail   String?  @map("to_email")
  fromEmail String?  @map("from_email")
  subject   String?
  status    String   @default("sent") // sent | failed | not_sent (Graph off)
  error     String?
  body      String?
  attachments String?                  // JSON array of attachment filenames
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("email_log")
}

// Non-email message log (WhatsApp, Teams) — inbound + outbound, mirrors email_log for the
// Comms Log admin views. Email keeps its own email_log; this covers the other channels.
model ChannelLog {
  id         Int      @id @default(autoincrement())
  channel    String   // whatsapp | teams
  direction  String   // inbound | outbound
  status     String   @default("received") // received | sent | failed | recorded
  ticketId   Int?     @map("ticket_id")
  contactId  Int?     @map("contact_id")
  peer       String?  // the other party — wa number or teams user/email
  peerName   String?  @map("peer_name")
  preview    String?  // short text preview of the message body
  externalId String?  @map("external_id") // provider message id
  error      String?
  userId     Int?     @map("user_id") // staff member who sent (outbound)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([channel, direction])
  @@index([status])
  @@index([createdAt])
  @@index([ticketId])
  @@map("channel_log")
}

// Blocked senders — inbound mail from these never creates/updates a ticket.
// kind = 'email' (exact match) or 'domain' (matches anything @domain). Release = delete the row.
model SpamSender {
  id          Int      @id @default(autoincrement())
  value       String   @unique // lower-cased email address or bare domain
  kind        String   @default("email") // email | domain
  reason      String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([kind])
  @@map("spam_senders")
}

// Audit trail — who did what (deletes, restores, status changes, etc.).
model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   // created | updated | deleted | restored | emptied | status_changed
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  summary    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_log")
}

// Customer A-Z review items — a living log of concerns / projects / notes per customer.
model CustomerReviewItem {
  id              Int       @id @default(autoincrement())
  customerId      Int       @map("customer_id")
  section         String    // concern | service | future | current | note
  body            String
  status          String    @default("open") // open | done
  dueDate         DateTime? @map("due_date") @db.Date
  reminderSent    Boolean   @default(false) @map("reminder_sent")
  createdByUserId Int?      @map("created_by_user_id")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("customer_review_items")
}

// Per-user notifications shown in the top bar.
model Notification {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  type         String    @default("info") // info | escalation | reopened | quote | task
  title        String
  body         String?
  link         String?
  readAt       DateTime? @map("read_at")
  clearedAt    DateTime? @map("cleared_at")     // cleared = gone for good
  snoozedUntil DateTime? @map("snoozed_until")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([clearedAt])
  @@map("notifications")
}

// â”€â”€ Settings (key-value, grouped) — integration tokens, defaults, etc. â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Setting {
  id        Int      @id @default(autoincrement())
  group     String
  key       String
  value     String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([group, key])
  @@map("settings")
}

// â”€â”€ Login attempts (security log) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("login_attempts")
}

// â”€â”€ WhatsApp softphone call history â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// NB: also created at runtime by ensureCallTable(); declared here so `prisma db push`
// doesn't drop it on deploy. @db.Timestamptz(6) matches the runtime CREATE TABLE exactly.
model WaCall {
  id           BigInt    @id @default(autoincrement())
  callId       String?   @unique @map("call_id")
  direction    String
  peer         String
  peerName     String?   @map("peer_name")
  contactId    Int?      @map("contact_id")
  customerId   Int?      @map("customer_id")
  agentUserId  Int?      @map("agent_user_id")
  status       String?
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  connectedAt  DateTime? @map("connected_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  durationSecs Int       @default(0) @map("duration_secs")

  @@index([startedAt])
  @@index([peer, startedAt])
  @@map("wa_calls")
}

// â”€â”€ Website live chat (declared here so db push preserves these runtime tables) â”€â”€
model ChatSession {
  id              BigInt    @id @default(autoincrement())
  token           String    @unique
  name            String?
  email           String?
  phone           String?
  department      String?
  status          String    @default("active")
  origin          String?
  assignedUserId  Int?      @map("assigned_user_id")
  contactId       Int?      @map("contact_id")
  customerId      Int?      @map("customer_id")
  createdTicketId Int?      @map("created_ticket_id")
  createdLeadId   Int?      @map("created_lead_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastVisitorAt   DateTime? @map("last_visitor_at") @db.Timestamptz(6)
  lastAgentAt     DateTime? @map("last_agent_at") @db.Timestamptz(6)
  infoPrompted    Boolean   @default(false) @map("info_prompted")
  ip              String?
  userAgent       String?   @map("user_agent")
  browser         String?
  os              String?
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)       // soft delete -> recycle bin
  deletedByUserId Int?      @map("deleted_by_user_id")

  messages ChatMessage[]

  @@index([status, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        BigInt   @id @default(autoincrement())
  sessionId BigInt   @map("session_id")
  sender    String
  body      String?
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("chat_messages")
}

model ChatVisitor {
  visitorId    String   @id @map("visitor_id")
  page         String?
  title        String?
  referrer     String?
  sessionToken String?  @map("session_token")
  ip           String?
  userAgent    String?  @map("user_agent")
  browser      String?
  os           String?
  device       String?
  lang         String?
  screen       String?
  firstSeen    DateTime @default(now()) @map("first_seen") @db.Timestamptz(6)
  lastSeen     DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)

  @@index([lastSeen])
  @@map("chat_visitors")
}

model WebView {
  id        BigInt   @id @default(autoincrement())
  visitorId String?  @map("visitor_id")
  page      String?
  title     String?
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("web_views")
}

