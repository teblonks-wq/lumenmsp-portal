}

// Patch policies are a LIBRARY of named templates, not rows welded to a customer. Two ship
// as defaults ("Default Windows Desktop", "Default Windows Server"); anything unusual is a
// clone. A device resolves: its own override, then its customer's policy for its class,
// then the default. Everything is created disabled, so the end of that chain does nothing.
model PatchPolicy {
  id                  Int       @id @default(autoincrement())
  name                String
  deviceClass         String    @default("workstation") @map("device_class")
  isDefault           Boolean?  @default(false) @map("is_default")
  enabled             Boolean?  @default(false)
  installScope        String?   @default("security") @map("install_scope")
  windowDays          String?   @default("0") @map("window_days")
  windowStart         String?   @default("02:00") @map("window_start")
  windowMinutes       Int?      @default(180) @map("window_minutes")
  rebootMode          String?   @default("never") @map("reboot_mode")
  rebootDeferrals     Int?      @default(3) @map("reboot_deferrals")
  rebootDeadlineHours Int?      @default(72) @map("reboot_deadline_hours")
  notifyMinutes       Int?      @default(15) @map("notify_minutes")
  notifyMessage       String?   @map("notify_message")
  createdBy           Int?      @map("created_by")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedBy           Int?      @map("updated_by")
  updatedAt           DateTime? @default(now()) @map("updated_at")

  @@index([deviceClass])
  @@map("patch_policies")
}

// ── Cyber Essentials ────────────────────────────────────────────────────────────
// The agent collects facts; everything below is the Portal's judgement of them. That
// split is deliberate: the standard changes yearly and the software list changes
// weekly, and neither should mean pushing a new agent to every customer machine.

// The hand-maintained end-of-life list. Vendors publish these dates inconsistently and
// change them, so this is a table we own rather than a feed we trust — one row per
// thing that stops being supported, with the practical action attached.
model EolProduct {
  id          Int       @id @default(autoincrement())
  category    String    @default("app") // os | dotnet | runtime | browser | app | database | server
  vendor      String?
  name        String                     // as shown in the report
  matchType   String    @default("contains") @map("match_type") // contains | exact | regex | os_build | dotnet_release
  matchValue  String    @map("match_value")
  versionMax  String?   @map("version_max")  // matches only when the installed version is at or below this
  eolDate     DateTime? @map("eol_date") @db.Date
  severity    String    @default("fail")     // fail | warn
  action      String    @default("upgrade")  // remove | upgrade | replace | isolate
  replacement String?                        // what to move to
  guidance    String?                        // the practical sentence an engineer acts on
  ceControl   String    @default("patch") @map("ce_control") // firewall | config | access | malware | patch
  active      Boolean   @default(true)
  notes       String?
  // Where the row came from. 'endoflife.date' rows are rewritten by the nightly sync;
  // 'manual' rows are ours and are never touched by it. Ticking overridden freezes an
  // automatic row in place - for when a vendor announces an extension before the feed
  // catches up, which is the only reason anyone should be editing one.
  source      String    @default("manual")
  externalKey String?   @map("external_key")   // e.g. dotnet:6.0 — the sync's upsert key
  overridden  Boolean   @default(false)
  syncedAt    DateTime? @map("synced_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")

  @@unique([source, externalKey])
  @@index([category])
  @@index([active])
  @@map("eol_products")
}

// One run of the tool: a single device, a customer, or the whole estate.
model CeAssessment {
  id           Int       @id @default(autoincrement())
  scope        String    @default("device") // device | customer | all
  customerId   Int?      @map("customer_id")
  deviceId     Int?      @map("device_id")
  label        String?
  status       String    @default("running") // running | complete | partial | failed
  devicesTotal Int?      @default(0) @map("devices_total")
  devicesDone  Int?      @default(0) @map("devices_done")
  failCount    Int?      @default(0) @map("fail_count")
  warnCount    Int?      @default(0) @map("warn_count")
  passCount    Int?      @default(0) @map("pass_count")
  score        Int?
  startedBy    Int?      @map("started_by")
  startedAt    DateTime? @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  @@index([customerId])
  @@index([startedAt])
  @@map("ce_assessments")
}

// One machine's part of a run. The raw facts are kept so a rule added next month can be
// re-run against last month's evidence without going back to the machine.
model CeDeviceResult {
  id           Int       @id @default(autoincrement())
  assessmentId Int       @map("assessment_id")
  deviceId     Int       @map("device_id")
  commandId    Int?      @map("command_id")
  status       String    @default("queued") // queued | complete | failed | offline
  facts        Json?
  score        Int?
  failCount    Int?      @default(0) @map("fail_count")
  warnCount    Int?      @default(0) @map("warn_count")
  passCount    Int?      @default(0) @map("pass_count")
  error        String?
  collectedAt  DateTime? @map("collected_at")

  @@unique([assessmentId, deviceId])
  @@index([deviceId])
  @@map("ce_device_results")
}

// One judgement about one machine. Remediation is stored with the finding rather than
// generated at render time, so a report printed today still says what we told them.
model CeFinding {
  id           Int      @id @default(autoincrement())
  assessmentId Int      @map("assessment_id")
  deviceId     Int      @map("device_id")
  control      String   // firewall | config | access | malware | patch
  rule         String   // stable id, e.g. cfg.autorun
  title        String
  status       String   @default("fail") // fail | warn | pass
  action       String?  // remove | upgrade | configure | review | none
  detail       String?  // what we found
  remediation  String?  // what to do about it, in enough detail to act on
  evidence     String?  // the raw value behind the judgement
  eolDate      DateTime? @map("eol_date") @db.Date
  createdAt    DateTime? @default(now()) @map("created_at")

  @@index([assessmentId, status])
  @@index([deviceId])
  @@map("ce_findings")
}

// ── Servers ─────────────────────────────────────────────────────────────────────
// The same agent, in server mode. One row per machine, holding the whole collected
// picture as JSON rather than fifty columns: what a domain controller reports and what a
// SQL box reports have almost nothing in common, and a rule added next month can be run
// against last month's evidence without going back to the machine.
//
// The few things worth filtering and sorting on are lifted out into real columns.
model ServerFact {
  id          Int       @id @default(autoincrement())
  deviceId    Int       @unique @map("device_id")
  serverRole  String?   @map("server_role")   // domain controller | member server
  roles       String?                          // comma-separated Windows roles, for filtering
  domain      String?                          // AD domain this machine serves or belongs to
  sqlInstances Int?     @default(0) @map("sql_instances")
  vmCount     Int?      @default(0) @map("vm_count")
  alerts      Int?      @default(0)            // things the Portal judged worth a look
  facts       Json?
  commandId   Int?      @map("command_id")
  error       String?
  collectedAt DateTime? @default(now()) @map("collected_at")

  @@index([serverRole])
  @@map("server_facts")
}

// ── Networks a customer actually has ────────────────────────────────────────────
// Seeded by the server agent from the interfaces it can see, and added to by hand in its
// console when there are subnets the server does not sit on. Discovery reads this list;
// nothing is ever scanned that is not in it.
model CustomerNetwork {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  cidr       String                            // 192.168.10.0/24
  label      String?
  source     String    @default("manual")      // manual | detected
  deviceId   Int?      @map("device_id")       // which server reported it, when detected
  scan       Boolean   @default(true)          // include it when we look for unmanaged machines
  createdBy  Int?      @map("created_by")
  createdAt  DateTime? @default(now()) @map("created_at")

  @@unique([customerId, cidr])
  @@index([customerId])
  @@map("customer_networks")
}

// Group Policy inventory, collected read-only from the customer's AD agent. One row per
// GPO per customer, replaced wholesale on each collection — a GPO that has been deleted in
// the domain should disappear here too, and diffing to achieve that buys nothing.
/// A node the mesh bridge reported that matched no device in the Portal. Replaced
/// wholesale on every bridge run. This exists so "remote control is not ready" can say
/// WHY - the node is in a group no customer owns, or under a name we do not have.
model MeshUnmatchedNode {
  id        Int      @id @default(autoincrement())
  nodeId    String   @unique @map("node_id")
  groupId   String?  @map("group_id")
  hostname  String?
  osName    String?  @map("os_name")
  online    Boolean  @default(false)
  seenAt    DateTime @default(now()) @map("seen_at")

  @@index([hostname])
  @@map("mesh_unmatched_nodes")
}

model CustomerGpo {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id")
  gpoId        String   @map("gpo_id")        // the domain's own GUID for it
  name         String
  status       String?                        // AllSettingsEnabled | UserSettingsDisabled | ...
  description  String?
  domain       String?
  createdOn    String?  @map("created_on")
  modifiedOn   String?  @map("modified_on")
  linkCount    Int      @default(0) @map("link_count")
  linkedEnabled Int     @default(0) @map("linked_enabled")
  enforced     Boolean  @default(false)
  settingCount Int      @default(0) @map("setting_count")
  // How many extension blocks the report contained. A policy with extension data we could
  // not interpret is NOT an empty policy - and must never be flagged as one next to a
  // Delete button. -1 means the collector predates this and we simply do not know.
  extensionCount Int    @default(-1) @map("extension_count")
  appliesTo    Json?    @map("applies_to")    // security groups the policy filters to
  links        Json?                          // [{target,enabled,enforced,order}]
  settings     Json?                          // the reduced setting list (capped agent-side)
  reportError  String?  @map("report_error")

  // What Claude made of this policy, kept against the policy so a review survives a page
  // reload and can be filtered on. Cleared whenever the policy's settings change, because
  // a verdict about settings nobody has now is worse than no verdict.
  aiVerdict    String?  @map("ai_verdict")     // good | watch | broken
  aiSummary    String?  @map("ai_summary")
  aiFindings   Json?    @map("ai_findings")    // [{level,title,detail,fix}]
  aiAt         DateTime? @map("ai_at")
  aiFingerprint String? @map("ai_fingerprint") // settings hash the verdict was formed on

  collectedAt  DateTime @default(now()) @map("collected_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([customerId, gpoId])
  @@index([customerId])
  @@map("customer_gpos")
}

/// Every Group Policy Object the Portal has removed from a domain, and the backup the
/// agent took in the same breath.
///
/// This exists because "recoverable" was only true on paper. The agent has always backed
/// a policy up before removing it and returned the backup id - and the Portal wrote that
/// id to a console log and deleted the row. Undoing a deletion therefore meant remoting
/// into the domain controller and guessing which backup folder was which, which is the
/// same as not being able to undo it.
///
/// The settings snapshot is kept deliberately: once the object is gone from the domain,
/// this row is the only remaining answer to "what was actually in it".
model GpoDeletion {
  id           Int       @id @default(autoincrement())
  customerId   Int       @map("customer_id")
  deviceId     Int?      @map("device_id")     // the DC the delete ran on
  commandId    Int?      @map("command_id")
  gpoId        String    @map("gpo_id")        // the domain's own GUID - restore reuses it
  name         String
  domain       String?
  hostname     String?
  backupId     String?   @map("backup_id")     // Restore-GPO -BackupId
  backupPath   String?   @map("backup_path")   // ...-Path. Null means no way back.
  settingCount Int       @default(0) @map("setting_count")
  linkSnapshot Json?     @map("link_snapshot") // where it used to apply - restore drops links
  snapshot     Json?                            // the customer_gpos row as it stood
  deletedBy    Int?      @map("deleted_by")
  deletedAt    DateTime  @default(now()) @map("deleted_at")
  restoredAt   DateTime? @map("restored_at")
  restoredBy   Int?      @map("restored_by")

  @@index([customerId, deletedAt])
  @@index([customerId, gpoId])
  @@map("gpo_deletions")
}

// Microsoft/NCE subscription mirror — pulled from Giacom Billing "SubscriptionsManagementReport".
// Read-only reflection of the partner-side commitment: seats, term, and the two dates that
// drive exposure — renewalDate (the Microsoft anniversary to align a Cloud contract to) and
// cancellableUntilDate (the penalty-free cancel window). Full-refreshed on each sync.
model MsSubscription {
  id                Int       @id @default(autoincrement())
  customerId        Int?      @map("customer_id")            // resolved: tenantId → mexId → unique name
  mexId             String?   @map("mex_id")                 // Giacom account id (join to customer_external_ids)
  tenantId          String?   @map("tenant_id")              // Microsoft tenant GUID (join to customers.entra_tenant_id)
  customerName      String?   @map("customer_name")          // name as Giacom holds it
  hasGdap           Boolean?  @map("has_gdap")
  subscriptionId    String    @unique @map("subscription_id")// Microsoft subscription GUID — stable key
  name              String                                   // product/offer display name
  offerId           String?   @map("offer_id")
  licences          Int       @default(0)                    // seat count
  term              String?                                  // 'Annual' (committed/exposed) | 'Monthly'
  billingFrequency  String?   @map("billing_frequency")
  status            String?
  isNce             Boolean   @default(false) @map("is_nce")
  isPromoApplied    Boolean   @default(false) @map("is_promo_applied")
  orderDate         DateTime? @map("order_date")
  migratedToNceDate DateTime? @map("migrated_to_nce_date")
  renewalDate       DateTime? @map("renewal_date")           // NCE anniversary — align Cloud contract term to this
  cancellableUntil  DateTime? @map("cancellable_until_date") // penalty-free cancel window closes
  commitmentEndDate DateTime? @map("commitment_end_date")    // (null in current feed — kept for completeness)
  termEndAction     String?   @map("term_end_action")        // e.g. RenewToNewTerm
  price             Decimal?  @db.Decimal(12, 4)             // Lumen buy (per unit)
  erp               Decimal?  @db.Decimal(12, 4)             // Microsoft RRP / sell reference (per unit)
  raw               Json?                                     // full record as delivered (audit)
  syncedAt          DateTime  @default(now()) @map("synced_at")

  @@index([customerId])
  @@index([tenantId])
  @@index([mexId])
  @@map("ms_subscription")
}

// Renewal early-warning ledger. One row per warning ACTUALLY RAISED, so the nightly sweep
// can run as often as we like without duplicating a diary entry, and an entry somebody
// deliberately deleted stays deleted. renewal_date is part of the key on purpose: next
// year's renewal is a different event and warns again from scratch.
model RenewalAlert {
  id             Int      @id @default(autoincrement())
  subscriptionId String   @map("subscription_id")
  customerId     Int?     @map("customer_id")
  stage          String   // 60 | 30 | 7
  renewalDate    DateTime @map("renewal_date") @db.Date
  diaryEntryId   Int?     @map("diary_entry_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([subscriptionId, stage, renewalDate])
  @@index([customerId])
  @@map("renewal_alerts")
}

// ── The Diary — Lumen business scheduling ────────────────────────────────────────
// ONE pool of entries; the "diaries" (Mine / Andy's / Support / Onsite / Company
// Week) are views over it. An entry can name one or both staff — "Andy comes onsite
// with me" is a single entry with two people, never a clash. Timed entries live on
// start_at/end_at; day-lane items (tasks, promises) carry only day_key ('YYYY-MM-DD',
// Europe/London) — promises are not appointments, so they are never given fake times.
// Timestamps follow the estate rule: written via to_timestamp(epoch), read via
// EXTRACT(EPOCH ...) — never raw timestamps across the BST boundary.
model DiaryEntry {
  id         Int       @id @default(autoincrement())
  kind       String    // catchup | promise | task | remote | onsite | timeoff
  title      String
  notes      String?
  customerId Int?      @map("customer_id")
  ticketId   Int?      @map("ticket_id")
  startAt    DateTime? @map("start_at")  // timed entries; null = day-lane item
  endAt      DateTime? @map("end_at")
  dayKey     String?   @map("day_key")   // 'YYYY-MM-DD' for day-lane items and all-day time off
  // DATE RANGE: inclusive last day of a day-lane entry. null = a single day. A week off
  // is ONE row (day_key=Mon, end_day_key=Fri), not five — so cancelling it is one action
  // and the clash engine blocks every day in the span.
  endDayKey  String?   @map("end_day_key")
  bufferMins Int       @default(0) @map("buffer_mins") // onsite travel buffer, EACH side, counted by the clash check
  status     String    @default("booked") // booked | done | cancelled
  // RECURRENCE: occurrences are MATERIALISED as real rows, never expanded at read time —
  // the hard-block clash engine can only see what exists. series_id is the id of the
  // first entry in the series and is set on that first entry too, so "the whole series"
  // is one predicate. recurrence/recurrence_end are kept on every row for display.
  seriesId      Int?    @map("series_id")
  recurrence    String  @default("none") // none | daily | weekdays | weekly | fortnightly | monthly
  recurrenceEnd String? @map("recurrence_end") // 'YYYY-MM-DD' inclusive last day of the series
  // Colour override — a key from DIARY_COLOURS in lib/diary.ts. null = the kind's own colour.
  colour     String?
  // ── Customer bookings ──────────────────────────────────────────────────────────
  // A slot a CUSTOMER booked from /my. It is an ordinary diary entry — same pool, same
  // hard block, same Outlook push — plus who booked it and how to join. Deliberately not
  // a separate table: a booking the clash engine cannot see is a double-booking waiting
  // to happen, which is the whole failure mode of a bolt-on booking system.
  bookingServiceId Int?    @map("booking_service_id")
  bookedByUserId   Int?    @map("booked_by_user_id")   // the customer login that booked it
  bookedByName     String? @map("booked_by_name")
  bookedByEmail    String? @map("booked_by_email")
  bookedByPhone    String? @map("booked_by_phone")
  onlineMeetingUrl String? @map("online_meeting_url")  // Teams join link, when the service needs one
  cancelToken      String? @map("cancel_token")        // lets the booker cancel from the confirmation email
  createdBy  Int?      @map("created_by")
  graphSync  Json?     @map("graph_sync") // { "<userId>": "<graph event id>", ... } — pushed M365 events
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")

  @@index([startAt])
  @@index([dayKey])
  @@index([customerId])
  @@index([seriesId])
  @@index([bookingServiceId])
  @@map("diary_entries")
}

// ── Leavers ──────────────────────────────────────────────────────────────────────
// Someone leaves at a stated time. At that moment the Portal cuts access itself — the
// AD account is disabled through our own agent and the Microsoft sign-in is blocked and
// its sessions revoked — and THEN raises one task for all support staff to work the rest
// of the leavers procedure (shared mailbox, licences, kit, delegation).
//
// DELIBERATELY NOT AD's account-expiry field. Terry's rule, and it is the right one: a
// date typed into a directory attribute is invisible, unauditable and silently does the
// wrong thing if the clock or the replication is off. The Portal owns the schedule, so
// there is a record of who scheduled it, what actually ran, and what came back.
model LeaverPlan {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id")
  contactId    Int?     @map("contact_id")       // customer_contacts, when we know them
  displayName  String   @map("display_name")     // who is leaving, as people say it
  upn          String?                            // Microsoft sign-in (user principal name)
  samAccountName String? @map("sam_account_name") // on-prem AD account
  effectiveAt  DateTime @map("effective_at")     // when access is cut. UTC in the column, per the estate rule.
  disableAd    Boolean  @default(true)  @map("disable_ad")
  blockM365    Boolean  @default(true)  @map("block_m365")
  revokeSessions Boolean @default(true) @map("revoke_sessions")
  notes        String?                            // manager's instructions, forwarding, who takes the mailbox
  status       String   @default("scheduled")     // scheduled | done | partial | failed | cancelled
  taskId       Int?     @map("task_id")           // the leavers-procedure task raised for support
  adCommandId  Int?     @map("ad_command_id")     // the queued agent command, so its result can be read back
  resultLog    String?  @map("result_log")        // what actually happened, step by step, in plain words
  ranAt        DateTime? @map("ran_at")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status, effectiveAt])
  @@map("leaver_plans")
}

// ── Bookable services — the MS-Bookings-shaped front door ────────────────────────
// What a customer may book from /my, and the rules that decide which slots are OFFERED.
// Availability is computed from these plus the live diary and Outlook, so a slot on the
// page is a slot that is genuinely free; the write still goes through the diary's hard
// block, so if two people click the same slot the second one is told it has gone rather
// than quietly double-booking someone.
model BookingService {
  id            Int      @id @default(autoincrement())
  name          String                                   // "Remote support session", "IT review meeting"
  blurb         String?                                  // one line shown under the name
  kind          String   @default("remote")              // a DIARY_KINDS key — what it becomes in the diary
  durationMins  Int      @default(30) @map("duration_mins")
  bufferMins    Int      @default(0) @map("buffer_mins") // travel each side (onsite)
  slotStepMins  Int      @default(30) @map("slot_step_mins")
  leadTimeHours Int      @default(4) @map("lead_time_hours")  // minimum notice
  horizonDays   Int      @default(30) @map("horizon_days")    // how far ahead bookings open
  windowStart   String   @default("09:00") @map("window_start") // Europe/London wall clock
  windowEnd     String   @default("17:00") @map("window_end")
  weekdays      Json?                                    // [1..5] Mon=1; null = Mon-Fri
  staffIds      Json?    @map("staff_ids")               // who can take it; null/[] = anyone in the diary
  maxPerDay     Int?     @map("max_per_day")             // cap customer bookings per day, so a day cannot be flooded
  teamsMeeting  Boolean  @default(false) @map("teams_meeting") // create a Teams join link
  itsmOnly      Boolean  @default(false) @map("itsm_only")     // offer only to Managed IT customers
  colour        String?                                  // DIARY_COLOURS key for its diary cards
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("booking_services")
}

model DiaryEntryPerson {
  id      Int @id @default(autoincrement())
  entryId Int @map("entry_id")
  userId  Int @map("user_id")

  @@index([entryId])
  @@index([userId])
  @@map("diary_entry_people")
}

// ── Endpoint Security — Bitdefender / GravityZone ────────────────────────────────
// Lumen gives AV away with the Managed IT package: scope follows the CONTRACT
// (customers.is_itsm) rather than being sold per seat, and once a customer is
// enabled every new machine of theirs is picked up automatically. GravityZone is the
// engine; these tables are the Portal's mirror of it plus the migration paperwork.
// All new tables — db-push safe.
model SecurityCompany {
  id           Int       @id @default(autoincrement())
  gzId         String    @unique @map("gz_id")
  name         String
  // Null until matched to a Portal customer. Matching is by name, confirmed by a
  // human — guessing a customer wrong here would show one client another's machines.
  customerId   Int?      @map("customer_id")
  licenseTotal Int?      @map("license_total")
  licenseUsed  Int?      @map("license_used")
  raw          Json?
  syncedAt     DateTime  @default(now()) @map("synced_at")

  @@index([customerId])
  @@map("security_companies")
}

model SecurityEndpoint {
  id           Int       @id @default(autoincrement())
  gzId         String    @unique @map("gz_id")
  gzCompanyId  String?   @map("gz_company_id")
  customerId   Int?      @map("customer_id")
  // Our device, matched on hostname (and serial where GravityZone reports one).
  assetId      Int?      @map("asset_id")
  name         String
  fqdn         String?
  ip           String?
  osName       String?   @map("os_name")
  isManaged    Boolean   @default(false) @map("is_managed")
  policyName   String?   @map("policy_name")
  agentVersion String?   @map("agent_version")
  outdated     Boolean   @default(false)
  infected     Boolean   @default(false)
  modulesOn    String?   @map("modules_on")
  lastSeenAt   DateTime? @map("last_seen_at")
  // The whole endpoint record as GravityZone gave it. Display fields above are
  // derived; keeping the raw means a field we read wrong is a one-line fix, not a
  // re-sync of the estate.
  raw          Json?
  syncedAt     DateTime  @default(now()) @map("synced_at")

  @@index([customerId])
  @@index([assetId])
  @@map("security_endpoints")
}

// The migration paperwork: what is on a customer's machines today, what has to come
// off, and Lumen's sign-off. "We are the ITSM — we do" (Terry): the customer never
// approves, and nothing is uninstalled without a deliberate Lumen decision.
model SecurityAssessment {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  status     String    @default("draft") // draft | approved | superseded
  createdBy  Int?      @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  approvedBy Int?      @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  notes      String?

  @@index([customerId])
  @@map("security_assessments")
}

model SecurityAssessmentItem {
  id           Int     @id @default(autoincrement())
  assessmentId Int     @map("assessment_id")
  assetId      Int?    @map("asset_id")
  hostname     String
  currentAv    String? @map("current_av")
  // clean = Defender only, Bitdefender installs straight over
  // auto_remove = third-party AV that Bitdefender's competitive removal handles
  // manual = needs uninstalling by hand first
  // unknown = no agent data yet, so the agent goes on first
  category     String
  plan         String?
  included     Boolean @default(true)

  @@index([assessmentId])
  @@map("security_assessment_items")
}

// One row per real detection, deduped, so an outbreak raises one case per machine
// and threat rather than fifty.
model SecurityDetection {
  id           Int      @id @default(autoincrement())
  dedupeKey    String   @unique @map("dedupe_key")
  customerId   Int?     @map("customer_id")
  endpointGzId String?  @map("endpoint_gz_id")
  hostname     String?
  threatName   String?  @map("threat_name")
  detail       String?
  ticketId     Int?     @map("ticket_id")
  // Is this detection one of OUR OWN tools? Computed on every sync by isOwnToolDetection
  // and, until 20 Aug, thrown away — so the Portal knew a MeshCentral hit was ours (it
  // withheld the support case on exactly that basis) and still rendered the machine
  // INFECTED in red. Persisted so the read paths can use the conclusion the sync reached.
  ownTool      Boolean  @default(false) @map("own_tool")
  detectedAt   DateTime @default(now()) @map("detected_at")

  @@index([customerId])
  @@index([detectedAt])
  @@map("security_detections")
}

// One "Scan now" on one machine.
//
// GravityZone's createScanTask answers true rather than a task id, so the only durable
// handle on a task is its NAME — generated here, unique per scan, stored BEFORE the API
// call so a scan GravityZone accepted can never be missing from the history. The poller
// matches tasks back by that name.
//
// What a scan FOUND is not stored here: detections already arrive through the normal
// sync into security_detections, and the history joins them by time window. The task
// says the scan ran; the detections say what it found, and conflating the two would
// invent findings on a scan that simply has not reported yet.
model SecurityScanTask {
  id            Int       @id @default(autoincrement())
  assetId       Int       @map("asset_id")
  endpointGzId  String    @map("endpoint_gz_id")
  taskName      String    @unique @map("task_name")
  scanType      String    @map("scan_type")        // quick | full
  statusCode    Int?      @map("status_code")      // 1 pending · 2 running · 3 finished · null = failed to start
  detail        String?
  requestedBy   Int?      @map("requested_by")
  requestedAt   DateTime  @default(now()) @map("requested_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  lastCheckedAt DateTime? @map("last_checked_at")

  @@index([assetId])
  @@index([endpointGzId])
  @@map("security_scan_tasks")
}

// One Bitdefender installation package per customer, with its download links cached.
// The links are what our agent is actually pointed at, so they are resolved server side
// and stored here — never accepted from a browser, exactly like agent_packages.
model SecurityPackage {
  customerId        Int      @id @map("customer_id")
  gzCompanyId       String   @map("gz_company_id")
  packageName       String   @map("package_name")
  // Bitdefender's competitive removal. Recorded so the estate can prove a machine was
  // installed with removal ON rather than left running two AV products.
  removeCompetitors Boolean  @default(true) @map("remove_competitors")
  urlWindows        String?  @map("url_windows")
  urlMac            String?  @map("url_mac")
  urlMacArm         String?  @map("url_mac_arm")
  urlLinux          String?  @map("url_linux")
  // Bitdefender builds kits asynchronously: status 2 = ready, anything else = not yet.
  // Deploying from a kit that is still building is a guaranteed silent failure.
  readyWindows      Boolean  @default(false) @map("ready_windows")
  raw               Json?
  refreshedAt       DateTime @default(now()) @map("refreshed_at")

  @@map("security_packages")
}

// The rollout record for one machine: what we asked for, what happened, and — the part
// that matters — whether BOTH sides agree it worked.
model SecurityDeployment {
  id          Int       @id @default(autoincrement())
  deviceId    Int       @unique @map("device_id")
  customerId  Int?      @map("customer_id")
  // queued | running | installed | protected | failed | excluded
  // 'installed' means our agent sees Bitdefender locally. 'protected' additionally means
  // GravityZone has the endpoint — either signal alone can lie, which is exactly how a
  // deployment reported "complete" on a machine that had nothing on it.
  state       String    @default("queued")
  commandId   Int?      @map("command_id")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  // What was protecting the machine before we touched it — the before half of the
  // evidence that a Webroot removal actually happened.
  avBefore    String?   @map("av_before")
  avAfter     String?   @map("av_after")
  agentSeenAt DateTime? @map("agent_seen_at")
  gzSeenAt    DateTime? @map("gz_seen_at")
  requestedBy Int?      @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  settledAt   DateTime? @map("settled_at")

  @@index([customerId])
  @@index([state])
  @@map("security_deployments")
}

// -- Mobile phase 1: Web Push + the Pulse (2026-08-20). MUST live here - `prisma db push`
// runs on every deploy and drops anything it does not know about. --------------------
model PushSubscription {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  endpoint  String    @unique
  p256dh    String
  auth      String
  ua        String?
  createdAt DateTime  @default(now()) @map("created_at")
  lastOkAt  DateTime? @map("last_ok_at")
  failures  Int       @default(0)

  @@index([userId])
  @@map("push_subscriptions")
}

model PulseEvent {
  id         Int       @id @default(autoincrement())
  kind       String
  dedupeKey  String    @unique @map("dedupe_key")
  title      String
  body       String?
  link       String?
  customerId Int?      @map("customer_id")
  deviceId   Int?      @map("device_id")
  rank       Int       @default(50)
  pushed     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")
  expiresAt  DateTime? @map("expires_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([resolvedAt, expiresAt, rank])
  @@map("pulse_events")
}

// ── Questionnaires, polls and case feedback (Marketing) ────────────────────────
// A questionnaire is a first-class object; the Mass Mailer is one DISTRIBUTOR of it.
//
// Two rules the shape enforces:
//  • The imported JSON is the AUTHORING format, not the storage format. Import validates
//    it, then MATERIALISES questions and answers as rows. Answers buried in a JSON blob
//    can never be reported on in SQL — this is the same call the diary made on recurrence.
//  • Import creates a VERSION and an invite pins version_id, so editing a question after
//    forty people have answered cannot change what those forty were asked.
//
// questionnaire_invites.campaign_id is NULLABLE on purpose: that is what lets a case
// close, or a customer page, raise an invite without inventing a campaign.

model Questionnaire {
  id               Int      @id @default(autoincrement())
  key              String   @unique                       // stable slug from the JSON, e.g. "systems-review-2026"
  title            String
  kind             String   @default("general")           // general | case_feedback | systems
  status           String   @default("active")            // active | archived
  currentVersionId Int?     @map("current_version_id")
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([kind])
  @@map("questionnaires")
}

model QuestionnaireVersion {
  id              Int       @id @default(autoincrement())
  questionnaireId Int       @map("questionnaire_id")
  version         Int
  title           String
  intro           String?
  mode            String    @default("form")              // form | poll
  thankYou        String?   @map("thank_you")
  closesAt        DateTime? @map("closes_at")
  spec            Json                                     // the imported JSON verbatim, for re-export
  publishedAt     DateTime  @default(now()) @map("published_at")

  @@unique([questionnaireId, version])
  @@map("questionnaire_versions")
}

model QuestionnaireQuestion {
  id         Int     @id @default(autoincrement())
  versionId  Int     @map("version_id")
  ord        Int
  key        String
  type       String                                        // single|multi|rating|nps|yes_no|short_text|long_text|heading
  label      String
  helpText   String? @map("help_text")
  required   Boolean @default(false)
  scale      Int?                                          // rating: 1..scale
  options    Json?                                         // [{value,label}] for single/multi
  allowOther Boolean @default(false) @map("allow_other")

  @@unique([versionId, key])
  @@index([versionId, ord])
  @@map("questionnaire_questions")
}

model QuestionnaireInvite {
  id           Int       @id @default(autoincrement())
  versionId    Int       @map("version_id")
  campaignId   Int?      @map("campaign_id")               // NULL for case feedback and customer-page sends
  ticketId     Int?      @unique @map("ticket_id")         // case feedback: ONE invite per case, forever
  contactId    Int?      @map("contact_id")
  customerId   Int?      @map("customer_id")
  email        String?
  fullName     String?   @map("full_name")
  customerName String?   @map("customer_name")
  token        String    @unique                            // the public /q/:token link
  sentAt       DateTime? @map("sent_at")
  openedAt     DateTime? @map("opened_at")
  completedAt  DateTime? @map("completed_at")
  // A "send me a test" invite. Real and clickable, so a test send can be followed all the
  // way through, but excluded from every count — otherwise testing a campaign quietly
  // inflates its own response rate.
  isTest       Boolean   @default(false) @map("is_test")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([versionId])
  @@index([campaignId])
  @@index([customerId])
  @@map("questionnaire_invites")
}

model QuestionnaireResponse {
  id          Int       @id @default(autoincrement())
  versionId   Int       @map("version_id")
  inviteId    Int?      @unique @map("invite_id")          // one response per invite
  contactId   Int?      @map("contact_id")
  customerId  Int?      @map("customer_id")
  ticketId    Int?      @map("ticket_id")
  assignedUserId Int?   @map("assigned_user_id")           // case feedback: the engineer who owned the case
  submittedAt DateTime  @default(now()) @map("submitted_at")
  completedAt DateTime? @map("completed_at")               // set when the last required question is in

  // Case-feedback denormalisation. The rating and comment are ALSO stored as answer rows;
  // these copies exist so scoring by engineer and by customer is one cheap query.
  rating         Int?
  comment        String?
  // Website publication. TWO gates: publishConsent is the CUSTOMER'S tick (a five-star
  // rating is not consent) and publishState 'approved' is a human at Lumen pressing approve.
  // publishText/publishName record exactly what was published, so a withdrawal can be
  // honoured and evidenced.
  publishConsent Boolean   @default(false) @map("publish_consent")
  publishState   String    @default("none") @map("publish_state") // none | pending | approved | withdrawn
  publishName    String?   @map("publish_name")
  publishText    String?   @map("publish_text")
  publishedAt    DateTime? @map("published_at")
  approvedBy     Int?      @map("approved_by")
  actioned       Boolean   @default(false)                 // someone has dealt with it
  actionedBy     Int?      @map("actioned_by")
  actionedAt     DateTime? @map("actioned_at")

  @@index([versionId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([publishState])
  @@index([submittedAt])
  @@map("questionnaire_responses")
}

model QuestionnaireAnswer {
  id         Int      @id @default(autoincrement())
  responseId Int      @map("response_id")
  questionId Int      @map("question_id")
  valueText  String?  @map("value_text")                   // free text, or the chosen option's value
  valueNum   Float?   @map("value_num")                    // rating / nps / yes_no as 1|0
  valueJson  Json?    @map("value_json")                   // multi-select: array of chosen values
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("questionnaire_answers")
}

// ── Script library ────────────────────────────────────────────────────────────────
// Lumen's own automation scripts, moved off Atera. Atera's team library is the seed;
// `sourceRef` is Atera's script GUID, which is what makes an import idempotent — a
// re-import UPDATES the row it already created instead of laying down a second copy.
// The Portal has no community library and is not getting one: only Lumen uses it.
model Script {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  fileType    String    @default("ps1") @map("file_type")   // ps1 | bat | cmd | sh | py | vbs
  osType      String    @default("windows") @map("os_type") // windows | macos | linux
  body        String                                        // the script itself
  runAs       String    @default("system") @map("run_as")   // system | current_user
  arguments   String?
  maxRuntimeMinutes Int? @map("max_runtime_minutes")
  category    String?
  source      String    @default("lumen")                   // atera | lumen
  sourceRef   String?   @map("source_ref")                  // Atera script GUID
  createdBy   Int?      @map("created_by")

  // Claude's read of the script. `reviewedHash` is the md5 of the body AS REVIEWED — edit
  // the script and the review is shown as stale rather than quietly standing for code that
  // no longer exists. Never guard on reviewedAt alone for that reason.
  reviewVerdict  String?   @map("review_verdict")   // ok | warn | broken
  reviewHeadline String?   @map("review_headline")
  reviewSummary  String?   @map("review_summary")
  reviewFindings Json?     @map("review_findings")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewedHash   String?   @map("reviewed_hash")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([source, sourceRef])
  @@index([name])
  @@map("scripts")
}

// ── Automation: scheduled tasks ─────────────────────────────────────────────────
// One row = one thing to do, to a chosen set of machines, at a chosen moment. The task
// is the intention; agent_commands are what actually reach the machines, and they are
// only created when the task is ARMED. That split is deliberate: a weekly reboot running
// for a year would otherwise sit as 52 queued commands per machine from the day it was
// made, and nobody could tell an outstanding command from a future one.
//
// Recurrence follows the diary's rule and MATERIALISES each occurrence as its own row
// (series_id = the id of the first). Expanding at read time was rejected there for a
// good reason and the same one applies here: you cannot cancel, re-time or report on an
// occurrence that does not exist as a row.
model AutomationTask {
  id            Int       @id @default(autoincrement())
  name          String
  // power.restart | power.shutdown | wu.off | wu.on | script.run | software.install
  action        String
  // Action arguments: { scriptId } | { packageId, packageName } | { delaySeconds }
  payload       Json?
  // next_contact | datetime | after_reboot | window
  condition     String    @default("next_contact")
  runAt         DateTime? @map("run_at")            // the datetime condition; also the START of a window
  runUntil      DateTime? @map("run_until")         // the END of a window — after this the task closes
  recurrence    String    @default("none")          // none | daily | weekdays | weekly | fortnightly | monthly
  recurrenceEnd String?   @map("recurrence_end")    // 'YYYY-MM-DD', inclusive
  seriesId      Int?      @map("series_id")
  // scheduled = waiting for its moment · armed = commands are on the machines
  // done · cancelled · failed (nothing could be armed at all)
  status        String    @default("scheduled")
  armedAt       DateTime? @map("armed_at")
  finishedAt    DateTime? @map("finished_at")
  cancelledAt   DateTime? @map("cancelled_at")
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@index([seriesId])
  @@map("automation_tasks")
}

// One machine's share of a task. command_id is filled at arm time and is the only link
// back to what the agent actually did, so the task screen can report per machine rather
// than as one lump that is "partly done".
model AutomationTaskDevice {
  id         Int       @id @default(autoincrement())
  taskId     Int       @map("task_id")
  deviceId   Int       @map("device_id")
  commandId  Int?      @map("command_id")
  status     String    @default("pending") // pending | queued | running | done | failed | skipped
  error      String?
  finishedAt DateTime? @map("finished_at")

  @@unique([taskId, deviceId])
  @@index([taskId])
  @@index([deviceId])
  @@map("automation_task_devices")
}
