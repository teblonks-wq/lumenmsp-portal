// â”€â”€ Mass Mailer (Marketing → Mass Mailer) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// A campaign is a one-off bulk email to customer contacts whose address is on their
// customer's DEFAULT (primary) domain. The recipient list is snapshotted at creation
// so the campaign page always shows exactly who was/will be emailed. Sending happens
// in a throttled background loop via the Graph mailer (lib/mass-mailer.ts).
model MailCampaign {
  id         Int       @id @default(autoincrement())
  name       String                                    // internal label, e.g. "July price update"
  subject    String
  bodyHtml   String    @map("body_html")               // composed HTML (merge fields resolved per recipient)
  fromEmail  String?   @map("from_email")              // send-as mailbox; null = GRAPH_SEND_FROM default
  status     String    @default("draft")               // draft | sending | paused | sent | failed
  audience   Json?                                     // filters used to build the list (for the record)
  // Attached one-click poll: the FROZEN questionnaire version this campaign asks. Pinned to
  // a version, not a questionnaire, so re-importing the questions later cannot change what
  // the people who already answered were asked.
  questionnaireVersionId Int? @map("questionnaire_version_id")
  createdBy  Int?      @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  recipients MailCampaignRecipient[]

  @@index([status])
  @@map("mail_campaigns")
}

model MailCampaignRecipient {
  id           Int       @id @default(autoincrement())
  campaignId   Int       @map("campaign_id")
  contactId    Int?      @map("contact_id")            // → customer_contacts.id (informational)
  customerId   Int?      @map("customer_id")
  email        String
  fullName     String?   @map("full_name")
  customerName String?   @map("customer_name")
  status       String    @default("pending")           // pending | sent | failed | skipped
  error        String?
  sentAt       DateTime? @map("sent_at")

  campaign MailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@map("mail_campaign_recipients")
}

