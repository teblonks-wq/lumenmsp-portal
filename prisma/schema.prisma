// Pending Windows Updates per device, reported on the agent's daily inventory pass.
// Rows are upserted so first_seen survives — "missing for 40 days" is the number that matters.
model DevicePatch {
  id         Int       @id @default(autoincrement())
  deviceId   Int       @map("device_id")
  updateId   String    @map("update_id")
  title      String?
  kb         String?
  severity   String?
  categories String?
  sizeMb     Decimal?  @map("size_mb") @db.Decimal(10, 1)
  downloaded Boolean?  @default(false)
  // Windows Update, WinGet or Chocolatey. One table, because "what is out of date on this
  // machine" is one question and nobody wants to look at three screens to answer it.
  source           String?   @default("windows")
  currentVersion   String?   @map("current_version")   // third-party only
  availableVersion String?   @map("available_version") // third-party only
  firstSeen  DateTime? @default(now()) @map("first_seen")
  lastSeen   DateTime? @default(now()) @map("last_seen")

  @@unique([deviceId, updateId])
  @@index([deviceId])
  @@index([severity])
  @@index([source])
