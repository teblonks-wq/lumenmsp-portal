<%- include('../partials/header', { title: 'Portal Flow', user }) %>
<%
  function badge(s){ return s==='sent'?'badge-sent':(s==='failed'?'badge-failed':'badge-inactive'); }
  function sbadge(s){ return s==='sent'?'badge-sent':(s==='received'?'badge-primary':(s==='failed'?'badge-failed':'badge-inactive')); }
  function chBadge(c){ return c==='whatsapp'?'badge-sent':(c==='teams'?'badge-primary':'badge-inactive'); }
  function cap(s){ return s ? s.charAt(0).toUpperCase()+s.slice(1) : ''; }
  // email_log / channel_log timestamps are stored as UTC wall-clock in a timezone-naive column,
  // so a raw toLocaleString shows them an hour behind during BST. Re-read the components as UTC,
  // then render in Europe/London — correct in summer and winter, whatever TZ the process runs in.
  // Just format it. This used to rebuild the Date by taking its LOCAL clock components and
  // re-stamping them as UTC — a hand-rolled correction for node-pg reading our zone-less
  // `timestamp` columns as Europe/London instead of the UTC they hold. That parse is fixed
  // properly now (src/db/pg-utc.ts), so the old correction had become a second one applied
  // on top of the first, and this table read an HOUR AHEAD: a reply logged at 16:06 showed
  // as 17:06. Two fixes for one bug is worse than none, because whichever you find first
  // looks right.
  function lts(v, dateOnly){
    if (!v) return '—';
    var d = new Date(v);
    return dateOnly ? d.toLocaleDateString('en-GB', { timeZone: 'Europe/London' })
                    : d.toLocaleString('en-GB', { timeZone: 'Europe/London' });
  }
  // Keep the current search when switching status/channel filters, and vice versa.
  function link(over){
    var p = { tab: tab, status: status, q: q, channel: channel, direction: direction };
    for (var k in (over||{})) p[k] = over[k];
    var a = [];
    for (var k2 in p) if (p[k2] !== '' && p[k2] != null) a.push(k2 + '=' + encodeURIComponent(p[k2]));
    return '/admin/portal-flow' + (a.length ? '?' + a.join('&') : '');
  }
  var commsTally = function(fn){ var t=0; (commsSummary||[]).forEach(function(r){ if(fn(r)) t+=r.n; }); return t; };
%>

<style>
  .pf-sec{border:1px solid var(--line);border-radius:12px;margin-bottom:14px;background:var(--surface);}
  .pf-sec>summary{cursor:pointer;padding:14px 18px;font-weight:600;font-size:15px;list-style:none;display:flex;align-items:center;gap:10px;}
  .pf-sec>summary::-webkit-details-marker{display:none;}
  .pf-sec>summary::before{content:'▸';font-size:12px;color:var(--muted);transition:transform .12s ease;}
  .pf-sec[open]>summary::before{transform:rotate(90deg);}
  .pf-sec>summary:hover{background:var(--surface-2);border-radius:12px;}
  .pf-sec .pf-body{padding:0 18px 18px;}
  .pf-count{font-weight:400;font-size:13px;color:var(--muted);}
  .pf-primary>summary{background:linear-gradient(135deg,var(--tint-teal),var(--accent-soft));border-radius:12px;}
</style>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/admin">← Admin</a></p>
  <h1>Portal Flow</h1>
  <p class="muted">Everything the portal sends and receives — email, WhatsApp and Teams — plus a delivery test, in one place.</p>
</div>

<div class="tabs" style="margin-bottom:16px;">
  <a class="tab-btn <%= tab==='mail' ? 'active' : '' %>" href="/admin/portal-flow?tab=mail">Mail flow</a>
  <a class="tab-btn <%= tab==='comms' ? 'active' : '' %>" href="/admin/portal-flow?tab=comms">Comms log</a>
  <a class="tab-btn <%= tab==='test' ? 'active' : '' %>" href="/admin/portal-flow?tab=test">Email delivery test</a>
</div>

<% if (saved === 'blocked') { %><div class="alert alert-success" style="max-width:900px;">Sender blocked. Their mail will no longer raise tickets.</div><% } %>
<% if (saved === 'released') { %><div class="alert alert-success" style="max-width:900px;">Released — mail from that sender will come through again.</div><% } %>
<% if (saved === 'norecover') { %><div class="alert alert-danger" style="max-width:900px;">That email couldn't be recovered — it may already have been raised.</div><% } %>
<% if (notice) { %><div class="alert alert-success" style="max-width:900px;"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-danger" style="max-width:900px;"><%= error %></div><% } %>

<% if (tab === 'mail') { %>
  <p class="muted" style="margin:0 0 12px;">Last 7 days: <strong><%= summary.sent || 0 %></strong> sent · <strong style="color:var(--bad-fg);"><%= summary.failed || 0 %></strong> failed<% if (summary.not_sent) { %> · <%= summary.not_sent %> skipped (Graph off)<% } %>.</p>

  <form method="GET" action="/admin/portal-flow" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px;">
    <input type="hidden" name="tab" value="mail">
    <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <input class="input" type="search" name="q" value="<%= q %>" placeholder="Search recipient, sender, subject or error…" style="min-width:320px;">
    <button class="btn btn-primary" type="submit">Search</button>
    <% if (q) { %><a class="btn" href="<%= link({ q: '' }) %>">Clear</a><% } %>
    <span class="muted" style="font-size:12px;">searches the whole log, not just what's on screen</span>
  </form>

  <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;">
    <a class="btn <%= status===''?'btn-primary':'' %>" href="<%= link({ status: '' }) %>">All</a>
    <a class="btn <%= status==='sent'?'btn-primary':'' %>" href="<%= link({ status: 'sent' }) %>">Sent</a>
    <a class="btn <%= status==='failed'?'btn-primary':'' %>" href="<%= link({ status: 'failed' }) %>">Failed</a>
    <a class="btn <%= status==='not_sent'?'btn-primary':'' %>" href="<%= link({ status: 'not_sent' }) %>">Skipped</a>
  </div>

  <!-- Outbound first and open by default: it's the one you actually come here for. -->
  <details class="pf-sec pf-primary" open>
    <summary>Outbound email <span class="pf-count">(<%= items.length %><%= items.length===200 ? ' shown, newest first' : '' %><%= q ? ' matching “' + q + '”' : '' %>)</span></summary>
    <div class="pf-body" style="padding-left:0;padding-right:0;">
      <div class="table-wrap">
        <table class="table" style="margin:0;">
          <thead><tr><th>When</th><th>To</th><th>Subject</th><th>Status</th><th>Detail</th></tr></thead>
          <tbody>
            <% if (items.length===0) { %>
              <tr><td colspan="5"><div class="empty-state"><%= q ? 'No emails match that search.' : 'No emails logged yet.' %></div></td></tr>
            <% } %>
            <% items.forEach(function(m){ %>
              <tr>
                <td class="muted" style="font-size:12px;white-space:nowrap;"><%= lts(m.created_at) %></td>
                <td><%= m.to_email || '—' %></td>
                <td><a class="row-link" href="/admin/mail-flow/<%= m.id %>"><%= m.subject || '(no subject)' %></a></td>
                <td><span class="badge <%= badge(m.status) %>"><%= m.status %></span></td>
                <td class="muted" style="font-size:12px;max-width:340px;overflow-wrap:anywhere;"><%= m.error || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </details>

  <details class="pf-sec">
    <summary>Spam list <span class="pf-count">(<%= (spam||[]).length %>)</span></summary>
    <div class="pf-body">
      <p class="muted" style="margin:0 0 10px;">Blocked senders never raise or update a ticket. Mark a case as spam from the ticket, or add one here. Release to let their mail through again.</p>
      <form method="post" action="/admin/mail-flow/spam" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px;">
        <input class="input" name="value" placeholder="person@example.com or example.com" style="min-width:300px;" required>
        <button class="btn btn-primary" type="submit">Block</button>
        <span class="muted" style="font-size:12px;">An address blocks one person; a bare domain blocks everyone there.</span>
      </form>
      <% if (!(spam && spam.length)) { %>
        <p class="muted" style="margin:0;">Nothing blocked. 🎉</p>
      <% } else { %>
        <input class="input" type="search" placeholder="Filter the blocked list…" style="max-width:320px;margin-bottom:10px;" oninput="pfFilter(this,'spamRows')">
        <div class="table-wrap"><table class="table" style="margin:0;">
          <thead><tr><th>Blocked</th><th>Type</th><th>Reason</th><th>Added by</th><th>When</th><th></th></tr></thead>
          <tbody id="spamRows">
            <% spam.forEach(function(s){ %>
              <tr>
                <td style="font-weight:600;overflow-wrap:anywhere;"><%= s.value %></td>
                <td><span class="badge <%= s.kind==='domain'?'badge-failed':'badge-inactive' %>"><%= s.kind %></span></td>
                <td class="muted" style="font-size:12px;"><%= s.reason || '—' %></td>
                <td class="muted" style="font-size:12px;"><%= s.created_by_name || '—' %></td>
                <td class="muted" style="font-size:12px;white-space:nowrap;"><%= lts(s.created_at, true) %></td>
                <td style="text-align:right;"><form method="post" action="/admin/mail-flow/spam/<%= s.id %>/release" style="margin:0;"><button class="btn" type="submit">Release</button></form></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>
  </details>

  <details class="pf-sec">
    <summary>Auto-filed inbound <span class="pf-count">(<%= (suppressed||[]).length %>)</span></summary>
    <div class="pf-body">
      <p class="muted" style="margin:0 0 10px;">Inbound emails the loop/auto-reply guard set aside <em>without</em> raising a ticket — bounces, auto-replies, mailing lists, etc. If one is a real request that got filed by mistake, recover it onto the helpdesk.</p>
      <% if (!(suppressed && suppressed.length)) { %>
        <p class="muted" style="margin:0;">Nothing auto-filed. 🎉</p>
      <% } else { %>
        <input class="input" type="search" placeholder="Filter auto-filed mail…" style="max-width:320px;margin-bottom:10px;" oninput="pfFilter(this,'suppRows')">
        <div class="table-wrap"><table class="table" style="margin:0;">
          <thead><tr><th>When</th><th>From</th><th>Subject</th><th>Why filed</th><th></th></tr></thead>
          <tbody id="suppRows">
            <% suppressed.forEach(function(s){ %>
              <tr>
                <td class="muted" style="font-size:12px;white-space:nowrap;"><%= lts(s.received_at) %></td>
                <td style="font-size:13px;overflow-wrap:anywhere;"><%= s.from_name || '' %><% if (s.from_email) { %><br><span class="muted" style="font-size:12px;"><%= s.from_email %></span><% } %></td>
                <td style="font-size:13px;overflow-wrap:anywhere;"><%= s.subject || '(no subject)' %></td>
                <td class="muted" style="font-size:12px;"><%= s.suppression_reason || '—' %></td>
                <td style="text-align:right;"><form method="post" action="/admin/mail-flow/suppressed/<%= s.id %>/raise" style="margin:0;" onsubmit="return confirm('Raise this email as a support ticket?');"><button class="btn btn-primary" type="submit" style="padding:3px 10px;font-size:12px;">Raise as ticket</button></form></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>
  </details>

<% } else if (tab === 'comms') { %>
  <p class="muted" style="margin:0 0 12px;">Every WhatsApp and Teams message in and out of the portal. Last 7 days:
    <strong><%= commsTally(function(r){return r.channel==='whatsapp';}) %></strong> WhatsApp ·
    <strong><%= commsTally(function(r){return r.channel==='teams';}) %></strong> Teams ·
    <strong style="color:var(--bad-fg);"><%= commsTally(function(r){return r.status==='failed';}) %></strong> failed.</p>

  <form method="GET" action="/admin/portal-flow" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px;">
    <input type="hidden" name="tab" value="comms">
    <% if (channel) { %><input type="hidden" name="channel" value="<%= channel %>"><% } %>
    <% if (direction) { %><input type="hidden" name="direction" value="<%= direction %>"><% } %>
    <input class="input" type="search" name="q" value="<%= q %>" placeholder="Search party, message or error…" style="min-width:320px;">
    <button class="btn btn-primary" type="submit">Search</button>
    <% if (q) { %><a class="btn" href="<%= link({ q: '' }) %>">Clear</a><% } %>
  </form>

  <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;">
    <a class="btn <%= channel===''&&direction===''?'btn-primary':'' %>" href="<%= link({ channel: '', direction: '' }) %>">All</a>
    <a class="btn <%= channel==='whatsapp'?'btn-primary':'' %>" href="<%= link({ channel: 'whatsapp' }) %>">WhatsApp</a>
    <a class="btn <%= channel==='teams'?'btn-primary':'' %>" href="<%= link({ channel: 'teams' }) %>">Teams</a>
    <span style="width:1px;background:var(--line);margin:0 4px;"></span>
    <a class="btn <%= direction==='outbound'?'btn-primary':'' %>" href="<%= link({ direction: 'outbound' }) %>">Outbound</a>
    <a class="btn <%= direction==='inbound'?'btn-primary':'' %>" href="<%= link({ direction: 'inbound' }) %>">Inbound</a>
  </div>

  <details class="pf-sec pf-primary" open>
    <summary>Messages <span class="pf-count">(<%= comms.length %><%= comms.length===300 ? ' shown, newest first' : '' %>)</span></summary>
    <div class="pf-body" style="padding-left:0;padding-right:0;">
      <% if (!comms.length) { %>
        <p class="muted" style="padding:4px 18px 0;margin:0;">No messages logged yet<%= (channel||direction||q)?' for this filter':'' %>.</p>
      <% } else { %>
        <div class="table-wrap"><table class="table" style="margin:0;">
          <thead><tr><th>When</th><th>Channel</th><th>Dir</th><th>Status</th><th>Party</th><th>Message</th><th>Case</th></tr></thead>
          <tbody>
            <% comms.forEach(function(m){ %>
              <tr>
                <td class="muted" style="font-size:12px;white-space:nowrap;"><%= lts(m.created_at) %></td>
                <td><span class="badge <%= chBadge(m.channel) %>"><%= cap(m.channel) %></span></td>
                <td style="font-size:12px;"><%= m.direction==='inbound' ? '⬇ In' : '⬆ Out' %></td>
                <td><span class="badge <%= sbadge(m.status) %>"><%= cap(m.status) %></span><% if (m.error) { %><div class="muted" style="font-size:11px;color:var(--bad-fg);max-width:220px;overflow-wrap:anywhere;"><%= m.error %></div><% } %></td>
                <td style="font-size:13px;overflow-wrap:anywhere;"><% if (m.peer_name) { %><strong><%= m.peer_name %></strong><br><% } %><span class="muted" style="font-size:12px;"><%= m.peer || '—' %></span></td>
                <td style="font-size:13px;max-width:360px;overflow-wrap:anywhere;color:var(--text-soft);"><%= m.preview || '—' %></td>
                <td style="white-space:nowrap;"><% if (m.ticket_id) { %><a class="row-link" href="/tickets/<%= m.ticket_id %>"><%= m.ticket_number || ('#'+m.ticket_id) %></a><% } else { %><span class="muted">—</span><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>
  </details>

<% } else { %>
  <% if (!graphOn) { %><div class="alert alert-danger" style="max-width:820px;">Microsoft Graph isn't configured, so emails won't actually send — they'll be logged to Mail flow as “not sent”. Configure Graph in Settings → Integrations to send for real.</div><% } %>

  <form method="post" action="/admin/email-test" class="card" style="max-width:820px;">
    <div style="margin-bottom:14px;">
      <label class="muted" style="font-size:12px;display:block;margin-bottom:4px;">Template</label>
      <select id="tpl" class="input" style="min-width:280px;">
        <% (templates||[]).forEach(function(t){ %><option value="<%= t.key %>"><%= t.label %></option><% }); %>
      </select>
      <span class="muted" style="font-size:12px;margin-left:8px;">picking one fills the subject &amp; body — edit before sending</span>
    </div>
    <div style="margin-bottom:14px;">
      <label class="muted" style="font-size:12px;display:block;margin-bottom:4px;">To <span style="font-weight:400;">(comma-separate multiple addresses)</span></label>
      <input class="input" type="text" name="to" required placeholder="someone@example.com, another@example.com" style="width:100%;">
    </div>
    <div style="margin-bottom:14px;">
      <label class="muted" style="font-size:12px;display:block;margin-bottom:4px;">Subject</label>
      <input id="subject" class="input" type="text" name="subject" required style="width:100%;">
    </div>
    <div style="margin-bottom:16px;">
      <label class="muted" style="font-size:12px;display:block;margin-bottom:4px;">Body <span style="font-weight:400;">(HTML allowed)</span></label>
      <textarea id="body" class="input" name="body" rows="12" style="width:100%;font-family:ui-monospace,Consolas,monospace;font-size:13px;"></textarea>
    </div>
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <button class="btn btn-primary" type="submit">Send test email</button>
      <button class="btn" type="button" id="previewBtn">Preview</button>
      <span class="muted" style="font-size:12px;">Sends from <%= fromAddr %></span>
    </div>
  </form>

  <div id="preview" class="card" style="max-width:820px;margin-top:14px;display:none;">
    <div class="card-header"><h2 style="font-size:15px;">Preview</h2></div>
    <iframe id="previewFrame" style="width:100%;height:380px;border:1px solid var(--line);border-radius:8px;background:var(--surface);"></iframe>
  </div>

  <script>
    var TEMPLATES = <%- JSON.stringify(templates || []) %>;
    var byKey = {}; TEMPLATES.forEach(function(t){ byKey[t.key] = t; });
    var tplSel = document.getElementById('tpl');
    var subjectEl = document.getElementById('subject');
    var bodyEl = document.getElementById('body');
    tplSel.addEventListener('change', function(){
      var t = byKey[tplSel.value]; if (!t) return;
      if (t.key === 'blank') { return; }
      subjectEl.value = t.subject || '';
      bodyEl.value = t.html || '';
    });
    document.getElementById('previewBtn').addEventListener('click', function(){
      var box = document.getElementById('preview'); box.style.display = 'block';
      var f = document.getElementById('previewFrame');
      f.srcdoc = bodyEl.value || '<p style="font-family:sans-serif;color:var(--faint);padding:16px;">Nothing to preview yet.</p>';
    });
  </script>
<% } %>

<script>
  // Small in-page filter for the collapsed lists. These are fully loaded and capped
  // (spam list in full, auto-filed at 100), so filtering client-side can't hide anything
  // the way it would on the outbound log — that one searches server-side instead.
  function pfFilter(input, tbodyId){
    var term = (input.value || '').toLowerCase().trim();
    var tb = document.getElementById(tbodyId);
    if (!tb) return;
    Array.prototype.forEach.call(tb.rows, function(tr){
      tr.style.display = (!term || tr.textContent.toLowerCase().indexOf(term) >= 0) ? '' : 'none';
    });
  }
</script>

<%- include('../partials/footer') %>
