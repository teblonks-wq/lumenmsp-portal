<%- include('../partials/header', { title: 'Invoices', user }) %>
<% function money(v){ return '£' + (Number(v)||0).toFixed(2); }
   function pstate(i){
     if (i.status==='void') return { label:'Void', cls:'badge-inactive' };
     if (i.payment_status==='paid') return { label:'Paid', cls:'badge-sent' };
     var bal = Number(i.balance||0), tot = Number(i.total||0);
     if (bal > 0 && bal < tot) return { label:'Part-paid', cls:'badge-primary' };
     var overdue = i.due_date && new Date(i.due_date) < new Date(new Date().toDateString());
     return overdue ? { label:'Overdue', cls:'badge-failed' } : { label:'Unpaid', cls:'badge-primary' };
   }
   // Sync-column tooltips. A grey icon has to say what has NOT happened — the titles used
   // to read "Emailed to customer" and "In QuickBooks" whether the icon was lit or not, so
   // hovering an unsent invoice told you it had been sent.
   function syncWhen(ts){
     if (!ts) return '';
     return new Date(ts).toLocaleString('en-GB', { timeZone:'Europe/London',
       day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
   }
   function syncTip(on, onText, offText, ts, extra){
     if (!on) return offText;
     var w = syncWhen(ts);
     // No date for something that plainly happened means the date was never recorded —
     // usually a row that predates the column. Say that, rather than borrowing another date.
     return onText + ' · ' + (w || 'date not recorded') + (extra || '');
   } %>

<div class="page-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div><h1>Invoices</h1><p class="muted"><%= invoices.length %> shown<% if (period && period.from) { %> · <%= period.label %><% } %></p></div>
  <button class="btn" type="button" onclick="finOpen()" style="color:var(--accent-deep);border-color:var(--accent-line);" title="Finance Agent — customer-wide money questions: every invoice, every GoCardless collection, credits, reconciliation pre-computed">&pound; Finance Agent</button>
  <a class="btn" href="/invoices/health" title="Invoice health — what QuickBooks actually holds, missing balances and issue dates, and the repairs">&#10010; Health</a>
  <a class="btn btn-primary" href="/invoices/new">+ New invoice</a>
</div>

<%
  function qs(over){ var p = { status:status, search:search, source:source, period:(period&&period.key)||'', from:from, to:to };
    for (var k in (over||{})) p[k]=over[k];
    var a=[]; for (var k in p) if (p[k]!=='' && p[k]!=null) a.push(k+'='+encodeURIComponent(p[k]));
    return '/invoices' + (a.length?'?'+a.join('&'):''); }
%>

<%
  // Stat band. Money figures follow the current filter (they come from the rows shown),
  // so drilling into one customer or one month keeps the numbers honest. Overdue is
  // computed the same way the badge on each row is - one definition, not two.
  var _today = new Date(new Date().toDateString());
  var _overdue = 0, _overdueVal = 0;
  invoices.forEach(function (i) {
    if (i.status === 'void' || i.payment_status === 'paid' || !(Number(i.balance) > 0 || i.payment_status !== 'paid')) return;
    if (i.due_date && new Date(i.due_date) < _today && i.status !== 'draft') { _overdue++; _overdueVal += Number(i.balance || i.total) || 0; }
  });
%>
<div class="stat-band acc-invoices">
  <a class="tile" href="<%= qs({status:'', search:'', paid:''}) %>" title="Everything in the current period">
    <div class="n"><%= money(total) %></div><div class="l">billed · shown</div><div class="h">clear filters</div></a>
  <a class="tile acc-warn<%= paid==='unpaid' ? ' on' : '' %>" href="<%= qs({paid: paid==='unpaid' ? '' : 'unpaid'}) %>" title="Invoices still carrying a balance">
    <div class="n <%= Number(outstanding) > 0 ? 'warn' : '' %>"><%= money(outstanding) %></div><div class="l">outstanding</div><div class="h"><%= paid==='unpaid' ? 'filtering — click to clear' : 'show unpaid' %></div></a>
  <a class="tile acc-bad" href="<%= qs({paid:'unpaid'}) %>" title="Unpaid and past the due date, in the rows shown">
    <div class="n <%= _overdue ? 'bad' : '' %>"><%= _overdue %><% if (_overdueVal) { %> <small><%= money(_overdueVal) %></small><% } %></div><div class="l">overdue</div><div class="h">show unpaid</div></a>
  <a class="tile acc-plain<%= status==='draft' ? ' on' : '' %>" href="<%= qs({status: status==='draft' ? '' : 'draft'}) %>">
    <div class="n"><%= statusCounts.draft||0 %></div><div class="l">raised</div><div class="h"><%= status==='draft' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= status==='issued' ? ' on' : '' %>" href="<%= qs({status: status==='issued' ? '' : 'issued'}) %>">
    <div class="n info"><%= statusCounts.issued||0 %></div><div class="l">issued</div><div class="h"><%= status==='issued' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= status==='paid' ? ' on' : '' %>" href="<%= qs({status: status==='paid' ? '' : 'paid'}) %>">
    <div class="n good"><%= statusCounts.paid||0 %></div><div class="l">paid</div><div class="h"><%= status==='paid' ? 'filtering — click to clear' : 'click to filter' %></div></a>
</div>

<!-- Status tabs -->
<div class="tabs" style="margin-bottom:14px;">
  <a class="tab-btn <%= status==='' ? 'active' : '' %>" href="<%= qs({status:''}) %>">All</a>
  <% var _slabel = { draft: 'Raised', issued: 'Issued', paid: 'Paid', void: 'Void' }; %>
  <% ['draft','issued','paid','void'].forEach(function(s){ %>
    <a class="tab-btn <%= status===s ? 'active' : '' %>" href="<%= qs({status:s}) %>"><%= _slabel[s] %> <span class="muted">(<%= statusCounts[s]||0 %>)</span></a>
  <% }); %>
</div>

<%
  // How many of the folded filters are live - the count sits on the Filters button so a
  // narrowed list can never masquerade as the whole picture.
  var _folded = 0;
  [source, paid, dd, (typeof gc!=='undefined'?gc:''), (typeof qb!=='undefined'?qb:''), (typeof recurring!=='undefined'?recurring:''), (typeof emailed!=='undefined'?emailed:'')].forEach(function(v){ if (v) _folded++; });
%>
<%
  // What is actually filtering the list, in words. Filters are STICKY — they survive an
  // action and coming back through the nav — so arriving at a narrowed list is normal and
  // must never be silent. This drives both the toolbar button and the banner below.
  var _v = function (n) { return (typeof n !== 'undefined' && n) ? n : ''; };
  var _filterBits = [];
  if (status) _filterBits.push('Status: ' + status.charAt(0).toUpperCase() + status.slice(1));
  if (search) _filterBits.push('Search "' + search + '"');
  if (period && period.key) _filterBits.push(period.label);
  if (source) _filterBits.push({ legacy: 'From QuickBooks', portal: 'Raised here', nocustomer: 'No customer' }[source] || source);
  if (paid) _filterBits.push(paid === 'paid' ? 'Paid' : 'Unpaid / part-paid');
  if (_v(dd)) _filterBits.push(dd === 'yes' ? 'On Direct Debit' : 'Not on Direct Debit');
  if (_v(gc)) _filterBits.push(gc === 'yes' ? 'Sent to GoCardless' : 'Not sent to GoCardless');
  if (_v(qb)) _filterBits.push(qb === 'yes' ? 'In QuickBooks' : 'Not in QuickBooks');
  if (_v(emailed)) _filterBits.push(emailed === 'yes' ? 'Emailed' : 'Not emailed');
  if (_v(recurring) === 'yes') _filterBits.push('Templates, not invoices');
%>
<!-- Toolbar: search + period stay out; everything else folds into one Filters panel -->
<form method="get" action="/invoices" class="toolbar" autocomplete="off">
  <input type="hidden" name="status" value="<%= status %>">
  <input class="input grow" type="search" name="search" value="<%= search %>" placeholder="Search number, title, customer, line item…" style="min-width:240px;">
  <select class="input" name="period" id="inv-period" style="width:auto;" onchange="invPeriodToggle();this.form.submit()">
    <% periodOptions.forEach(function(o){ %><option value="<%= o.key %>" <%= (period&&period.key)===o.key?'selected':'' %>><%= o.label %></option><% }); %>
  </select>
  <span class="inv-custom" style="<%= (period&&period.key)==='custom'?'':'display:none;' %>"><input class="input" type="date" name="from" value="<%= from %>" title="From"></span>
  <span class="inv-custom" style="<%= (period&&period.key)==='custom'?'':'display:none;' %>"><input class="input" type="date" name="to" value="<%= to %>" title="To"></span>
  <div class="filters-pop">
    <button class="btn" type="button" id="invFiltersBtn" aria-expanded="false">Filters<% if (_folded) { %><span class="filters-count"><%= _folded %></span><% } %></button>
    <div class="filters-panel" id="invFiltersPanel">
      <label class="fl">Source
        <select class="input" name="source" onchange="this.form.submit()">
          <option value="" <%= source===''?'selected':'' %>>All invoices</option>
          <option value="portal" <%= source==='portal'?'selected':'' %>>Portal-native</option>
          <option value="legacy" <%= source==='legacy'?'selected':'' %>>Legacy (QuickBooks) (<%= legacyCount %>)</option>
          <% if (unmatchedCount) { %><option value="nocustomer" <%= source==='nocustomer'?'selected':'' %>>&#9888; No customer (<%= unmatchedCount %>)</option><% } %>
        </select>
      </label>
      <label class="fl">Payment
        <select class="input" name="paid" onchange="this.form.submit()">
          <option value="" <%= paid===''?'selected':'' %>>All</option>
          <option value="unpaid" <%= paid==='unpaid'?'selected':'' %>>Unpaid</option>
          <option value="paid" <%= paid==='paid'?'selected':'' %>>Paid</option>
        </select>
      </label>
      <label class="fl">Direct Debit
        <select class="input" name="dd" onchange="this.form.submit()">
          <option value="" <%= dd===''?'selected':'' %>>Any</option>
          <option value="yes" <%= dd==='yes'?'selected':'' %>>DD only</option>
          <option value="no" <%= dd==='no'?'selected':'' %>>Non-DD</option>
        </select>
      </label>
      <label class="fl">Sent to GC
        <select class="input" name="gc" onchange="this.form.submit()">
          <option value="" <%= (typeof gc==='undefined'||gc==='')?'selected':'' %>>Any</option>
          <option value="yes" <%= gc==='yes'?'selected':'' %>>Sent to GC</option>
          <option value="no" <%= gc==='no'?'selected':'' %>>Not sent</option>
        </select>
      </label>
      <label class="fl">Sent to QB
        <select class="input" name="qb" onchange="this.form.submit()">
          <option value="" <%= (typeof qb==='undefined'||qb==='')?'selected':'' %>>Any</option>
          <option value="yes" <%= qb==='yes'?'selected':'' %>>Sent to QB</option>
          <option value="no" <%= qb==='no'?'selected':'' %>>Not sent</option>
        </select>
      </label>
      <label class="fl">Show
        <select class="input" name="recurring" onchange="this.form.submit()">
          <option value="" <%= (typeof recurring==='undefined'||recurring==='')?'selected':'' %>>Invoices</option>
          <option value="yes" <%= (typeof recurring!=='undefined'&&recurring==='yes')?'selected':'' %>>&#9851; Templates</option>
        </select>
      </label>
      <label class="fl">Emailed
        <select class="input" name="emailed" onchange="this.form.submit()">
          <option value="" <%= (typeof emailed==='undefined'||emailed==='')?'selected':'' %>>Any</option>
          <option value="yes" <%= emailed==='yes'?'selected':'' %>>Emailed</option>
          <option value="no" <%= emailed==='no'?'selected':'' %>>Not emailed</option>
        </select>
      </label>
      <div class="fp-foot">
        <% if (_folded) { %><a class="btn" href="<%= qs({source:'',paid:'',dd:'',gc:'',qb:'',recurring:'',emailed:''}) %>">Reset these</a><% } %>
        <button class="btn btn-primary" type="submit">Apply</button>
      </div>
    </div>
  </div>
  <button class="btn" type="submit">Search</button>
  <% if (_filterBits.length) { %><a class="btn" href="/invoices?clear=1" title="Filters stay set until you clear them">Clear filters</a><% } %>
</form>
<script>
  (function(){
    var btn = document.getElementById('invFiltersBtn'), panel = document.getElementById('invFiltersPanel');
    if (!btn || !panel) return;
    btn.addEventListener('click', function(e){ e.stopPropagation(); panel.classList.toggle('on'); btn.setAttribute('aria-expanded', panel.classList.contains('on') ? 'true' : 'false'); });
    document.addEventListener('click', function(e){ if (!panel.contains(e.target) && e.target !== btn) panel.classList.remove('on'); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') panel.classList.remove('on'); });
  })();
</script>
<script>
  function invPeriodToggle(){ var v=document.getElementById('inv-period').value; document.querySelectorAll('.inv-custom').forEach(function(e){ e.style.display = v==='custom'?'':'none'; }); }
</script>

<% if (_filterBits.length) { %>
<div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:10px;padding:9px 14px;border:1px solid var(--warn-line,#fde68a);background:var(--tint-warn,#fffbeb);border-radius:9px;">
  <span style="font-size:13px;color:var(--warn-deep,#92400e);">
    <strong>You are looking at a filtered list</strong> &mdash; <%= _filterBits.join(' · ') %>.
    <span class="muted" style="color:var(--warn-deep,#92400e);opacity:.8;">The totals above follow the filter.</span>
  </span>
  <a class="btn" href="/invoices?clear=1" style="margin-left:auto;background:var(--card,#fff);">Clear filters</a>
</div>
<% } %>

<div id="batchStatus" style="display:none;margin-bottom:10px;padding:10px 14px;border-radius:8px;border:1px solid var(--info-line);background:var(--tint-info);font-size:13px;"></div>
<div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap;">
  <span class="muted" style="font-size:13px;margin-right:auto;"><span id="batchCount">0</span> selected</span>
  <select class="input" id="bulkAction" style="width:auto;font-size:13px;">
    <option value="">Bulk action…</option>
    <option value="email">Email to customer</option>
    <option value="qb">Send to QuickBooks</option>
    <option value="gc">Send to GoCardless (collect DD)</option>
    <option value="reminder">Send reminders</option>
    <option value="delete">Delete (move to recycle bin)</option>
  </select>
  <button class="btn" id="bulkApply" type="button" disabled>Apply</button>
  <button class="btn" id="bulkDownload" type="button" disabled>Download</button>
  <button class="btn" id="bulkPrint" type="button" disabled>Print</button>
  <button class="btn btn-primary" type="submit" form="batchForm" id="batchBtn" disabled title="Email + QuickBooks + Direct Debit in one go">Complete</button>
</div>
<form method="post" action="/invoices/batch-complete" id="batchForm"></form>
<script>
  (function(){
    function chks(){ return Array.prototype.slice.call(document.querySelectorAll('.batch-chk')); }
    function selectedIds(){ return chks().filter(function(c){return c.checked;}).map(function(c){return c.value;}); }
    var apply=document.getElementById('bulkApply'), dl=document.getElementById('bulkDownload'), pr=document.getElementById('bulkPrint'), act=document.getElementById('bulkAction');
    function refreshBulk(){ var n=selectedIds().length; [apply,dl,pr].forEach(function(b){ if(b) b.disabled = (n===0); }); }
    document.addEventListener('change', function(e){ if(e.target && (e.target.classList.contains('batch-chk') || e.target.id==='batchAll')) setTimeout(refreshBulk,0); });
    refreshBulk();
    var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content || '';
    if(apply) apply.addEventListener('click', function(){
      var ids=selectedIds(), a=act.value;
      if(!ids.length) return;
      if(!a){ alert('Choose a bulk action first.'); return; }
      var nice={email:'email to customer',qb:'send to QuickBooks',gc:'send to GoCardless (collect by Direct Debit)',reminder:'send payment reminders',delete:'delete (move to recycle bin)'}[a];
      var prompt = a==='delete' ? ('Move '+ids.length+' invoice(s) to the recycle bin? They can be restored from there.') : ('Apply "'+nice+'" to '+ids.length+' invoice(s)?');
      if(!confirm(prompt)) return;
      var f=document.createElement('form'); f.method='post'; f.action='/invoices/bulk';
      function add(n,v){ var i=document.createElement('input'); i.type='hidden'; i.name=n; i.value=v; f.appendChild(i); }
      add('action',a); add('_csrf',csrf); ids.forEach(function(id){ add('ids',id); });
      document.body.appendChild(f); f.submit();
    });
    function openPdf(print){ var ids=selectedIds(); if(!ids.length) return; window.open('/invoices/bulk-pdf?ids='+ids.join(',')+(print?'&print=1':''),'_blank'); }
    if(dl) dl.addEventListener('click', function(){ openPdf(false); });
    if(pr) pr.addEventListener('click', function(){ openPdf(true); });
  })();
</script>
<script>
  (function(){
    var box = document.getElementById('batchStatus');
    if (!box) return;
    var started = new URLSearchParams(location.search).get('batch') === 'running';
    var form = document.getElementById('batchForm');
    var btn = document.getElementById('batchBtn');
    function render(s){
      if (!s || (!s.running && (s.total||0) === 0)) { box.style.display='none'; return; }
      box.style.display='block';
      if (s.running) {
        box.style.borderColor='var(--info-line)'; box.style.background='var(--tint-info)';
        box.innerHTML = '⏳ Completing invoices… <strong>' + s.done + ' / ' + s.total + '</strong> done (' + s.ok + ' ok)';
      } else {
        var bad = (s.errs||[]).length;
        box.style.borderColor = bad ? 'var(--warn-line)' : 'var(--ok-line)';
        box.style.background = bad ? 'var(--tint-warn)' : 'var(--tint-ok)';
        box.innerHTML = '✓ Batch finished — <strong>' + s.ok + ' of ' + s.total + '</strong> completed'
          + (bad ? '. <span style="color:var(--warn-deep);">' + bad + ' issue(s): ' + s.errs.slice(0,5).join('; ') + '</span>' : '.')
          + ' <a href="/invoices' + location.search + '" style="margin-left:6px;">Refresh list</a>';
      }
    }
    function poll(){
      fetch('/invoices/batch-status').then(function(r){return r.json();}).then(function(s){
        render(s);
        if (s && s.running) setTimeout(poll, 2500);
      }).catch(function(){});
    }
    // Submit the batch over fetch — no full-page navigation, so a heavy list render can't 504 the action.
    if (form) form.addEventListener('submit', function(ev){
      ev.preventDefault();
      var ids = Array.prototype.slice.call(document.querySelectorAll('.batch-chk')).filter(function(c){return c.checked;});
      if (!ids.length) return;
      if (!confirm('Complete ' + ids.length + ' invoice(s)? This emails the finance contact, pushes to QuickBooks and submits to GoCardless for each. It runs in the background.')) return;
      var body = new URLSearchParams(); ids.forEach(function(c){ body.append('ids', c.value); });
      if (btn) { btn.disabled = true; }
      box.style.display='block'; box.style.borderColor='var(--info-line)'; box.style.background='var(--tint-info)'; box.innerHTML = '⏳ Starting…';
      fetch('/invoices/batch-complete', { method:'POST', headers:{ 'Content-Type':'application/x-www-form-urlencoded', 'X-Requested-With':'XMLHttpRequest', 'Accept':'application/json' }, body: body.toString() })
        .then(function(r){ return r.json().then(function(j){ return { ok:r.ok, j:j }; }); })
        .then(function(res){
          if (!res.ok || !res.j.ok) { box.style.borderColor='var(--bad-line2)'; box.style.background='var(--tint-bad)'; box.innerHTML = '⚠ ' + (res.j.error || 'Could not start batch.'); if (btn) btn.disabled=false; return; }
          setTimeout(poll, 800);
        })
        .catch(function(){ box.style.borderColor='var(--bad-line2)'; box.style.background='var(--tint-bad)'; box.innerHTML = '⚠ Network error starting batch.'; if (btn) btn.disabled=false; });
    });
    poll();
    if (started) setTimeout(poll, 1500);
  })();
</script>

<div class="card" style="padding:0;border-top:3px solid var(--ok);">
  <div class="table-wrap">
    <table class="table table-lift">
      <thead><tr><th style="width:30px;"><input type="checkbox" id="batchAll" title="Select all"></th><th>Number</th><th>Title</th><th>Customer</th><th>Paid?</th><th style="text-align:right;">Total</th><th style="text-align:right;">Outstanding</th><th>Issued</th><th style="text-align:center;">Sync</th></tr></thead>
      <tbody>
        <% if (invoices.length===0) { %><tr><td colspan="9"><div class="empty-state">No invoices.</div></td></tr><% } %>
        <% invoices.forEach(function(i){ var on='var(--accent)', off='var(--line-strong)';
             var ps = pstate(i);
             var _re = ps.label==='Overdue' ? 're-bad' : ps.label==='Part-paid' ? 're-warn'
                     : ps.label==='Paid' ? 're-ok' : ps.label==='Void' ? 're-dim' : ''; %>
          <tr class="<%= _re %>">
            <td style="text-align:center;"><input type="checkbox" class="batch-chk" name="ids" value="<%= i.id %>" form="batchForm"></td>
            <td><a class="row-link" href="/invoices/<%= i.id %>"><%= i.invoice_number %></a><% if (i.is_recurring) { %> <span title="Recurring template">♻</span><% } %><% if (i.is_legacy) { %> <span class="badge badge-inactive" title="Imported from QuickBooks" style="font-size:10px;">Legacy</span><% } %></td>
            <td><%= i.title %>
              <% if (i.match_lines) { %>
                <div class="muted" style="font-size:11px;margin-top:2px;" title="Matching line items on this invoice">&#8627; <%= i.match_lines %></div>
              <% } %>
            </td>
            <td class="muted"><% if (i.customer_id) { %><a class="row-link" href="/customers/<%= i.customer_id %>"><%= i.customer_name %></a><% } else { %>—<% } %></td>
            <td>
              <span class="badge <%= ps.cls %>"><%= ps.label %></span>
              <% if (i.gocardless_mandate_id) { %><br><span class="muted" style="font-size:11px;">Direct Debit</span><% } %>
            </td>
            <td class="money"><%= money(i.total) %></td>
            <td class="money"><% if (Number(i.balance) > 0) { %><span style="color:var(--warn-fg);"><%= money(i.balance) %></span><% } else if (i.payment_status==='paid') { %><span class="muted">—</span><% } else { %><span class="muted"><%= money(i.total) %></span><% } %></td>
            <td class="muted"><%= i.issue_date ? new Date(i.issue_date).toLocaleDateString('en-GB') : '—' %></td>
            <td style="text-align:center;white-space:nowrap;">
              <%
                 // The invoice's own send date, falling back to the newest outbound message.
                 // A later message than the send is a resend, a reminder or a chase, and it
                 // is worth saying so rather than showing one date and hiding the other.
                 var _emAt = i.emailed_at || i.last_emailed;
                 var _emExtra = (i.emailed_at && i.last_emailed && new Date(i.last_emailed) > new Date(i.emailed_at))
                   ? ' · last message ' + syncWhen(i.last_emailed) : '';
              %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="<%= i.emailed ? 'var(--blue)' : off %>" stroke-width="2" style="vertical-align:middle;margin:0 2px;"><title><%= syncTip(i.emailed, 'Emailed to customer', 'Not emailed to the customer', _emAt, _emExtra) %></title><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="<%= i.gocardless_payment_id ? 'var(--ok-fg)' : off %>" stroke-width="2" style="vertical-align:middle;margin:0 2px;"><title><%= syncTip(!!i.gocardless_payment_id, 'Submitted for payment (GoCardless)', 'Not submitted for payment', i.gocardless_submitted_at) %></title><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="<%= i.quickbooks_invoice_id ? 'var(--warn-fg)' : off %>" stroke-width="2" style="vertical-align:middle;margin:0 2px;"><title><%= syncTip(!!i.quickbooks_invoice_id, 'Sent to QuickBooks', 'Not in QuickBooks', i.qb_push_at, i.payment_synced_at ? ' · payment state last read ' + syncWhen(i.payment_synced_at) : '') %></title><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function(){
    var all = document.getElementById('batchAll');
    var btn = document.getElementById('batchBtn');
    var cnt = document.getElementById('batchCount');
    function chks(){ return Array.prototype.slice.call(document.querySelectorAll('.batch-chk')); }
    function refresh(){ var n = chks().filter(function(c){return c.checked;}).length; if(cnt) cnt.textContent = n; if(btn) btn.disabled = n===0; }
    if (all) all.addEventListener('change', function(){ chks().forEach(function(c){ c.checked = all.checked; }); refresh(); });
    chks().forEach(function(c){ c.addEventListener('change', refresh); });
    refresh();
  })();
</script>

