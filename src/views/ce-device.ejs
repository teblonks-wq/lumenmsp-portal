<%- include('partials/header', { title: device.hostname + ' — Cyber Essentials', user }) %>
<%
var controlLabel = {};
controls.forEach(function (c) { controlLabel[c.key] = c.label; });
function scoreColour(v) {
  if (v == null) return '';
  if (v >= 90) return 'color:var(--ok-fg);';
  if (v >= 70) return 'color:var(--warn-fg);';
  return 'color:var(--bad-fg);';
}
var byControl = {};
controls.forEach(function (c) { byControl[c.key] = []; });
findings.forEach(function (f) { (byControl[f.control] = byControl[f.control] || []).push(f); });
%>

<style>
  .ce-f { border-top:1px solid var(--line); padding:14px 0; }
  .ce-f:first-child { border-top:0; }
  .ce-f .r { font-size:13px; margin-top:6px; }
  .ce-f .e { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:11px; color:var(--muted); margin-top:6px; word-break:break-all; }
</style>

<div class="page-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/ce">← Cyber Essentials</a></p>
    <h1 style="margin:0;"><%= device.hostname %></h1>
    <p class="muted" style="margin:4px 0 0;">
      <% if (device.customer_id) { %><a class="row-link" href="/customers/<%= device.customer_id %>"><%= device.customer_name %></a> · <% } %>
      <%= device.os || 'Windows' %>
      <% if (result) { %> · assessed <%= new Date(result.collected_at).toLocaleString('en-GB') %><% } %>
      · <a class="row-link" href="/patching/device/<%= device.id %>">patching</a>
    </p>
  </div>
  <form method="post" action="/ce/run">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <input type="hidden" name="scope" value="device">
    <input type="hidden" name="device_id" value="<%= device.id %>">
    <button class="btn btn-primary" type="submit">Assess this machine now</button>
  </form>
</div>

<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>

<% if (!result) { %>
<div class="card"><div class="empty-state">
  This machine has never been assessed. Run it above — the agent gathers the evidence on its next check-in,
  which is within a minute for a machine that is switched on.
</div></div>
<% } else { %>

<div class="card-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));">
  <div class="card"><div class="card-header"><h2>Score</h2></div><div class="stat" style="font-size:24px;<%= scoreColour(result.score) %>"><%= result.score %></div><p class="muted" style="margin:2px 0 0;">out of 100</p></div>
  <div class="card"><div class="card-header"><h2>Fails</h2></div><div class="stat" style="font-size:24px;<%= Number(result.fail_count) ? 'color:var(--bad-fg);' : '' %>"><%= result.fail_count %></div></div>
  <div class="card"><div class="card-header"><h2>Warnings</h2></div><div class="stat" style="font-size:24px;"><%= result.warn_count %></div></div>
  <div class="card"><div class="card-header"><h2>Passes</h2></div><div class="stat" style="font-size:24px;color:var(--ok-fg);"><%= result.pass_count %></div></div>
</div>

<% controls.forEach(function (c) { var list = (byControl[c.key] || []); if (!list.length) return; %>
<div class="card">
  <div class="card-header"><h2><%= c.label %></h2></div>
  <% list.forEach(function (f) { %>
    <div class="ce-f">
      <div>
        <span class="badge <%= f.status === 'fail' ? 'badge-failed' : f.status === 'warn' ? 'badge-primary' : 'badge-active' %>"><%= f.status %></span>
        <strong><%= f.title %></strong>
        <% if (f.eol_date) { %><span class="muted" style="font-size:12px;">— end of support <%= new Date(f.eol_date).toLocaleDateString('en-GB') %></span><% } %>
      </div>
      <% if (f.detail) { %><div class="muted" style="font-size:13px;margin-top:4px;"><%= f.detail %></div><% } %>
      <% if (f.status !== 'pass' && f.remediation) { %><div class="r"><strong>Do this:</strong> <%= f.remediation %></div><% } %>
      <% if (f.evidence) { %><div class="e"><%= f.evidence %></div><% } %>
    </div>
  <% }); %>
</div>
<% }); %>

<% if (history.length > 1) { %>
<div class="card" style="padding:0;">
  <div class="card-header" style="padding:20px 24px 0;"><h2>History</h2></div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Assessed</th><th style="text-align:right;">Score</th><th style="text-align:right;">Fails</th><th style="text-align:right;">Warnings</th><th></th></tr></thead>
      <tbody>
        <% history.forEach(function (h) { %>
          <tr>
            <td><%= new Date(h.collected_at).toLocaleString('en-GB') %></td>
            <td style="text-align:right;font-weight:600;<%= scoreColour(h.score) %>"><%= h.score %></td>
            <td style="text-align:right;"><%= h.fail_count %></td>
            <td style="text-align:right;"><%= h.warn_count %></td>
            <td style="text-align:right;"><a class="row-link" href="/ce/run/<%= h.assessment_id %>">the run</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% } %>

<%- include('partials/footer') %>
