<%- include('../partials/header', { title: 'Credential handovers', user }) %>
<% function dt(x){ return x ? new Date(x).toLocaleString('en-GB', { timeZone:'Europe/London' }) : '—'; }
   var TONE = { ok:'var(--ok-fg,#15803d)', warn:'var(--warn-deep,#92400e)', bad:'#b91c1c', muted:'var(--muted,#64748b)' }; %>

<div class="page-header">
  <h1>Credential handovers</h1>
  <p class="muted">Every set of login details sent by one-time link — who it went to, whether they collected it, and from where. Nothing here can show you the credentials: once collected they are gone from the database, and until then they are encrypted.</p>
</div>

<div class="card" style="padding:0;">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Sent</th><th>Customer</th><th>What</th><th>To</th><th>By</th><th>Status</th><th>Opens</th><th></th></tr></thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8" class="muted" style="padding:16px;">Nothing sent yet. Use <strong>🔐 Send credentials…</strong> in the composer on a case or a customer.</td></tr>
        <% } %>
        <% rows.forEach(function(r){ var st = statusOf(r); %>
        <tr>
          <td style="white-space:nowrap;font-size:13px;"><%= dt(r.created_at) %></td>
          <td><%= r.customer_name || '—' %></td>
          <td><%= r.title || (r.item_count + (r.item_count === 1 ? ' credential' : ' credentials')) %></td>
          <td style="font-size:13px;"><%= r.to_email || '—' %></td>
          <td style="font-size:13px;"><%= r.created_by_name || '—' %></td>
          <td style="font-weight:600;font-size:13px;color:<%= TONE[st.tone] %>;"><%= st.label %></td>
          <td style="text-align:center;"><%= r.opens || 0 %></td>
          <td><a class="row-link" href="/credential-sends/<%= r.id %>">View</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
