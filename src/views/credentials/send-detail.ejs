<%- include('../partials/header', { title: 'Credential handover', user }) %>
<%
function dt(x){ return x ? new Date(x).toLocaleString('en-GB', { timeZone:'Europe/London' }) : '—'; }
var TONE = { ok:'var(--ok-fg,#15803d)', warn:'var(--warn-deep,#92400e)', bad:'#b91c1c', muted:'var(--muted,#64748b)' };
// Plain English for the log. "link_opened" tells an engineer something; it tells the
// customer on the phone nothing, and this page gets read out to customers.
var LABEL = {
  created:          ['Link created',              'The handover was minted and the passcode shown once to the sender.'],
  link_opened:      ['Link opened',               'Someone loaded the page. Could be the recipient — could equally be their mail scanner clicking every link in the email.'],
  passcode_failed:  ['Wrong passcode',            'The page was open and a passcode was tried that did not match.'],
  revealed:         ['Details collected',         'The right passcode was entered, the details were shown once, and the encrypted copy was destroyed.'],
  opened_after_burn:['Opened after collection',   'Somebody followed the link after it had already been used. They saw nothing.'],
  opened_expired:   ['Opened after expiry',       'Followed too late. They saw nothing.'],
  opened_revoked:   ['Opened after cancelling',   'Followed after the link was cancelled. They saw nothing.'],
  locked:           ['Locked out',                'Too many wrong passcodes. The link is dead and needs reissuing.'],
  revoked:          ['Cancelled',                 'Killed from the Portal before it was collected.'],
  passcode_reissued:['New passcode issued',        'The old passcode stopped working at this moment. Same link, same details — only the code changed.'],
};
var live = !s.revealed_at && !s.revoked_at && !s.locked_at && new Date(s.expires_at).getTime() > Date.now();
%>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/credential-sends">← Credential handovers</a></p>
  <h1><%= s.title || (s.item_count + (s.item_count === 1 ? ' credential' : ' credentials')) %></h1>
  <p class="muted">
    <%= s.customer_name ? s.customer_name + ' · ' : '' %>sent <%= dt(s.created_at) %><%= s.created_by_name ? ' by ' + s.created_by_name : '' %><%= s.to_email ? ' to ' + s.to_email : '' %>
    <% if (s.ticket_id) { %> · <a class="row-link" href="/tickets/<%= s.ticket_id %>">case</a><% } %>
  </p>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success" style="max-width:900px;"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error" style="max-width:900px;"><%= error %></div><% } %>

<% if (typeof newPasscode !== 'undefined' && newPasscode) { %>
<div class="card" style="max-width:900px;margin-bottom:18px;border:2px solid var(--accent-line,#0e7490);">
  <h2 style="margin:0 0 4px;font-size:17px;">New passcode — write it down this time</h2>
  <p class="muted" style="margin:0 0 12px;font-size:13px;">
    The old one stopped working the moment you pressed the button. The link itself has not changed,
    so the email already in their inbox still works — you only need to give them this code.
    You will not see it again.
  </p>
  <div style="font-family:ui-monospace,'Cascadia Mono',Consolas,monospace;font-size:34px;font-weight:800;letter-spacing:9px;
              text-align:center;padding:16px 10px;background:#ecfeff;border:2px dashed #0e7490;border-radius:12px;color:#0b3a5b;"
       id="npCode"><%= newPasscode %></div>
  <div style="display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap;">
    <button type="button" class="btn" id="npCopy" style="font-size:12.5px;">Copy passcode</button>
    <a class="btn" style="font-size:12.5px;"
       href="sms:?&body=<%= encodeURIComponent('Your passcode for the Lumen login details page is ' + newPasscode) %>">Text it</a>
    <a class="btn" target="_blank" rel="noopener" style="font-size:12.5px;"
       href="https://wa.me/?text=<%= encodeURIComponent('Your passcode for the Lumen login details page is ' + newPasscode) %>">WhatsApp it</a>
  </div>
  <div style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:10px;padding:11px 13px;font-size:13px;margin-top:14px;">
    Not by the same email as the link. Two channels, or the whole exercise is for nothing.
  </div>
</div>
<script>
  document.getElementById('npCopy').addEventListener('click', function(){
    var b = this, v = document.getElementById('npCode').textContent.trim();
    var done = function(){ b.textContent = 'Copied'; setTimeout(function(){ b.textContent = 'Copy passcode'; }, 1500); };
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(v).then(done, done);
    else { var t = document.createElement('textarea'); t.value = v; document.body.appendChild(t); t.select(); try { document.execCommand('copy'); } catch(e){} document.body.removeChild(t); done(); }
  });
</script>
<% } %>

<div class="card" style="max-width:900px;margin-bottom:18px;">
  <div style="display:flex;gap:22px;flex-wrap:wrap;align-items:center;">
    <div>
      <div class="muted" style="font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;">Status</div>
      <div style="font-size:19px;font-weight:700;color:<%= TONE[status.tone] %>;"><%= status.label %></div>
    </div>
    <div>
      <div class="muted" style="font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;">Contents</div>
      <div style="font-size:19px;font-weight:700;"><%= s.item_count %></div>
    </div>
    <div>
      <div class="muted" style="font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;">Wrong passcodes</div>
      <div style="font-size:19px;font-weight:700;"><%= s.attempts || 0 %></div>
    </div>
    <div>
      <div class="muted" style="font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;"><%= live ? 'Dies' : 'Died' %></div>
      <div style="font-size:14px;font-weight:600;"><%= dt(s.revealed_at || s.revoked_at || s.expires_at) %></div>
    </div>
    <span style="flex:1;"></span>
    <% if (live) { %>
    <form method="post" action="/credential-sends/<%= s.id %>/reissue" style="margin:0;"
          onsubmit="return confirm('Issue a new passcode? The one you gave them stops working immediately — you will have to pass on the new one.');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit" title="Lost the code, or gave it to the wrong person — same link, new code">Reissue passcode</button>
    </form>
    <form method="post" action="/credential-sends/<%= s.id %>/revoke" style="margin:0;"
          onsubmit="return confirm('Cancel this link? The customer will not be able to collect these details and you will need to send a fresh set.');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit" style="color:#b91c1c;">Cancel this link</button>
    </form>
    <% } %>
  </div>
  <% if (live && typeof url !== 'undefined' && url) { %>
  <p class="muted" style="margin:14px 0 0;font-size:12px;font-family:ui-monospace,Consolas,monospace;word-break:break-all;">
    <%= url %>
  </p>
  <% } %>
  <% if (s.revealed_at) { %>
  <p class="muted" style="margin:14px 0 0;font-size:13px;">
    Collected <%= dt(s.revealed_at) %>. The encrypted copy was deleted at that moment — there is nothing left to show, here or in the database.
    If the row below says it was collected from somewhere you do not recognise, change the password.
  </p>
  <% } %>
</div>

<div class="card" style="max-width:900px;padding:0;">
  <div class="card-header" style="padding:12px 16px;">
    <h2 style="margin:0;">What happened <span class="muted" style="font-weight:400;font-size:14px;">(<%= events.length %>)</span></h2>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>When</th><th>What</th><th>From where</th><th>Device</th></tr></thead>
      <tbody>
        <% events.forEach(function(e){ var L = LABEL[e.event] || [e.event, '']; %>
        <tr>
          <td style="white-space:nowrap;font-size:13px;"><%= dt(e.created_at) %></td>
          <td>
            <strong><%= L[0] %></strong>
            <% if (L[1]) { %><div class="muted" style="font-size:12px;max-width:46ch;"><%= L[1] %></div><% } %>
          </td>
          <td style="font-size:12.5px;"><%= e.ip ? whereFrom(e.meta, e.ip) : '—' %></td>
          <td class="muted" style="font-size:11.5px;max-width:26ch;overflow-wrap:anywhere;"><%= e.user_agent || '—' %></td>
        </tr>
        <% }); %>
        <% if (!events.length) { %><tr><td colspan="4" class="muted" style="padding:16px;">Nothing logged yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <p class="muted" style="padding:12px 16px;margin:0;font-size:12px;border-top:1px solid var(--line);">
    Locations come from the IP address and are a rough guide, not evidence — a customer on
    4G looks like wherever their carrier breaks out, which can be two counties away. It is
    enough to answer "did this open somewhere I would not expect", which is the question worth asking.
  </p>
</div>

<%- include('../partials/footer') %>
