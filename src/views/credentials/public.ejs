<%
// ── The page the customer lands on ──────────────────────────────────────────────
// Standalone: no Portal layout, no session, no sidebar. Modes:
//   ask     — passcode prompt (also what a mail scanner gets, which is the point)
//   shown   — the one and only reveal, with a Copy button per field
//   burnt / expired / revoked / locked / missing — dead ends, each saying plainly what
//   happened and what to do next, because "invalid link" makes people ring up.
var modeText = {
  burnt:   { h: 'These details have already been collected', p: 'This page only opens once, and it has been opened. If that was not you, ring us straight away on 0333 3350170 and we will change the password.' },
  expired: { h: 'This link has expired', p: 'Links are short-lived on purpose. Reply to the email we sent and we will issue a fresh one — it takes a moment.' },
  revoked: { h: 'This link has been cancelled', p: 'Someone at Lumen cancelled this handover. Reply to the email we sent and we will sort it out.' },
  locked:  { h: 'Too many wrong passcodes', p: 'This link is now locked. Reply to the email we sent, or ring 0333 3350170, and we will issue a new one with a new passcode.' },
  missing: { h: "We can't find that link", p: 'Check you copied the whole address from the email — they are long and easy to cut short.' },
};
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="referrer" content="no-referrer">
  <title>Your login details · Lumen IT Solutions</title>
  <link rel="icon" type="image/png" href="/static/lumen-crest.png">
  <style>
    :root { --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --accent:#0e7490; --accent-2:#22d3ee; }
    * { box-sizing:border-box; }
    body { margin:0; background:#eef2f6; color:var(--ink); font:15px/1.55 'Segoe UI',system-ui,-apple-system,Arial,sans-serif; }
    .wrap { max-width:680px; margin:0 auto; padding:28px 16px 64px; }
    .brand { display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:20px; }
    .brand img { max-width:190px; height:auto; }
    .brand .ph { font-size:13px; color:var(--muted); }
    .brand .ph a { color:var(--accent); text-decoration:none; font-weight:600; }
    .hero { background:linear-gradient(120deg,#0b3a5b,#0e7490); color:#fff; border-radius:16px; padding:24px 26px; margin-bottom:16px; }
    .hero h1 { margin:0 0 6px; font-size:23px; letter-spacing:-.4px; }
    .hero p { margin:0; opacity:.92; font-size:14.5px; max-width:56ch; }
    .card { background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px 24px; margin-bottom:16px; box-shadow:0 1px 3px rgba(15,23,42,.05); }
    .note { border-radius:10px; padding:11px 14px; font-size:13.5px; margin-bottom:14px; }
    .note.bad { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }
    .note.warn { background:#fffbeb; color:#92400e; border:1px solid #fde68a; }
    label { display:block; font-size:12px; font-weight:700; color:var(--muted); margin:0 0 6px; letter-spacing:.3px; text-transform:uppercase; }
    .code-in { width:100%; font:inherit; font-size:26px; font-weight:700; letter-spacing:8px; text-align:center; text-transform:uppercase;
               padding:14px 12px; border:2px solid #cbd5e1; border-radius:11px; background:#fff; color:var(--ink); font-family:ui-monospace,'Cascadia Mono',Consolas,monospace; }
    .code-in:focus { outline:3px solid var(--accent-2); outline-offset:1px; border-color:var(--accent); }
    .btn { display:inline-block; font:inherit; font-size:14px; font-weight:600; padding:11px 20px; border-radius:9px; cursor:pointer;
           border:1px solid var(--line); background:#fff; color:var(--ink); text-decoration:none; }
    .btn.primary { background:var(--accent); border-color:var(--accent); color:#fff; width:100%; font-size:15px; }
    .btn.primary:hover { background:#0b5c73; }
    .cred { border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:12px; background:#fbfdfe; }
    .cred h3 { margin:0 0 10px; font-size:15.5px; }
    .row { display:flex; align-items:center; gap:10px; padding:7px 0; border-top:1px dashed #e8eef3; }
    .row:first-of-type { border-top:0; }
    .row .k { flex:0 0 84px; font-size:11.5px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.3px; }
    .row .v { flex:1; min-width:0; font-family:ui-monospace,'Cascadia Mono',Consolas,monospace; font-size:14px; word-break:break-all; }
    .row .v a { color:var(--accent); }
    .copy { flex:0 0 auto; font:inherit; font-size:12px; font-weight:700; padding:5px 11px; border-radius:7px; cursor:pointer;
            border:1px solid var(--accent); background:#fff; color:var(--accent); }
    .copy:hover { background:var(--accent); color:#fff; }
    .copy.done { background:#15803d; border-color:#15803d; color:#fff; }
    .pw { letter-spacing:1px; }
    .noteline { margin-top:8px; font-size:13px; color:var(--muted); }
    .foot { text-align:center; color:#94a3b8; font-size:12px; margin-top:26px; line-height:1.7; }
    .foot a { color:#64748b; }
    @media print { body { background:#fff; } .copy, .btn { display:none; } }
  </style>
</head>
<body>
<div class="wrap">

  <div class="brand">
    <img src="/static/lumen-msp-logo.png" alt="Lumen IT Solutions">
    <div class="ph">Not expecting this? <a href="tel:03333350170">0333 3350170</a></div>
  </div>

<% if (mode === 'ask') { %>

  <div class="hero">
    <h1>Your login details are ready</h1>
    <p>We don't put passwords in email. Enter the passcode we gave you over the phone or by text and your details will appear below.</p>
  </div>

  <div class="card">
    <% if (error) { %><div class="note bad"><%= error %><% if (attemptsLeft > 0) { %> You have <strong><%= attemptsLeft %></strong> <%= attemptsLeft === 1 ? 'try' : 'tries' %> left.<% } %></div><% } %>
    <div class="note warn">
      <strong>Read this first.</strong> This page opens <strong>once</strong>. As soon as you enter the passcode the details are shown and then deleted from our system — so have somewhere ready to save them (your password manager is ideal) before you press the button.
    </div>
    <form method="post" action="/c/<%= token %>" autocomplete="off">
      <label for="pc">Passcode</label>
      <input class="code-in" id="pc" name="passcode" maxlength="12" required autofocus
             autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="••••••">
      <p style="font-size:13px;color:var(--muted);margin:10px 0 16px;">Letters and numbers, no spaces. Capitals don't matter.</p>
      <button class="btn primary" type="submit" id="go">Show my details</button>
    </form>
  </div>
  <script>
    document.getElementById('go').closest('form').addEventListener('submit', function(){
      var b = document.getElementById('go'); b.disabled = true; b.textContent = 'Checking…';
    });
  </script>

<% } else if (mode === 'shown') { %>

  <div class="hero">
    <h1><%= title || 'Your login details' %></h1>
    <p>Here they are. Copy each one into your password manager now — this page will not open again, and refreshing it will lose them.</p>
  </div>

  <div class="card">
    <% items.forEach(function(it, i){ %>
      <div class="cred">
        <h3><%= it.label %></h3>
        <% if (it.url) { %>
        <div class="row">
          <div class="k">Website</div>
          <div class="v"><a href="<%= it.url %>" target="_blank" rel="noopener noreferrer"><%= it.url %></a></div>
          <button class="copy" type="button" data-v="<%= it.url %>">Copy</button>
        </div>
        <% } %>
        <% if (it.username) { %>
        <div class="row">
          <div class="k">Username</div>
          <div class="v"><%= it.username %></div>
          <button class="copy" type="button" data-v="<%= it.username %>">Copy</button>
        </div>
        <% } %>
        <% if (it.password) { %>
        <div class="row">
          <div class="k">Password</div>
          <div class="v pw"><%= it.password %></div>
          <button class="copy" type="button" data-v="<%= it.password %>">Copy</button>
        </div>
        <% } %>
        <% if (it.note) { %><div class="noteline"><%= it.note %></div><% } %>
      </div>
    <% }); %>
    <p style="font-size:13px;color:var(--muted);margin:14px 0 0;">
      Keep these to yourself — we will never ring you and ask for a password. If you think somebody
      else has seen them, tell us on <a href="tel:03333350170" style="color:var(--accent);">0333 3350170</a> and we will change them.
    </p>
  </div>
  <script>
    // Clipboard API needs a secure context; the textarea fallback covers the rest.
    document.querySelectorAll('.copy').forEach(function(b){
      b.addEventListener('click', function(){
        var v = b.getAttribute('data-v') || '';
        var done = function(){ b.classList.add('done'); b.textContent = 'Copied'; setTimeout(function(){ b.classList.remove('done'); b.textContent = 'Copy'; }, 1600); };
        if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(v).then(done, fallback); }
        else fallback();
        function fallback(){
          var t = document.createElement('textarea'); t.value = v; t.style.position='fixed'; t.style.opacity='0';
          document.body.appendChild(t); t.select();
          try { document.execCommand('copy'); done(); } catch(e) { alert('Copy did not work on this browser — select the text and copy it by hand.'); }
          document.body.removeChild(t);
        }
      });
    });
    // Leaving or reloading loses them for good, so say so once.
    var warned = false;
    window.addEventListener('beforeunload', function(e){ if (!warned) { warned = true; e.preventDefault(); e.returnValue = ''; } });
  </script>

<% } else { var m = modeText[mode] || modeText.missing; %>

  <div class="card" style="text-align:center;padding:44px 24px;">
    <div style="font-size:38px;line-height:1;margin-bottom:12px;">🔒</div>
    <h1 style="margin:0 0 10px;font-size:21px;"><%= m.h %></h1>
    <p style="color:var(--muted);margin:0 auto 22px;max-width:46ch;"><%= m.p %></p>
    <a class="btn" href="mailto:sp@lumenmsp.co.uk?subject=New%20credentials%20link%20please">Email us for a new link</a>
  </div>

<% } %>

  <div class="foot">
    Lumen IT Solutions Limited · Gemini House, Hargreaves Road, Groundwell Industrial Estate, Swindon SN25 5AZ<br>
    Registered in England and Wales, company number 14951068 · <a href="https://www.lumenmsp.co.uk">www.lumenmsp.co.uk</a>
  </div>

</div>
</body>
</html>
