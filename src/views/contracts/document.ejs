<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title><%= contract.contract_number %></title>
<style>
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:Arial,Helvetica,sans-serif; font-size:11.5px; color:#374151; background:#fff; line-height:1.55; }
  .page { padding:26mm 18mm 22mm; position:relative; }
  .page + .page { page-break-before:always; }
  h1 { font-size:22px; color:#111827; font-weight:700; }
  h2 { font-size:15px; color:#0f766e; font-weight:700; margin:20px 0 7px; padding-bottom:4px; border-bottom:1.5px solid #99f6e4; }
  h3 { font-size:12.5px; color:#111827; font-weight:700; margin:13px 0 5px; }
  p { margin:0 0 8px; }
  ul { margin:0 0 9px 17px; } li { margin:0 0 3px; }
  table { border-collapse:collapse; width:100%; margin:7px 0 12px; font-size:11px; }
  th { background:#f0fdfa; color:#115e59; text-align:left; font-size:9.5px; text-transform:uppercase; letter-spacing:.05em; padding:6px 8px; border:1px solid #ccfbf1; }
  td { padding:6px 8px; border:1px solid #e5e7eb; vertical-align:top; }
  td.r, th.r { text-align:right; }
  .muted { color:#6b7280; }
  .conf { text-align:center; font-size:11px; letter-spacing:.22em; color:#9ca3af; text-transform:uppercase; margin-bottom:60px; }
  .cover-title { text-align:center; margin:70px 0 40px; }
  .cover-title .sub { font-size:13px; color:#6b7280; margin-top:8px; }
  .to { margin-top:70px; font-size:12px; }
  .to .lbl { font-size:9.5px; text-transform:uppercase; letter-spacing:.05em; color:#9ca3af; margin-bottom:5px; }
  .parties { display:table; width:100%; table-layout:fixed; }
  .party { display:table-cell; width:50%; padding-right:14px; vertical-align:top; }
  .party dl { margin:0; } .party dt { font-size:9px; text-transform:uppercase; letter-spacing:.05em; color:#9ca3af; margin-top:7px; }
  .party dd { margin:1px 0 0; font-size:11.5px; color:#111827; }
  .term-box { background:#f0fdfa; border:1px solid #ccfbf1; border-radius:6px; padding:11px 14px; margin:8px 0 4px; }
  .sig-grid { display:table; width:100%; margin-top:14px; }
  .sig { display:table-cell; width:50%; padding-right:18px; vertical-align:top; }
  .sig .box { border:1px solid #d1d5db; border-radius:6px; padding:12px 14px; min-height:118px; }
  .sig .mark { font-family:'Segoe Script','Brush Script MT',cursive; font-size:25px; color:#0f766e; margin:5px 0 7px; min-height:32px; }
  .sig .line { border-bottom:1px solid #9ca3af; height:24px; margin:5px 0 3px; }
  .sig .cap { font-size:9px; text-transform:uppercase; letter-spacing:.05em; color:#9ca3af; }
  .audit { margin-top:9px; font-size:9.5px; color:#6b7280; background:#f9fafb; border:1px solid #f3f4f6; border-radius:5px; padding:8px 10px; }
  .audit code { font-family:'Courier New',monospace; font-size:9px; word-break:break-all; }
  .foot { position:fixed; bottom:9mm; left:18mm; right:18mm; font-size:8.5px; color:#9ca3af; text-align:center; border-top:1px solid #f3f4f6; padding-top:5px; }
  .draft { position:fixed; top:44%; left:0; right:0; text-align:center; font-size:78px; font-weight:700; color:rgba(15,118,110,.07); transform:rotate(-24deg); letter-spacing:.09em; }
</style></head><body>
<%
  function d(x){ return x ? new Date(x).toLocaleDateString('en-GB',{day:'2-digit',month:'2-digit',year:'numeric'}) : '—'; }
  function dl(x){ return x ? new Date(x).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) : '—'; }
  function m(v){ return '£' + (Number(v)||0).toFixed(2); }
  function esc(t){ return String(t==null?'':t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  // Section bodies use blank-line paragraphs and "- " bullets.
  function body(txt){
    var out='', buf=[];
    function flush(){ if(buf.length){ out += '<ul>' + buf.map(function(b){ return '<li>'+esc(b)+'</li>'; }).join('') + '</ul>'; buf=[]; } }
    String(txt||'').split(/\n/).forEach(function(raw){
      var t=raw.trim();
      if(t.indexOf('- ')===0){ buf.push(t.slice(2)); return; }
      flush();
      if(t) out += '<p>'+esc(t)+'</p>';
    });
    flush(); return out;
  }
  var addr = [customer.address_line_1, customer.address_line_2, customer.city, customer.county].filter(Boolean);
  var svc = serviceContacts.map(function(c){ return c.full_name + (c.job_title ? ' — ' + c.job_title : ''); }).join('<br>');
  var isDraft = contract.sign_status !== 'countersigned';
%>
<% if (isDraft && typeof watermark !== 'undefined' && watermark) { %><div class="draft">DRAFT</div><% } %>
<div class="foot"><%= supplier.legalName %> — <%= supplier.address %>, <%= supplier.postcode %> — <%= supplier.web %> — <%= supplier.phone %></div>

<!-- ── Cover ───────────────────────────────────────────────────────── -->
<div class="page">
  <div class="conf">Strictly Confidential</div>
  <div class="cover-title">
    <h1>Multi Product — Service Contract</h1>
    <div class="sub"><%= dl(contract.start_date) %></div>
    <div class="sub" style="margin-top:4px;"><%= contract.contract_number %> · Version <%= contract.version || 1 %></div>
  </div>
  <div class="to">
    <div class="lbl">To</div>
    <strong style="font-size:14px;color:#111827;"><%= customer.customer_name || '—' %></strong><br>
    <span class="muted"><%= addr.join(', ') %><% if (customer.postcode) { %>, <%= customer.postcode %><% } %></span>
  </div>
</div>

<!-- ── Change control + confidential statement ──────────────────────── -->
<div class="page">
  <h2>Document change control</h2>
  <p class="muted">The following is the document control for revisions to this document.</p>
  <table>
    <thead><tr><th style="width:14%;">Version</th><th style="width:20%;">Date of issue</th><th style="width:22%;">Type</th><th>Description of change</th></tr></thead>
    <tbody>
      <% changeControl.forEach(function(r){ %>
        <tr><td>V<%= r.version %>.0</td><td><%= d(r.generated_at) %></td><td class="muted"><%= (r.kind||'agreement').charAt(0).toUpperCase()+(r.kind||'agreement').slice(1) %></td><td><%= r.change_summary || r.title || '—' %></td></tr>
      <% }); %>
    </tbody>
  </table>
  <% var confSec = sections.filter(function(s){ return s.key==='confidential'; })[0]; %>
  <% if (confSec) { %><h2>Confidential statement</h2><%- body(confSec.body) %><% } %>

  <h2>Introduction</h2>
  <% var intro = sections.filter(function(s){ return s.key==='introduction'; })[0]; %>
  <% if (intro) { %><%- body(intro.body) %><% } %>

  <h2>Parties</h2>
  <p>This contract is between the following parties.</p>
  <div class="parties">
    <div class="party">
      <h3>The Client</h3>
      <dl>
        <dt>Legal name</dt><dd><%= customer.customer_name || '—' %></dd>
        <dt>Address</dt><dd><%= addr.length ? addr.join(', ') : '—' %></dd>
        <dt>Postcode</dt><dd><%= customer.postcode || '—' %></dd>
        <dt>Service contact</dt><dd><%- svc || '—' %></dd>
      </dl>
    </div>
    <div class="party">
      <h3>The Supplier</h3>
      <dl>
        <dt>Legal name</dt><dd><%= supplier.legalName %></dd>
        <dt>Address</dt><dd><%= supplier.address %></dd>
        <dt>Postcode</dt><dd><%= supplier.postcode %></dd>
        <dt>Service contact</dt><dd><%= supplier.serviceContact %></dd>
      </dl>
    </div>
  </div>

  <h2>Agreement term</h2>
  <div class="term-box">
    <strong>Start date:</strong> <%= dl(contract.start_date) %><br>
    <strong>Term:</strong> <%= contract.term_months || '—' %> months<% if (contract.end_date) { %> (to <%= dl(contract.end_date) %>)<% } %><br>
    <strong>Renewals:</strong>
    <% if (contract.renewal_mode === 'signed_extension') { %>
      Renewed only by a signed extension. <%= contract.notice_days %> days' notice.
    <% } else { %>
      Automatically renewed unless <%= contract.notice_days %> days' notice is provided.
    <% } %>
  </div>
  <% if (terms && terms.length > 1) { %>
    <h3>Term history</h3>
    <table>
      <thead><tr><th>#</th><th>From</th><th>To</th><th>Months</th><th>How agreed</th></tr></thead>
      <tbody><% terms.forEach(function(t){ %>
        <tr><td><%= t.seq %></td><td><%= d(t.start_date) %></td><td><%= d(t.end_date) %></td><td><%= t.months %></td>
            <td class="muted"><%= String(t.source||'').replace(/_/g,' ') %><% if (t.signed_at) { %> · signed <%= d(t.signed_at) %><% } %></td></tr>
      <% }); %></tbody>
    </table>
  <% } %>
</div>

<!-- ── Services ────────────────────────────────────────────────────── -->
<div class="page">
  <h2>Services subscribed to</h2>
  <% if (!groups.length) { %><p class="muted">No services have been added to this contract yet.</p><% } %>
  <% groups.forEach(function(g){ %>
    <h3><%= g.title %></h3>
    <% if (g.intro) { %><p><strong><%= g.intro %></strong></p><% } %>
    <% if (g.bullets && g.bullets.length) { %><ul><% g.bullets.forEach(function(b){ %><li><%= b %></li><% }); %></ul><% } %>
    <table>
      <thead><tr><th>Item</th><th class="r" style="width:9%;">Qty</th><th class="r" style="width:16%;">Unit price</th><th style="width:14%;">Billing</th><th class="r" style="width:16%;">Total</th></tr></thead>
      <tbody>
        <% g.lines.forEach(function(l){ %>
          <tr>
            <td><%= l.description %><% if (l.detail) { %><br><span class="muted"><%= l.detail %></span><% } %>
              <% if (l.term_start || l.term_end) { %><br><span class="muted">Term <%= d(l.term_start) %> – <%= d(l.term_end) %><% if (l.notice_days) { %>, <%= l.notice_days %> day notice<% } %></span><% } %></td>
            <td class="r"><%= Number(l.quantity) %></td>
            <td class="r"><%= m(l.unit_price) %></td>
            <td class="muted"><%= String(l.billing_frequency||'').replace(/_/g,' ') %></td>
            <td class="r"><%= m(l.line_total) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% }); %>
  <table style="margin-top:14px;">
    <tbody>
      <tr><td><strong>Total monthly</strong></td><td class="r"><strong><%= m(totals.monthly) %></strong></td></tr>
      <% if (totals.annual) { %><tr><td>Total annual</td><td class="r"><%= m(totals.annual) %></td></tr><% } %>
      <% if (totals.oneOff) { %><tr><td>One-off</td><td class="r"><%= m(totals.oneOff) %></td></tr><% } %>
      <tr><td><strong>Annualised value</strong></td><td class="r"><strong><%= m(totals.annualised) %></strong></td></tr>
    </tbody>
  </table>
</div>

<!-- ── Terms & conditions ──────────────────────────────────────────── -->
<div class="page">
  <% sections.filter(function(s){ return ['confidential','introduction'].indexOf(s.key) === -1; }).forEach(function(s){ %>
    <h2><%= s.heading %></h2>
    <%- body(s.body) %>
  <% }); %>
</div>

<!-- ── Signatures ──────────────────────────────────────────────────── -->
<div class="page">
  <h2>Signatures</h2>
  <p>This contract is between <strong><%= customer.customer_name || '—' %></strong> and <strong><%= supplier.legalName %></strong>.</p>
  <div class="sig-grid">
    <div class="sig">
      <h3>Signed on behalf of the client</h3>
      <div class="box">
        <% if (contract.client_signed_at) { %>
          <div class="mark"><%- contract.client_signature_svg || esc(contract.client_sign_name) %></div>
          <div><strong><%= contract.client_sign_name %></strong></div>
          <div class="muted"><%= contract.client_sign_position || '' %></div>
          <div class="muted" style="margin-top:5px;">Signed <%= dl(contract.client_signed_at) %></div>
        <% } else { %>
          <div class="cap">Name</div><div class="line"></div>
          <div class="cap">Position</div><div class="line"></div>
          <div class="cap">Signature</div><div class="line"></div>
          <div class="cap">Date</div><div class="line"></div>
        <% } %>
      </div>
    </div>
    <div class="sig">
      <h3>Signed on behalf of the supplier</h3>
      <div class="box">
        <% if (contract.supplier_signed_at) { %>
          <div class="mark"><%- contract.supplier_signature_svg || esc(contract.supplier_sign_name) %></div>
          <div><strong><%= contract.supplier_sign_name %></strong></div>
          <div class="muted"><%= contract.supplier_sign_position || 'Managing Director' %></div>
          <div class="muted" style="margin-top:5px;">Signed <%= dl(contract.supplier_signed_at) %></div>
        <% } else { %>
          <div><strong><%= supplier.serviceContact %></strong></div>
          <div class="cap" style="margin-top:9px;">Signature</div><div class="line"></div>
          <div class="cap">Date</div><div class="line"></div>
        <% } %>
      </div>
    </div>
  </div>

  <% if (contract.client_signed_at) { %>
    <div class="audit">
      <strong>Signature audit</strong><br>
      Signed by <%= contract.client_sign_name %><% if (contract.client_sign_email) { %> (<%= contract.client_sign_email %>)<% } %>
      on <%= new Date(contract.client_signed_at).toLocaleString('en-GB') %><% if (contract.client_sign_ip) { %> from <%= contract.client_sign_ip %><% } %>.<br>
      <% if (contract.client_sign_user_agent) { %>Device: <%= contract.client_sign_user_agent %><br><% } %>
      <% if (typeof documentHash !== 'undefined' && documentHash) { %>Document SHA-256: <code><%= documentHash %></code><% } %>
    </div>
  <% } %>
</div>
</body></html>
