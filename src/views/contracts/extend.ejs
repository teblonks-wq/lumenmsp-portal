<%- include('../partials/header', { title: 'Extend contract', user }) %>
<% function dd(x){ return x ? new Date(x).toLocaleDateString('en-GB') : '—'; } %>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/contracts/<%= contract.id %>">← Back to contract</a></p>
  <h1 style="margin:0;">Extend contract</h1>
  <p class="muted" style="margin:4px 0 0;"><%= contract.contract_number %> · <%= contract.title %><% if (contract.customer_name) { %> · <%= contract.customer_name %><% } %></p>
</div>

<% if (err) { %><div class="alert alert-error" style="max-width:820px;margin-bottom:14px;"><%= err %></div><% } %>

<form method="post" action="/contracts/<%= contract.id %>/extend" style="max-width:820px;">
  <div class="card">
    <div class="card-header"><h2>Current term</h2></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;font-size:13px;">
      <div><span class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Started</span><br><%= dd(contract.start_date) %></div>
      <div><span class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Ends</span><br><%= dd(contract.end_date) %></div>
      <div><span class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Length</span><br><%= contract.term_months || '—' %> months</div>
      <div><span class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Notice</span><br><%= contract.notice_days %> days</div>
      <div><span class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Terms so far</span><br><%= terms.length || 1 %></div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Length of extension</h2></div>
    <div id="lenPicker" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
      <% [12, 24, 36].forEach(function(m){ %>
        <label class="len-opt" style="flex:1;min-width:130px;border:1px solid var(--line);border-radius:10px;padding:12px 14px;cursor:pointer;display:block;">
          <input type="radio" name="months" value="<%= m %>" <%= m === defaultMonths ? 'checked' : '' %> style="margin-right:7px;">
          <strong><%= m %> months</strong>
          <span class="muted" style="display:block;font-size:11.5px;margin-top:2px;"><%= m/12 %> year<%= m === 12 ? '' : 's' %></span>
        </label>
      <% }); %>
      <label class="len-opt" style="flex:1;min-width:130px;border:1px solid var(--line);border-radius:10px;padding:12px 14px;cursor:pointer;display:block;">
        <input type="radio" name="months" value="custom" style="margin-right:7px;">
        <strong>Custom</strong>
        <input class="input" type="number" name="custom_months" id="customMonths" min="1" max="120" placeholder="months"
               style="width:100%;margin-top:5px;font-size:13px;" disabled>
      </label>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div class="form-group" style="margin:0;">
        <label>Extension starts</label>
        <input class="input" type="date" name="start_date" id="xStart" value="<%= suggestedStart %>" required>
        <p class="muted" style="font-size:11.5px;margin:4px 0 0;">Defaults to the day after the current term ends.</p>
      </div>
      <div class="form-group" style="margin:0;">
        <label>Extension ends</label>
        <input class="input" type="date" name="end_date" id="xEnd">
        <p class="muted" style="font-size:11.5px;margin:4px 0 0;">Calculated from the length — override if you need to.</p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>How is it being agreed?</h2></div>
    <label style="display:flex;gap:9px;align-items:flex-start;margin-bottom:11px;cursor:pointer;">
      <input type="radio" name="source" value="signed_extension" checked style="margin-top:3px;">
      <span><strong>Signed extension</strong><br><span class="muted" style="font-size:12.5px;">Produces an extension document continuing the agreement on the same terms, which the customer signs. You will go straight to the review &amp; send screen.</span></span>
    </label>
    <label style="display:flex;gap:9px;align-items:flex-start;cursor:pointer;">
      <input type="radio" name="source" value="auto_renew" style="margin-top:3px;">
      <span><strong>Auto-renewed — record only</strong><br><span class="muted" style="font-size:12.5px;">The term rolled under the existing notice clause. Records the new term for the audit trail; nothing is sent and no signature is asked for.</span></span>
    </label>
    <div class="form-group" style="margin:14px 0 0;">
      <label>Note <span class="muted" style="font-weight:400;">(optional)</span></label>
      <input class="input" name="notes" placeholder="e.g. agreed on call with the FD, 12 July" style="width:100%;">
    </div>
  </div>

  <div style="display:flex;gap:10px;">
    <button class="btn btn-primary" type="submit">Extend contract</button>
    <a class="btn" href="/contracts/<%= contract.id %>">Cancel</a>
  </div>
</form>

<script>
  (function(){
    var picker = document.getElementById('lenPicker');
    var custom = document.getElementById('customMonths');
    var start = document.getElementById('xStart'), end = document.getElementById('xEnd');
    function months(){
      var sel = picker.querySelector('input[name="months"]:checked');
      if (!sel) return NaN;
      return sel.value === 'custom' ? parseInt(custom.value, 10) : parseInt(sel.value, 10);
    }
    function derive(){
      var m = months();
      if (isNaN(m) || m < 1 || !start.value) { end.value = ''; return; }
      var d = new Date(start.value + 'T00:00:00Z'), day = d.getUTCDate();
      d.setUTCMonth(d.getUTCMonth() + m);
      if (d.getUTCDate() < day) d.setUTCDate(0);
      d.setUTCDate(d.getUTCDate() - 1);
      end.value = d.toISOString().slice(0, 10);
    }
    picker.addEventListener('change', function(){
      var sel = picker.querySelector('input[name="months"]:checked');
      custom.disabled = !(sel && sel.value === 'custom');
      if (!custom.disabled) custom.focus();
      derive();
    });
    custom.addEventListener('input', derive);
    start.addEventListener('change', derive);
    derive();
  })();
</script>

<%- include('../partials/footer') %>
