<%- include('../partials/header', { title: contract && contract.id ? 'Edit contract' : 'New contract', user }) %>
<% var isEdit = contract && contract.id; %>
<% function v(f){ return contract && contract[f] != null ? contract[f] : ''; } %>
<% function dateVal(f){ if(!contract || !contract[f]) return ''; try { return new Date(contract[f]).toISOString().slice(0,10); } catch(e){ return contract[f]; } } %>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="<%= isEdit ? '/contracts/' + contract.id : '/contracts' %>">← Back</a></p>
  <h1><%= isEdit ? 'Edit contract' : 'New contract' %></h1>
</div>

<% if (error) { %><div class="alert alert-error" style="max-width:900px;"><%= error %></div><% } %>
<% if (typeof msg !== 'undefined' && msg) { %><div class="alert alert-success" style="max-width:900px;"><%= msg %></div><% } %>

<form method="post" action="<%= isEdit ? '/contracts/' + contract.id : '/contracts' %>">
  <div class="card">
    <div class="card-header"><h2>Details</h2></div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
      <div class="form-group" style="grid-column:1 / -1;"><label>Title *</label><input class="input" name="title" required value="<%= v('title') %>"></div>
      <div class="form-group"><label>Customer</label>
        <select class="input" name="customer_id"><option value="">— none —</option><% customers.forEach(function(c){ %><option value="<%= c.id %>" <%= (contract && contract.customer_id===c.id)||(preselectCustomer===c.id)?'selected':'' %>><%= c.name %></option><% }); %></select>
      </div>
      <div class="form-group"><label>Status</label><select class="input" name="status"><% ['draft','active','expired','cancelled'].forEach(function(s){ %><option value="<%= s %>" <%= v('status')===s?'selected':'' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% }); %></select></div>
      <div class="form-group"><label>Service type</label><select class="input" name="service_type"><% ['IT','Cloud','Comms','Hardware'].forEach(function(s){ %><option value="<%= s %>" <%= v('service_type')===s?'selected':'' %>><%= s %></option><% }); %></select></div>
      <div class="form-group"><label>Start date</label><input class="input" type="date" name="start_date" id="startDate" value="<%= dateVal('start_date') %>"></div>
      <div class="form-group"><label>Term (months)</label>
        <input class="input" type="number" name="term_months" id="termMonths" min="1" max="120"
               value="<%= contract && contract.term_months != null ? contract.term_months : 12 %>">
      </div>
      <div class="form-group"><label>End date <span class="muted" style="font-weight:400;">— follows the term unless you set it</span></label>
        <input class="input" type="date" name="end_date" id="endDate" value="<%= dateVal('end_date') %>">
      </div>
      <div class="form-group"><label>Support cover</label>
        <select class="input" name="support_cover">
          <% [['business','Business hours — 09:00–17:00, Mon–Fri'],
              ['extended','Extended hours — 08:00–18:00, Mon–Fri'],
              ['always','24/7 — round the clock, every day']].forEach(function(o){ %>
            <option value="<%= o[0] %>" <%= ((contract && contract.support_cover) || 'business') === o[0] ? 'selected' : '' %>><%= o[1] %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group"><label>Renewal</label>
        <select class="input" name="renewal_mode">
          <option value="auto" <%= (!contract || contract.renewal_mode !== 'signed_extension') ? 'selected' : '' %>>Auto-renew unless notice is given</option>
          <option value="signed_extension" <%= (contract && contract.renewal_mode === 'signed_extension') ? 'selected' : '' %>>Signed extension required</option>
        </select>
      </div>
      <div class="form-group"><label>Notice (days)</label><input class="input" type="number" name="notice_days" value="<%= contract && contract.notice_days!=null ? contract.notice_days : 30 %>"></div>
      <div class="form-group"><label>Payment method</label><select class="input" name="payment_method"><% ['upfront','delivery','direct_debit'].forEach(function(s){ %><option value="<%= s %>" <%= v('payment_method')===s?'selected':'' %>><%= s.replace('_',' ') %></option><% }); %></select></div>
      <label style="display:flex;align-items:center;gap:8px;font-weight:500;"><input type="checkbox" name="auto_renew" <%= (!contract || contract.auto_renew) ? 'checked' : '' %>> Auto-renew</label>
    </div>
  </div>

  <div class="card" style="padding:0;">
    <div class="card-header" style="padding:20px 24px 0;"><h2>Contract lines</h2></div>
    <div class="table-wrap">
      <table class="table" id="itemsTable">
        <thead><tr><th style="min-width:230px;">Service</th><th style="width:120px;">Section</th><th style="text-align:right;">Qty</th><th style="text-align:right;">Unit £</th><th>Billing</th><th style="text-align:right;">Line £</th><th></th></tr></thead>
        <tbody id="itemsBody">
          <% var rows = (lines && lines.length) ? lines : [{}]; %>
          <% rows.forEach(function(l){ %>
            <tr class="item-row">
              <td>
                <input type="hidden" name="product_id[]" class="prod-id" value="<%= l.product_id || '' %>">
                <div style="display:flex;gap:6px;align-items:center;">
                  <input class="input prod-search" name="desc[]" list="catList" placeholder="Search the service list, or type a description…" value="<%= l.description || '' %>" style="flex:1;" autocomplete="off">
                  <button type="button" class="btn more-toggle" title="Note and licence term for this line"
                          style="flex:none;padding:5px 9px;font-size:12px;line-height:1;">⋯</button>
                </div>
                <%
                  var hasExtra = l.detail || l.term_start || l.term_end || l.notice_days;
                  function dv(x){ if(!x) return ''; try { return new Date(x).toISOString().slice(0,10); } catch(e){ return ''; } }
                %>
                <!-- A licence or backup block carries its own annual term, which need not line up
                     with the contract term (Staybrook: contract 01/08, licences 01/07). -->
                <div class="line-extra" style="<%= hasExtra ? '' : 'display:none;' %>margin-top:7px;padding:9px 11px;background:var(--surface-2);border:1px solid var(--line);border-radius:8px;">
                  <input class="input" name="detail[]" value="<%= l.detail || '' %>" placeholder="Note shown under the item, e.g. 5 devices covered · unlimited storage" style="width:100%;font-size:12.5px;">
                  <div style="display:flex;gap:8px;margin-top:7px;flex-wrap:wrap;align-items:end;">
                    <label style="font-size:11px;color:var(--muted);flex:1;min-width:120px;">Licence term from
                      <input class="input" type="date" name="line_term_start[]" value="<%= dv(l.term_start) %>" style="width:100%;font-size:12.5px;"></label>
                    <label style="font-size:11px;color:var(--muted);flex:1;min-width:120px;">to
                      <input class="input" type="date" name="line_term_end[]" value="<%= dv(l.term_end) %>" style="width:100%;font-size:12.5px;"></label>
                    <label style="font-size:11px;color:var(--muted);width:104px;">Notice (days)
                      <input class="input" type="number" name="line_notice[]" min="0" value="<%= l.notice_days != null ? l.notice_days : '' %>" style="width:100%;font-size:12.5px;"></label>
                  </div>
                </div>
              </td>
              <td><select class="input sect" name="section[]"><% ['IT','Cloud','Backup','Comms','Hardware'].forEach(function(sc){ %><option value="<%= sc %>" <%= (l.section||'IT')===sc?'selected':'' %>><%= sc %></option><% }); %></select></td>
              <td><input class="input num-qty" name="qty[]" type="number" step="0.01" value="<%= l.quantity!=null ? Number(l.quantity) : 1 %>" style="width:80px;text-align:right;"></td>
              <td><input class="input num-price" name="price[]" type="number" step="0.01" value="<%= l.unit_price!=null ? Number(l.unit_price) : '' %>" style="width:100px;text-align:right;"></td>
              <td><select class="input freq" name="freq[]"><% ['monthly','annual','one_off'].forEach(function(f){ %><option value="<%= f %>" <%= l.billing_frequency===f?'selected':'' %>><%= f.replace('_',' ') %></option><% }); %></select></td>
              <td style="text-align:right;" class="line-total">£0.00</td>
              <td><button type="button" class="btn remove-row">✕</button></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div style="padding:12px 24px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <button type="button" class="btn" id="addRow">+ Add line</button>
        <input class="input" id="catSearch" list="catList" placeholder="Add from the service list…" style="min-width:230px;">
        <datalist id="catList"></datalist>
        <button type="button" class="btn" id="addFromCat">+ From service list</button>
      </div>
      <div style="text-align:right;font-size:14px;">
        <div class="muted">Monthly: <span id="sumMonthly">£0.00</span> · Annual: <span id="sumAnnual">£0.00</span> · One-off: <span id="sumOneOff">£0.00</span></div>
        <div style="font-weight:700;font-size:16px;">Annualised: <span id="sumAnnualised">£0.00</span></div>
      </div>
    </div>
  </div>

  <div class="card"><div class="card-header"><h2>Notes</h2></div><textarea class="input" name="notes" rows="4" style="width:100%;"><%= v('notes') %></textarea></div>

  <div style="display:flex;gap:10px;">
    <button class="btn btn-primary" type="submit"><%= isEdit ? 'Save contract' : 'Create contract' %></button>
    <a class="btn" href="<%= isEdit ? '/contracts/' + contract.id : '/contracts' %>">Cancel</a>
  </div>
</form>

<script>
  // Dates: the term drives the end date, but a typed end date is never overwritten -- the
  // dates can be overridden right up to the point of sending.
  (function () {
    var start = document.getElementById('startDate'), term = document.getElementById('termMonths'), end = document.getElementById('endDate');
    if (!start || !term || !end) return;
    var manual = !!end.value;
    end.addEventListener('input', function(){ manual = true; });
    function derive(){
      if (manual || !start.value) return;
      var m = parseInt(term.value, 10); if (isNaN(m) || m < 1) return;
      var d = new Date(start.value + 'T00:00:00Z'), day = d.getUTCDate();
      d.setUTCMonth(d.getUTCMonth() + m);
      if (d.getUTCDate() < day) d.setUTCDate(0);
      d.setUTCDate(d.getUTCDate() - 1);
      end.value = d.toISOString().slice(0, 10);
    }
    start.addEventListener('change', derive); term.addEventListener('input', derive);
    derive();
  })();
  (function () {
    var body = document.getElementById('itemsBody');
    function money(x){ return '£' + (isNaN(x)?0:x).toFixed(2); }
    function recalc(){
      var mo=0, an=0, oo=0;
      body.querySelectorAll('.item-row').forEach(function(row){
        var q = parseFloat(row.querySelector('.num-qty').value) || 0;
        var p = parseFloat(row.querySelector('.num-price').value) || 0;
        var f = row.querySelector('.freq').value;
        var line = q * p;
        row.querySelector('.line-total').textContent = money(line);
        if (f === 'monthly') mo += line; else if (f === 'annual') an += line; else oo += line;
      });
      document.getElementById('sumMonthly').textContent = money(mo);
      document.getElementById('sumAnnual').textContent = money(an);
      document.getElementById('sumOneOff').textContent = money(oo);
      document.getElementById('sumAnnualised').textContent = money(mo*12 + an);
    }
    function addRow(){
      var clone = body.querySelector('.item-row').cloneNode(true);
      clone.querySelectorAll('input').forEach(function(i){ if (i.classList.contains('num-qty')) i.value = 1; else i.value = ''; });
      var sc = clone.querySelector('.sect'); if (sc) sc.value = 'IT';
      var ex = clone.querySelector('.line-extra'); if (ex) ex.style.display = 'none';
      body.appendChild(clone);
      return clone;
    }
    document.getElementById('addRow').addEventListener('click', function(){ addRow(); recalc(); });
    // Per-line note and licence term stay tucked away until wanted — most lines never need them.
    body.addEventListener('click', function(e){
      if (!e.target.classList.contains('more-toggle')) return;
      var x = e.target.closest('.item-row').querySelector('.line-extra');
      x.style.display = (x.style.display === 'none' || !x.style.display) ? '' : 'none';
    });
    body.addEventListener('input', recalc);
    body.addEventListener('change', recalc);
    body.addEventListener('click', function(e){
      if (e.target.classList.contains('remove-row')) {
        if (body.querySelectorAll('.item-row').length > 1) e.target.closest('.item-row').remove();
        else e.target.closest('.item-row').querySelectorAll('input').forEach(function(i){ if(!i.classList.contains('num-qty')) i.value=''; });
        recalc();
      }
    });
    var catalogue = [];
    fetch('/products/catalogue.json').then(function(r){ return r.json(); }).then(function(rows){
      catalogue = rows; var dl = document.getElementById('catList');
      rows.forEach(function(p){ var o = document.createElement('option'); o.value = p.name; dl.appendChild(o); });
    }).catch(function(){});
    // Per-row picker: choosing a service from the list fills in its price and links the
    // catalogue product, so the price is not retyped (and reporting stays joined up).
    function guessSection(p){
      var t = ((p.item_type||'') + ' ' + (p.name||'') + ' ' + (p.description||'')).toLowerCase();
      if (/backup|acronis|veeam/.test(t)) return 'Backup';
      if (/365|azure|licence|license|cloud|entra|sharepoint/.test(t)) return 'Cloud';
      if (/voip|sip|call|mobile|broadband|line rental|comms/.test(t)) return 'Comms';
      if (/laptop|desktop|server|hardware|switch|firewall|nas/.test(t)) return 'Hardware';
      return 'IT';
    }
    body.addEventListener('input', function(e){
      if (!e.target.classList.contains('prod-search')) return;
      var row = e.target.closest('.item-row');
      var p = catalogue.find(function(x){ return x.name === e.target.value; });
      if (!p) { row.querySelector('.prod-id').value = ''; return; }
      row.querySelector('.prod-id').value = p.id;
      var price = row.querySelector('.num-price');
      if (!price.value || parseFloat(price.value) === 0) price.value = Number(p.unit_price || 0).toFixed(2);
      row.querySelector('.sect').value = guessSection(p);
      recalc();
    });
    document.getElementById('addFromCat').addEventListener('click', function(){
      var name = document.getElementById('catSearch').value.trim(); if (!name) return;
      var p = catalogue.find(function(x){ return x.name === name; }); if (!p) return;
      var row = addRow();
      row.querySelector('[name="desc[]"]').value = p.description || p.name;
      row.querySelector('.prod-id').value = p.id;
      row.querySelector('.num-price').value = Number(p.unit_price) || 0;
      row.querySelector('.sect').value = guessSection(p);
      document.getElementById('catSearch').value = '';
      recalc();
    });
    recalc();
  })();
</script>

<%- include('../partials/footer') %>
