<%- include('../partials/header', { title: 'Send for signature', user }) %>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/contracts/<%= contract.id %>">← Back to contract</a></p>
  <h1 style="margin:0;">Send for signature</h1>
  <p class="muted" style="margin:4px 0 0;"><%= contract.contract_number %> · <%= contract.title %><% if (contract.customer_name) { %> · <%= contract.customer_name %><% } %></p>
</div>

<% if (err) { %><div class="alert alert-error" style="margin-bottom:14px;"><%= err %></div><% } %>
<% if (typeof msg !== 'undefined' && msg) { %><div class="alert alert-success" style="margin-bottom:14px;"><%= msg %></div><% } %>

<% if (reviewFlags && reviewFlags.length) { %>
  <div class="alert alert-error" style="margin-bottom:14px;">
    <strong>Template wording still needs a decision (<%= reviewFlags.length %>).</strong>
    <ul style="margin:6px 0 0 18px;">
      <% reviewFlags.forEach(function(f){ %><li><strong><%= f.heading %>:</strong> <%= f.note %></li><% }); %>
    </ul>
    <p style="margin:6px 0 0;">You can still send — this is a reminder, not a block.</p>
  </div>
<% } %>

<div style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr);gap:16px;align-items:start;">

  <!-- Preview exactly what the customer will be asked to sign, before it goes anywhere. -->
  <div class="card" style="padding:0;overflow:hidden;">
    <div class="card-header" style="padding:16px 20px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
      <h2 style="margin:0;">Preview</h2>
      <div style="display:flex;gap:8px;">
        <a class="btn" href="/contracts/<%= contract.id %>/document.pdf" target="_blank" style="font-size:12px;padding:4px 10px;">Open in new tab</a>
        <a class="btn" href="/contracts/<%= contract.id %>/document.pdf?dl=1" style="font-size:12px;padding:4px 10px;">Download</a>
      </div>
    </div>
    <iframe src="/contracts/<%= contract.id %>/document.pdf#view=FitH" title="Agreement preview"
            style="width:100%;height:760px;border:0;border-top:1px solid var(--line);display:block;background:var(--surface-2);"></iframe>
  </div>

  <div>
  <!-- Last chance to correct the dates: editable here, and locked once it is signed. -->
  <% var signedOff = contract.sign_status === 'signed' || contract.sign_status === 'countersigned'; %>
  <form method="post" action="/contracts/<%= contract.id %>/dates">
    <input type="hidden" name="back" value="send">
    <div class="card">
      <div class="card-header"><h2><%= docKind === 'extension' ? 'Extension dates' : 'Agreement dates' %></h2></div>
      <% if (signedOff) { %>
        <p class="muted" style="font-size:12.5px;margin:0;">Signed on <%= new Date(contract.client_signed_at).toLocaleDateString('en-GB') %> — the dates are fixed now.</p>
      <% } else { %>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div class="form-group" style="margin:0;"><label>Start date</label>
            <input class="input" type="date" name="start_date" id="sStart"
                   value="<%= contract.start_date ? new Date(contract.start_date).toISOString().slice(0,10) : '' %>"></div>
          <div class="form-group" style="margin:0;"><label>Term (months)</label>
            <input class="input" type="number" name="term_months" id="sTerm" min="1" max="120" value="<%= contract.term_months || 12 %>"></div>
          <div class="form-group" style="margin:0;"><label>End date</label>
            <input class="input" type="date" name="end_date" id="sEnd"
                   value="<%= contract.end_date ? new Date(contract.end_date).toISOString().slice(0,10) : '' %>"></div>
          <div class="form-group" style="margin:0;"><label>Notice (days)</label>
            <input class="input" type="number" name="notice_days" min="0" value="<%= contract.notice_days %>"></div>
        </div>
        <button class="btn" type="submit" style="width:100%;margin-top:10px;">Update dates &amp; refresh preview</button>
      <% } %>
    </div>
  </form>

  <form method="post" action="/contracts/<%= contract.id %>/send">
    <div class="card">
      <div class="card-header"><h2>Recipient</h2></div>
      <div class="form-group">
        <label>Send to</label>
        <input class="input" name="send_to" type="email" list="contactList" required
               value="<%= contract.sent_to || (contacts[0] && contacts[0].email) || '' %>" placeholder="name@company.co.uk">
        <datalist id="contactList">
          <% contacts.forEach(function(c){ if (c.email) { %><option value="<%= c.email %>"><%= c.full_name %><%= c.job_title ? ' — ' + c.job_title : '' %></option><% } }); %>
        </datalist>
        <% if (!contacts.length) { %>
          <p class="muted" style="font-size:12px;margin:6px 0 0;">No primary or service contact is set on this customer. Add one on the customer screen so the agreement names them.</p>
        <% } else { %>
          <p class="muted" style="font-size:12px;margin:6px 0 0;">
            Primary and service contacts: <%= contacts.map(function(c){ return c.full_name; }).join(', ') %>
          </p>
        <% } %>
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
          <span>Message <span class="muted" style="font-weight:400;">(optional)</span></span>
          <!-- Hidden unless Claude is configured, so it never offers something that cannot work. -->
          <button type="button" class="btn" id="ctPolish" style="display:none;font-size:12px;padding:3px 9px;font-weight:500;"
                  title="Rewrites your draft in clear British English — keeps every fact, invents nothing">✨ Improve with Claude</button>
        </label>
        <textarea class="input" id="ctMessage" name="message" rows="5" style="width:100%;" placeholder="Anything you want to say alongside the agreement…"></textarea>
        <p id="ctPolishMsg" class="muted" style="font-size:12px;margin:5px 0 0;min-height:15px;"></p>
      </div>
      <p class="muted" style="font-size:12px;">
        They receive a link that opens the agreement on our site — no login, no account. They can read it,
        download it, print it and sign it there.
      </p>
      <button class="btn btn-primary" type="submit" style="width:100%;">
        <%= contract.sign_status === 'sent' || contract.sign_status === 'viewed' ? 'Resend for signature' : 'Send for signature' %>
      </button>
      <a class="btn" href="/contracts/<%= contract.id %>" style="width:100%;margin-top:8px;text-align:center;">Cancel</a>
    </div>

    <% if (contract.sign_token) { %>
      <div class="card">
        <div class="card-header"><h2>Signing link</h2></div>
        <input class="input" readonly value="<%= appUrl %>/c/<%= contract.sign_token %>" style="width:100%;font-size:12px;"
               onclick="this.select();">
        <p class="muted" style="font-size:12px;margin:6px 0 0;">
          Opened <%= contract.view_count || 0 %> time<%= (contract.view_count||0) === 1 ? '' : 's' %><% if (contract.sent_at) { %> · sent <%= new Date(contract.sent_at).toLocaleString('en-GB') %><% } %>
        </p>
      </div>
    <% } %>
  </form>
  </div>
</div>

<script>
  // Improve with Claude — the same /ai/polish endpoint the rest of the portal uses, so the
  // house rules (British English, preserve every fact, invent nothing) apply here too.
  (function(){
    var btn = document.getElementById('ctPolish');
    var box = document.getElementById('ctMessage');
    var note = document.getElementById('ctPolishMsg');
    if (!btn || !box) return;
    var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    var undo = null;

    // Only show it if Claude is actually set up.
    fetch('/ai/status').then(function(r){ return r.json(); })
      .then(function(j){ if (j && j.configured) btn.style.display = ''; })
      .catch(function(){ /* leave hidden */ });

    btn.addEventListener('click', function(){
      var text = box.value.trim();
      if (!text) { note.style.color = 'var(--warn-fg)'; note.textContent = 'Type a message first.'; return; }
      // Second press puts the original back, so an unwanted rewrite is never a dead end.
      if (undo !== null && btn.dataset.state === 'done') {
        box.value = undo; undo = null; btn.dataset.state = '';
        btn.innerHTML = '✨ Improve with Claude'; note.textContent = ''; return;
      }
      var original = btn.innerHTML;
      btn.disabled = true; btn.innerHTML = '✨ Improving…';
      note.style.color = ''; note.textContent = 'Claude is tidying your draft…';
      fetch('/ai/polish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
        body: JSON.stringify({ text: text })
      }).then(function(r){ return r.json(); }).then(function(j){
        btn.disabled = false;
        if (!j || !j.ok) {
          btn.innerHTML = original;
          note.style.color = 'var(--bad)'; note.textContent = (j && j.error) || 'Improve failed.';
          return;
        }
        undo = text; box.value = j.message;
        btn.dataset.state = 'done'; btn.innerHTML = '↩ Undo';
        note.style.color = 'var(--teal-deep)'; note.textContent = 'Improved — read it before sending.';
      }).catch(function(){
        btn.disabled = false; btn.innerHTML = original;
        note.style.color = 'var(--bad)'; note.textContent = 'Improve failed.';
      });
    });

    box.addEventListener('input', function(){
      // Typing after a rewrite means the undo no longer matches what is on screen.
      if (btn.dataset.state === 'done') { btn.dataset.state = ''; undo = null; btn.innerHTML = '✨ Improve with Claude'; note.textContent = ''; }
    });
  })();

  (function(){
    var start=document.getElementById('sStart'), term=document.getElementById('sTerm'), end=document.getElementById('sEnd');
    if(!start||!term||!end) return;
    var manual=false; end.addEventListener('input',function(){ manual=true; });
    function derive(){
      if(manual||!start.value) return;
      var m=parseInt(term.value,10); if(isNaN(m)||m<1) return;
      var d=new Date(start.value+'T00:00:00Z'), day=d.getUTCDate();
      d.setUTCMonth(d.getUTCMonth()+m);
      if(d.getUTCDate()<day) d.setUTCDate(0);
      d.setUTCDate(d.getUTCDate()-1);
      end.value=d.toISOString().slice(0,10);
    }
    start.addEventListener('change',derive); term.addEventListener('input',derive);
  })();
</script>

<%- include('../partials/footer') %>
