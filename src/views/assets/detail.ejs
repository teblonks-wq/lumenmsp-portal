<style>
  /* Push-the-update button. Only ever rendered when a newer build actually exists, so its
     presence IS the message — an always-visible arrow would train people to ignore it. */
  .agent-up { background:var(--accent); color:#fff; border:none; border-radius:5px;
              cursor:pointer; font-size:12px; font-weight:700; line-height:1;
              padding:3px 7px; vertical-align:middle; }
  .agent-up:hover { background:var(--accent-deep, #0e6377); }
</style>
<%
  // Disk space as a bar, not just a sentence. The agent already reports every volume's
  // size and free space on the heartbeat, so this needs nothing new from the machine.
  // Bars are ABSOLUTE, not scaled to the fullest drive: 90% full has to look the same on
  // every disk or the picture flatters a machine that is about to run out of room.
  function diskList(json){
    if (!json) return [];
    try {
      var list = (typeof json === 'string') ? JSON.parse(json) : json;
      if (!Array.isArray(list)) return [];
      return list.map(function(d){
        var total = Number(d && d.total_gb), free = Number(d && d.free_gb);
        if (!isFinite(total) || total <= 0) return null;
        if (!isFinite(free) || free < 0) free = 0;
        var used = Math.max(0, total - free);
        return { drive: String((d && d.drive) || '?').replace(/\\+$/, ''),
                 total: total, free: free, used: used,
                 pct: Math.min(100, Math.round(used / total * 100)) };
      }).filter(Boolean);
    } catch (e) { return []; }
  }
  // Colour on what is LEFT, not on what is used: 10GB free matters on a 128GB disk and on
  // a 2TB one, and a percentage alone would call the second one healthy.
  function diskColour(d){
    if (d.free < 5 || d.pct >= 95) return 'var(--bad)';
    if (d.free < 20 || d.pct >= 85) return 'var(--warn)';
    return 'var(--accent)';
  }
  function gb(n){ return (n >= 100 ? Math.round(n) : n.toFixed(1)) + ' GB'; }
%>
<%- include('../partials/header', { title: asset.hostname || 'Device', user }) %>
<% function fmt(v){ return (v===null || v===undefined || v==='') ? '—' : v; } %>
<% function dt(v){ return v ? new Date(v).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'; } %>
<% var _ours = (asset.data_source === 'agent') || !!asset.agent_device_id; %>

<style>
  .dev-tabs { display:flex; flex-wrap:wrap; gap:2px; border-bottom:2px solid var(--line); margin:0 0 18px; }
  .dev-tabs button { background:none; border:none; padding:10px 16px; font-size:14px; font-weight:600; color:var(--muted); cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-2px; }
  .dev-tabs button:hover { color:var(--ink); }
  .dev-tabs button.active { color:var(--accent); border-bottom-color:var(--accent); }
  .dev-tab-panel { display:none; }
  .dev-tab-panel.active { display:block; }
  .dev-info-cols { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:0 32px; }
  .dev-field-row { display:grid; grid-template-columns:150px 1fr; gap:10px; padding:9px 0; border-bottom:1px solid var(--surface-3); font-size:13px; }
  .dev-field-row:last-child { border-bottom:none; }
  .dev-field-row .k { color:var(--muted); }
  .dev-field-row .v { font-weight:500; }
  .dev-subcard-title { font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); margin:0 0 6px; }
</style>

<div class="doc-hero" style="--hero-accent:linear-gradient(90deg,var(--accent),var(--blue-bright));">
<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="<%= back %>">← Back</a></p>
    <p class="doc-kicker">Device · <%= asset.device_type || 'Unknown type' %><% if (asset.customer_name) { %> · <%= asset.customer_name %><% } %></p>
    <%
      // The friendly name leads when there is one. This is NOT a rename: the hostname is
      // still shown underneath and is still what the machine calls itself, what the agent
      // reports and what every match in the Portal keys on. This is only what the
      // CUSTOMER calls it — "Cholsey Rec Left" — which is what actually gets said on the
      // phone and therefore what actually gets searched for.
      var _title = asset.friendly_name || asset.hostname || '(unnamed device)';
    %>
    <h1 style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <span id="devTitle"><%= _title %></span>
      <button type="button" class="btn" id="renameBtn" style="padding:2px 9px;font-size:12px;font-weight:600;"
              title="Give this machine the name the customer uses for it. The hostname is not changed.">&#9998; Rename</button>
    </h1>
    <% if (asset.friendly_name && asset.hostname) { %>
      <p class="muted" style="margin:2px 0 0;font-size:12.5px;" title="The machine's actual hostname — unchanged by the friendly name.">Hostname <span style="font-family:ui-monospace,Menlo,Consolas,monospace;"><%= asset.hostname %></span></p>
    <% } %>
    <form method="post" action="/assets/<%= asset.id %>/friendly-name" id="renameForm"
          style="display:none;margin:8px 0 0;gap:6px;align-items:center;flex-wrap:wrap;">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="back" value="<%= back %>">
      <input class="input" name="friendlyName" maxlength="120" style="font-size:13px;padding:5px 9px;min-width:260px;"
             placeholder="e.g. Cholsey Rec Left" value="<%= asset.friendly_name || '' %>">
      <button class="btn btn-primary" type="submit" style="padding:5px 12px;font-size:12px;">Save name</button>
      <button class="btn" type="button" id="renameCancel" style="padding:5px 12px;font-size:12px;">Cancel</button>
      <span class="muted" style="font-size:11.5px;flex-basis:100%;">Searchable everywhere. Clearing it puts the hostname back as the title — the machine itself is never renamed.</span>
    </form>
    <p class="muted" style="margin:6px 0 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <% var _hw = (typeof onlineWindowSecs !== 'undefined' && onlineWindowSecs) ? onlineWindowSecs : 180;
         var _live = !!asset.agent_device_id && typeof agentInfo !== 'undefined' && agentInfo
                     && agentInfo.seen_secs != null && Number(agentInfo.seen_secs) < _hw; %>
      <span title="<%= asset.agent_device_id ? 'Live status from the LumenMSP Agent' : 'No LumenMSP Agent on this machine, so the Portal has no live status for it' %>" style="display:inline-flex;align-items:center;gap:5px;font-weight:600;color:<%= _live ? 'var(--ok)' : 'var(--faint)' %>;">
        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= _live ? 'var(--ok)' : 'var(--line-strong)' %>;"></span>
        <%= _live ? 'Online' : 'Offline' %>
      </span>
      <span class="badge badge-inactive"><%= asset.device_type || 'Device' %></span>
      <% if (typeof agentInfo !== 'undefined' && agentInfo) { %>
      <span title="LumenMSP Agent v<%= agentInfo.agent_version || '?' %> — last seen <%= dt(agentInfo.last_seen_at) %>" style="display:inline-flex;align-items:center;gap:5px;font-weight:600;color:var(--accent);"><img src="/static/img/lumen-agent-16.png" width="14" height="14" alt=""> <a class="row-link" href="/agents" style="color:inherit;">Agent installed</a></span>
      <% } else { %>
      <a class="badge" href="/agents#download" style="background:var(--tint-warn);color:var(--warn-deep);border:1px solid var(--warn-line);text-decoration:none;">agent required</a>
      <% } %>
      <% if (asset.customer_id) { %>· <a class="row-link" href="/customers/<%= asset.customer_id %>#assets"><%= asset.customer_name %></a><% } %>
      <% if (asset.last_login_user) { %>· <span class="muted"><%= asset.last_login_user %></span><% } %>
      <% if (_ours) { %>· <span class="muted" title="The Portal is the master record for this machine — every field on this page is collected by our own agent, not by Atera.">updated <%= dt(asset.synced_at) %></span><% } %>
    </p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <% if (remoteUrl) { %><a class="btn btn-remote" target="_blank" rel="noopener" href="/assets/<%= asset.id %>/remote-mesh">🖥 Remote control</a><% } %>
    <%
      // Reinstall remote control, for a machine MeshCentral still HAS a node for.
      //
      // Every other remote-access control on this page lives inside the banner below,
      // which only renders when there is NO node — so once MeshCentral had a record there
      // was no way to put the agent back. That record is not the machine: Bitdefender
      // quarantining MeshAgent.exe leaves the node standing while remote control is dead.
      // This is the button for that, and it is deliberately quiet — secondary, confirmed,
      // and only where remote access is supposed to be working already.
      var _msTop = (typeof meshState !== 'undefined') ? meshState : null;
    %>
    <% if (user.role === 'admin' && _msTop && _msTop.hasNode && _msTop.deviceId) { %>
    <form method="post" action="/assets/<%= asset.id %>/mesh-install" style="display:inline;"
          onsubmit="return confirm('Reinstall remote control on ' + <%- JSON.stringify(String(asset.hostname || 'this machine')) %> + '?\n\nUse this when MeshCentral says the machine is there but remote control does not actually work — a quarantined or removed Mesh Agent leaves the record behind.\n\nIt runs at the next agent check-in and WILL drop any live session on this machine.');">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="force" value="1">
      <button class="btn" type="submit" title="Push the Mesh Agent back onto this machine — for when the node record is stale but remote control is dead">&#8635; Reinstall remote control</button>
    </form>
    <% } %>
    <% if (!asset.agent_device_id && (user.role === 'admin')) { %>
    <form method="post" action="/assets/<%= asset.id %>/archive" style="display:inline;"
          onsubmit="return confirm('Archive ' + <%- JSON.stringify(String(asset.hostname || 'this device')) %> + '?\n\nUse this for an Atera import of a machine you will never manage. It is hidden from the estate and the Atera sync will NOT bring it back. Reversible from the archived list.');">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="reason" value="not managed">
      <button class="btn" type="submit" style="color:var(--bad-fg);" title="Remove this device from the estate — for Atera imports you will never put an agent on">Archive / remove</button>
    </form>
    <% } %>
    <% if (user.role === 'admin' && typeof agentInfo !== 'undefined' && agentInfo) { %>
    <button type="button" class="btn" id="manageBtn" title="Remote tools for this device - every one opens right here">&#128736; Manage &#9662;</button>
    <% } %>
    <% if (asset.agent_device_id) { %>
    <div class="pw-wrap" style="position:relative;display:inline-block;">
      <button type="button" class="btn pw-btn" <%= (typeof powerPending !== 'undefined' && powerPending) ? 'style="border-color:var(--warn-line);"' : '' %>
              data-id="<%= asset.agent_device_id %>" data-host="<%= asset.hostname || '' %>"
              data-user="<%= (typeof agentInfo !== 'undefined' && agentInfo) ? (agentInfo.logged_in_user || '') : '' %>"
              data-live="<%= _live ? '1' : '' %>" data-pending="<%= (typeof powerPending !== 'undefined' && powerPending) ? '1' : '' %>"
              data-pending-info="<%= (typeof powerPendingText !== 'undefined' && powerPendingText) ? powerPendingText : '' %>"
              data-strict="<%= (typeof serverFacts !== 'undefined' && serverFacts) ? '1' : '' %>"
              title="Sign out, restart or shut down">⏻ Power ▾</button>
    </div>
    <% } %>
  </div>
</div>
<%
  // The device's vitals as one strip - status, patching, security, backup, agent - so an
  // engineer reads the machine's state before scrolling an inch. Every figure is the same
  // source the tabs below use; nothing here is a second opinion.
  var _ai = (typeof agentInfo !== 'undefined') ? agentInfo : null;
  var _sec = (typeof security !== 'undefined') ? security : null;
  var _bp = (typeof backupPlans !== 'undefined' && backupPlans) ? backupPlans : [];
  var _bpFailed = _bp.filter(function(p){ return p.cls === 'failed'; }).length;
  var _patchN = _ai && _ai.patch_pending != null ? Number(_ai.patch_pending) : null;
  var _reboot = !!(_ai && _ai.reboot_required);
%>
<% if (_ai) { %>
<div class="doc-stats">
  <div class="ds">
    <div class="n <%= _live ? 'good' : '' %>"><%= _live ? 'Online' : 'Offline' %></div>
    <div class="l"><%= _live ? 'agent checked in' : ('last seen ' + (_ai.last_seen_at ? dt(_ai.last_seen_at) : 'never')) %></div>
  </div>
  <div class="ds">
    <div class="n <%= (_patchN != null && _patchN > 0) || _reboot ? 'warn' : (_patchN === 0 ? 'good' : '') %>"><%= _patchN != null ? _patchN : '—' %><% if (_reboot) { %> <small style="font-size:12px;font-weight:700;color:var(--warn-fg);">restart due</small><% } %></div>
    <div class="l">updates pending</div>
  </div>
  <div class="ds">
    <% if (_sec && !_sec.awaiting) { var _secBadN = _sec.rows.filter(function(r){ return !r.ok; }).length; %>
    <div class="n <%= _secBadN ? 'bad' : 'good' %>"><%= _secBadN ? _secBadN + ' issue' + (_secBadN===1?'':'s') : 'Protected' %></div>
    <div class="l">security</div>
    <% } else { %>
    <div class="n" style="font-size:15px;line-height:1.5;color:var(--muted);">awaiting agent</div>
    <div class="l">security</div>
    <% } %>
  </div>
  <%
    // Bitdefender gets its own vital, and it is a LINK. Terry looked for the deploy
    // button repeatedly without finding it, and a state buried three tabs down might as
    // well not exist. This is the shortest route from "open a machine" to "install AV
    // on it".
    var _bd = (typeof bd !== 'undefined') ? bd : null;
    var _bdWord = { 'protected':'Protected', 'infected':'INFECTED', 'installed':'Installed',
                    'queued':'Queued', 'running':'Installing', 'failed':'Failed',
                    'excluded':'Held back', 'no-agent':'No agent', 'not-deployed':'Not deployed' };
    var _bdCls = { 'protected':'good', 'infected':'bad', 'failed':'bad',
                   'installed':'', 'queued':'', 'running':'' };
  %>
  <% if (_bd) { %>
  <a class="ds" href="#security" style="text-decoration:none;color:inherit;" onclick="if(window.lmaShowTab)lmaShowTab('security');">
    <div class="n <%= _bdCls[_bd.state] === undefined ? 'warn' : _bdCls[_bd.state] %>" style="font-size:15px;line-height:1.5;"><%= _bdWord[_bd.state] || _bd.state %></div>
    <div class="l">Bitdefender &rsaquo;</div>
  </a>
  <% } %>
  <div class="ds">
    <% if (_bp.length) { %>
    <div class="n <%= _bpFailed ? 'bad' : 'good' %>"><%= _bpFailed ? 'Attention' : 'Protected' %></div>
    <div class="l">backup · <%= _bp.length %> plan<%= _bp.length===1?'':'s' %></div>
    <% } else { %>
    <div class="n" style="font-size:15px;line-height:1.5;color:var(--muted);">no plans</div>
    <div class="l">backup</div>
    <% } %>
  </div>
  <div class="ds">
    <div class="n" style="font-size:15px;line-height:1.5;">v<%= _ai.agent_version || '?' %><% if (typeof latestAgentVersion !== 'undefined' && latestAgentVersion && _ai.agent_version && _ai.agent_version !== latestAgentVersion) { %> <span class="badge badge-inactive" style="font-size:10px;">update due</span><% } %><% if (user.role === 'admin' && typeof latestAgentVersion !== 'undefined' && latestAgentVersion && _ai && _ai.agent_version && _ai.agent_version !== latestAgentVersion) { %><form method="post" action="/agents/<%= _ai.id %>/update-now" style="display:inline;margin:0 0 0 6px;"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><button class="agent-up" type="submit" title="Push v<%= latestAgentVersion %> to this machine now">&#8593;</button></form><% } %></div>
    <div class="l">LumenMSP agent</div>
  </div>
</div>
<% } %>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error && String(error).indexOf('No remote-access session') !== 0) { %><div class="alert alert-error"><%= error %></div><% } %>

<%
// Remote access banner. Every state here is something an engineer can act on — the old
// version said "not yet" and left you with a machine in front of you and no next step.
var _ms = (typeof meshState !== 'undefined') ? meshState : null;
function _ago(d) {
  if (!d) return '';
  var m = Math.round((Date.now() - new Date(d).getTime()) / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return m + ' minute' + (m === 1 ? '' : 's') + ' ago';
  var h = Math.round(m / 60);
  return h < 24 ? h + ' hour' + (h === 1 ? '' : 's') + ' ago' : Math.round(h / 24) + ' days ago';
}
%>
<% if (_ms && !_ms.hasNode) { %>
  <% if (_ms.pendingSince) { %>
    <div class="alert" style="border:1px solid var(--info-line);background:var(--tint-accent);display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <span>
        <% if (_ms.pendingStarted) { %>
        <strong>Installing remote access…</strong>
        <span class="muted">The agent picked this up and is running it. If it overruns it is failed automatically and retried — nothing to do.</span>
        <% if (user.role === 'admin' && _ms.lastAttempt) { %>
          <span class="muted" style="display:block;font-size:11.5px;margin-top:4px;">
            Started <%= dt(_ms.lastAttempt.startedAt) %><% if (_ms.lastAttempt.progressPct != null) { %> · <%= _ms.lastAttempt.progressPct %>%<% } %>
            <% if (_ms.lastAttempt.progress) { %><br><span style="font-family:ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;"><%= _ms.lastAttempt.progress %></span><% } %>
          </span>
        <% } %>
        <% } else { %>
        <strong>Remote access install is queued.</strong>
        <span class="muted">Queued <%= _ago(_ms.pendingSince) %>, and the machine has not collected it yet — it runs within seconds of the agent checking in. This page refreshes itself.</span>
        <% } %>
      </span>
    </div>
    <meta http-equiv="refresh" content="20">
  <% } else if (_ms.failed) { %>
    <div class="alert alert-error" style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap;">
      <span style="flex:1;min-width:280px;">
        <strong>The last remote-access install failed<%= _ms.failed.at ? ' ' + _ago(_ms.failed.at) : '' %>.</strong>
        <div class="muted" style="font-size:12px;margin-top:5px;font-family:ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;"><%= _ms.failed.output || 'No output was returned.' %></div>
      </span>
      <form method="post" action="/assets/<%= asset.id %>/mesh-install" style="margin:0;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button class="btn" type="submit">Try again</button>
      </form>
    </div>
  <% } else if (!_ms.enabled) { %>
    <div class="alert" style="border:1px solid var(--warn-line);">
      <strong>Remote access is switched off for <%= _ms.customer || 'this customer' %>.</strong>
      <span class="muted">Turn it on for the customer and it installs everywhere automatically.</span>
    </div>
  <% } else if (!_ms.hasPackage) { %>
    <div class="alert" style="border:1px solid var(--warn-line);display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <span><strong><%= _ms.customer || 'This customer' %> has no remote-access agent yet.</strong>
      <span class="muted">One gets built per customer, then installs itself on every machine they have.</span></span>
      <a class="btn" href="/agents" style="margin-left:auto;">Agents page</a>
    </div>
  <% } else if (_ms.installed) { %>
    <div class="alert" style="border:1px solid var(--warn-line);display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap;">
      <span style="flex:1;min-width:300px;">
        <strong>Remote access is installed on this machine, but the Portal has not been told which machine it is.</strong>
        <span class="muted" style="display:block;margin-top:4px;"><%= _ms.strandedDetail || 'The machine has not been linked to a MeshCentral node yet.' %></span>
        <% if (_ms.installedAt) { %><span class="muted" style="display:block;font-size:11.5px;margin-top:4px;">The agent reported a clean install <%= _ago(_ms.installedAt) %>.</span><% } %>
        <span class="muted" style="display:block;font-size:11.5px;margin-top:4px;">Reinstalling will not fix this — the Mesh Agent is already there. It is the link that is missing.</span>
      </span>
      <span style="display:flex;gap:8px;margin-left:auto;">
        <a class="btn" href="/agents">Bridge status</a>
        <form method="post" action="/assets/<%= asset.id %>/mesh-install" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button class="btn" type="submit">Reinstall anyway</button>
        </form>
      </span>
    </div>
  <% } else { %>
    <div class="alert" style="border:1px solid var(--warn-line);display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <span style="flex:1;min-width:280px;"><strong>Remote control is not installed on this machine yet.</strong>
      <span class="muted">Installing takes a minute and needs nobody at the far end — the LumenMSP agent does it.</span>
      <% if (user.role === 'admin' && _ms.lastAttempt && _ms.lastAttempt.output) { %>
        <span class="muted" style="display:block;font-size:11.5px;margin-top:5px;">Last attempt <%= _ms.lastAttempt.status %><% if (_ms.lastAttempt.exitCode != null) { %> (exit <%= _ms.lastAttempt.exitCode %>)<% } %> <%= dt(_ms.lastAttempt.finishedAt || _ms.lastAttempt.startedAt) %>:<br>
        <span style="font-family:ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;"><%= _ms.lastAttempt.output %></span></span>
      <% } %></span>
      <form method="post" action="/assets/<%= asset.id %>/mesh-install" style="margin:0 0 0 auto;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button class="btn btn-primary" type="submit">🖥 Install remote control</button>
      </form>
    </div>
  <% } %>
<% } %>


<% if (!_ours) { %>
<div class="card" style="background:var(--tint-warn);border-color:var(--warn-line);">
  <p style="margin:0;font-size:13px;color:var(--warn-deep);">
    <strong>Imported from Atera — no LumenMSP Agent on this machine.</strong> Everything below is whatever Atera last reported, and the
    Portal cannot describe it, patch it or remote onto it until our agent is installed. It shows as offline here for that reason.
    <a href="/agents#download" style="font-weight:600;">Install the LumenMSP Agent &rarr;</a>
  </p>
</div>
<% } %>

<div class="card">
  <nav class="dev-tabs">
    <button type="button" data-tab="overview">Overview</button>
    <button type="button" data-tab="hardware">Hardware</button>
    <button type="button" data-tab="os">OS</button>
<% var _isServer = (typeof serverFacts !== 'undefined' && serverFacts); %>
<% if (_isServer) { %><button type="button" data-tab="server">Server<% var _sb = (serverAlerts||[]).filter(function(a){ return a.level==='bad'; }).length; %><% if (_sb) { %> <span style="color:var(--bad-fg);">●</span><% } %></button><% } %>
<% if (typeof gpo !== 'undefined' && gpo) { %><button type="button" data-tab="gpo">Group Policy<% if (gpo.bad) { %> <span style="color:var(--bad-fg);">&#9679;</span><% } %></button><% } %>
    <button type="button" data-tab="security">Security<% if (typeof security !== 'undefined' && security && security.bad) { %> <span style="color:var(--bad-fg);">&#9679;</span><% } else if (typeof security !== 'undefined' && security && security.warn) { %> <span style="color:var(--warn-fg);">&#9679;</span><% } %></button>
    <button type="button" data-tab="backup">Backup<% if (backupPlans.length && backupPlans.some(function(p){ return p.cls==='failed'; })) { %> <span style="color:var(--bad-fg);">●</span><% } %></button>
  </nav>

  <section class="dev-tab-panel" data-key="overview">
    <div class="dev-info-cols">
      <div>
        <p class="dev-subcard-title">Device info</p>
        <div class="dev-field-row"><div class="k">Machine name</div><div class="v"><%= fmt(asset.hostname) %></div></div>
        <div class="dev-field-row"><div class="k">Domain / Workgroup</div><div class="v"><%= fmt(asset.domain_or_workgroup) %></div></div>
        <div class="dev-field-row"><div class="k">Public IP</div><div class="v"><%= fmt(asset.public_ip) %></div></div>
        <div class="dev-field-row"><div class="k">Local IP address(es)</div><div class="v"><%= fmt(asset.ip_addresses) %></div></div>
        <div class="dev-field-row"><div class="k">MAC address</div><div class="v"><%= fmt(asset.mac_address) %></div></div>
        <div class="dev-field-row"><div class="k">Signed-in user</div><div class="v"><%= fmt(asset.last_login_user) %></div></div>
        <div class="dev-field-row"><div class="k">Disks</div><div class="v">
          <% var _dl = diskList(agentInfo && agentInfo.disk_info); %>
          <% if (!_dl.length) { %><%= fmt(asset.disk_info) %><% } else { %>
            <% _dl.forEach(function(d){ var c = diskColour(d); %>
              <div style="margin:0 0 9px;max-width:340px;">
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px;">
                  <span style="font-weight:600;"><%= d.drive %></span>
                  <span class="muted"><%= d.pct %>% of <%= gb(d.total) %></span>
                </div>
                <div style="height:8px;border-radius:4px;background:var(--surface-3);overflow:hidden;">
                  <div style="width:<%= d.pct %>%;height:100%;background:<%= c %>;"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:11px;margin-top:3px;" class="muted">
                  <span><%= gb(d.used) %> used</span>
                  <span style="color:<%= d.free < 20 ? c : 'inherit' %>;font-weight:<%= d.free < 20 ? '600' : '400' %>;"><%= gb(d.free) %> free</span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div></div>
        <div class="dev-field-row"><div class="k">Last seen</div><div class="v"><%= dt(asset.last_seen_at) %></div></div>
        <div class="dev-field-row"><div class="k">Last reboot</div><div class="v"><%= dt(asset.last_reboot_at) %></div></div>
        <div class="dev-field-row"><div class="k">Date added</div><div class="v"><%= dt(asset.added_at) %></div></div>
      </div>
      <% if (typeof agentInfo !== 'undefined' && agentInfo) {
           // Same window as the list and the SQL — passed in, never re-typed.
           var _win = (typeof onlineWindowSecs !== 'undefined' && onlineWindowSecs) ? onlineWindowSecs : 180;
           var agOnline = agentInfo.seen_secs != null && Number(agentInfo.seen_secs) < _win;
      %>
      <div>
        <p class="dev-subcard-title" style="display:flex;align-items:center;gap:6px;"><img src="/static/img/lumen-agent-16.png" width="14" height="14" alt=""> Reported by</p>
        <div class="dev-field-row"><div class="k">Source</div><div class="v">LumenMSP Agent <span class="muted">(this machine, live)</span></div></div>
        <div class="dev-field-row"><div class="k">Status</div><div class="v">
          <span style="display:inline-flex;align-items:center;gap:5px;font-weight:600;color:<%= agOnline ? 'var(--ok)' : 'var(--faint)' %>;">
            <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= agOnline ? 'var(--ok)' : 'var(--line-strong)' %>;"></span>
            <%= agOnline ? 'Online' : 'Offline' %>
          </span>
        </div></div>
        <div class="dev-field-row"><div class="k">Agent version</div><div class="v"><strong><%= agentInfo.agent_version ? 'v' + agentInfo.agent_version : '—' %></strong><% if (typeof latestAgentVersion !== 'undefined' && latestAgentVersion && agentInfo.agent_version && agentInfo.agent_version !== latestAgentVersion) { %> <span class="badge badge-inactive" title="Self-updates to v<%= latestAgentVersion %> within 6 hours">update due</span><% } %><% if (user.role === 'admin' && typeof latestAgentVersion !== 'undefined' && latestAgentVersion && agentInfo && agentInfo.agent_version && agentInfo.agent_version !== latestAgentVersion) { %><form method="post" action="/agents/<%= agentInfo.id %>/update-now" style="display:inline;margin:0 0 0 6px;"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><button class="agent-up" type="submit" title="Push v<%= latestAgentVersion %> to this machine now">&#8593;</button></form><% } %></div></div>
        <div class="dev-field-row"><div class="k">Last check-in</div><div class="v"><%= dt(agentInfo.last_seen_at) %></div></div>
        <div class="dev-field-row"><div class="k">&nbsp;</div><div class="v"><a class="row-link" href="/agents">Manage agents &rarr;</a></div></div>
      </div>
      <% } else { %>
      <div>
        <p class="dev-subcard-title">Reported by</p>
        <div class="dev-field-row"><div class="k">Source</div><div class="v">Atera <span class="muted">(import only)</span></div></div>
        <div class="dev-field-row"><div class="k">Status</div><div class="v"><span class="muted">Offline — the Portal has no live link to this machine.</span></div></div>
        <div class="dev-field-row"><div class="k">Last imported</div><div class="v"><%= dt(asset.synced_at) %></div></div>
        <div class="dev-field-row"><div class="k">&nbsp;</div><div class="v"><a class="row-link" href="/agents#download">Install the LumenMSP Agent &rarr;</a></div></div>
      </div>
      <% } %>
      <div>
        <p class="dev-subcard-title">Device relations</p>
        <div class="dev-field-row">
          <div class="k">Customer</div>
          <div class="v">
            <% if (asset.customer_id) { %><a class="row-link" href="/customers/<%= asset.customer_id %>#assets"><%= asset.customer_name %></a>
            <% } else { %><span class="muted">Not matched yet</span><% } %>
          </div>
        </div>
        <div class="dev-field-row"><div class="k">Assigned user</div><div class="v">
          <% if (asset.customer_id) { %>
          <form method="post" action="/assets/<%= asset.id %>/assign" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <select class="input" name="contact_id" style="font-size:12px;padding:4px 8px;max-width:230px;">
              <option value="">&mdash; unallocated &mdash;</option>
              <% (contactOptions || []).forEach(function(ct){ %><option value="<%= ct.id %>" <%= asset.assigned_contact_id===ct.id?'selected':'' %>><%= ct.full_name %></option><% }); %>
            </select>
            <button class="btn" type="submit" style="padding:4px 10px;font-size:12px;">Save</button>
          </form>
          <% } else { %><span class="muted">match this device to a customer first</span><% } %>
        </div></div>
        <div class="dev-field-row"><div class="k">Record owner</div><div class="v"><span class="badge <%= _ours ? 'badge-sent' : 'badge-inactive' %>"><%= _ours ? 'LumenMSP Agent' : 'Atera import' %></span></div></div>
        <% var _ateraId = asset.atera_agent_id || (asset.source_system === 'atera' ? asset.external_id : null); %>
        <% if (_ateraId) { %>
        <div class="dev-field-row"><div class="k">Atera Agent ID</div><div class="v muted" style="font-family:monospace;font-size:12px;" title="Kept only so the old Atera deep-link still works while Atera is wound down."><%= _ateraId %></div></div>
        <% } %>
        <% if (asset.device_guid) { %>
        <div class="dev-field-row"><div class="k">Device GUID</div><div class="v muted" style="font-family:monospace;font-size:11px;overflow-wrap:anywhere;"><%= asset.device_guid %></div></div>
        <% } %>
      </div>
    </div>
    <p class="muted" style="font-size:12px;margin:14px 0 0;">"Assigned user" is who this machine belongs to, set here and never touched by any import — the signed-in user above is only whoever last logged on. Assign a person and their devices appear on any case they raise, with a jump-through and remote control.</p>
  </section>

  <% if (_isServer) { %><%- include('_server') %><% } %>

  <% if (typeof gpo !== 'undefined' && gpo) { %><%- include('_gpo', { gpo: gpo, asset: asset, user: user, csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '') }) %><% } %>

  <% if (user.role === 'admin') { %><%- include('_tools', {
        asset: asset, agentInfo: (typeof agentInfo !== 'undefined' ? agentInfo : null), user: user,
        patches: (typeof patches !== 'undefined' ? patches : []),
        patchMeta: (typeof patchMeta !== 'undefined' ? patchMeta : null),
        agentScripts: (typeof agentScripts !== 'undefined' ? agentScripts : []),
        csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '') }) %><% } %>

  <section class="dev-tab-panel" data-key="hardware">
    <%
      // One place decides the colour of a warranty (lib/warranty.ts), so this page, the
      // asset list and anything built later cannot disagree about the same machine.
      var _w  = (typeof warranty !== 'undefined' && warranty) ? warranty : { state:'unknown', label:'Not known', entitlements:[], canCheck:false, providerName:null };
      var _wc = _w.state === 'active' ? 'var(--ok)' : _w.state === 'expiring' ? 'var(--warn)' : _w.state === 'expired' ? 'var(--bad)' : 'var(--line-strong)';
      var _wt = _w.state === 'active' ? 'var(--tint-ok, var(--surface-2))' : _w.state === 'expiring' ? 'var(--tint-warn)' : _w.state === 'expired' ? 'var(--tint-bad, var(--surface-2))' : 'var(--surface-2)';
      function _wd(v){ return v ? new Date(v).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : '—'; }
    %>
    <div class="card" id="warranty" style="background:<%= _wt %>;border-left:4px solid <%= _wc %>;margin:0 0 18px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;">
        <div style="min-width:260px;">
          <p class="dev-subcard-title" style="margin:0 0 4px;">Warranty</p>
          <p style="margin:0;font-size:19px;font-weight:700;color:<%= _wc %>;"><%= _w.label %></p>
          <p class="muted" style="margin:4px 0 0;font-size:13px;">
            <% if (asset.warranty_level) { %><span style="font-weight:600;color:var(--ink);"><%= asset.warranty_level %></span><br><% } %>
            <% if (asset.warranty_end) { %>Cover <%= _wd(asset.warranty_start) %> &rarr; <strong><%= _wd(asset.warranty_end) %></strong><% } %>
            <% if (asset.warranty_ship_date) { %><br>Shipped <%= _wd(asset.warranty_ship_date) %><% } %>
          </p>
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <% if (_w.canCheck) { %>
          <form method="post" action="/assets/<%= asset.id %>/warranty/refresh" style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="back" value="<%= back %>">
            <button class="btn" type="submit" title="Ask <%= _w.providerName %> for this machine's warranty now, by serial number"<%= asset.warranty_locked ? ' disabled' : '' %>>&#8635; Check with <%= _w.providerName %></button>
          </form>
          <% } %>
          <button type="button" class="btn" id="warrEditBtn">&#9998; <%= asset.warranty_end || asset.warranty_level ? 'Edit by hand' : 'Enter by hand' %></button>
        </div>
      </div>

      <p class="muted" style="margin:12px 0 0;font-size:12px;">
        <% if (asset.warranty_source === 'manual') { %>
          Entered by hand<% if (asset.warranty_supplier) { %> · bought from <%= asset.warranty_supplier %><% } %>
        <% } else if (asset.warranty_source) { %>
          From <%= asset.warranty_provider || asset.warranty_source %><% if (asset.warranty_checked_at) { %> · checked <%= dt(asset.warranty_checked_at) %><% } %>
        <% } else if (!_w.canCheck && !String(asset.serial_number || '').trim()) { %>
          No serial number on this device, so there is nothing to look a warranty up by. Type it in if you have the paperwork.
        <% } else if (!_w.canCheck) { %>
          No warranty service is connected for <%= asset.manufacturer || 'this manufacturer' %> yet — add the credentials under
          <a class="row-link" href="/settings/integrations#warranty">Settings &rarr; Integrations</a>, or type the warranty in.
        <% } else { %>
          Never checked. Press &ldquo;Check with <%= _w.providerName %>&rdquo;, or wait for tonight's sweep.
        <% } %>
        <% if (asset.warranty_locked) { %>
          <span class="badge badge-sent" style="margin-left:6px;" title="A person entered this, so no automatic lookup will overwrite it">locked</span>
        <% } %>
      </p>
      <% if (asset.warranty_notes) { %><p class="muted" style="margin:8px 0 0;font-size:12.5px;"><%= asset.warranty_notes %></p><% } %>
      <% if (asset.warranty_error) { %>
        <p style="margin:8px 0 0;font-size:12px;color:var(--bad-fg);" title="The last lookup did not produce an answer. A gap here should be visible, not silent.">&#9888; <%= asset.warranty_error %></p>
      <% } %>

      <% if ((_w.entitlements || []).length) { %>
        <p class="dev-subcard-title" style="margin:16px 0 6px;">Entitlements</p>
        <p class="muted" style="margin:0 0 8px;font-size:12px;">A machine normally carries several at once, with different end dates — this is where &ldquo;is the accidental-damage cover still live?&rdquo; gets answered.</p>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>Cover</th><th>Type</th><th>From</th><th>To</th></tr></thead>
          <tbody>
          <% _w.entitlements.forEach(function(e){ var _ee = e.end_date ? new Date(e.end_date) : null; var _dead = _ee && _ee.getTime() < Date.now(); %>
            <tr<%= _dead ? ' style="opacity:.55;"' : '' %>>
              <td style="font-weight:600;"><%= e.description || e.service_code || '—' %></td>
              <td class="muted"><%= e.entitlement_type || '—' %></td>
              <td class="muted" style="white-space:nowrap;"><%= _wd(e.start_date) %></td>
              <td class="muted" style="white-space:nowrap;"><%= _wd(e.end_date) %><%= _dead ? ' (ended)' : '' %></td>
            </tr>
          <% }); %>
          </tbody>
        </table></div>
      <% } %>

      <form method="post" action="/assets/<%= asset.id %>/warranty" id="warrForm" style="display:none;margin:16px 0 0;padding:16px 0 0;border-top:1px solid var(--line);">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="back" value="<%= back %>">
        <p class="muted" style="margin:0 0 12px;font-size:12.5px;">Saving here <strong>locks</strong> the warranty: no automatic lookup will overwrite it. That is deliberate — if you have read the contract you know more than the manufacturer's database does about a second-hand machine or a third-party support deal.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;">
          <div class="form-group"><label>Provider</label><input class="input" name="provider" maxlength="60" value="<%= asset.warranty_provider || '' %>" placeholder="Dell, HP, a third party…"></div>
          <div class="form-group"><label>Level of cover</label><input class="input" name="level" maxlength="160" value="<%= asset.warranty_level || '' %>" placeholder="3Y Onsite Next Business Day"></div>
          <div class="form-group"><label>Starts</label><input class="input" type="date" name="start" value="<%= asset.warranty_start ? new Date(asset.warranty_start).toISOString().slice(0,10) : '' %>"></div>
          <div class="form-group"><label>Expires</label><input class="input" type="date" name="end" value="<%= asset.warranty_end ? new Date(asset.warranty_end).toISOString().slice(0,10) : '' %>"></div>
          <div class="form-group"><label>Bought from</label><input class="input" name="supplier" maxlength="120" value="<%= asset.warranty_supplier || '' %>" placeholder="Supplier"></div>
        </div>
        <div class="form-group" style="margin-top:4px;"><label>Notes</label><input class="input" name="notes" maxlength="500" value="<%= asset.warranty_notes || '' %>" placeholder="Contract reference, what it does and does not cover…" style="width:100%;"></div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px;">
          <button class="btn btn-primary" type="submit">Save warranty</button>
          <button class="btn" type="button" id="warrCancel">Cancel</button>
        </div>
      </form>
      <% if (asset.warranty_locked) { %>
      <form method="post" action="/assets/<%= asset.id %>/warranty/unlock" style="margin:10px 0 0;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="back" value="<%= back %>">
        <button class="btn" type="submit" style="padding:3px 10px;font-size:12px;" title="Hand this machine back to the nightly lookup">Unlock &mdash; let automatic lookups update it again</button>
      </form>
      <% } %>
    </div>

    <div class="dev-info-cols">
      <div>
        <div class="dev-field-row"><div class="k">Manufacturer / Model</div><div class="v"><%= fmt([asset.manufacturer, asset.model].filter(Boolean).join(' ') || null) %></div></div>
        <div class="dev-field-row"><div class="k">Serial number</div><div class="v"><%= fmt(asset.serial_number) %></div></div>
        <div class="dev-field-row"><div class="k">Processor</div><div class="v"><%= fmt(asset.cpu) %></div></div>
        <div class="dev-field-row"><div class="k">RAM</div><div class="v"><%= asset.ram_gb ? asset.ram_gb + ' GB' : '—' %></div></div>
        <div class="dev-field-row"><div class="k">Disk</div><div class="v">
          <% var _dl = diskList(agentInfo && agentInfo.disk_info); %>
          <% if (!_dl.length) { %><%= fmt(asset.disk_info) %><% } else { %>
            <% _dl.forEach(function(d){ var c = diskColour(d); %>
              <div style="margin:0 0 9px;max-width:340px;">
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px;">
                  <span style="font-weight:600;"><%= d.drive %></span>
                  <span class="muted"><%= d.pct %>% of <%= gb(d.total) %></span>
                </div>
                <div style="height:8px;border-radius:4px;background:var(--surface-3);overflow:hidden;">
                  <div style="width:<%= d.pct %>%;height:100%;background:<%= c %>;"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:11px;margin-top:3px;" class="muted">
                  <span><%= gb(d.used) %> used</span>
                  <span style="color:<%= d.free < 20 ? c : 'inherit' %>;font-weight:<%= d.free < 20 ? '600' : '400' %>;"><%= gb(d.free) %> free</span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div></div>
      </div>
    </div>
  </section>

  <section class="dev-tab-panel" data-key="backup">
    <% if (!backupPlans.length) { %>
      <p class="muted" style="font-size:13px;">No backup plans reported for this device by MSP360. If it should be protected, check the machine name matches in MSP360 (<%= asset.hostname || 'no hostname' %>) — devices match by machine name.</p>
    <% } else { %>
      <p class="dev-subcard-title">Backup plans (<%= backupPlans[0].provider %>)</p>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Plan</th><th>Type</th><th>Last run</th><th>Next run</th><th>Data moved</th><th>Status</th></tr></thead>
        <tbody>
        <% backupPlans.forEach(function(p){ %>
          <tr>
            <td style="font-weight:600;"><%= p.planName %><% if (p.errorMessage) { %><div class="muted" style="font-size:11px;color:var(--bad-fg);"><%= p.errorMessage %></div><% } %></td>
            <td class="muted"><%= p.typeLabel || '—' %></td>
            <td class="muted" style="white-space:nowrap;"><%= dt(p.lastStart) %></td>
            <td class="muted" style="white-space:nowrap;"><%= dt(p.nextStart) %></td>
            <td class="muted"><%= p.dataCopiedH || '—' %><% if (p.totalDataH) { %> <span style="font-size:11px;">of <%= p.totalDataH %></span><% } %></td>
            <td><span class="badge <%= p.cls==='ok' ? 'badge-sent' : (p.cls==='failed' ? 'badge-failed' : 'badge-inactive') %>"><%= p.statusLabel %></span></td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <% if (backupHistory.length) { %>
        <p class="dev-subcard-title" style="margin-top:16px;">Recent history (last 14 days)</p>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>Day</th><th>Plan</th><th>Result</th><th>Data moved</th></tr></thead>
          <tbody>
          <% backupHistory.forEach(function(h){ %>
            <tr>
              <td class="muted" style="white-space:nowrap;"><%= new Date(h.day + 'T00:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></td>
              <td class="muted"><%= h.planName %></td>
              <td><span class="badge <%= h.cls==='ok' ? 'badge-sent' : (h.cls==='failed' ? 'badge-failed' : 'badge-inactive') %>"><%= h.statusLabel %></span></td>
              <td class="muted"><%= h.dataCopiedH || '—' %></td>
            </tr>
          <% }); %>
          </tbody>
        </table></div>
      <% } else { %>
        <p class="muted" style="font-size:12px;margin-top:12px;">Daily history starts accruing from today's sync — the Portal keeps its own backup timeline per device from now on.</p>
      <% } %>
      <p class="muted" style="font-size:12px;margin-top:10px;">Synced nightly from MSP360; matched to this device by machine name. Company link for reporting is set on the customer's IT report page.</p>
    <% } %>
  </section>

  <section class="dev-tab-panel" data-key="security">
    <%- include('_bitdefender', {
          bd: (typeof bd !== 'undefined') ? bd : null,
          bdGate: (typeof bdGate !== 'undefined') ? bdGate : null,
          bdLog: (typeof bdLog !== 'undefined') ? bdLog : [],
          bdLogError: (typeof bdLogError !== 'undefined') ? bdLogError : null,
          requiredExclusions: (typeof requiredExclusions !== 'undefined') ? requiredExclusions : [],
          asset: asset, user: user,
          csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '')
        }) %>

    <h4 style="margin:18px 0 8px;">What the machine reports</h4>
    <% var _sec = (typeof security !== 'undefined') ? security : null; %>
    <% if (!agentInfo) { %>
      <p class="muted" style="font-size:13px;">Security status needs the LumenMSP Agent on this machine &mdash; there is no live link to read it from.</p>
    <% } else if (!_sec || _sec.awaiting) { %>
      <p class="muted" style="font-size:13px;">
        The agent has not reported security status yet. It arrives with agent v1.0.24 on the daily pass
        <% if (user.role === 'admin') { %> &mdash; or ask the machine now:
        <form method="post" action="/assets/<%= asset.id %>/security-refresh" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button class="btn" type="submit" style="padding:2px 10px;font-size:12px;">Refresh from device</button>
        </form>
        <% } %>
      </p>
    <% } else { %>
      <% (_sec.notices || []).forEach(function (n) { %>
        <div style="margin:0 0 10px;padding:9px 12px;border-left:3px solid var(--warn-fg);background:rgba(190,130,20,.08);font-size:12.5px;line-height:1.5;">
          <strong style="color:var(--warn-fg);">Worth a look</strong> &mdash; <%= n.text %>
        </div>
      <% }); %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th style="width:160px;">Protection</th><th>Product</th><th>Status</th></tr></thead>
        <tbody>
        <% _sec.rows.forEach(function (r) { %>
          <tr>
            <td style="font-weight:600;"><%= r.area %></td>
            <td><%= r.product %><% if (r.extra) { %><div class="muted" style="font-size:11.5px;"><%= r.extra %></div><% } %></td>
            <td>
              <% var _c = (r.level === 'warn') ? 'var(--warn-fg)' : (r.level === 'bad' || r.ok === false) ? 'var(--bad-fg)' : 'var(--ok)'; %>
              <span style="display:inline-flex;align-items:center;gap:6px;font-weight:600;color:<%= _c %>;">
                <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= _c %>;"></span>
                <%= r.detail %>
              </span>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <p class="muted" style="font-size:12px;margin:12px 0 0;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <span>Collected <%= dt(_sec.collectedAt) %> by the agent<% if (_sec.stale) { %> &mdash; <strong style="color:var(--warn-fg);">over two days old</strong>; the machine has probably been off<% } %>. Refreshes on the daily inventory pass.</span>
        <% if (user.role === 'admin') { %>
        <form method="post" action="/assets/<%= asset.id %>/security-refresh" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button class="btn" type="submit" style="padding:2px 10px;font-size:12px;">Refresh from device</button>
        </form>
        <% } %>
      </p>
    <% } %>

    <h4 style="margin:22px 0 8px;">Bitdefender scans</h4>
    <% var _sc = (typeof bdScans !== 'undefined') ? bdScans : []; %>
    <% var _running = _sc.some(function(s){ return !s.finished_at && s.status_code != null; }); %>
    <% if (!bd || !bd.deviceId && !bd.assetId) { %>
      <p class="muted" style="font-size:13px;">No Bitdefender record for this machine yet.</p>
    <% } else { %>
      <% if (user.role === 'admin') { %>
      <div style="display:flex;gap:8px;align-items:center;margin:0 0 10px;flex-wrap:wrap;">
        <% ['quick','full'].forEach(function(t){ %>
        <form method="post" action="/assets/<%= asset.id %>/bd-scan" style="display:inline;margin:0;"
              <% if (t === 'full') { %>onsubmit="return confirm('A full scan reads every file and can take hours, and the machine will feel slower while it runs. Start it?');"<% } %>>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="type" value="<%= t %>">
          <button class="btn<%= t === 'quick' ? ' btn-primary' : '' %>" type="submit" style="padding:4px 12px;font-size:12.5px;" <%= _running ? 'disabled' : '' %>>
            <%= t === 'quick' ? 'Quick scan now' : 'Full scan' %>
          </button>
        </form>
        <% }); %>
        <% if (_running) { %><span class="muted" style="font-size:12px;">A scan is already running — status refreshes every few minutes.</span><% } %>
      </div>
      <% } %>
      <% if (!_sc.length) { %>
        <p class="muted" style="font-size:13px;">No scans have been started from the Portal yet. Scheduled scans set in GravityZone are not listed here.</p>
      <% } else { %>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>Started</th><th>Type</th><th>Status</th><th>Found</th><th>Asked by</th></tr></thead>
          <tbody>
          <% _sc.forEach(function (s) { %>
            <tr>
              <td class="muted" style="white-space:nowrap;font-size:12.5px;"><%= s.requested_at %></td>
              <td style="text-transform:capitalize;"><%= s.scan_type %></td>
              <td>
                <% var _c = s.status_code == null ? 'var(--bad-fg)' : (s.status_code === 3 ? 'var(--ok)' : 'var(--warn-fg)'); %>
                <span style="display:inline-flex;align-items:center;gap:6px;font-weight:600;color:<%= _c %>;">
                  <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= _c %>;"></span>
                  <%= s.status_label %>
                </span>
                <% if (s.detail) { %><div class="muted" style="font-size:11.5px;"><%= s.detail %></div><% } %>
                <% if (s.finished_at) { %><div class="muted" style="font-size:11.5px;">finished <%= s.finished_at %></div><% } %>
              </td>
              <td>
                <% if (s.status_code !== 3) { %><span class="muted">&mdash;</span>
                <% } else if (!s.found) { %><span style="color:var(--ok);font-weight:600;">Clean</span>
                <% } else { %><span style="color:var(--bad-fg);font-weight:600;"><%= s.found %> detection<%= s.found === 1 ? '' : 's' %></span><% } %>
              </td>
              <td class="muted" style="font-size:12.5px;"><%= s.requested_by_name || 'Portal' %></td>
            </tr>
          <% }); %>
          </tbody>
        </table></div>
        <p class="muted" style="font-size:11.5px;margin:8px 0 0;line-height:1.5;">
          &ldquo;Found&rdquo; counts detections Bitdefender recorded on this machine while the scan ran.
          Our own MeshAgent trips Hyper Detect and is deliberately not counted.
        </p>
      <% } %>
    <% } %>

    <h4 style="margin:22px 0 8px;">BitLocker</h4>
    <% var _bl = (typeof bitlocker !== 'undefined') ? bitlocker : []; %>
    <% var _blVault = (typeof canVaultKeys !== 'undefined' && canVaultKeys); %>
    <p class="muted" style="font-size:12.5px;margin:0 0 10px;line-height:1.55;">
      Recovery keys are held here so they can be read out to whoever is standing at the machine.
      A PC sitting at the BitLocker recovery screen has no operating system running, so nothing —
      here or in any other tool — can reach it remotely.
      Keys are stored encrypted; every reveal and copy is written to the activity log.
    </p>
    <% if (!agentInfo) { %>
      <p class="muted" style="font-size:13px;">BitLocker needs the LumenMSP Agent on this machine.</p>
    <% } else if (!_bl.length) { %>
      <p class="muted" style="font-size:13px;">
        Nothing collected yet.
        <% if (user.role === 'admin') { %>
        <form method="post" action="/assets/<%= asset.id %>/bitlocker-refresh" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button class="btn" type="submit" style="padding:2px 10px;font-size:12px;">Ask the device now</button>
        </form>
        <% } %>
      </p>
    <% } else { %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th style="width:90px;">Drive</th><th>Protection</th><th>Recovery key</th><th>Collected</th><th></th></tr></thead>
        <tbody>
        <% _bl.forEach(function (v) { %>
          <tr>
            <td style="font-weight:600;"><%= v.mount_point %>
              <% if (v.volume_type) { %><div class="muted" style="font-size:11.5px;"><%= v.volume_type === 'OperatingSystem' ? 'System drive' : v.volume_type %></div><% } %>
            </td>
            <td>
              <% var _on = String(v.protection_status||'').toLowerCase() === 'on';
                 var _c = _on ? 'var(--ok)' : 'var(--warn-fg)'; %>
              <span style="display:inline-flex;align-items:center;gap:6px;font-weight:600;color:<%= _c %>;">
                <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= _c %>;"></span>
                <%= v.protection_status || 'Unknown' %>
              </span>
              <div class="muted" style="font-size:11.5px;"><%= v.encryption_method || '' %><% if (v.lock_status) { %> &middot; <%= v.lock_status %><% } %></div>
            </td>
            <td>
              <% if (!v.has_key) { %>
                <span style="color:var(--bad-fg);font-weight:600;">No key held</span>
                <div class="muted" style="font-size:11.5px;">Nothing to read out if this drive locks.</div>
              <% } else if (_blVault) { %>
                <span style="display:inline-flex;align-items:center;gap:6px;">
                  <span class="bl-key" data-shown="0">&bull;&bull;&bull;&bull;&bull;&bull;-&bull;&bull;&bull;&bull;&bull;&bull;</span>
                  <button type="button" class="bl-mini" title="Reveal" onclick="blReveal(<%= v.id %>,this)">&#128065;</button>
                  <button type="button" class="bl-mini" title="Copy key" onclick="blCopy(<%= v.id %>,this)">&#8865;</button>
                </span>
              <% } else { %>
                <span class="muted" title="Vault access required">&bull;&bull;&bull;&bull;&bull;&bull; &#128274;</span>
              <% } %>
            </td>
            <td class="muted" style="white-space:nowrap;font-size:12px;"><%= v.collected_at %></td>
            <td style="white-space:nowrap;">
              <% if (user.role === 'admin' && String(v.protection_status||'').toLowerCase() === 'on') { %>
              <form method="post" action="/assets/<%= asset.id %>/bitlocker-suspend" style="display:inline;margin:0;"
                    onsubmit="return confirm('Suspend BitLocker on <%= v.mount_point %> for one reboot? Protection resumes by itself.');">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="mount" value="<%= v.mount_point %>">
                <button class="btn" type="submit" style="padding:2px 10px;font-size:12px;" title="Before a BIOS or firmware update, so the machine does not drop into a recovery prompt">Suspend 1 reboot</button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <% if (user.role === 'admin') { %>
      <p class="muted" style="font-size:12px;margin:10px 0 0;">
        <form method="post" action="/assets/<%= asset.id %>/bitlocker-refresh" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button class="btn" type="submit" style="padding:2px 10px;font-size:12px;">Refresh from device</button>
        </form>
      </p>
      <% } %>
    <% } %>
    <style>
      .bl-mini { background:none;border:1px solid var(--line);border-radius:5px;cursor:pointer;font-size:13px;padding:1px 6px;line-height:1.4; }
      .bl-mini:hover { border-color:var(--accent); }
      .bl-key { font-family:monospace;font-size:13px;letter-spacing:.3px; }
    </style>
    <script>
      function blReveal(id, btn){ var span = btn.closest('span').querySelector('.bl-key');
        if (span.dataset.shown === '1'){ span.textContent = '••••••-••••••'; span.dataset.shown = '0'; return; }
        fetch('/bitlocker/'+id+'/key?action=reveal').then(function(r){ return r.json(); }).then(function(d){
          if (d.secret != null){ span.textContent = d.secret; span.dataset.shown = '1'; } else { alert(d.error || 'Could not reveal'); }
        }).catch(function(){ alert('Could not reveal'); }); }
      function blCopy(id, btn){ fetch('/bitlocker/'+id+'/key?action=copy').then(function(r){ return r.json(); }).then(function(d){
          if (d.secret != null){ navigator.clipboard.writeText(d.secret).then(function(){ var o = btn.textContent; btn.textContent = '✓'; setTimeout(function(){ btn.textContent = o; }, 900); }); }
          else { alert(d.error || 'Could not copy'); }
        }).catch(function(){ alert('Could not copy'); }); }
    </script>
  </section>

  <section class="dev-tab-panel" data-key="os">
    <div class="dev-info-cols">
      <div>
        <div class="dev-field-row"><div class="k">Operating system</div><div class="v"><%= fmt(asset.os) %></div></div>
        <div class="dev-field-row"><div class="k">Version / build</div><div class="v"><%= fmt(asset.os_version) %></div></div>
      </div>
    </div>
  </section>
</div>

<% if (typeof rawJson !== 'undefined' && rawJson) { %>
<div class="card">
  <details>
    <summary style="cursor:pointer;font-weight:600;font-size:13px;color:var(--muted);">🔧 Raw Atera payload (debug — admin only, ?debug=1)</summary>
    <pre style="margin-top:10px;font-size:11px;line-height:1.5;overflow:auto;max-height:500px;background:var(--ink-chip);color:var(--line);padding:14px;border-radius:8px;"><%= rawJson %></pre>
  </details>
</div>
<% } %>

<script>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.dev-tabs button'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.dev-tab-panel'));
    function show(k) {
      tabs.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-tab') === k); });
      panels.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-key') === k); });
    }
    tabs.forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-tab')); }); });
    // Exposed so anything higher up the page can jump straight to a tab — the vitals
    // strip's Bitdefender tile uses it. Without this, clicking it only set the hash and
    // the panel stayed where it was, which is exactly the kind of dead control that had
    // Terry hunting for the deploy button in the first place.
    window.lmaShowTab = function (k) {
      if (!document.querySelector('.dev-tab-panel[data-key="' + k + '"]')) return;
      show(k);
      var el = document.querySelector('.dev-tabs');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    // Always open on the first tab. A deep link (#gpo, #security, #backup) still jumps
    // straight to its tab - what we no longer do is restore whichever tab happened to be
    // open on the last visit, which made "go to a device" land somewhere different every time.
    var hash = (location.hash || '').replace('#', '');
    // #warranty is not a tab, it is a card INSIDE the Hardware tab — every warranty
    // action redirects back to it, and without this the page would land on Overview and
    // look like nothing happened.
    if (hash === 'warranty') {
      show('hardware');
      setTimeout(function () {
        var card = document.getElementById('warranty');
        if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 60);
    } else {
      show((hash && document.querySelector('.dev-tab-panel[data-key="' + hash + '"]')) ? hash : 'overview');
    }
  })();
</script>

<script>
  // Two inline editors, same shape: a button reveals the form, Cancel puts it back.
  (function () {
    function toggler(btnId, formId, cancelId, focusSel) {
      var btn = document.getElementById(btnId), form = document.getElementById(formId);
      if (!btn || !form) return;
      btn.addEventListener('click', function () {
        var open = form.style.display !== 'none';
        form.style.display = open ? 'none' : 'flex';
        if (formId === 'warrForm' && !open) form.style.display = 'block';
        if (!open) { var f = form.querySelector(focusSel); if (f) { f.focus(); if (f.select) f.select(); } }
      });
      var cancel = cancelId && document.getElementById(cancelId);
      if (cancel) cancel.addEventListener('click', function () { form.style.display = 'none'; });
    }
    toggler('renameBtn', 'renameForm', 'renameCancel', 'input[name=friendlyName]');
    toggler('warrEditBtn', 'warrForm', 'warrCancel', 'input[name=provider]');
  })();
</script>

