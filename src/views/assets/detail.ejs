<%- include('../partials/header', { title: asset.hostname || 'Device', user }) %>
<% function fmt(v){ return (v===null || v===undefined || v==='') ? '—' : v; } %>
<% function dt(v){ return v ? new Date(v).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'; } %>
<% var _ours = (asset.data_source === 'agent') || !!asset.agent_device_id; %>

<style>
  .dev-tabs { display:flex; flex-wrap:wrap; gap:2px; border-bottom:2px solid var(--line); margin:0 0 18px; }
  .dev-tabs button { background:none; border:none; padding:10px 16px; font-size:14px; font-weight:600; color:var(--muted); cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-2px; }
  .dev-tabs button:hover { color:var(--ink); }
  .dev-tabs button.active { color:var(--accent); border-bottom-color:var(--accent); }
  .dev-tab-panel { display:none; }
  .dev-tab-panel.active { display:block; }
  .dev-info-cols { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:0 32px; }
  .dev-field-row { display:grid; grid-template-columns:150px 1fr; gap:10px; padding:9px 0; border-bottom:1px solid var(--surface-3); font-size:13px; }
  .dev-field-row:last-child { border-bottom:none; }
  .dev-field-row .k { color:var(--muted); }
  .dev-field-row .v { font-weight:500; }
  .dev-subcard-title { font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); margin:0 0 6px; }
</style>

<div class="doc-hero" style="--hero-accent:linear-gradient(90deg,var(--accent),var(--blue-bright));">
<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="<%= back %>">← Back</a></p>
    <p class="doc-kicker">Device · <%= asset.device_type || 'Unknown type' %><% if (asset.customer_name) { %> · <%= asset.customer_name %><% } %></p>
    <h1><%= asset.hostname || '(unnamed device)' %></h1>
    <p class="muted" style="margin:6px 0 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <% var _hw = (typeof onlineWindowSecs !== 'undefined' && onlineWindowSecs) ? onlineWindowSecs : 180;
         var _live = !!asset.agent_device_id && typeof agentInfo !== 'undefined' && agentInfo
                     && agentInfo.seen_secs != null && Number(agentInfo.seen_secs) < _hw; %>
      <span title="<%= asset.agent_device_id ? 'Live status from the LumenMSP Agent' : 'No LumenMSP Agent on this machine, so the Portal has no live status for it' %>" style="display:inline-flex;align-items:center;gap:5px;font-weight:600;color:<%= _live ? 'var(--ok)' : 'var(--faint)' %>;">
        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= _live ? 'var(--ok)' : 'var(--line-strong)' %>;"></span>
        <%= _live ? 'Online' : 'Offline' %>
      </span>
      <span class="badge badge-inactive"><%= asset.device_type || 'Device' %></span>
      <% if (typeof agentInfo !== 'undefined' && agentInfo) { %>
      <span title="LumenMSP Agent v<%= agentInfo.agent_version || '?' %> — last seen <%= dt(agentInfo.last_seen_at) %>" style="display:inline-flex;align-items:center;gap:5px;font-weight:600;color:var(--accent);"><img src="/static/img/lumen-agent-16.png" width="14" height="14" alt=""> <a class="row-link" href="/agents" style="color:inherit;">Agent installed</a></span>
      <% } else { %>
      <a class="badge" href="/agents#download" style="background:var(--tint-warn);color:var(--warn-deep);border:1px solid var(--warn-line);text-decoration:none;">agent required</a>
      <% } %>
      <% if (asset.customer_id) { %>· <a class="row-link" href="/customers/<%= asset.customer_id %>#assets"><%= asset.customer_name %></a><% } %>
      <% if (asset.last_login_user) { %>· <span class="muted"><%= asset.last_login_user %></span><% } %>
      <% if (_ours) { %>· <span class="muted" title="The Portal is the master record for this machine — every field on this page is collected by our own agent, not by Atera.">updated <%= dt(asset.synced_at) %></span><% } %>
    </p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <% if (remoteUrl) { %><a class="btn btn-remote" target="_blank" rel="noopener" href="/assets/<%= asset.id %>/remote-mesh">🖥 Remote control</a><% } %>
    <% if (!asset.agent_device_id && (user.role === 'admin')) { %>
    <form method="post" action="/assets/<%= asset.id %>/archive" style="display:inline;"
          onsubmit="return confirm('Archive ' + <%- JSON.stringify(String(asset.hostname || 'this device')) %> + '?\n\nUse this for an Atera import of a machine you will never manage. It is hidden from the estate and the Atera sync will NOT bring it back. Reversible from the archived list.');">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="reason" value="not managed">
      <button class="btn" type="submit" style="color:var(--bad-fg);" title="Remove this device from the estate — for Atera imports you will never put an agent on">Archive / remove</button>
    </form>
    <% } %>
    <% if (user.role === 'admin' && typeof agentInfo !== 'undefined' && agentInfo) { %>
    <button type="button" class="btn" id="manageBtn" title="Remote tools for this device - every one opens right here">&#128736; Manage &#9662;</button>
    <% } %>
    <% if (asset.agent_device_id) { %>
    <div class="pw-wrap" style="position:relative;display:inline-block;">
      <button type="button" class="btn pw-btn" <%= (typeof powerPending !== 'undefined' && powerPending) ? 'style="border-color:var(--warn-line);"' : '' %>
              data-id="<%= asset.agent_device_id %>" data-host="<%= asset.hostname || '' %>"
              data-user="<%= (typeof agentInfo !== 'undefined' && agentInfo) ? (agentInfo.logged_in_user || '') : '' %>"
              data-live="<%= _live ? '1' : '' %>" data-pending="<%= (typeof powerPending !== 'undefined' && powerPending) ? '1' : '' %>"
              data-pending-info="<%= (typeof powerPendingText !== 'undefined' && powerPendingText) ? powerPendingText : '' %>"
              data-strict="<%= (typeof serverFacts !== 'undefined' && serverFacts) ? '1' : '' %>"
              title="Sign out, restart or shut down">⏻ Power ▾</button>
    </div>
    <% } %>
  </div>
</div>
<%
  // The device's vitals as one strip - status, patching, security, backup, agent - so an
  // engineer reads the machine's state before scrolling an inch. Every figure is the same
  // source the tabs below use; nothing here is a second opinion.
  var _ai = (typeof agentInfo !== 'undefined') ? agentInfo : null;
  var _sec = (typeof security !== 'undefined') ? security : null;
  var _bp = (typeof backupPlans !== 'undefined' && backupPlans) ? backupPlans : [];
  var _bpFailed = _bp.filter(function(p){ return p.cls === 'failed'; }).length;
  var _patchN = _ai && _ai.patch_pending != null ? Number(_ai.patch_pending) : null;
  var _reboot = !!(_ai && _ai.reboot_required);
%>
<% if (_ai) { %>
<div class="doc-stats">
  <div class="ds">
    <div class="n <%= _live ? 'good' : '' %>"><%= _live ? 'Online' : 'Offline' %></div>
    <div class="l"><%= _live ? 'agent checked in' : ('last seen ' + (_ai.last_seen_at ? dt(_ai.last_seen_at) : 'never')) %></div>
  </div>
  <div class="ds">
    <div class="n <%= (_patchN != null && _patchN > 0) || _reboot ? 'warn' : (_patchN === 0 ? 'good' : '') %>"><%= _patchN != null ? _patchN : '—' %><% if (_reboot) { %> <small style="font-size:12px;font-weight:700;color:var(--warn-fg);">restart due</small><% } %></div>
    <div class="l">updates pending</div>
  </div>
  <div class="ds">
    <% if (_sec && !_sec.awaiting) { var _secBadN = _sec.rows.filter(function(r){ return !r.ok; }).length; %>
    <div class="n <%= _secBadN ? 'bad' : 'good' %>"><%= _secBadN ? _secBadN + ' issue' + (_secBadN===1?'':'s') : 'Protected' %></div>
    <div class="l">security</div>
    <% } else { %>
    <div class="n" style="font-size:15px;line-height:1.5;color:var(--muted);">awaiting agent</div>
    <div class="l">security</div>
    <% } %>
  </div>
  <div class="ds">
    <% if (_bp.length) { %>
    <div class="n <%= _bpFailed ? 'bad' : 'good' %>"><%= _bpFailed ? 'Attention' : 'Protected' %></div>
    <div class="l">backup · <%= _bp.length %> plan<%= _bp.length===1?'':'s' %></div>
    <% } else { %>
    <div class="n" style="font-size:15px;line-height:1.5;color:var(--muted);">no plans</div>
    <div class="l">backup</div>
    <% } %>
  </div>
  <div class="ds">
    <div class="n" style="font-size:15px;line-height:1.5;">v<%= _ai.agent_version || '?' %><% if (typeof latestAgentVersion !== 'undefined' && latestAgentVersion && _ai.agent_version && _ai.agent_version !== latestAgentVersion) { %> <span class="badge badge-inactive" style="font-size:10px;">update due</span><% } %></div>
    <div class="l">LumenMSP agent</div>
  </div>
</div>
<% } %>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error && String(error).indexOf('No remote-access session') !== 0) { %><div class="alert alert-error"><%= error %></div><% } %>

<%
// Remote access banner. Every state here is something an engineer can act on — the old
// version said "not yet" and left you with a machine in front of you and no next step.
var _ms = (typeof meshState !== 'undefined') ? meshState : null;
function _ago(d) {
  if (!d) return '';
  var m = Math.round((Date.now() - new Date(d).getTime()) / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return m + ' minute' + (m === 1 ? '' : 's') + ' ago';
  var h = Math.round(m / 60);
  return h < 24 ? h + ' hour' + (h === 1 ? '' : 's') + ' ago' : Math.round(h / 24) + ' days ago';
}
%>
<% if (_ms && !_ms.hasNode) { %>
  <% if (_ms.pendingSince) { %>
    <div class="alert" style="border:1px solid var(--info-line);background:var(--tint-accent);display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <span>
        <% if (_ms.pendingStarted) { %>
        <strong>Installing remote access…</strong>
        <span class="muted">The agent picked this up and is running it. If it overruns it is failed automatically and retried — nothing to do.</span>
        <% if (user.role === 'admin' && _ms.lastAttempt) { %>
          <span class="muted" style="display:block;font-size:11.5px;margin-top:4px;">
            Started <%= dt(_ms.lastAttempt.startedAt) %><% if (_ms.lastAttempt.progressPct != null) { %> · <%= _ms.lastAttempt.progressPct %>%<% } %>
            <% if (_ms.lastAttempt.progress) { %><br><span style="font-family:ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;"><%= _ms.lastAttempt.progress %></span><% } %>
          </span>
        <% } %>
        <% } else { %>
        <strong>Remote access install is queued.</strong>
        <span class="muted">Queued <%= _ago(_ms.pendingSince) %>, and the machine has not collected it yet — it runs within seconds of the agent checking in. This page refreshes itself.</span>
        <% } %>
      </span>
    </div>
    <meta http-equiv="refresh" content="20">
  <% } else if (_ms.failed) { %>
    <div class="alert alert-error" style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap;">
      <span style="flex:1;min-width:280px;">
        <strong>The last remote-access install failed<%= _ms.failed.at ? ' ' + _ago(_ms.failed.at) : '' %>.</strong>
        <div class="muted" style="font-size:12px;margin-top:5px;font-family:ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;"><%= _ms.failed.output || 'No output was returned.' %></div>
      </span>
      <form method="post" action="/assets/<%= asset.id %>/mesh-install" style="margin:0;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button class="btn" type="submit">Try again</button>
      </form>
    </div>
  <% } else if (!_ms.enabled) { %>
    <div class="alert" style="border:1px solid var(--warn-line);">
      <strong>Remote access is switched off for <%= _ms.customer || 'this customer' %>.</strong>
      <span class="muted">Turn it on for the customer and it installs everywhere automatically.</span>
    </div>
  <% } else if (!_ms.hasPackage) { %>
    <div class="alert" style="border:1px solid var(--warn-line);display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <span><strong><%= _ms.customer || 'This customer' %> has no remote-access agent yet.</strong>
      <span class="muted">One gets built per customer, then installs itself on every machine they have.</span></span>
      <a class="btn" href="/agents" style="margin-left:auto;">Agents page</a>
    </div>
  <% } else if (_ms.installed) { %>
    <div class="alert" style="border:1px solid var(--warn-line);display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap;">
      <span style="flex:1;min-width:300px;">
        <strong>Remote access is installed on this machine, but the Portal has not been told which machine it is.</strong>
        <span class="muted" style="display:block;margin-top:4px;"><%= _ms.strandedDetail || 'The machine has not been linked to a MeshCentral node yet.' %></span>
        <% if (_ms.installedAt) { %><span class="muted" style="display:block;font-size:11.5px;margin-top:4px;">The agent reported a clean install <%= _ago(_ms.installedAt) %>.</span><% } %>
        <span class="muted" style="display:block;font-size:11.5px;margin-top:4px;">Reinstalling will not fix this — the Mesh Agent is already there. It is the link that is missing.</span>
      </span>
      <span style="display:flex;gap:8px;margin-left:auto;">
        <a class="btn" href="/agents">Bridge status</a>
        <form method="post" action="/assets/<%= asset.id %>/mesh-install" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button class="btn" type="submit">Reinstall anyway</button>
        </form>
      </span>
    </div>
  <% } else { %>
    <div class="alert" style="border:1px solid var(--warn-line);display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <span style="flex:1;min-width:280px;"><strong>Remote control is not installed on this machine yet.</strong>
      <span class="muted">Installing takes a minute and needs nobody at the far end — the LumenMSP agent does it.</span>
      <% if (user.role === 'admin' && _ms.lastAttempt && _ms.lastAttempt.output) { %>
        <span class="muted" style="display:block;font-size:11.5px;margin-top:5px;">Last attempt <%= _ms.lastAttempt.status %><% if (_ms.lastAttempt.exitCode != null) { %> (exit <%= _ms.lastAttempt.exitCode %>)<% } %> <%= dt(_ms.lastAttempt.finishedAt || _ms.lastAttempt.startedAt) %>:<br>
        <span style="font-family:ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;"><%= _ms.lastAttempt.output %></span></span>
      <% } %></span>
      <form method="post" action="/assets/<%= asset.id %>/mesh-install" style="margin:0 0 0 auto;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button class="btn btn-primary" type="submit">🖥 Install remote control</button>
      </form>
    </div>
  <% } %>
<% } %>


<% if (!_ours) { %>
<div class="card" style="background:var(--tint-warn);border-color:var(--warn-line);">
  <p style="margin:0;font-size:13px;color:var(--warn-deep);">
    <strong>Imported from Atera — no LumenMSP Agent on this machine.</strong> Everything below is whatever Atera last reported, and the
    Portal cannot describe it, patch it or remote onto it until our agent is installed. It shows as offline here for that reason.
    <a href="/agents#download" style="font-weight:600;">Install the LumenMSP Agent &rarr;</a>
  </p>
</div>
<% } %>

<div class="card">
  <nav class="dev-tabs">
    <button type="button" data-tab="overview">Overview</button>
    <button type="button" data-tab="hardware">Hardware</button>
    <button type="button" data-tab="os">OS</button>
<% var _isServer = (typeof serverFacts !== 'undefined' && serverFacts); %>
<% if (_isServer) { %><button type="button" data-tab="server">Server<% var _sb = (serverAlerts||[]).filter(function(a){ return a.level==='bad'; }).length; %><% if (_sb) { %> <span style="color:var(--bad-fg);">●</span><% } %></button><% } %>
<% if (typeof gpo !== 'undefined' && gpo) { %><button type="button" data-tab="gpo">Group Policy<% if (gpo.bad) { %> <span style="color:var(--bad-fg);">&#9679;</span><% } %></button><% } %>
    <button type="button" data-tab="security">Security<% if (typeof security !== 'undefined' && security && security.bad) { %> <span style="color:var(--bad-fg);">&#9679;</span><% } %></button>
    <button type="button" data-tab="backup">Backup<% if (backupPlans.length && backupPlans.some(function(p){ return p.cls==='failed'; })) { %> <span style="color:var(--bad-fg);">●</span><% } %></button>
  </nav>

  <section class="dev-tab-panel" data-key="overview">
    <div class="dev-info-cols">
      <div>
        <p class="dev-subcard-title">Device info</p>
        <div class="dev-field-row"><div class="k">Machine name</div><div class="v"><%= fmt(asset.hostname) %></div></div>
        <div class="dev-field-row"><div class="k">Domain / Workgroup</div><div class="v"><%= fmt(asset.domain_or_workgroup) %></div></div>
        <div class="dev-field-row"><div class="k">Public IP</div><div class="v"><%= fmt(asset.public_ip) %></div></div>
        <div class="dev-field-row"><div class="k">Local IP address(es)</div><div class="v"><%= fmt(asset.ip_addresses) %></div></div>
        <div class="dev-field-row"><div class="k">MAC address</div><div class="v"><%= fmt(asset.mac_address) %></div></div>
        <div class="dev-field-row"><div class="k">Signed-in user</div><div class="v"><%= fmt(asset.last_login_user) %></div></div>
        <div class="dev-field-row"><div class="k">Disks</div><div class="v"><%= fmt(asset.disk_info) %></div></div>
        <div class="dev-field-row"><div class="k">Last seen</div><div class="v"><%= dt(asset.last_seen_at) %></div></div>
        <div class="dev-field-row"><div class="k">Last reboot</div><div class="v"><%= dt(asset.last_reboot_at) %></div></div>
        <div class="dev-field-row"><div class="k">Date added</div><div class="v"><%= dt(asset.added_at) %></div></div>
      </div>
      <% if (typeof agentInfo !== 'undefined' && agentInfo) {
           // Same window as the list and the SQL — passed in, never re-typed.
           var _win = (typeof onlineWindowSecs !== 'undefined' && onlineWindowSecs) ? onlineWindowSecs : 180;
           var agOnline = agentInfo.seen_secs != null && Number(agentInfo.seen_secs) < _win;
      %>
      <div>
        <p class="dev-subcard-title" style="display:flex;align-items:center;gap:6px;"><img src="/static/img/lumen-agent-16.png" width="14" height="14" alt=""> Reported by</p>
        <div class="dev-field-row"><div class="k">Source</div><div class="v">LumenMSP Agent <span class="muted">(this machine, live)</span></div></div>
        <div class="dev-field-row"><div class="k">Status</div><div class="v">
          <span style="display:inline-flex;align-items:center;gap:5px;font-weight:600;color:<%= agOnline ? 'var(--ok)' : 'var(--faint)' %>;">
            <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= agOnline ? 'var(--ok)' : 'var(--line-strong)' %>;"></span>
            <%= agOnline ? 'Online' : 'Offline' %>
          </span>
        </div></div>
        <div class="dev-field-row"><div class="k">Agent version</div><div class="v"><strong><%= agentInfo.agent_version ? 'v' + agentInfo.agent_version : '—' %></strong><% if (typeof latestAgentVersion !== 'undefined' && latestAgentVersion && agentInfo.agent_version && agentInfo.agent_version !== latestAgentVersion) { %> <span class="badge badge-inactive" title="Self-updates to v<%= latestAgentVersion %> within 6 hours">update due</span><% } %></div></div>
        <div class="dev-field-row"><div class="k">Last check-in</div><div class="v"><%= dt(agentInfo.last_seen_at) %></div></div>
        <div class="dev-field-row"><div class="k">&nbsp;</div><div class="v"><a class="row-link" href="/agents">Manage agents &rarr;</a></div></div>
      </div>
      <% } else { %>
      <div>
        <p class="dev-subcard-title">Reported by</p>
        <div class="dev-field-row"><div class="k">Source</div><div class="v">Atera <span class="muted">(import only)</span></div></div>
        <div class="dev-field-row"><div class="k">Status</div><div class="v"><span class="muted">Offline — the Portal has no live link to this machine.</span></div></div>
        <div class="dev-field-row"><div class="k">Last imported</div><div class="v"><%= dt(asset.synced_at) %></div></div>
        <div class="dev-field-row"><div class="k">&nbsp;</div><div class="v"><a class="row-link" href="/agents#download">Install the LumenMSP Agent &rarr;</a></div></div>
      </div>
      <% } %>
      <div>
        <p class="dev-subcard-title">Device relations</p>
        <div class="dev-field-row">
          <div class="k">Customer</div>
          <div class="v">
            <% if (asset.customer_id) { %><a class="row-link" href="/customers/<%= asset.customer_id %>#assets"><%= asset.customer_name %></a>
            <% } else { %><span class="muted">Not matched yet</span><% } %>
          </div>
        </div>
        <div class="dev-field-row"><div class="k">Assigned user</div><div class="v">
          <% if (asset.customer_id) { %>
          <form method="post" action="/assets/<%= asset.id %>/assign" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <select class="input" name="contact_id" style="font-size:12px;padding:4px 8px;max-width:230px;">
              <option value="">&mdash; unallocated &mdash;</option>
              <% (contactOptions || []).forEach(function(ct){ %><option value="<%= ct.id %>" <%= asset.assigned_contact_id===ct.id?'selected':'' %>><%= ct.full_name %></option><% }); %>
            </select>
            <button class="btn" type="submit" style="padding:4px 10px;font-size:12px;">Save</button>
          </form>
          <% } else { %><span class="muted">match this device to a customer first</span><% } %>
        </div></div>
        <div class="dev-field-row"><div class="k">Record owner</div><div class="v"><span class="badge <%= _ours ? 'badge-sent' : 'badge-inactive' %>"><%= _ours ? 'LumenMSP Agent' : 'Atera import' %></span></div></div>
        <% var _ateraId = asset.atera_agent_id || (asset.source_system === 'atera' ? asset.external_id : null); %>
        <% if (_ateraId) { %>
        <div class="dev-field-row"><div class="k">Atera Agent ID</div><div class="v muted" style="font-family:monospace;font-size:12px;" title="Kept only so the old Atera deep-link still works while Atera is wound down."><%= _ateraId %></div></div>
        <% } %>
        <% if (asset.device_guid) { %>
        <div class="dev-field-row"><div class="k">Device GUID</div><div class="v muted" style="font-family:monospace;font-size:11px;overflow-wrap:anywhere;"><%= asset.device_guid %></div></div>
        <% } %>
      </div>
    </div>
    <p class="muted" style="font-size:12px;margin:14px 0 0;">"Assigned user" is who this machine belongs to, set here and never touched by any import — the signed-in user above is only whoever last logged on. Assign a person and their devices appear on any case they raise, with a jump-through and remote control.</p>
  </section>

  <% if (_isServer) { %><%- include('_server') %><% } %>

  <% if (typeof gpo !== 'undefined' && gpo) { %><%- include('_gpo', { gpo: gpo, asset: asset, user: user, csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '') }) %><% } %>

  <% if (user.role === 'admin') { %><%- include('_tools', {
        asset: asset, agentInfo: (typeof agentInfo !== 'undefined' ? agentInfo : null), user: user,
        patches: (typeof patches !== 'undefined' ? patches : []),
        patchMeta: (typeof patchMeta !== 'undefined' ? patchMeta : null),
        agentScripts: (typeof agentScripts !== 'undefined' ? agentScripts : []),
        csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '') }) %><% } %>

  <section class="dev-tab-panel" data-key="hardware">
    <div class="dev-info-cols">
      <div>
        <div class="dev-field-row"><div class="k">Manufacturer / Model</div><div class="v"><%= fmt([asset.manufacturer, asset.model].filter(Boolean).join(' ') || null) %></div></div>
        <div class="dev-field-row"><div class="k">Serial number</div><div class="v"><%= fmt(asset.serial_number) %></div></div>
        <div class="dev-field-row"><div class="k">Processor</div><div class="v"><%= fmt(asset.cpu) %></div></div>
        <div class="dev-field-row"><div class="k">RAM</div><div class="v"><%= asset.ram_gb ? asset.ram_gb + ' GB' : '—' %></div></div>
        <div class="dev-field-row"><div class="k">Disk</div><div class="v"><%= fmt(asset.disk_info) %></div></div>
      </div>
    </div>
  </section>

  <section class="dev-tab-panel" data-key="backup">
    <% if (!backupPlans.length) { %>
      <p class="muted" style="font-size:13px;">No backup plans reported for this device by MSP360. If it should be protected, check the machine name matches in MSP360 (<%= asset.hostname || 'no hostname' %>) — devices match by machine name.</p>
    <% } else { %>
      <p class="dev-subcard-title">Backup plans (<%= backupPlans[0].provider %>)</p>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Plan</th><th>Type</th><th>Last run</th><th>Next run</th><th>Data moved</th><th>Status</th></tr></thead>
        <tbody>
        <% backupPlans.forEach(function(p){ %>
          <tr>
            <td style="font-weight:600;"><%= p.planName %><% if (p.errorMessage) { %><div class="muted" style="font-size:11px;color:var(--bad-fg);"><%= p.errorMessage %></div><% } %></td>
            <td class="muted"><%= p.typeLabel || '—' %></td>
            <td class="muted" style="white-space:nowrap;"><%= dt(p.lastStart) %></td>
            <td class="muted" style="white-space:nowrap;"><%= dt(p.nextStart) %></td>
            <td class="muted"><%= p.dataCopiedH || '—' %><% if (p.totalDataH) { %> <span style="font-size:11px;">of <%= p.totalDataH %></span><% } %></td>
            <td><span class="badge <%= p.cls==='ok' ? 'badge-sent' : (p.cls==='failed' ? 'badge-failed' : 'badge-inactive') %>"><%= p.statusLabel %></span></td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <% if (backupHistory.length) { %>
        <p class="dev-subcard-title" style="margin-top:16px;">Recent history (last 14 days)</p>
        <div class="table-wrap"><table class="table">
          <thead><tr><th>Day</th><th>Plan</th><th>Result</th><th>Data moved</th></tr></thead>
          <tbody>
          <% backupHistory.forEach(function(h){ %>
            <tr>
              <td class="muted" style="white-space:nowrap;"><%= new Date(h.day + 'T00:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></td>
              <td class="muted"><%= h.planName %></td>
              <td><span class="badge <%= h.cls==='ok' ? 'badge-sent' : (h.cls==='failed' ? 'badge-failed' : 'badge-inactive') %>"><%= h.statusLabel %></span></td>
              <td class="muted"><%= h.dataCopiedH || '—' %></td>
            </tr>
          <% }); %>
          </tbody>
        </table></div>
      <% } else { %>
        <p class="muted" style="font-size:12px;margin-top:12px;">Daily history starts accruing from today's sync — the Portal keeps its own backup timeline per device from now on.</p>
      <% } %>
      <p class="muted" style="font-size:12px;margin-top:10px;">Synced nightly from MSP360; matched to this device by machine name. Company link for reporting is set on the customer's IT report page.</p>
    <% } %>
  </section>

  <section class="dev-tab-panel" data-key="security">
    <% var _sec = (typeof security !== 'undefined') ? security : null; %>
    <% if (!agentInfo) { %>
      <p class="muted" style="font-size:13px;">Security status needs the LumenMSP Agent on this machine &mdash; there is no live link to read it from.</p>
    <% } else if (!_sec || _sec.awaiting) { %>
      <p class="muted" style="font-size:13px;">
        The agent has not reported security status yet. It arrives with agent v1.0.24 on the daily pass
        <% if (user.role === 'admin') { %> &mdash; or ask the machine now:
        <button type="button" class="btn" style="padding:2px 10px;font-size:12px;" onclick="if(window.lmaSecurityRefresh)lmaSecurityRefresh(this);">Refresh from device</button>
        <span class="tool-busy" id="secBusy"></span>
        <% } %>
      </p>
    <% } else { %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th style="width:160px;">Protection</th><th>Product</th><th>Status</th></tr></thead>
        <tbody>
        <% _sec.rows.forEach(function (r) { %>
          <tr>
            <td style="font-weight:600;"><%= r.area %></td>
            <td><%= r.product %><% if (r.extra) { %><div class="muted" style="font-size:11.5px;"><%= r.extra %></div><% } %></td>
            <td>
              <span style="display:inline-flex;align-items:center;gap:6px;font-weight:600;color:<%= r.ok ? 'var(--ok)' : 'var(--bad-fg)' %>;">
                <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= r.ok ? 'var(--ok)' : 'var(--bad-fg)' %>;"></span>
                <%= r.detail %>
              </span>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <p class="muted" style="font-size:12px;margin:12px 0 0;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <span>Collected <%= dt(_sec.collectedAt) %> by the agent<% if (_sec.stale) { %> &mdash; <strong style="color:var(--warn-fg);">over two days old</strong>; the machine has probably been off<% } %>. Refreshes on the daily inventory pass.</span>
        <% if (user.role === 'admin') { %>
        <button type="button" class="btn" style="padding:2px 10px;font-size:12px;" onclick="if(window.lmaSecurityRefresh)lmaSecurityRefresh(this);">Refresh from device</button>
        <span class="tool-busy" id="secBusy"></span>
        <% } %>
      </p>
    <% } %>
  </section>

  <section class="dev-tab-panel" data-key="os">
    <div class="dev-info-cols">
      <div>
        <div class="dev-field-row"><div class="k">Operating system</div><div class="v"><%= fmt(asset.os) %></div></div>
        <div class="dev-field-row"><div class="k">Version / build</div><div class="v"><%= fmt(asset.os_version) %></div></div>
      </div>
    </div>
  </section>
</div>

<% if (typeof rawJson !== 'undefined' && rawJson) { %>
<div class="card">
  <details>
    <summary style="cursor:pointer;font-weight:600;font-size:13px;color:var(--muted);">🔧 Raw Atera payload (debug — admin only, ?debug=1)</summary>
    <pre style="margin-top:10px;font-size:11px;line-height:1.5;overflow:auto;max-height:500px;background:var(--ink-chip);color:var(--line);padding:14px;border-radius:8px;"><%= rawJson %></pre>
  </details>
</div>
<% } %>

<script>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.dev-tabs button'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.dev-tab-panel'));
    function show(k) {
      tabs.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-tab') === k); });
      panels.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-key') === k); });
    }
    tabs.forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-tab')); }); });
    // Always open on the first tab. A deep link (#gpo, #security, #backup) still jumps
    // straight to its tab - what we no longer do is restore whichever tab happened to be
    // open on the last visit, which made "go to a device" land somewhere different every time.
    var hash = (location.hash || '').replace('#', '');
    show((hash && document.querySelector('.dev-tab-panel[data-key="' + hash + '"]')) ? hash : 'overview');
  })();
</script>

<%- include('../partials/power-menu') %>
<%- include('../partials/command-progress') %>

<% if (typeof gpo !== 'undefined' && gpo) { %>
<%- include('../gpo/_ask-script') %>
<script>
(function () {
  var CUST = <%= gpo.customerId %>;
  var panel = document.getElementById('gpoAskPanel');
  if (!panel) return;
  var form = document.getElementById('gpoAskForm');
  var input = document.getElementById('gpoAskInput');
  var go = document.getElementById('gpoAskGo');
  var head = document.getElementById('gpoAskQ');
  var body = document.getElementById('gpoAskBody');

  function ask(q) { input.value = q; window.gpoAsk({ customer_id: CUST }, q, head, body, go); }

  var chips = document.getElementById('gpoAskChips');
  ['Does anything here weaken security?',
   'Which of these policies overlap or contradict each other?',
   'Which of these are doing nothing and could go?'].forEach(function (t) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'btn'; b.style.cssText = 'font-size:12px;padding:3px 10px;';
    b.textContent = t;
    b.addEventListener('click', function () { ask(t); });
    chips.appendChild(b);
  });

  document.getElementById('gpoAskBtn').addEventListener('click', function () {
    panel.style.display = 'block';
    input.focus();
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  document.getElementById('gpoAskClose').addEventListener('click', function () { panel.style.display = 'none'; });
  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var q = (input.value || '').trim();
    if (q) window.gpoAsk({ customer_id: CUST }, q, head, body, go);
  });
})();
</script>
<% } %>

<% var _track = (typeof trackCommandId !== 'undefined' && trackCommandId) ? trackCommandId
                : ((typeof gpo !== 'undefined' && gpo && gpo.pendingId) ? gpo.pendingId : null); %>
<% if (_track) { %>
<script>
// A queued collection follows itself and reloads the page when it lands, so nobody has
// to sit there pressing refresh wondering whether the button did anything.
document.addEventListener('DOMContentLoaded', function () {
  var mount = document.getElementById('gpoTrack');
  if (mount && window.trackCommand) {
    window.trackCommand({ id: <%= _track %>, mount: mount, onDone: 'reload', title: 'Reading Group Policy…' });
    var t = document.querySelector('[data-tab="gpo"]');
    if (t && location.hash === '#gpo') t.click();
  }
});
</script>
<% } %>

<%- include('../partials/footer') %>
