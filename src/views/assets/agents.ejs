<%- include('../partials/header', { title: 'LumenMSP Agents', user }) %>
<% function dt(v){ return v ? new Date(v).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'; } %>
<% // Online-ness comes from the DATABASE clock (seen_secs), never from subtracting a
   // db timestamp from this process's clock — that breaks on any timezone mismatch.
   function isOnline(d){ return d.seen_secs != null && Number(d.seen_secs) < 12*60; } %>
<%
  // 1.0.2 is the first build containing the self-update worker. Anything older can never
  // update itself, however the rollout is set - it is STRANDED until someone reinstalls
  // it by hand. Saying "update due" on those would imply it sorts itself out.
  var SELF_UPDATE_FROM = [1, 0, 2];
  function verParts(v){ return String(v || '').split('.').map(function(n){ return parseInt(n, 10) || 0; }); }
  function olderThan(v, ref){
    var a = verParts(v);
    for (var i = 0; i < ref.length; i++) {
      var x = a[i] || 0;
      if (x !== ref[i]) return x < ref[i];
    }
    return false;
  }
  function stranded(v){ return !!v && olderThan(v, SELF_UPDATE_FROM); }
%>

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/assets">← Assets</a></p>
    <h1 style="margin:0;">LumenMSP Agents</h1>
    <p class="muted" style="margin:6px 0 0;">Devices running the LumenMSP Agent — chat, system info and end-user tools. Online = heartbeat in the last 12 minutes.</p>
  </div>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card" id="download" style="margin-bottom:20px;">
  <h3 style="margin-top:0;">Download the agent</h3>
  <% if (!msi) { %>
    <p class="muted" style="font-size:13px;margin:0;">No installer uploaded yet<%= isAdmin ? ' - upload dist\\LumenMSPAgent.msi below.' : ' - ask an admin to upload it.' %></p>
  <% } else { %>
  <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
    <label style="flex:1;min-width:280px;">Customer
      <select class="input" id="dlCustomer">
        <% customers.forEach(function(c){ if (c.agent_site_key) { %>
        <option value="<%= c.agent_site_key %>"><%= c.name %></option>
        <% } }); %>
      </select>
    </label>
    <a class="btn btn-primary" id="dlBtn" href="#" style="white-space:nowrap;">&#11015; Download MSI</a>
  </div>
  <p class="muted" style="font-size:12px;margin:12px 0 6px;">The customer's key is built into the filename, so the installer just runs - no options, no key to type. Or paste this into an <strong>elevated</strong> PowerShell on the machine (also fine as an RMM script):</p>
  <div style="display:flex;gap:8px;align-items:flex-start;">
    <textarea class="input" id="dlCmd" readonly rows="3" style="flex:1;font-family:ui-monospace,Consolas,monospace;font-size:11.5px;line-height:1.5;" onclick="this.select();"></textarea>
    <button class="btn" type="button" id="dlCopy" style="white-space:nowrap;">Copy</button>
  </div>
  <% } %>
</div>

<% if (isAdmin) {
     var _mb = typeof meshBridge !== 'undefined' ? meshBridge : null;
     var _stranded = typeof meshStranded !== 'undefined' ? Number(meshStranded) : 0;
     var _loose = typeof meshLoose !== 'undefined' ? meshLoose : [];
     var _ageH = _mb ? Math.round(_mb.ageSecs / 3600) : null;
     var _watch = typeof meshWatchingSecs !== 'undefined' ? Number(meshWatchingSecs) : 99999;
     var _cycle = typeof meshCycleSecs !== 'undefined' ? Number(meshCycleSecs) : 300;
     // No report yet, but the Portal has only just restarted: that is a wait, not a fault.
     // The two look identical in the database and mean completely different things.
     var _rej = typeof meshReject !== 'undefined' ? meshReject : null;
     var _con = typeof meshContact !== 'undefined' ? meshContact : null;
     // Alive: it authenticated recently, whether or not it got as far as syncing devices.
     var _alive = _con && _con.ageSecs < _cycle * 3;
     var _tooSoon = !_mb && !_rej && !_alive && _watch < _cycle * 3;
     var _bad = !_tooSoon && (!_mb || _mb.ageSecs > 6 * 3600);
     var _warn = !_bad && (_tooSoon || _stranded > 0 || _loose.length > 0);
%>
<div class="card" style="border-left:3px solid <%= _bad ? 'var(--bad-fg)' : (_warn ? 'var(--warn-fg)' : 'var(--ok)') %>;">
  <h3 style="margin-top:0;">Remote access &mdash; mesh bridge</h3>
  <p class="muted" style="margin:0 0 8px;font-size:12.5px;">
    The bridge on mesh01 is what links a machine to its MeshCentral node. Remote control only
    works on machines it has linked, so if it stops, everything installed after that point is stranded.
  </p>
  <% if (!_mb && _tooSoon) { %>
    <p style="margin:0;font-size:13.5px;color:var(--warn-fg);">
      <strong>Waiting for the bridge's first report.</strong>
      <span class="muted">The Portal restarted <%= Math.max(1, Math.round(_watch / 60)) %> minute<%= Math.round(_watch / 60) === 1 ? '' : 's' %> ago
      and only starts counting from then, so this is not evidence of anything yet. The bridge reports every
      <%= Math.round(_cycle / 60) %> minutes &mdash; give it a cycle and reload.</span>
    </p>
  <% } else if (!_mb && _alive) { %>
    <p style="margin:0;font-size:13.5px;color:var(--bad-fg);">
      <strong>The bridge is running and reaching the Portal, but never finishes a run.</strong>
      It last called in <%= Math.max(1, Math.round(_con.ageSecs / 60)) %> minute<%= Math.round(_con.ageSecs / 60) === 1 ? '' : 's' %> ago
      &mdash; so the Portal, its secret and the network are all fine &mdash; but it has never got as far as reporting devices.
      It is failing inside its own run, which almost always means MeshCentral is refusing its login.
      On mesh01: <code>journalctl -u lumen-mesh-bridge.service -n 40 --no-pager</code>.
    </p>
  <% } else if (!_mb && _rej) { %>
    <p style="margin:0;font-size:13.5px;color:var(--bad-fg);">
      <strong>The bridge is running, but the Portal is turning it away.</strong>
      Something tried <%= _rej.ageSecs < 3600 ? Math.max(1, Math.round(_rej.ageSecs / 60)) + ' minutes' : Math.round(_rej.ageSecs / 3600) + ' hours' %> ago and was rejected:
      <em><%= _rej.reason %></em>.
      Set <code>PORTAL_SECRET</code> on mesh01 to the same value as the bridge secret in Settings, and it will link everything on its next run.
    </p>
  <% } else if (!_mb) { %>
    <p style="margin:0;font-size:13.5px;color:var(--bad-fg);"><strong>The bridge has not reported in the <%= Math.round(_watch / 60) %> minutes since the Portal restarted.</strong>
      It reports every <%= Math.round(_cycle / 60) %> minutes, and nothing has even reached the Portal, so it is not running at all.
      On mesh01, check that its schedule still exists &mdash; <code>crontab -l</code> or <code>systemctl list-timers</code> &mdash; and try one run by hand.</p>
  <% } else { %>
    <p style="margin:0 0 6px;font-size:13.5px;<%= _bad ? 'color:var(--bad-fg);' : '' %>">
      <strong>Last reported <%= _mb.ageSecs < 3600 ? Math.round(_mb.ageSecs / 60) + ' minutes' : _ageH + ' hours' %> ago</strong>
      &mdash; <%= _mb.received %> node<%= _mb.received === 1 ? '' : 's' %> seen, <%= _mb.matched %> linked<% if (_mb.unmatched) { %>,
      <span style="color:var(--warn-fg);"><%= _mb.unmatched %> it could not place</span><% } %>.
      <% if (_bad) { %> That is long enough to assume it has stopped.<% } %>
    </p>
  <% } %>
  <% if (_stranded) { %>
    <p style="margin:6px 0 0;font-size:13px;">
      <strong style="color:var(--warn-fg);"><%= _stranded %></strong> machine<%= _stranded === 1 ? ' has' : 's have' %>
      the Mesh Agent installed but no node linked &mdash; remote control will not open on <%= _stranded === 1 ? 'it' : 'them' %>.
      <% if (_tooSoon || (_mb && _mb.ageSecs < _cycle * 2)) { %><span class="muted">These should link themselves on the bridge's next run.</span><% } %>
    </p>
  <% } %>
  <% if (_loose.length) { %>
    <details style="margin-top:8px;">
      <summary style="cursor:pointer;font-size:12.5px;">Nodes MeshCentral has that the Portal could not place (<%= _loose.length %>)</summary>
      <div class="table-wrap" style="margin-top:6px;">
        <table class="table">
          <thead><tr><th>Machine</th><th>Device group</th><th>Seen</th></tr></thead>
          <tbody>
            <% _loose.forEach(function (n) { %>
              <tr>
                <td><%= n.hostname || '(unnamed)' %></td>
                <td style="font-family:ui-monospace,Consolas,monospace;font-size:11.5px;"><%= n.group_id || '-' %></td>
                <td class="muted" style="font-size:12.5px;white-space:nowrap;"><%= n.seen_at ? new Date(n.seen_at).toLocaleString('en-GB') : '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="muted" style="margin:6px 0 0;font-size:12px;">
        A node here is in a MeshCentral device group that no customer in the Portal is linked to, or under a name
        the Portal does not have. The group id is the thing to check.
      </p>
    </details>
  <% } %>
</div>
<% } %>

<% if (isAdmin && rollout && rollout.version) {
     var stage = rollout.stage;
     var stageLabel = stage === -1 ? 'Halted' : stage === 0 ? 'Internal only' : stage === 1 ? 'Internal + pilot' : 'Everyone';
     var stageColour = stage === -1 ? 'var(--bad-fg)' : stage === 2 ? 'var(--ok)' : 'var(--warn-fg)';
     var byRing = {}; (ringCounts || []).forEach(function(r){ byRing[r.ring] = r; });
     function ringN(n){ return (byRing[n] && byRing[n].n) || 0; }
     function ringBehind(n){ return (byRing[n] && byRing[n].behind) || 0; }
%>
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-top:0;">Rollout &mdash; v<%= rollout.version %></h3>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">
    Status: <strong style="color:<%= stageColour %>;"><%= stageLabel %></strong>.
    A newly published build always starts at <em>internal only</em> &mdash; promote it once you are happy.
    Agents check every 6 hours.
  </p>
  <div style="display:flex;gap:18px;flex-wrap:wrap;margin-bottom:12px;font-size:12.5px;">
    <div><strong>Ring 0 &middot; internal</strong><br><span class="muted"><%= ringN(0) %> device<%= ringN(0)===1?'':'s' %>, <%= ringBehind(0) %> to update</span></div>
    <div><strong>Ring 1 &middot; pilot</strong><br><span class="muted"><%= ringN(1) %> device<%= ringN(1)===1?'':'s' %>, <%= ringBehind(1) %> to update</span></div>
    <div><strong>Ring 2 &middot; everyone</strong><br><span class="muted"><%= ringN(2) %> device<%= ringN(2)===1?'':'s' %>, <%= ringBehind(2) %> to update</span></div>
  </div>
  <% var strandedRows = (rows || []).filter(function(d){ return !d.revoked && stranded(d.agent_version); }); %>
  <% if (strandedRows.length) { %>
  <div class="alert alert-error" style="margin:0 0 12px;font-size:12.5px;">
    <strong><%= strandedRows.length %> device<%= strandedRows.length===1?'':'s' %> cannot self-update</strong> &mdash;
    <%= strandedRows.map(function(d){ return d.hostname + ' (v' + d.agent_version + ')'; }).join(', ') %>.
    Builds before 1.0.2 have no update worker, so they stay on their current version until the MSI is reinstalled on them by hand.
  </div>
  <% } %>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
    <% if (stage < 1) { %>
    <form method="post" action="/agents/rollout" style="display:inline;"><input type="hidden" name="stage" value="1">
      <button class="btn btn-primary" type="submit" onsubmit="">Promote to pilot</button></form>
    <% } %>
    <% if (stage < 2) { %>
    <form method="post" action="/agents/rollout" style="display:inline;" onsubmit="return confirm('Release v<%= rollout.version %> to EVERY enrolled device?');">
      <input type="hidden" name="stage" value="2"><button class="btn btn-primary" type="submit">Release to everyone</button></form>
    <% } %>
    <% var behindNow = (rows || []).filter(function(d){ return !d.revoked && d.agent_version && d.agent_version !== rollout.version && !stranded(d.agent_version); }); %>
    <% if (behindNow.length) { %>
    <form method="post" action="/agents/update-all" style="display:inline;"
          onsubmit="return confirm('Push v<%= rollout.version %> to <%= behindNow.length %> device(s) right now, ignoring the rollout stage?');">
      <button class="btn" type="submit" title="Skip the 6-hour wait and the ring gate for every device that is behind">Update <%= behindNow.length %> now</button>
    </form>
    <% } %>
    <% if (stage >= 0) { %>
    <form method="post" action="/agents/rollout" style="display:inline;" onsubmit="return confirm('Halt this rollout? No device will update until you resume.');">
      <input type="hidden" name="stage" value="-1"><button class="btn" type="submit">Halt</button></form>
    <% } else { %>
    <form method="post" action="/agents/rollout" style="display:inline;"><input type="hidden" name="stage" value="0">
      <button class="btn" type="submit">Resume (internal only)</button></form>
    <% } %>
    <span class="muted" style="font-size:11.5px;">
      <% if (hostedSha) { %>sha256 <%= hostedSha.slice(0,12) %>&hellip; verified by every agent before install<% } else { %><strong style="color:var(--warn-fg);">No checksum published &mdash; agents will refuse to self-update. Re-run build.ps1.</strong><% } %>
    </span>
  </div>
</div>
<% } %>

<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-top:0;">Enrolled devices (<span id="agShown"><%= rows.length %></span> of <%= rows.length %>)</h3>
  <% if (!rows.length) { %>
    <p class="muted">No devices yet. Generate a site key below, then install the agent MSI with <code>SITEKEY=&lt;key&gt;</code>.</p>
  <% } else { %>

  <%
    // Counts for the chips, worked out once here rather than in the browser.
    var _agOnline = 0, _agOffline = 0, _agBehind = 0, _agStranded = 0, _agRevoked = 0, _agAd = 0, _agNoAsset = 0;
    rows.forEach(function (d) {
      if (d.revoked) { _agRevoked++; return; }
      if (isOnline(d)) { _agOnline++; } else { _agOffline++; }
      if (latestVersion && d.agent_version && d.agent_version !== latestVersion) {
        if (stranded(d.agent_version)) { _agStranded++; } else { _agBehind++; }
      }
      if (d.is_ad_agent) _agAd++;
      if (!d.asset_id) _agNoAsset++;
    });
    var _agCustomers = [];
    var _agSeen = {};
    rows.forEach(function (d) {
      if (d.customer_id && !_agSeen[d.customer_id]) { _agSeen[d.customer_id] = 1; _agCustomers.push({ id: d.customer_id, name: d.customer_name }); }
    });
    _agCustomers.sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
  %>

  <div class="ag-bar">
    <input class="input ag-search" id="agSearch" type="search" autofocus
           placeholder="Search hostname, user, serial, IP or customer…">
    <select class="input ag-cust" id="agCust">
      <option value="">All customers</option>
      <% _agCustomers.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
    </select>
    <div class="ag-chips" id="agChips">
      <button type="button" class="ag-chip on" data-f="">All <span><%= rows.length %></span></button>
      <button type="button" class="ag-chip" data-f="online">Online <span><%= _agOnline %></span></button>
      <button type="button" class="ag-chip" data-f="offline">Offline <span><%= _agOffline %></span></button>
      <% if (_agBehind) { %><button type="button" class="ag-chip" data-f="behind">Update due <span><%= _agBehind %></span></button><% } %>
      <% if (_agStranded) { %><button type="button" class="ag-chip" data-f="stranded">Manual reinstall <span><%= _agStranded %></span></button><% } %>
      <% if (_agAd) { %><button type="button" class="ag-chip" data-f="ad">AD agents <span><%= _agAd %></span></button><% } %>
      <% if (_agNoAsset) { %><button type="button" class="ag-chip" data-f="noasset">No asset <span><%= _agNoAsset %></span></button><% } %>
      <% if (_agRevoked) { %><button type="button" class="ag-chip" data-f="revoked">Revoked <span><%= _agRevoked %></span></button><% } %>
    </div>
  </div>

  <div style="overflow-x:auto;" class="ag-tablewrap">
    <table class="table">
      <thead><tr><th></th><th>Device</th><th>Customer</th><th>User</th><th>Local IPs</th><th>Public IP</th><th>Version</th><th>Last seen</th><% if (isAdmin) { %><th>Ring</th><th>AD agent</th><th></th><% } %></tr></thead>
      <tbody>
        <% rows.forEach(function(d){ var on = !d.revoked && isOnline(d);
             var _f = [];
             if (d.revoked) { _f.push('revoked'); } else { _f.push(on ? 'online' : 'offline'); }
             if (!d.revoked && latestVersion && d.agent_version && d.agent_version !== latestVersion) {
               _f.push(stranded(d.agent_version) ? 'stranded' : 'behind');
             }
             if (d.is_ad_agent) _f.push('ad');
             if (!d.asset_id) _f.push('noasset');
             var _hay = [d.hostname, d.serial_number, d.logged_in_user, d.local_ips, d.public_ip,
                         d.customer_name, d.agent_version].filter(Boolean).join(' ').toLowerCase();
        %>
        <tr class="ag-row" data-f="<%= _f.join(' ') %>" data-cust="<%= d.customer_id || '' %>"
            data-hay="<%= _hay.replace(/"/g, '&quot;') %>" style="<%= d.revoked ? 'opacity:.5;' : '' %>">
          <td><span title="<%= d.revoked ? 'Revoked' : (on ? 'Online' : 'Offline') %>" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= d.revoked ? 'var(--bad-fg)' : (on ? 'var(--ok)' : 'var(--line-strong)') %>;"></span></td>
          <td>
            <% if (d.asset_id) { %>
              <a class="row-link" href="/assets/<%= d.asset_id %>?back=<%= encodeURIComponent('/agents') %>" style="font-weight:700;" title="Open this device - system info, backup and the Tools tab"><%= d.hostname || '(unnamed)' %></a>
            <% } else { %>
              <strong><%= d.hostname || '(unnamed)' %></strong>
              <span class="muted" style="font-size:10.5px;" title="No matching Atera asset - the device may not be in Atera, or its serial/hostname differs">(no asset)</span>
            <% } %>
            <% if (d.serial_number) { %><div class="muted" style="font-size:11px;"><%= d.serial_number %></div><% } %>
          </td>
          <td>
            <% if (d.customer_id) { %><a class="row-link" href="/customers/<%= d.customer_id %>"><%= d.customer_name %></a><% } else { %><span class="muted">—</span><% } %>
            <% if (isAdmin) { var known = (customers || []).some(function(c){ return c.id === d.customer_id; }); %>
            <form method="post" action="/agents/<%= d.id %>/customer" style="margin-top:3px;"
                  onsubmit="return confirm('Move <%= d.hostname %> to another customer? Its open cases move with it.');">
              <select class="input" name="customer_id" style="font-size:11px;padding:1px 4px;width:auto;max-width:150px;"
                      onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit();" title="Move this device to another customer">
                <% if (!known && d.customer_id) { %><option value="<%= d.customer_id %>" selected><%= d.customer_name %></option><% } %>
                <% (customers || []).forEach(function(c){ %><option value="<%= c.id %>" <%= c.id === d.customer_id ? 'selected' : '' %>><%= c.name %></option><% }); %>
              </select>
            </form>
            <% } %>
          </td>
          <td><%= d.logged_in_user || '—' %></td>
          <td style="font-size:12px;"><%= d.local_ips || '—' %></td>
          <td style="font-size:12px;"><%= d.public_ip || '—' %></td>
          <td><%= d.agent_version || '—' %><% if (latestVersion && d.agent_version && d.agent_version !== latestVersion && !d.revoked) { %>
            <% if (stranded(d.agent_version)) { %> <span class="badge badge-failed" title="This build predates self-update - it will NOT update itself. Reinstall the MSI on this machine once.">manual reinstall</span>
            <% } else { %> <span class="badge badge-inactive" title="Self-updates to <%= latestVersion %> within 6 hours (once its ring is in scope)">update due</span><% } %>
          <% } %></td>
          <td><%= dt(d.last_seen_at) %></td>
          <% if (isAdmin) { %>
          <td>
            <form method="post" action="/agents/<%= d.id %>/ring" style="display:inline;">
              <select class="input" name="ring" style="font-size:11.5px;padding:2px 6px;width:auto;" onchange="this.form.submit();" title="0 internal, 1 pilot, 2 everyone">
                <option value="0" <%= (d.update_ring===0)?'selected':'' %>>0 internal</option>
                <option value="1" <%= (d.update_ring===1)?'selected':'' %>>1 pilot</option>
                <option value="2" <%= (d.update_ring==null||d.update_ring===2)?'selected':'' %>>2 everyone</option>
              </select>
            </form>
          </td>
          <td style="white-space:nowrap;">
            <% if (!d.revoked && d.customer_id) { %>
            <form method="post" action="/agents/<%= d.id %>/ad-agent" style="display:inline;">
              <input type="hidden" name="on" value="<%= d.is_ad_agent ? '0' : '1' %>">
              <button class="btn btn-small" type="submit" title="The device that runs Active Directory actions for this customer - use a DC or management server"><%= d.is_ad_agent ? '\u2713 AD agent' : 'Set' %></button>
            </form>
            <% } else { %><span class="muted" style="font-size:12px;">&mdash;</span><% } %>
          </td>
          <td style="white-space:nowrap;">
            <% if (!d.revoked && latestVersion && d.agent_version && d.agent_version !== latestVersion && !stranded(d.agent_version)) { %>
            <form method="post" action="/agents/<%= d.id %>/update-now" style="display:inline;"
                  onsubmit="return confirm('Push v<%= latestVersion %> to <%= d.hostname %> now? The agent restarts as it installs.');">
              <button class="btn btn-small btn-primary" type="submit" title="Download, verify and install v<%= latestVersion %> immediately">Update now</button>
            </form>
            <% } %>
            <% if (!d.revoked) { %>
            <form method="post" action="/agents/<%= d.id %>/revoke" style="display:inline;" onsubmit="return confirm('Revoke this device? Its agent stops working until the MSI is reinstalled.');">
              <button class="btn btn-small" type="submit">Revoke</button>
            </form>
            <% } else { %><span class="muted" style="font-size:12px;">revoked</span><% } %>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="muted" id="agNone" style="display:none;padding:14px 2px;">Nothing matches that. <a href="#" id="agClear">Clear the filters</a>.</p>

  <style>
    .ag-bar { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin:0 0 12px; }
    .ag-search { flex:0 1 300px; min-width:190px; font-size:13px; padding:6px 10px; }
    .ag-cust { width:auto; max-width:230px; font-size:13px; padding:6px 8px; }
    .ag-chips { display:flex; gap:6px; flex-wrap:wrap; }
    .ag-chip { font-size:12px; padding:3px 10px; border-radius:999px; cursor:pointer;
               border:1px solid var(--line-strong); background:transparent; color:var(--text-2); }
    .ag-chip span { opacity:.65; margin-left:4px; font-variant-numeric:tabular-nums; }
    .ag-chip:hover { border-color:var(--blue); }
    .ag-chip.on { background:var(--blue); border-color:var(--blue); color:#fff; }
    .ag-chip.on span { opacity:.85; }
    /* 141 machines is a lot of scrolling - keep the header in view. */
    .ag-tablewrap { max-height:70vh; overflow:auto; }
    .ag-tablewrap thead th { position:sticky; top:0; background:var(--card,#fff); z-index:2; }
  </style>
  <script>
  (function () {
    var rows = Array.prototype.slice.call(document.querySelectorAll('.ag-row'));
    if (!rows.length) return;
    var search = document.getElementById('agSearch');
    var cust = document.getElementById('agCust');
    var chips = Array.prototype.slice.call(document.querySelectorAll('#agChips .ag-chip'));
    var shown = document.getElementById('agShown');
    var none = document.getElementById('agNone');
    var flag = '';

    function apply() {
      var q = (search.value || '').trim().toLowerCase();
      var c = cust.value || '';
      var n = 0;
      rows.forEach(function (r) {
        var okF = !flag || (' ' + r.getAttribute('data-f') + ' ').indexOf(' ' + flag + ' ') >= 0;
        var okC = !c || r.getAttribute('data-cust') === c;
        var okQ = !q || r.getAttribute('data-hay').indexOf(q) >= 0;
        var on = okF && okC && okQ;
        r.style.display = on ? '' : 'none';
        if (on) n++;
      });
      shown.textContent = n;
      none.style.display = n ? 'none' : 'block';
    }

    search.addEventListener('input', apply);
    cust.addEventListener('change', apply);
    chips.forEach(function (b) {
      b.addEventListener('click', function () {
        chips.forEach(function (x) { x.classList.remove('on'); });
        b.classList.add('on');
        flag = b.getAttribute('data-f') || '';
        apply();
      });
    });
    document.getElementById('agClear').addEventListener('click', function (e) {
      e.preventDefault();
      search.value = ''; cust.value = ''; flag = '';
      chips.forEach(function (x) { x.classList.toggle('on', !x.getAttribute('data-f')); });
      apply();
    });
    // Escape clears, so you can get back to everything without reaching for the mouse.
    search.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { search.value = ''; apply(); }
    });
    apply();
  })();
  </script>
  <% } %>
</div>

<% if (isAdmin) { %>
