<%- include('../partials/header', { title: 'LumenMSP Agents', user }) %>
<% function dt(v){ return v ? new Date(v).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'; } %>
<% function isOnline(v){ return v && (Date.now() - new Date(v).getTime()) < 12*60*1000; } %>

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/assets">← Assets</a></p>
    <h1 style="margin:0;">LumenMSP Agents</h1>
    <p class="muted" style="margin:6px 0 0;">Devices running the LumenMSP Agent — chat, system info and end-user tools. Online = heartbeat in the last 12 minutes.</p>
  </div>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card" id="download" style="margin-bottom:20px;">
  <h3 style="margin-top:0;">Download the agent</h3>
  <% if (!msi) { %>
    <p class="muted" style="font-size:13px;margin:0;">No installer uploaded yet<%= isAdmin ? ' - upload dist\\LumenMSPAgent.msi below.' : ' - ask an admin to upload it.' %></p>
  <% } else { %>
  <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
    <label style="flex:1;min-width:280px;">Customer
      <select class="input" id="dlCustomer">
        <% customers.forEach(function(c){ if (c.agent_site_key) { %>
        <option value="<%= c.agent_site_key %>"><%= c.name %></option>
        <% } }); %>
      </select>
    </label>
    <a class="btn btn-primary" id="dlBtn" href="#" style="white-space:nowrap;">&#11015; Download MSI</a>
  </div>
  <p class="muted" style="font-size:12px;margin:12px 0 6px;">The customer's key is built into the filename, so the installer just runs - no options, no key to type. Or paste this into an <strong>elevated</strong> PowerShell on the machine (also fine as an RMM script):</p>
  <div style="display:flex;gap:8px;align-items:flex-start;">
    <textarea class="input" id="dlCmd" readonly rows="3" style="flex:1;font-family:ui-monospace,Consolas,monospace;font-size:11.5px;line-height:1.5;" onclick="this.select();"></textarea>
    <button class="btn" type="button" id="dlCopy" style="white-space:nowrap;">Copy</button>
  </div>
  <% } %>
</div>

<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-top:0;">Enrolled devices (<%= rows.length %>)</h3>
  <% if (!rows.length) { %>
    <p class="muted">No devices yet. Generate a site key below, then install the agent MSI with <code>SITEKEY=&lt;key&gt;</code>.</p>
  <% } else { %>
  <div style="overflow-x:auto;">
    <table class="table">
      <thead><tr><th></th><th>Device</th><th>Customer</th><th>User</th><th>Local IPs</th><th>Public IP</th><th>Version</th><th>Last seen</th><% if (isAdmin) { %><th></th><% } %></tr></thead>
      <tbody>
        <% rows.forEach(function(d){ var on = !d.revoked && isOnline(d.last_seen_at); %>
        <tr style="<%= d.revoked ? 'opacity:.5;' : '' %>">
          <td><span title="<%= d.revoked ? 'Revoked' : (on ? 'Online' : 'Offline') %>" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= d.revoked ? 'var(--bad-fg)' : (on ? 'var(--ok)' : 'var(--line-strong)') %>;"></span></td>
          <td><strong><%= d.hostname || '(unnamed)' %></strong><% if (d.serial_number) { %><div class="muted" style="font-size:11px;"><%= d.serial_number %></div><% } %></td>
          <td><% if (d.customer_id) { %><a class="row-link" href="/customers/<%= d.customer_id %>"><%= d.customer_name %></a><% } else { %>—<% } %></td>
          <td><%= d.logged_in_user || '—' %></td>
          <td style="font-size:12px;"><%= d.local_ips || '—' %></td>
          <td style="font-size:12px;"><%= d.public_ip || '—' %></td>
          <td><%= d.agent_version || '—' %><% if (latestVersion && d.agent_version && d.agent_version !== latestVersion && !d.revoked) { %> <span class="badge badge-inactive" title="Will self-update to <%= latestVersion %> within 6 hours">update due</span><% } %></td>
          <td><%= dt(d.last_seen_at) %></td>
          <% if (isAdmin) { %>
          <td>
            <% if (!d.revoked) { %>
            <form method="post" action="/agents/<%= d.id %>/revoke" style="display:inline;" onsubmit="return confirm('Revoke this device? Its agent stops working until the MSI is reinstalled.');">
              <button class="btn btn-small" type="submit">Revoke</button>
            </form>
            <% } else { %><span class="muted" style="font-size:12px;">revoked</span><% } %>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<% if (isAdmin) { %>
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-top:0;">Agent installer (MSI)</h3>
  <% if (msi) { %>
  <p class="muted" style="font-size:13px;">Current build: <strong><%= latestVersion ? 'v' + latestVersion : 'version not set' %></strong> &middot; <%= (msi.size/1048576).toFixed(1) %> MB &middot; uploaded <%= dt(msi.mtime) %>.
    <% if (latestVersion) { %>Agents older than this update themselves within 6 hours &mdash; no re-download needed.<% } else { %><strong style="color:var(--warn-fg);">No version set, so agents will not auto-update.</strong><% } %> Every customer download link serves this file under its own keyed name (<code>LumenMSPAgent-&lt;sitekey&gt;.msi</code>) — the installer reads the key from its filename, so a plain double-click install needs no command-line options.</p>
  <% } else { %>
  <p class="muted" style="font-size:13px;">No installer uploaded yet. Build it with <code>build.ps1</code> in <code>D:\LITS\LumenMSP Agent</code>, then upload <code>dist\LumenMSPAgent.msi</code> here.</p>
  <% } %>
  <form method="post" action="/agents/installer" enctype="multipart/form-data" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
    <label style="flex:1;min-width:220px;">Installer file
      <input class="input" type="file" name="msi" accept=".msi" required>
    </label>
    <label style="width:130px;">Version
      <input class="input" type="text" name="version" value="<%= latestVersion %>" placeholder="1.0.1" pattern="[0-9.]*" title="e.g. 1.0.1 - must match the version you built">
    </label>
    <button class="btn btn-primary" type="submit">Upload<%= msi ? ' new build' : '' %></button>
  </form>
  <p class="muted" style="font-size:12px;margin:8px 0 0;">Bump the version every release: it is how installed agents know to upgrade. Leave it blank only if you want to stage a build without pushing it out.</p>
</div>

<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-top:0;">Global defaults</h3>
  <p class="muted" style="font-size:13px;">Used by every device whose customer has no override. The RMM installer URL is what "Reinstall RMM Agent" downloads and runs (<code>msiexec /i</code>).</p>
  <form method="post" action="/agents/settings" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
    <label style="flex:2;min-width:280px;">Default RMM installer URL (https)
      <input class="input" type="url" name="url" value="<%= defaults.url %>" placeholder="https://…/setup.msi">
    </label>
    <label style="flex:1;min-width:180px;">msiexec args
      <input class="input" type="text" name="args" value="<%= defaults.args %>" placeholder="/qn /norestart">
    </label>
    <button class="btn btn-primary" type="submit">Save defaults</button>
  </form>
</div>

<details class="card">
  <summary style="cursor:pointer;font-weight:700;">Advanced: site keys &amp; per-customer RMM installer</summary>
  <div style="margin-top:14px;">
  <p class="muted" style="font-size:13px;">
    The site key enrolls new installs for a customer:
    <code>msiexec /i LumenMSPAgent.msi SITEKEY=&lt;key&gt; /qn</code>.
    Rotating a key does not affect devices already enrolled. Clearing it blocks new enrollments.
  </p>
  <div style="overflow-x:auto;">
    <table class="table">
      <thead><tr><th>Customer</th><th>Devices</th><th>Site key</th><th></th><th>Install</th><th>RMM installer URL override</th></tr></thead>
      <tbody>
        <% customers.forEach(function(c){ %>
        <tr>
          <td><a class="row-link" href="/customers/<%= c.id %>"><%= c.name %></a></td>
          <td><%= c.device_count %></td>
          <td style="font-family:monospace;font-size:12px;max-width:340px;word-break:break-all;"><%= c.agent_site_key || '—' %></td>
          <td style="white-space:nowrap;">
            <form method="post" action="/agents/sitekey/<%= c.id %>" style="display:inline;" <% if (c.agent_site_key) { %>onsubmit="return confirm('Rotate the site key? New installs must use the new key (existing devices keep working).');"<% } %>>
              <button class="btn btn-small" type="submit"><%= c.agent_site_key ? 'Rotate' : 'Generate' %></button>
            </form>
            <% if (c.agent_site_key) { %>
            <form method="post" action="/agents/sitekey/<%= c.id %>/clear" style="display:inline;" onsubmit="return confirm('Clear the site key? New enrollments for this customer will be blocked.');">
              <button class="btn btn-small" type="submit">Clear</button>
            </form>
            <% } %>
          </td>
          <td style="white-space:nowrap;">
            <% if (c.agent_site_key && msi) { %>
            <a class="btn btn-small" href="/agent/download/LumenMSPAgent-<%= c.agent_site_key %>.msi">&#11015; MSI</a>
            <button class="btn btn-small copy-cmd" type="button" data-key="<%= c.agent_site_key %>">Copy command</button>
            <% } else { %><span class="muted" style="font-size:12px;"><%= msi ? 'needs key' : 'no MSI yet' %></span><% } %>
          </td>
          <td>
            <form method="post" action="/agents/rmm-url/<%= c.id %>" style="display:flex;gap:6px;">
              <input class="input" type="url" name="url" value="<%= c.rmm_installer_url || '' %>" placeholder="(use default)" style="min-width:220px;font-size:12px;">
              <button class="btn btn-small" type="submit">Save</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  </div>
</details>
<% } %>

<script>
(function(){
  var sel = document.getElementById('dlCustomer');
  var btn = document.getElementById('dlBtn');
  var cmd = document.getElementById('dlCmd');
  var cpy = document.getElementById('dlCopy');
  if (!sel || !btn || !cmd) return;
  var BASE = '<%= baseUrl %>';
  var Q = String.fromCharCode(34), A = String.fromCharCode(39);
  function update(){
    var name = 'LumenMSPAgent-' + sel.value + '.msi';
    var url = BASE + '/agent/download/' + name;
    btn.href = url;
    // No $ anywhere: an outer PowerShell would expand $f/$env:TEMP before the inner
    // shell ever ran (that is what produced '/i',,'/qn'). Literal temp path instead,
    // so this one string is safe pasted into PowerShell, cmd.exe or an RMM script.
    var B = String.fromCharCode(92);
    var tmp = 'C:' + B + 'Windows' + B + 'Temp' + B + name;
    cmd.value = 'powershell -NoProfile -ExecutionPolicy Bypass -Command ' + Q
      + 'Invoke-WebRequest ' + A + url + A + ' -OutFile ' + A + tmp + A + ' -UseBasicParsing; '
      + 'Start-Process msiexec -ArgumentList ' + A + '/i' + A + ',' + A + tmp + A + ',' + A + '/qn' + A + ' -Wait' + Q;
  }
  sel.addEventListener('change', update);
  update();
  if (cpy) cpy.addEventListener('click', function(){
    cmd.select();
    (navigator.clipboard ? navigator.clipboard.writeText(cmd.value) : Promise.reject()).then(function(){
      cpy.textContent = 'Copied \u2713'; setTimeout(function(){ cpy.textContent = 'Copy'; }, 1600);
    }).catch(function(){ try { document.execCommand('copy'); cpy.textContent = 'Copied \u2713'; setTimeout(function(){ cpy.textContent = 'Copy'; }, 1600); } catch(e){} });
  });
})();
</script>

<script>
(function(){
  var BASE = '<%= baseUrl %>';
  document.querySelectorAll('.copy-cmd').forEach(function(b){
    b.addEventListener('click', function(){
      var key = b.getAttribute('data-key');
      var name = 'LumenMSPAgent-' + key + '.msi';
      var url = BASE + '/agent/download/' + name;
      var B = String.fromCharCode(92), Q = String.fromCharCode(34), A = String.fromCharCode(39);
      var tmp = 'C:' + B + 'Windows' + B + 'Temp' + B + name;
      var cmd = 'powershell -NoProfile -ExecutionPolicy Bypass -Command ' + Q
        + 'Invoke-WebRequest ' + A + url + A + ' -OutFile ' + A + tmp + A + ' -UseBasicParsing; '
        + 'Start-Process msiexec -ArgumentList ' + A + '/i' + A + ',' + A + tmp + A + ',' + A + '/qn' + A + ' -Wait' + Q;
      (navigator.clipboard ? navigator.clipboard.writeText(cmd) : Promise.reject()).then(function(){
        b.textContent = 'Copied \u2713';
        setTimeout(function(){ b.textContent = 'Copy command'; }, 1600);
      }).catch(function(){ window.prompt('Copy this command:', cmd); });
    });
  });
})();
</script>

<%- include('../partials/footer') %>
