<%- include('../partials/header', { title: 'Assets', user }) %>
<% function secsAgo(s){ if (s == null) return 'never'; var m = Math.round(Number(s)/60); if (m < 1) return 'just now'; if (m < 60) return m + 'm ago'; var h = Math.round(m/60); if (h < 24) return h + 'h ago'; return Math.round(h/24) + 'd ago'; } %>
<% function timeAgo(iso){ if(!iso) return 'never'; var d=new Date(iso); var mins=Math.round((Date.now()-d.getTime())/60000); if(mins<1) return 'just now'; if(mins<60) return mins+'m ago'; var hrs=Math.round(mins/60); if(hrs<24) return hrs+'h ago'; return Math.round(hrs/24)+'d ago'; } %>
<%
// Same fallback logic as lib/asset-sync.ts's buildRemoteUrl: if the saved template needs a
// device_guid this row hasn't been re-synced with yet, fall back to the old numeric-ID page
// rather than producing a dead link with a literal "{deviceGuid}" in it.
function remoteHref(a){
  var tpl = remoteTemplate;
  if (tpl.indexOf('{deviceGuid}') !== -1 && !a.device_guid) {
    return 'https://app.atera.com/AgentDetails/' + encodeURIComponent(a.external_id || '');
  }
  var url = tpl;
  if (a.device_guid) url = url.split('{deviceGuid}').join(encodeURIComponent(a.device_guid));
  if (a.external_id) url = url.split('{agentId}').join(encodeURIComponent(a.external_id));
  return url;
}
%>

<div class="page-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
<% var _noAgent = rows.filter(function(a){ return !a.agent_device_id; }).length; %>
  <div><h1>Assets</h1><p class="muted"><%= rows.length %> device<%= rows.length===1?'':'s' %> shown · reported by the LumenMSP Agent · last Atera import <%= timeAgo(lastSynced) %></p></div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <a class="btn" href="/agents#download" style="display:inline-flex;align-items:center;gap:6px;"><img src="/static/img/lumen-agent-16.png" width="14" height="14" alt=""> Download Agent</a>
    <% if (typeof user!=='undefined' && user.role==='admin') { %>
    <form method="post" action="/assets/sync"><button class="btn" type="submit" title="Pulls Atera's device list to find machines we do not have. It never overwrites anything our own agent reports.">↻ Import from Atera</button></form>
    <% } %>
    <% if (unmatchedCount > 0) { %><a class="btn" href="/assets/unmatched" style="border-color:var(--amber);color:var(--warn-fg);">⚠ <%= unmatchedCount %> unmatched</a><% } %>
    <% if (typeof duplicateCount !== 'undefined' && duplicateCount > 0 && user.role === 'admin') { %><a class="btn" href="/assets/duplicates" style="border-color:var(--warn-line);color:var(--warn-deep);" title="One machine held as two records — usually the Atera import and our agent's own, which failed to match up">⧉ <%= duplicateCount %> duplicate<%= duplicateCount===1?'':'s' %></a><% } %>
  </div>
</div>

<% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<%
// Hero board. Counts come from the ROWS ON SCREEN, so they follow the filter rather than
// silently describing the whole estate while you're looking at one customer — the labels
// say "shown" for exactly that reason.
// Online means OUR agent checked in recently. Computed from the live seconds-since-last-
// seen rather than the stored flag: the flag is only refreshed when something recomputes
// it, and a hero tile disagreeing with the dot next to it is worse than no tile.
var _win = (typeof onlineWindowSecs !== 'undefined' && onlineWindowSecs) ? onlineWindowSecs : 180;
function _isLive(a){ return a.agent_device_id && a.agent_seen_secs != null && Number(a.agent_seen_secs) < _win; }
var _online  = rows.filter(_isLive).length;
var _agent   = rows.filter(function (a) { return a.agent_device_id; }).length;
var _servers = rows.filter(function (a) { return String(a.device_type || '').toLowerCase().indexOf('server') >= 0; }).length;
var _nouser  = rows.filter(function (a) { return !a.assigned_name && !a.last_login_user; }).length;
var _pct     = rows.length ? Math.round((_agent / rows.length) * 100) : 0;
var _anyFilter = !!(filters.q || filters.customer || filters.type || filters.online || filters.nouser || filters.agent || filters.servers);
// Each tile is a filter you can click. Carries the other filters through (so "servers" inside
// one customer works) and clicking an active tile clears just that one.
function tileHref(over){
  var f = { q: filters.q, customer: filters.customer, type: filters.type,
            online: filters.online ? '1' : '', agent: filters.agent,
            nouser: filters.nouser ? '1' : '', servers: filters.servers ? '1' : '' };
  Object.keys(over).forEach(function (k) { f[k] = over[k]; });
  var parts = [];
  ['q','customer','type','online','agent','nouser','servers'].forEach(function (k) {
    if (f[k]) parts.push(k + '=' + encodeURIComponent(f[k]));
  });
  return '/assets' + (parts.length ? '?' + parts.join('&') : '');
}
%>
<style>
  .hero { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; margin:0 0 14px; }
  .hero .tile { background:var(--card,#fff); border:1px solid var(--line); border-radius:12px; padding:14px 16px; display:block; text-decoration:none; color:inherit; transition:border-color .12s, box-shadow .12s, transform .12s; }
  .hero a.tile:hover { border-color:var(--accent); box-shadow:0 3px 10px rgba(0,0,0,.07); transform:translateY(-1px); }
  .hero a.tile:focus-visible { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--focus-ring); }
  .hero .tile.on { border-color:var(--accent); box-shadow:inset 0 0 0 1px var(--accent); }
  .hero .tile .h { font-size:11px; font-weight:600; color:var(--accent); margin-top:6px; visibility:hidden; }
  .hero a.tile:hover .h, .hero .tile.on .h { visibility:visible; }
  .hero .tile .n { font-size:26px; font-weight:800; line-height:1.05; }
  .hero .tile .l { font-size:12px; color:var(--muted); margin-top:2px; }
  .hero-actions { display:flex; gap:8px; flex-wrap:wrap; margin:0 0 18px; }
</style>

<div class="hero">
  <a class="tile" href="/assets" title="Show every device - clears every filter"><div class="n"><%= rows.length %></div><div class="l">devices shown</div><div class="h"><%= _anyFilter ? 'show all devices' : 'all devices' %></div></a>
  <a class="tile<%= filters.online ? ' on' : '' %>" href="<%= tileHref({ online: filters.online ? '' : '1' }) %>" title="Only devices the LumenMSP Agent has checked in from recently"><div class="n" id="tileOnline" style="color:var(--ok-fg);"><%= _online %></div><div class="l">online now</div><div class="h"><%= filters.online ? 'filtering - click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= filters.agent === '1' ? ' on' : '' %>" href="<%= tileHref({ agent: filters.agent === '1' ? '' : '1' }) %>" title="Only devices with the LumenMSP Agent installed"><div class="n"><%= _agent %> <span style="font-size:14px;font-weight:600;color:var(--muted);"><%= _pct %>%</span></div><div class="l">running our agent</div><div class="h"><%= filters.agent === '1' ? 'filtering - click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= filters.servers ? ' on' : '' %>" href="<%= tileHref({ servers: filters.servers ? '' : '1', type: '' }) %>" title="Only devices typed as a server"><div class="n"><%= _servers %></div><div class="l">servers</div><div class="h"><%= filters.servers ? 'filtering - click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= filters.nouser ? ' on' : '' %>" href="<%= tileHref({ nouser: filters.nouser ? '' : '1' }) %>" title="Devices with no assigned contact and no last logged-in user"><div class="n" style="<%= _nouser ? 'color:var(--warn-fg);' : '' %>"><%= _nouser %></div><div class="l">no known user</div><div class="h"><%= filters.nouser ? 'filtering - click to clear' : 'click to filter' %></div></a>
  <% if (unmatchedCount > 0) { %>
  <a class="tile" href="/assets/unmatched" style="text-decoration:none;color:inherit;"><div class="n" style="color:var(--warn-fg);"><%= unmatchedCount %></div><div class="l">unmatched — click to fix</div></a>
  <% } %>
</div>

<div class="hero-actions">
  <a class="btn btn-primary" href="/patching">🛡 Patch management</a>
  <a class="btn" href="/software">📦 Software</a>
  <a class="btn" href="/ce">✅ Cyber Essentials</a>
  <% if (typeof user!=='undefined' && user.role==='admin') { %>
  <a class="btn" href="/agents">📦 Agent deployment</a>
  <% } %>
</div>

<div class="card" style="background:var(--tint-accent);border-color:var(--info-line);">
  <p style="margin:0;font-size:13px;color:var(--info-deep);">
    <strong>The Portal is the master record.</strong> Devices are described by the <strong>LumenMSP Agent</strong>, which writes straight
    into this list the moment it enrols — no sync to run. Atera is now an <strong>importer only</strong>: it tells us a machine exists
    so it can be chased for an agent, and it is never allowed to overwrite anything our own agent reports.
    <% if (_noAgent) { %><br><span style="font-weight:600;"><%= _noAgent %> of the devices shown <%= _noAgent === 1 ? 'has' : 'have' %> no LumenMSP Agent yet</span> — <%= _noAgent === 1 ? 'that is the one' : 'those are the ones' %> still relying on Atera.<% } %>
  </p>
</div>

<div class="card" style="padding:16px 20px;">
  <form method="get" action="/assets" id="asset-filters" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
    <input class="input" type="search" name="q" value="<%= filters.q %>" placeholder="Search hostname, serial, model, user, customer…" style="min-width:260px;">
    <select class="input js-autofilter" name="customer" style="min-width:200px;">
      <option value="">All customers</option>
      <% customers.forEach(function(c){ %><option value="<%= c.id %>" <%= filters.customer===c.id?'selected':'' %>><%= c.name %></option><% }); %>
    </select>
    <select class="input js-autofilter" name="type">
      <option value="">All types</option>
      <% types.forEach(function(t){ %><option value="<%= t %>" <%= filters.type===t?'selected':'' %>><%= t %></option><% }); %>
    </select>
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;"><input class="js-autofilter" type="checkbox" name="online" value="1" <%= filters.online?'checked':'' %>> Online only</label>
    <select class="input js-autofilter" name="agent" title="Filter by whether the LumenMSP Agent is installed">
      <option value="">Agent: any</option>
      <option value="1" <%= filters.agent==='1'?'selected':'' %>>Agent installed</option>
      <option value="0" <%= filters.agent==='0'?'selected':'' %>>Without agent</option>
    </select>
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;" title="Devices with no assigned person and no known signed-in user"><input class="js-autofilter" type="checkbox" name="nouser" value="1" <%= filters.nouser?'checked':'' %>> No known user</label>
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;" title="Anything Atera types as a server"><input class="js-autofilter" type="checkbox" name="servers" value="1" <%= filters.servers?'checked':'' %>> Servers only</label>
    <noscript><button class="btn" type="submit">Filter</button></noscript>
    <% if (_anyFilter) { %><a class="btn" href="/assets">Clear</a><% } %>
  </form>
</div>
<script>
  // ── Live status ───────────────────────────────────────────────────────────────
  // The offline window is short (see ONLINE_WINDOW_SECS), which is no use on a page
  // somebody is looking at. This repaints the dots and the last-seen column in place -
  // no reload, so filters, scroll position and any open menu survive.
  (function () {
    var WINDOW = <%- JSON.stringify(typeof onlineWindowSecs !== 'undefined' ? onlineWindowSecs : 180) %>;
    var dots = document.querySelectorAll('.dot-live');
    if (!dots.length) return;
    var ids = Array.prototype.map.call(dots, function (d) { return d.getAttribute('data-asset'); }).filter(Boolean);
    if (!ids.length) return;

    function ago(s) {
      if (s == null) return 'never';
      var m = Math.round(s / 60);
      if (m < 1) return 'just now';
      if (m < 60) return m + 'm ago';
      var h = Math.round(m / 60);
      return h < 24 ? h + 'h ago' : Math.round(h / 24) + 'd ago';
    }

    function paint(d) {
      var dot = document.querySelector('.dot-live[data-asset="' + d.id + '"]');
      if (dot) {
        var hasAgent = dot.getAttribute('data-agent') === '1';
        dot.style.background = d.online ? 'var(--ok)' : 'var(--line-strong)';
        dot.title = d.online ? 'Online - the LumenMSP Agent checked in recently'
          : (hasAgent ? 'Offline' : 'Offline - no LumenMSP Agent on this machine, so the Portal has no live status for it');
      }
      var seen = document.querySelector('.seen-live[data-asset="' + d.id + '"]');
      if (seen && d.seenSecs != null) seen.textContent = ago(d.seenSecs);
    }

    var timer = null;
    function tick() {
      // Nothing to gain from polling a tab nobody is looking at.
      if (document.hidden) return;
      fetch('/assets/status.json?ids=' + encodeURIComponent(ids.join(',')))
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j || !j.ok || !j.devices) return;
          j.devices.forEach(paint);
          var live = j.devices.filter(function (d) { return d.online; }).length;
          var tile = document.getElementById('tileOnline');
          if (tile) tile.textContent = live;
        })
        .catch(function () { /* a blip should not blank the page */ });
    }
    // A third of the offline window: fast enough that a machine going dark is visible
    // almost immediately, slow enough to be nothing on the server.
    var everyMs = Math.max(15, Math.round(WINDOW / 3)) * 1000;
    timer = setInterval(tick, everyMs);
    document.addEventListener('visibilitychange', function () { if (!document.hidden) tick(); });
  })();

  // Pick a customer (or any other single-click filter) and the list filters itself. The
  // search box is deliberately left alone - it submits on Enter, not on every keystroke.
  (function () {
    var form = document.getElementById('asset-filters');
    if (!form) return;
    form.querySelectorAll('.js-autofilter').forEach(function (el) {
      el.addEventListener('change', function () {
        if (typeof form.requestSubmit === 'function') form.requestSubmit(); else form.submit();
      });
    });
  })();
</script>

<div class="card" style="padding:0;">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th></th><th>Hostname</th><th>Customer</th><th>Type</th><th>Backup</th><th>OS</th><th>Manufacturer / Model</th><th>User</th><th>Last seen</th><th></th></tr></thead>
      <tbody>
        <% if (rows.length===0) { %><tr><td colspan="10"><div class="empty-state">No devices match. Machines appear here as soon as the LumenMSP Agent enrols on them — use "↻ Import from Atera" to pull in the ones that do not have it yet.</div></td></tr><% } %>
        <% rows.forEach(function(a){ %>
          <tr>
            <% var _lv = _isLive(a); %>
            <td><span class="dot-live" data-asset="<%= a.id %>" data-agent="<%= a.agent_device_id ? '1' : '' %>" title="<%= _lv ? 'Online - the LumenMSP Agent checked in recently' : (a.agent_device_id ? 'Offline' : 'Offline - no LumenMSP Agent on this machine, so the Portal has no live status for it') %>" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%= _lv ? 'var(--ok)' : 'var(--line-strong)' %>;"></span></td>
            <td><a class="row-link" href="/assets/<%= a.id %>?back=<%= encodeURIComponent('/assets') %>"><%= a.hostname || '(unnamed device)' %></a><% if (a.agent_device_id) { %> <img src="/static/img/lumen-agent-16.png" width="14" height="14" alt="LumenMSP Agent" style="vertical-align:-2px;margin-left:5px;" title="LumenMSP Agent<%= a.agent_agent_version ? ' v' + a.agent_agent_version : '' %> — last seen <%= secsAgo(a.agent_seen_secs) %>"><% if (a.agent_agent_version) { %><span class="muted" style="font-size:10.5px;margin-left:3px;">v<%= a.agent_agent_version %></span><% } %><% } %></td>
            <td class="muted"><% if (a.customer_id) { %><a class="row-link" href="/customers/<%= a.customer_id %>#assets"><%= a.customer_name %></a><% } else { %>—<% } %></td>
            <td><span class="badge badge-inactive"><%= a.device_type || '—' %></span><% if (!a.agent_device_id) { %> <button type="button" class="badge copy-install" data-key="<%= a.agent_site_key || '' %>" data-host="<%= a.hostname || 'this machine' %>" style="background:var(--tint-warn);color:var(--warn-deep);border:1px solid var(--warn-line);cursor:pointer;font:inherit;font-size:11px;" title="Copy the PowerShell command that installs the LumenMSP Agent on this machine, then paste it into an elevated PowerShell on the box">agent required — copy install ⧉</button><% } %></td>
            <td><% var bs = backupState[String(a.hostname||'').toLowerCase()]; %>
              <% if (bs === 'ok') { %><span class="badge badge-sent" title="All backup plans succeeded (MSP360)">Protected</span>
              <% } else if (bs === 'failed') { %><span class="badge badge-failed" title="A backup plan needs attention (MSP360)">Attention</span>
              <% } else if (bs) { %><span class="badge badge-inactive" title="Backup state is running/warning/unknown (MSP360)">Check</span>
              <% } else { %><span class="muted" style="opacity:.5;">—</span><% } %>
            </td>
            <td class="muted"><%= a.os || '—' %><% if (a.os_version) { %> <span style="font-size:11px;">(<%= a.os_version %>)</span><% } %></td>
            <td class="muted"><%= [a.manufacturer, a.model].filter(Boolean).join(' ') || '—' %></td>
            <td class="muted" style="font-size:12px;" title="<%= a.assigned_name ? (a.assigned_name + ' (assigned)') : (a.last_login_user || '') %>"><% if (a.assigned_name) { %><span style="font-weight:600;color:var(--ink);"><%= a.assigned_name %></span><% } else if (a.last_login_user) { %><%= String(a.last_login_user).split('\\').pop() %><% } else { %><span class="muted" style="opacity:.55;">unallocated</span><% } %></td>
            <td class="muted seen-live" data-asset="<%= a.id %>" style="font-size:12px;"><%= a.agent_device_id && a.agent_seen_secs != null ? secsAgo(a.agent_seen_secs) : timeAgo(a.last_seen_at) %></td>
            <td style="text-align:right;white-space:nowrap;">
              <% if (a.agent_device_id && a.agent_mesh_node_id) { %>
                <a class="btn" style="padding:3px 10px;font-size:12px;" target="_blank" rel="noopener" href="/assets/<%= a.id %>/remote-mesh" title="Open this machine's desktop">🖥 Remote</a>
              <% } else if (a.agent_device_id) { %>
                <button type="button" class="btn remote-help" data-id="<%= a.id %>" data-host="<%= a.hostname || 'this machine' %>" style="padding:3px 10px;font-size:12px;opacity:.75;" title="Remote control is not ready on this machine yet — press for the reason and what to do">🖥 Remote</button>
              <% } else if (a.external_id) { %>
                <a class="btn" style="padding:3px 10px;font-size:12px;" target="_blank" rel="noopener" href="<%= remoteHref(a) %>" title="Falls back to Atera — this machine has no LumenMSP Agent">🖥 Remote</a>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (typeof user!=='undefined' && user.role==='admin') { %>
<div class="card">
  <div class="card-header"><h2>Remote-access link</h2></div>
  <p class="muted" style="margin:0 0 12px;font-size:13px;">
    The "🖥 Remote" button opens this URL with <code>{deviceGuid}</code> (or <code>{agentId}</code>) replaced by the device's Atera identifiers. Confirmed live 2026-07-23 against Atera's current device page — adjust here if that ever changes, no redeploy needed.
  </p>
  <form method="post" action="/assets/remote-settings" style="display:flex;gap:8px;">
    <input class="input" type="text" name="template" value="<%= remoteTemplate %>" style="flex:1;font-family:monospace;font-size:13px;">
    <button class="btn btn-primary" type="submit">Save</button>
  </form>
</div>
<% } %>

<!-- Remote-access lightbox. Pressing Remote on a machine that is not ready used to send
     you to the device page carrying an error, which reads as "it opened another window and
     did nothing". This answers in place, and offers the install where that is the fix. -->
<div id="rmOverlay" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:120;" onclick="if(event.target===this)rmClose()">
  <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,92vw);background:var(--card,#fff);border:1px solid var(--line-strong);border-radius:14px;box-shadow:0 18px 50px rgba(0,0,0,.28);padding:22px;">
    <div style="display:flex;align-items:flex-start;gap:12px;">
      <div style="flex:1;">
        <p class="muted" style="margin:0 0 3px;font-size:11.5px;text-transform:uppercase;letter-spacing:.04em;font-weight:700;">Remote control</p>
        <h2 id="rmTitle" style="margin:0;font-size:17px;">Checking…</h2>
      </div>
      <button type="button" onclick="rmClose()" style="border:none;background:none;font-size:22px;line-height:1;cursor:pointer;color:var(--muted);">&times;</button>
    </div>
    <p id="rmDetail" class="muted" style="margin:11px 0 0;font-size:13.5px;line-height:1.55;"></p>
    <pre id="rmOut" style="display:none;margin:11px 0 0;font-size:11px;line-height:1.5;background:var(--ink-chip);color:var(--line);padding:11px;border-radius:8px;max-height:180px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;"></pre>
    <div id="rmActions" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;"></div>
  </div>
</div>

<script>
(function () {
  var BASE = <%- JSON.stringify(typeof baseUrl !== 'undefined' ? baseUrl : '') %>;
  var Q = String.fromCharCode(34), A = String.fromCharCode(39), B = String.fromCharCode(92);

  // Byte-for-byte the command the Agents page hands out. No '$' anywhere: an outer shell
  // would expand it before PowerShell ever saw it, which is what once produced '/i',,'/qn'.
  function installCommand(key) {
    var name = 'LumenMSPAgent-' + key + '.msi';
    var url = BASE + '/agent/download/' + name;
    var tmp = 'C:' + B + 'Windows' + B + 'Temp' + B + name;
    return 'powershell -NoProfile -ExecutionPolicy Bypass -Command ' + Q
      + 'Invoke-WebRequest ' + A + url + A + ' -OutFile ' + A + tmp + A + ' -UseBasicParsing; '
      + 'Start-Process msiexec -ArgumentList ' + A + '/i' + A + ',' + A + tmp + A + ',' + A + '/qn' + A + ','
      + A + '/l*v' + A + ',' + A + 'C:' + B + 'Windows' + B + 'Temp' + B + 'LumenMSPAgent-install.log' + A + ' -Wait' + Q;
  }
  function copyText(text, btn, done) {
    var restore = btn.textContent;
    (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject())
      .then(function () { btn.textContent = done; setTimeout(function () { btn.textContent = restore; }, 1800); })
      .catch(function () { window.prompt('Copy this command:', text); });
  }

  document.querySelectorAll('.copy-install').forEach(function (b) {
    b.addEventListener('click', function () {
      var key = b.getAttribute('data-key');
      if (!key) { window.alert('This customer has no agent site key yet — open the Agents page and one is generated automatically.'); return; }
      copyText(installCommand(key), b, 'copied — paste into elevated PowerShell ✓');
    });
  });

  var ov = document.getElementById('rmOverlay');
  var elTitle = document.getElementById('rmTitle'), elDetail = document.getElementById('rmDetail');
  var elOut = document.getElementById('rmOut'), elActions = document.getElementById('rmActions');
  window.rmClose = function () { ov.style.display = 'none'; };
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') rmClose(); });

  function btn(label, primary) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'btn' + (primary ? ' btn-primary' : '');
    b.textContent = label; return b;
  }

  document.querySelectorAll('.remote-help').forEach(function (b) {
    b.addEventListener('click', function () {
      var id = b.getAttribute('data-id'), host = b.getAttribute('data-host');
      elTitle.textContent = 'Checking ' + host + '…';
      elDetail.textContent = ''; elOut.style.display = 'none'; elActions.innerHTML = '';
      ov.style.display = 'block';

      fetch('/assets/' + id + '/remote-state.json').then(function (r) { return r.json(); }).then(function (d) {
        if (!d.ok) { elTitle.textContent = 'Could not check'; elDetail.textContent = d.error || 'Unknown error.'; return; }
        // Became ready between the page loading and the click - just go.
        if (d.ready) { rmClose(); window.open(d.href, '_blank', 'noopener'); return; }

        elTitle.textContent = d.title;
        elDetail.textContent = d.detail;

        var la = d.lastAttempt;
        if (la && (la.output || la.progress)) {
          elOut.style.display = 'block';
          elOut.textContent = 'Last attempt: ' + la.status
            + (la.exitCode !== null && la.exitCode !== undefined ? ' (exit ' + la.exitCode + ')' : '')
            + (la.startedAt ? ' — started ' + new Date(la.startedAt).toLocaleString('en-GB') : '')
            + '\n\n' + (la.output || la.progress);
        }

        if (d.canInstall) {
          var install = btn('🖥 Install remote control', true);
          install.addEventListener('click', function () {
            install.disabled = true; install.textContent = 'Queueing…';
            var f = document.createElement('form');
            f.method = 'post'; f.action = d.installUrl;
            var t = document.createElement('input');
            t.type = 'hidden'; t.name = '_csrf';
            var m = document.querySelector('meta[name="csrf-token"]');
            t.value = m ? m.getAttribute('content') : '';
            f.appendChild(t); document.body.appendChild(f); f.submit();
          });
          elActions.appendChild(install);
        }
        if (d.action) {
          var a = document.createElement('a');
          a.className = 'btn'; a.href = d.action.href; a.textContent = d.action.label;
          elActions.appendChild(a);
        }
        var page = document.createElement('a');
        page.className = 'btn'; page.href = '/assets/' + id; page.textContent = 'Open the device page';
        elActions.appendChild(page);

        var close = btn('Close', false);
        close.addEventListener('click', rmClose);
        elActions.appendChild(close);
      }).catch(function () {
        elTitle.textContent = 'Could not check';
        elDetail.textContent = 'The Portal did not answer. Try the device page.';
      });
    });
  });
})();
</script>

