<style>
  /* Command progress. A determinate bar when the script can say how far along it is,
     and a moving one when it cannot — the point is to distinguish "working" from
     "hung", which a static spinner never did. */
  .tool-prog { display:inline-flex; align-items:center; gap:8px; vertical-align:middle; }
  .tool-prog-bar { position:relative; display:inline-block; width:130px; height:6px;
                   background:var(--line); border-radius:3px; overflow:hidden; }
  .tool-prog-bar i { position:absolute; inset:0 auto 0 0; display:block; height:100%;
                     background:var(--lumen, #0ea5e9); border-radius:3px; transition:width .4s ease; }
  .tool-prog-bar.indet i { width:40% !important; animation:toolProg 1.1s ease-in-out infinite; }
  @keyframes toolProg { 0% { left:-40%; } 100% { left:100%; } }
  .tool-prog-txt { font-size:11.5px; color:var(--muted); }
  .tool-prog-tail { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:11px; }
</style>
<style>
  /* Install-software lightbox. Fixed overlay rather than an inline panel: the search
     results are the whole job while it is open, and the page behind it is not. */
  .sw-modal { position:fixed; inset:0; z-index:900; background:rgba(15,23,42,.45);
              align-items:flex-start; justify-content:center; padding:6vh 16px; }
  .sw-sheet { background:var(--surface,#fff); border-radius:14px; width:min(760px,100%);
              max-height:88vh; display:flex; flex-direction:column; overflow:hidden;
              box-shadow:0 24px 60px rgba(15,23,42,.28); }
  .sw-head  { display:flex; align-items:center; justify-content:space-between; gap:12px;
              padding:16px 20px; border-bottom:1px solid var(--line); }
  .sw-body  { padding:16px 20px 20px; overflow:auto; }
  .sw-searchrow { display:flex; gap:8px; }
  .sw-searchrow .input { flex:1; }
  .sw-row   { display:flex; align-items:center; gap:12px; padding:10px 4px;
              border-bottom:1px solid var(--line); }
  .sw-row.done { opacity:.55; }
  .sw-name  { flex:1; min-width:0; font-size:13.5px; font-weight:600; display:flex; flex-direction:column; }
  .sw-id    { font-weight:400; font-size:11.5px; color:var(--muted);
              font-family:ui-monospace,Menlo,Consolas,monospace; overflow-wrap:anywhere; }
  .sw-ver   { font-size:12px; color:var(--muted); white-space:nowrap; }
  .sw-install { padding:4px 14px; font-size:12px; }
  .sw-badge { display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600;
              border-radius:6px; padding:3px 9px; white-space:nowrap; }
  .sw-wg    { background:#e8f1fb; color:#1a5fb4; border:1px solid #bcd7f5; }
  .sw-ch    { background:#f4ece4; color:#6b4423; border:1px solid #e0cdb8; }
  .sw-note  { font-size:12px; color:var(--warn-fg); padding:8px 4px; }
  .sw-msi   { margin-top:18px; border-top:1px solid var(--line); padding-top:12px; }
  .sw-msi summary { cursor:pointer; font-size:13px; font-weight:600; }
</style>
<%
  // Remote Tools tab — admin only. Everything here runs as SYSTEM on the customer's
  // machine via the LumenMSP Agent, so the whole panel is hidden for non-admins and
  // every action is audited server-side.
%>
<style>
  .tool-tabs { display:flex; flex-wrap:wrap; gap:2px; margin:0 0 16px; border-bottom:1px solid var(--line); }
  .tool-tabs button { background:none; border:none; padding:8px 14px; font-size:13px; font-weight:600; color:var(--muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
  .tool-tabs button.active { color:var(--accent); border-bottom-color:var(--accent); }
  /* ── Manage lightbox ─────────────────────────────────────────────────────────
     Every remote tool opens in one centred sheet over the page (the Atera pattern):
     the tool is the whole job while it is open, and the page behind it is not. The
     tool nav lives inside the sheet, so switching tools never means going back out. */
  .lb-overlay { display:none; position:fixed; inset:0; z-index:880; background:rgba(15,23,42,.45);
                align-items:flex-start; justify-content:center; padding:4vh 16px; }
  .lb-overlay.on { display:flex; }
  .lb-sheet { background:var(--surface,#fff); border-radius:14px; width:min(1100px,100%);
              max-height:90vh; display:flex; flex-direction:column; overflow:hidden;
              box-shadow:0 24px 60px rgba(15,23,42,.28); }
  .lb-sheet.max { width:96vw; max-width:96vw; height:94vh; max-height:94vh; }
  .lb-head { display:flex; align-items:center; gap:10px; padding:14px 20px 12px; border-bottom:1px solid var(--line); flex:none; }
  .lb-title { margin:0; font-size:15px; font-weight:700; }
  .lb-sub { margin:2px 0 0; font-size:12px; color:var(--muted); }
  .lb-body { padding:14px 20px 20px; overflow:auto; flex:1; }
  /* ── Manage menu (the Atera-style grouped dropdown) ─────────────────────────── */
  .mg-menu { display:none; position:absolute; z-index:890; min-width:230px;
             background:var(--card,#fff); border:1px solid var(--line-strong); border-radius:9px;
             box-shadow:0 8px 22px rgba(0,0,0,.16); text-align:left; padding:4px 0; }
  .mg-menu.on { display:block; }
  .mg-menu > button, .mg-sub > button { display:block; width:100%; text-align:left; border:0; background:none;
             padding:8px 14px; font:inherit; font-size:13px; cursor:pointer; color:var(--ink); }
  .mg-menu > button:hover, .mg-sub > button:hover { background:var(--tint-accent); }
  .mg-sep { height:1px; background:var(--line); margin:4px 0; }
  .mg-has-sub { position:relative; }
  .mg-has-sub > button { display:block; width:100%; text-align:left; border:0; background:none;
             padding:8px 14px; font:inherit; font-size:13px; cursor:pointer; color:var(--ink); }
  .mg-has-sub > button::after { content:'\25B8'; float:right; color:var(--muted); }
  .mg-has-sub > button:hover { background:var(--tint-accent); }
  .mg-sub { display:none; position:absolute; right:100%; top:-5px; min-width:190px; background:var(--card,#fff);
            border:1px solid var(--line-strong); border-radius:9px; box-shadow:0 8px 22px rgba(0,0,0,.16); padding:4px 0; }
  .mg-has-sub:hover .mg-sub { display:block; }
  /* Sub-tabs inside a tool (patch management's Available/Installed) */
  .pt-tabs { display:flex; gap:2px; border-bottom:1px solid var(--line); margin:0 0 12px; }
  .pt-tabs button { background:none; border:none; padding:8px 14px; font-size:13px; font-weight:600; color:var(--muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
  .pt-tabs button.active { color:var(--accent); border-bottom-color:var(--accent); }
  .tool-panel { display:none; }
  .tool-panel.active { display:block; }
  .tool-out { background:#0f172a; color:#e2e8f0; font-family:ui-monospace,Consolas,monospace; font-size:12px; line-height:1.5;
              padding:12px 14px; border-radius:8px; max-height:420px; overflow:auto; white-space:pre-wrap; word-break:break-word; margin-top:10px; }
  .tool-out:empty { display:none; }
  .reg-split { display:flex; gap:10px; align-items:stretch; min-height:340px; }
  .reg-tree { width:340px; flex:none; overflow:auto; max-height:440px; border:1px solid var(--line); border-radius:8px; padding:6px 4px; background:var(--surface); }
  .reg-values { flex:1; overflow:auto; max-height:440px; border:1px solid var(--line); border-radius:8px; padding:0 6px; background:var(--surface); }
  .reg-node { font-size:12.5px; white-space:nowrap; }
  .reg-node .row { display:flex; align-items:center; gap:3px; padding:2px 4px; border-radius:4px; cursor:pointer; }
  .reg-node .row:hover { background:var(--surface-2); }
  .reg-node .row.sel { background:var(--tint-accent); font-weight:600; }
  .reg-node .tw { width:14px; text-align:center; color:var(--muted); flex:none; }
  .reg-node ul { list-style:none; margin:0; padding-left:14px; }
  @media (max-width: 900px) { .reg-split { flex-direction:column; } .reg-tree { width:auto; max-height:220px; } }
  .term { background:#0f172a; border-radius:8px; padding:12px 14px; max-height:460px; overflow:auto;
          font-family:ui-monospace,Consolas,monospace; font-size:12.5px; line-height:1.55; color:#e2e8f0; cursor:text; }
  .term-line { display:flex; gap:8px; align-items:baseline; }
  .term-prompt { color:#38bdf8; white-space:pre; flex:none; }
  .term-in { flex:1; background:transparent; border:none; outline:none; color:#e2e8f0;
             font-family:inherit; font-size:inherit; padding:0; resize:none; overflow:hidden;
             line-height:1.55; min-height:1.55em; }
  .term-in::placeholder { color:#475569; }
  .term-echo { color:#94a3b8; }
  .term-echo b { color:#38bdf8; font-weight:400; }
  .term-err { color:#fca5a5; }
  .term-note { color:#fbbf24; }
  .term pre { margin:0 0 6px; white-space:pre-wrap; word-break:break-word; }
  .tool-busy { display:inline-block; font-size:12px; color:var(--muted); }
  .tool-tbl { width:100%; font-size:12.5px; border-collapse:collapse; margin-top:10px; }
  .tool-tbl th { text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); padding:6px 8px; border-bottom:1px solid var(--line); }
  .tool-tbl td { padding:6px 8px; border-bottom:1px solid var(--surface-3); }
  .tool-tbl tr:hover td { background:var(--surface-2); }
  .tool-crumb { font-family:ui-monospace,Consolas,monospace; font-size:12px; }
  .pw-reveal { background:var(--tint-accent); border:1px solid var(--info-line); border-radius:8px; padding:10px 12px; margin-top:10px; font-size:13px; }
  .pw-reveal code { font-size:14px; font-weight:700; user-select:all; }
</style>

<%
  // Remote tools, Atera-style: a Manage menu on the device page, every tool in a
  // centred lightbox. This partial renders nothing visible until the menu opens one.
%>
<div id="manageTools">
  <% if (!agentInfo) { %><% } else { %>

  <div class="lb-overlay" id="lbOverlay">
  <div class="lb-sheet" id="lbSheet" role="dialog" aria-modal="true">
  <div class="lb-head">
    <div style="min-width:0;">
      <h3 class="lb-title" id="lbTitle">Tools</h3>
      <p class="lb-sub">on <strong><%= asset.hostname %></strong> &mdash; runs as SYSTEM through the LumenMSP Agent; every action is audited. AD actions route via the customer's AD agent.</p>
    </div>
    <span style="flex:1;"></span>
    <button type="button" class="btn" id="lbMax" title="Expand" style="padding:2px 10px;">&#10530;</button>
    <button type="button" class="btn" id="lbClose" title="Close" style="padding:2px 10px;">&#10005;</button>
  </div>
  <div class="lb-body">
  <nav class="tool-tabs">
    <button type="button" data-tool="console">Console</button>
    <button type="button" data-tool="software">Installed software</button>
    <button type="button" data-tool="services">Services</button>
    <button type="button" data-tool="users">Users</button>
    <button type="button" data-tool="files">File system</button>
    <button type="button" data-tool="registry">Registry</button>
    <button type="button" data-tool="patching">Patching</button>
    <button type="button" data-tool="taskmgr">Task Manager</button>
    <button type="button" data-tool="events">Events</button>
    <button type="button" data-tool="script">Run script</button>
    <button type="button" data-tool="activity">User activity</button>
  </nav>

  <!-- Console: a real terminal, not a text box. The agent keeps a PowerShell session
       alive per machine, so cd and variables persist between commands. -->
  <div class="tool-panel" data-panel="console">
    <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px;flex-wrap:wrap;">
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;"><input type="radio" name="shellKind" value="shell.powershell" checked> PowerShell</label>
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;"><input type="radio" name="shellKind" value="shell.cmd"> Command line</label>
      <span style="width:1px;height:18px;background:var(--line);"></span>
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;" title="Full rights, but no access to the user's mapped drives, HKCU or profile"><input type="radio" name="runAs" value="system" checked> SYSTEM</label>
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;" title="Runs in the signed-in user's session - their drives, HKCU and profile"><input type="radio" name="runAs" value="user"> Signed-in user</label>
      <button class="btn" type="button" id="shellReset" style="padding:2px 10px;font-size:11.5px;">Reset session</button>
      <button class="btn" type="button" id="shellCopy" style="padding:2px 10px;font-size:11.5px;">Copy output</button>
      <span class="muted" style="font-size:11.5px;">&uarr;&darr; history &middot; Shift+Enter multi-line &middot; Ctrl+L clear &middot; 120s per command</span>
    </div>
    <div class="term" id="term">
      <div id="termOut"></div>
      <div class="term-line">
        <span class="term-prompt" id="termPrompt">PS&gt;</span>
        <textarea class="term-in" id="termIn" rows="1" spellcheck="false" autocomplete="off"
                  placeholder="type or paste a command - Enter runs, Shift+Enter for a new line"></textarea>
      </div>
    </div>
  </div>

  <!-- Installed software: served from the Portal's cached inventory, so it lists and
       searches even when the machine is off. Removal still needs it online. -->
  <div class="tool-panel" data-panel="software">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:4px;">
      <input class="input" id="softFilter" placeholder="Search name or publisher…" style="max-width:280px;font-size:12.5px;">
      <button class="btn" type="button" id="softSearch">Search</button>
      <button class="btn btn-primary" type="button" id="softRefresh" title="Ask the device for a fresh list (needs it online)">Refresh from device</button>
      <button class="btn" type="button" id="softInstall">Install software…</button>
      <span class="tool-busy" id="softwareBusy"></span>
    </div>
    <p class="muted" id="softAge" style="font-size:11.5px;margin:0;"></p>
    <div id="softwareResult"></div>

    <!-- Install software.
         One search box, both package managers at once. The old screen had three separate
         sections and made you copy a package id from a wall of text into a second box,
         which is precisely the sort of thing nobody does twice. -->
    <div id="swModal" class="sw-modal" style="display:none;">
      <div class="sw-sheet" role="dialog" aria-modal="true" aria-label="Install software">
        <div class="sw-head">
          <div>
            <h3 style="margin:0;font-size:15px;">Install software</h3>
            <p class="muted" style="margin:2px 0 0;font-size:12px;">on <%= asset.hostname %></p>
          </div>
          <button type="button" class="btn" id="swClose" title="Close" style="padding:2px 10px;">&#10005;</button>
        </div>

        <div class="sw-body">
          <div class="sw-searchrow">
            <input class="input" id="swQ" placeholder="Search for anything &mdash; spotify, 7-zip, chrome, teams&hellip;" autocomplete="off" style="font-size:14px;padding:9px 12px;">
            <button class="btn btn-primary" type="button" id="swGo" style="padding:9px 18px;">Search</button>
          </div>
          <p class="muted" id="swHint" style="font-size:12px;margin:8px 2px 0;">
            Asks WinGet and Chocolatey on this machine at the same time, so you see what each can actually install.
          </p>

          <div id="swResults" style="margin-top:12px;"></div>

          <details class="sw-msi">
            <summary>Have an MSI instead?</summary>
            <div style="padding:12px 2px 2px;">
              <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
                <label style="flex:2;min-width:220px;font-size:12px;">From the package library
                  <select class="input" id="pkgSelect" style="font-size:12.5px;"><option value="">&mdash; choose &mdash;</option></select>
                </label>
                <span class="muted" style="font-size:12px;padding-bottom:8px;">or</span>
                <label style="flex:2;min-width:220px;font-size:12px;">Direct MSI URL (https)
                  <input class="input" id="pkgUrl" placeholder="https://&hellip;/app.msi" style="font-size:12.5px;">
                </label>
                <label style="width:140px;font-size:12px;">msiexec args
                  <input class="input" id="pkgArgs" value="/qn /norestart" style="font-size:12.5px;">
                </label>
                <button class="btn btn-primary" type="button" id="pkgGo">Install</button>
              </div>

              <div style="margin-top:12px;padding-top:12px;border-top:1px dashed var(--line);display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
                <label style="flex:2;min-width:240px;font-size:12px;">Upload an MSI
                  <input class="input" type="file" id="pkgFile" accept=".msi,application/x-msi" style="font-size:12.5px;">
                </label>
                <label style="flex:1;min-width:160px;font-size:12px;">Call it
                  <input class="input" id="pkgFileName" placeholder="e.g. Sage 50 v30" style="font-size:12.5px;">
                </label>
                <button class="btn" type="button" id="pkgUpload">Upload &amp; install</button>
                <span class="muted" id="pkgUpMsg" style="font-size:12px;"></span>
              </div>
              <p class="muted" style="font-size:11.5px;margin:8px 0 0;">
                Uploads join the library, so the next machine that needs it is one click rather than another upload.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <!-- Services -->
  <div class="tool-panel" data-panel="services">
    <button class="btn btn-primary" type="button" data-load="services">Load services</button>
    <input class="input" id="svcFilter" placeholder="Filter…" style="max-width:220px;display:inline-block;margin-left:8px;font-size:12.5px;">
    <span class="tool-busy" id="servicesBusy"></span>
    <div id="servicesResult"></div>
  </div>

  <!-- Users -->
  <div class="tool-panel" data-panel="users">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <button class="btn btn-primary" type="button" data-load="users">Local users</button>
      <button class="btn" type="button" id="adLoad">Active Directory</button>
      <input class="input" id="adQuery" placeholder="AD search (name or username)" style="max-width:260px;font-size:12.5px;">
      <span class="tool-busy" id="usersBusy"></span>
    </div>
    <div id="usersResult"></div>
  </div>

  <!-- File system -->
  <div class="tool-panel" data-panel="files">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <button class="btn btn-primary" type="button" id="filesRoot">Drives</button>
      <input class="input tool-crumb" id="filesPath" placeholder="C:\Windows" style="flex:1;min-width:240px;">
      <button class="btn" type="button" id="filesGo">Go</button>
      <span class="tool-busy" id="filesBusy"></span>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px;">
      <input class="input" id="filesPattern" placeholder="Search this folder, e.g. *.log" style="max-width:220px;font-size:12.5px;">
      <select class="input" id="filesDepth" style="width:auto;font-size:12.5px;">
        <option value="1">1 level deep</option>
        <option value="4" selected>4 levels deep</option>
        <option value="8">8 levels deep</option>
      </select>
      <button class="btn" type="button" id="filesFind">Find</button>
      <span class="muted" style="font-size:11.5px;">first 300 matches</span>
      <span style="flex:1;"></span>
      <label class="btn" style="cursor:pointer;margin:0;">Upload here
        <input type="file" id="filesUpload" style="display:none;">
      </label>
    </div>
    <div id="filesResult"></div>
  </div>

  <!-- Registry: modelled on regedit - hive tree on the left, values on the right,
       address bar across the top, and the toolset engineers actually reach for. -->
  <div class="tool-panel" data-panel="registry">
    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:8px;">
      <input class="input tool-crumb" id="regPath" placeholder="HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft" style="flex:1;min-width:280px;">
      <button class="btn" type="button" id="regGo">Go</button>
      <button class="btn" type="button" id="regUp" title="Parent key">&uarr;</button>
      <button class="btn" type="button" id="regRefresh" title="Refresh">&#8635;</button>
      <span class="tool-busy" id="regBusy"></span>
    </div>
    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:8px;">
      <input class="input" id="regFind" placeholder="Find…" style="max-width:190px;font-size:12.5px;">
      <label style="font-size:11.5px;display:flex;gap:4px;align-items:center;"><input type="checkbox" id="regFindKeys" checked> keys</label>
      <label style="font-size:11.5px;display:flex;gap:4px;align-items:center;"><input type="checkbox" id="regFindValues" checked> values</label>
      <label style="font-size:11.5px;display:flex;gap:4px;align-items:center;"><input type="checkbox" id="regFindData" checked> data</label>
      <button class="btn" type="button" id="regFindGo">Find</button>
      <span style="width:1px;height:18px;background:var(--line);"></span>
      <button class="btn" type="button" id="regNewKey">New key</button>
      <select class="input" id="regNewValue" style="width:auto;font-size:12px;">
        <option value="">New value…</option>
        <option value="String">String</option>
        <option value="ExpandString">Expandable String</option>
        <option value="Binary">Binary</option>
        <option value="DWord">DWORD (32-bit)</option>
        <option value="QWord">QWORD (64-bit)</option>
        <option value="MultiString">Multi-String</option>
      </select>
      <button class="btn" type="button" id="regExport" title="Export this key to a .reg file">Export</button>
      <label class="btn" style="cursor:pointer;margin:0;" title="Import a .reg file">Import
        <input type="file" id="regImport" accept=".reg" style="display:none;">
      </label>
      <button class="btn" type="button" id="regAcl" title="View permissions on this key">Permissions</button>
      <button class="btn" type="button" id="regCopy" title="Copy key name">Copy name</button>
    </div>

    <div class="reg-split">
      <div class="reg-tree" id="regTree"></div>
      <div class="reg-values" id="regValues"></div>
    </div>
    <div class="tool-out" id="regOut"></div>
    <p class="muted" style="font-size:11.5px;margin:8px 0 0;">
      Runs as SYSTEM on the device. <strong>HKEY_CURRENT_USER is the SYSTEM account's own hive</strong>, not the signed-in
      user's &mdash; for a real user's HKCU, use the Console in "Signed-in user" mode.
    </p>
  </div>

  <!-- Patch management: the same data as /patching/device, in a lightbox on the device's
       own page. Available is served from the Portal's stored scan (works offline);
       Installed asks the machine for its Windows Update history (needs it online). -->
  <div class="tool-panel" data-panel="patching">
    <% var _pm = (typeof patchMeta !== 'undefined' && patchMeta) ? patchMeta : null; %>
    <% var _pt = (typeof patches !== 'undefined' && patches) ? patches : []; %>
    <% if (!_pm) { %>
      <p class="muted" style="font-size:13px;">No LumenMSP Agent on this device, so there is no patch data.</p>
    <% } else { %>
    <div class="pt-tabs">
      <button type="button" id="ptTabAvail" class="active">Available patches (<%= _pt.length %>)</button>
      <button type="button" id="ptTabInst">Installed patches</button>
      <span style="flex:1;"></span>
      <span class="muted" style="font-size:11.5px;align-self:center;">
        scanned <%= _pm.scanAgo %> · <a class="row-link" href="/patching/device/<%= _pm.deviceId %>">full patching page →</a>
      </span>
    </div>

    <div id="ptAvail">
      <% if (_pm.rebootRequired) { %>
      <div class="alert" style="border:1px solid var(--warn-line);padding:8px 12px;font-size:12.5px;">
        <strong>A restart is outstanding.</strong>
        <span class="muted">Updates have installed but won't take effect until this machine is restarted.</span>
      </div>
      <% } %>
      <form method="post" action="/patching/device/<%= _pm.deviceId %>/install">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="back" value="/assets/<%= asset.id %>">
        <div style="display:flex;gap:8px;margin:0 0 10px;flex-wrap:wrap;align-items:center;">
          <button class="btn btn-primary" type="submit" name="when" value="now" <%= _pt.length ? '' : 'disabled' %>
            onclick="return confirm('Install all <%= _pt.length %> pending update(s) on <%= asset.hostname %> now?\n\nNothing will be restarted.');">
            &#11015; Install everything now
          </button>
          <button class="btn" type="submit" name="when" value="window" <%= _pt.length ? '' : 'disabled' %>
            onclick="return confirm('Hold these until this machine\'s maintenance window?');">
            Install in the maintenance window
          </button>
          <span class="muted" style="font-size:12px;" id="ptSelNote">ticked rows install; none ticked = everything</span>
        </div>
        <div class="table-wrap"><table class="tool-tbl">
          <thead><tr>
            <th style="width:30px;"><input type="checkbox" id="ptAll" title="Select all"></th>
            <th>Update</th><th>Source</th><th>Severity</th><th style="text-align:right;">Size</th><th style="text-align:right;">Outstanding</th>
          </tr></thead>
          <tbody>
          <% if (!_pt.length) { %>
            <tr><td colspan="6" class="muted" style="padding:16px 8px;"><%= _pm.scanAt ? 'Nothing pending — this machine is up to date.' : 'Not scanned yet. The agent scans on its daily inventory pass.' %></td></tr>
          <% } %>
          <% _pt.forEach(function (p) {
               var isDrv = /driver/i.test(String(p.categories || ''));
               var src = isDrv ? 'driver' : String(p.source || 'windows');
          %>
            <tr>
              <td><input type="checkbox" class="pt-one" name="update_ids" value="<%= p.update_id %>"></td>
              <td><%= p.title %><% if (p.kb) { %> <span class="muted" style="font-size:11px;">(KB<%= String(p.kb).replace(/^KB/i,'') %>)</span><% } %>
                  <% if (p.available_version) { %><div class="muted" style="font-size:11px;"><%= p.current_version || '?' %> &rarr; <%= p.available_version %></div><% } %></td>
              <td><span class="badge badge-inactive" style="font-size:10.5px;"><%= src %></span></td>
              <td><% if (p.severity) { %><span class="badge <%= String(p.severity).toLowerCase()==='critical' ? 'badge-failed' : 'badge-inactive' %>" style="font-size:10.5px;"><%= p.severity %></span><% } else { %><span class="muted">&mdash;</span><% } %></td>
              <td style="text-align:right;white-space:nowrap;"><%= p.size_mb != null ? Number(p.size_mb).toFixed(1) + ' MB' : '—' %></td>
              <td style="text-align:right;white-space:nowrap;"><%= Math.floor(Number(p.age_days || 0)) %>d</td>
            </tr>
          <% }); %>
          </tbody>
        </table></div>
      </form>
      <p class="muted" style="font-size:11.5px;margin:10px 0 0;">
        Windows updates install as one batch; applications go through WinGet or Chocolatey. Nothing here restarts the machine.
        Policy, exclusions and scheduling live on the <a class="row-link" href="/patching/device/<%= _pm.deviceId %>">full patching page</a>.
      </p>
    </div>

    <div id="ptInst" style="display:none;">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <button class="btn btn-primary" type="button" id="ptInstLoad">Load from device</button>
        <input class="input" id="ptInstFilter" placeholder="Filter…" style="max-width:220px;font-size:12.5px;">
        <span class="tool-busy" id="patchhistBusy"></span>
        <span class="muted" style="font-size:11.5px;">Windows Update history, straight from the machine — it needs to be online.</span>
      </div>
      <div id="ptInstResult"></div>
    </div>
    <% } %>
  </div>

  <!-- Task Manager: live process list, sorted by memory, with End process. -->
  <div class="tool-panel" data-panel="taskmgr">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <button class="btn btn-primary" type="button" data-load="taskmgr">Refresh</button>
      <input class="input" id="tmFilter" placeholder="Filter by name or user…" style="max-width:240px;font-size:12.5px;">
      <span class="tool-busy" id="taskmgrBusy"></span>
      <span class="muted" style="font-size:11.5px;">Top 400 by memory. CPU is total processor time, not a live percentage.</span>
    </div>
    <div id="taskmgrResult"></div>
  </div>

  <!-- Event Viewer: read-only window on the Windows event logs. -->
  <div class="tool-panel" data-panel="events">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <select class="input" id="evLog" style="width:auto;font-size:12.5px;">
        <option value="System">System</option>
        <option value="Application">Application</option>
        <option value="Security">Security</option>
        <option value="Setup">Setup</option>
      </select>
      <select class="input" id="evLevel" style="width:auto;font-size:12.5px;">
        <option value="0">All levels</option>
        <option value="1">Critical</option>
        <option value="2">Error</option>
        <option value="3">Warning</option>
        <option value="4">Information</option>
      </select>
      <select class="input" id="evRange" style="width:auto;font-size:12.5px;">
        <option value="1">Last hour</option>
        <option value="24" selected>Last 24 hours</option>
        <option value="168">Last 7 days</option>
        <option value="720">Last 30 days</option>
      </select>
      <input class="input" id="evQ" placeholder="Contains text or event id…" style="max-width:220px;font-size:12.5px;">
      <button class="btn btn-primary" type="button" id="evLoad">Load</button>
      <span class="tool-busy" id="eventsBusy"></span>
      <span class="muted" style="font-size:11.5px;">newest 300</span>
    </div>
    <div id="eventsResult"></div>
  </div>

  <!-- Run script: one-off scripts and a saved library, on top of the same audited
       shell kinds the console uses. -->
  <div class="tool-panel" data-panel="script">
    <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-bottom:8px;">
      <label style="flex:2;min-width:220px;font-size:12px;">Saved scripts
        <select class="input" id="scLib" style="font-size:12.5px;"><option value="">— new script —</option></select>
      </label>
      <label style="flex:2;min-width:200px;font-size:12px;">Name
        <input class="input" id="scName" placeholder="e.g. Clear print queue" style="font-size:12.5px;">
      </label>
      <button class="btn" type="button" id="scSave" title="Save to the library so it can be run on any device">Save</button>
      <button class="btn" type="button" id="scDelete" style="display:none;color:var(--bad-fg);">Delete</button>
    </div>
    <textarea class="input" id="scBody" rows="10" spellcheck="false" placeholder="# PowerShell (or cmd) — runs on <%= asset.hostname %> exactly as typed"
              style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;width:100%;"></textarea>
    <div style="display:flex;gap:10px;align-items:center;margin:8px 0 0;flex-wrap:wrap;">
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;"><input type="radio" name="scShell" value="shell.powershell" checked> PowerShell</label>
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;"><input type="radio" name="scShell" value="shell.cmd"> Command line</label>
      <span style="width:1px;height:18px;background:var(--line);"></span>
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;"><input type="radio" name="scRunAs" value="system" checked> SYSTEM</label>
      <label style="display:flex;gap:5px;align-items:center;font-size:13px;"><input type="radio" name="scRunAs" value="user"> Signed-in user</label>
      <button class="btn btn-primary" type="button" id="scRun">&#9654; Run on <%= asset.hostname %></button>
      <span class="tool-busy" id="scriptBusy"></span>
    </div>
    <div class="tool-out" id="scOut"></div>
    <p class="muted" style="font-size:11.5px;margin:8px 0 0;">Runs in the console's session (120s limit per run) and is audited like any console command. Saved scripts are shared — every device's Run script tool sees the same library.</p>
  </div>

  <!-- User activity: who signed in and when, from the Security event log. -->
  <div class="tool-panel" data-panel="activity">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <select class="input" id="uaDays" style="width:auto;font-size:12.5px;">
        <option value="1">Last 24 hours</option>
        <option value="7" selected>Last 7 days</option>
        <option value="30">Last 30 days</option>
      </select>
      <button class="btn btn-primary" type="button" data-load="activity">Load</button>
      <span class="tool-busy" id="activityBusy"></span>
      <span class="muted" style="font-size:11.5px;">Interactive, remote-desktop and unlock events — service accounts and machine logons are filtered out.</span>
    </div>
    <div id="activityResult"></div>
  </div>

  </div><!-- /lb-body -->
  </div><!-- /lb-sheet -->
  </div><!-- /lb-overlay -->

<!-- The Manage menu itself. Positioned by JS under the Manage button in the page header. -->
<div class="mg-menu" id="mgMenu">
  <button type="button" data-mg="patching">Patch management</button>
  <button type="button" data-mg="software">Software inventory</button>
  <button type="button" data-mg="software-install">Software installation</button>
  <div class="mg-sep"></div>
  <button type="button" data-mg="script">Run script</button>
  <button type="button" data-mg="services">Service Manager</button>
  <button type="button" data-mg="taskmgr">Task Manager</button>
  <button type="button" data-mg="power">Shutdown actions</button>
  <div class="mg-sep"></div>
  <button type="button" data-mg="console-cmd">Command Prompt</button>
  <button type="button" data-mg="console-ps">PowerShell</button>
  <div class="mg-sep"></div>
  <button type="button" data-mg="activity">User activity</button>
  <div class="mg-has-sub">
    <button type="button">More tools</button>
    <div class="mg-sub">
      <button type="button" data-mg="files">File transfer</button>
      <button type="button" data-mg="events">Event Viewer</button>
      <button type="button" data-mg="registry">Registry Editor</button>
      <button type="button" data-mg="users">Users &amp; passwords</button>
    </div>
  </div>
</div>

  <script>
  (function(){
    var ASSET = <%= asset.id %>;
    var BASE = '/assets/' + ASSET + '/tools';
    var esc = function(s){ return String(s==null?'':s).replace(/[&<>"]/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]; }); };

    // ── tool sub-tabs ──────────────────────────────────────────────────────────
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.tool-tabs button'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.tool-panel'));
    function showTool(k){
      tabs.forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-tool') === k); });
      panels.forEach(function(p){ p.classList.toggle('active', p.getAttribute('data-panel') === k); });
    }
    tabs.forEach(function(b){ b.addEventListener('click', function(){ showTool(b.getAttribute('data-tool')); }); });
    showTool('console');   // initial active panel for when the lightbox first opens

    // Every JSON call goes through here. If the server answers with HTML instead of JSON
    // we say WHY (status + what it looks like) rather than leaking a parser error.
    function jsonFetch(url, opts){
      return fetch(url, opts).then(function(res){
        var ct = (res.headers.get('content-type') || '').toLowerCase();
        if (ct.indexOf('application/json') >= 0) {
          return res.json().then(function(j){
            if (!res.ok && j && !j.error) throw new Error('Server error ' + res.status);
            return j;
          });
        }
        return res.text().then(function(body){
          var hint;
          if (res.status === 401 || res.status === 403 || /name="password"|Sign in|login/i.test(body.slice(0, 800))) {
            hint = 'Your session has expired, or this needs admin rights. Reload the page and sign in again.';
          } else if (res.status === 404) {
            hint = 'That endpoint is not on the server yet - the Portal needs deploying.';
          } else if (res.status === 413) {
            hint = 'That file is too large for the server to accept.';
          } else {
            hint = 'The server replied with ' + res.status + ' and a web page instead of data.';
          }
          throw new Error(hint);
        });
      });
    }

    // ── queue a command, then poll until the agent answers ─────────────────────
    function run(kind, body, busyEl){
      if (busyEl) busyEl.textContent = 'Running on the device…';
      var payload = Object.assign({ kind: kind }, body || {});
      return jsonFetch(BASE + '/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).then(function(j){
        if (!j.ok) throw new Error(j.error || 'Could not queue that command.');
        return poll(j.command_id, busyEl, 0).then(function(res){ res.password = j.password; res.routedTo = j.routed_to; return res; });
      }).catch(function(e){
        if (busyEl) busyEl.textContent = '';
        throw e;
      });
    }

    // Live progress. Determinate when the script says how far along it is, a moving
    // barber-pole when it does not — and the last line of output either way, because
    // "Extracting cabinet 3 of 7" tells you more than any percentage.
    function renderProgress(el, j, secs){
      var pct = (j.progress_pct === 0 || j.progress_pct) ? Number(j.progress_pct) : null;
      var tail = String(j.progress || '').split(/\r?\n/).filter(function(l){ return l.trim(); }).pop() || '';
      var label = j.status === 'queued'
        ? 'Waiting for the device to pick it up…'
        : (pct !== null ? pct + '%' : 'Running');
      var mins = Math.floor(secs / 60), t = mins ? mins + 'm ' + (secs % 60) + 's' : secs + 's';
      el.innerHTML =
        '<span class="tool-prog">' +
          '<span class="tool-prog-bar' + (pct === null ? ' indet' : '') + '">' +
            '<i style="width:' + (pct === null ? 100 : pct) + '%"></i>' +
          '</span>' +
          '<span class="tool-prog-txt">' + esc(label) + ' · ' + esc(t) +
            (tail ? ' · <span class="tool-prog-tail">' + esc(tail.slice(0, 120)) + '</span>' : '') +
          '</span>' +
        '</span>';
    }

    function poll(id, busyEl, tries){
      return new Promise(function(resolve, reject){
        function attempt(n){
          jsonFetch(BASE + '/result/' + id).then(function(j){
            if (!j.ok) return reject(new Error(j.error || 'Lost track of that command.'));
            if (j.status === 'queued' || j.status === 'running') {
              // No hard ceiling here any more. The server expires a command that has gone
              // quiet for three minutes; one that is still reporting is still working, and
              // a patch install or a big MSI legitimately takes far longer than that.
              if (busyEl) renderProgress(busyEl, j, n);
              return setTimeout(function(){ attempt(n + 1); }, 1000);
            }
            if (busyEl) busyEl.textContent = '';
            resolve(j);
          }).catch(reject);
        }
        attempt(tries);
      });
    }

    // Structured tools return JSON from PowerShell. Be tolerant: a stray warning or
    // error line can share the stream, so slice from the first bracket rather than
    // demanding the whole payload be clean. A single row arrives as an object, not an
    // array. Returns null only when there is genuinely no JSON in there.
    function parseRows(out){
      var t = String(out || '').trim();
      if (!t) return [];
      var starts = [t.indexOf('['), t.indexOf('{')].filter(function(n){ return n >= 0; });
      if (!starts.length) return null;
      var from = Math.min.apply(null, starts);
      var last = Math.max(t.lastIndexOf(']'), t.lastIndexOf('}'));
      if (last <= from) return null;
      try {
        var v = JSON.parse(t.slice(from, last + 1));
        if (v == null) return [];
        return Array.isArray(v) ? v : [v];
      } catch (e) { return null; }
    }

    function fail(el, msg){ el.innerHTML = '<div class="tool-out">' + esc(msg) + '</div>'; }

    // ── terminal ───────────────────────────────────────────────────────────────
    var term = document.getElementById('term');
    var termOut = document.getElementById('termOut');
    var termIn = document.getElementById('termIn');
    var termPrompt = document.getElementById('termPrompt');
    var history = [], histPos = -1, cwd = '';
    var CWD_MARK = '___LMA_CWD___';

    function runAsMode(){ var r = document.querySelector('input[name="runAs"]:checked'); return r ? r.value : 'system'; }
    function promptText(){
      var mode = (document.querySelector('input[name="shellKind"]:checked') || {}).value === 'shell.cmd' ? 'CMD' : 'PS';
      // Make the context impossible to miss - running the wrong one is a real trap.
      return mode + (runAsMode() === 'user' ? ' (user)' : ' (SYSTEM)') + ' ' + (cwd || '') + '>';
    }
    function refreshPrompt(){ termPrompt.textContent = promptText(); }

    function write(text, cls){
      var pre = document.createElement('pre');
      if (cls) pre.className = cls;
      pre.textContent = text;
      termOut.appendChild(pre);
      term.scrollTop = term.scrollHeight;
    }
    function writeEcho(cmd){
      var pre = document.createElement('pre');
      pre.className = 'term-echo';
      pre.innerHTML = '<b>' + esc(promptText()) + '</b> ' + esc(cmd);
      termOut.appendChild(pre);
      term.scrollTop = term.scrollHeight;
    }

    term.addEventListener('click', function(e){ if (!window.getSelection().toString()) termIn.focus(); });
    document.querySelectorAll('input[name="shellKind"], input[name="runAs"]').forEach(function(r){
      r.addEventListener('change', function(){
        // The two contexts have separate working directories on the device.
        cwd = '';
        refreshPrompt();
        if (this.name === 'runAs') {
          write(this.value === 'user'
            ? '-- switched to the signed-in user context (their drives, HKCU and profile; variables do not persist between commands) --'
            : '-- switched to SYSTEM (full rights; no user drives, HKCU or profile) --', 'term-note');
        }
      });
    });

    function submitCommand(){
      var cmd = termIn.value.trim();
      if (!cmd) return;
      var kind = (document.querySelector('input[name="shellKind"]:checked') || {}).value || 'shell.powershell';
      writeEcho(cmd);
      history.unshift(cmd); histPos = -1;
      termIn.value = '';
      growInput();
      termIn.disabled = true;
      var waiting = document.createElement('pre');
      waiting.className = 'term-note';
      waiting.textContent = 'running...';
      termOut.appendChild(waiting);
      term.scrollTop = term.scrollHeight;

      // The waiting line doubles as the progress element, so a long deployment typed in
      // here shows the bar and its own last line of output instead of sitting on
      // "running..." for ten minutes looking hung.
      run(kind, { script: cmd, run_as: runAsMode() }, waiting).then(function(r){
        waiting.remove();
        var out = String(r.output || '');
        var k = out.lastIndexOf(CWD_MARK);
        if (k >= 0) {
          cwd = out.slice(k + CWD_MARK.length).trim();
          out = out.slice(0, k).replace(/\s+$/, '');
          refreshPrompt();
        }
        if (r.status === 'expired') write(out || 'The device did not respond.', 'term-err');
        else if (out) write(out);
      }).catch(function(e){
        waiting.remove();
        write(e.message, 'term-err');
      }).then(function(){
        termIn.disabled = false;
        termIn.focus();
      });
    }

    // Auto-grow so a pasted multi-line command is fully visible.
    function growInput(){
      termIn.style.height = 'auto';
      termIn.style.height = Math.min(termIn.scrollHeight, 220) + 'px';
      term.scrollTop = term.scrollHeight;
    }
    termIn.addEventListener('input', growInput);
    // Paste lands as normal text (including multiple lines); just resize after it.
    termIn.addEventListener('paste', function(){ setTimeout(growInput, 0); });

    termIn.addEventListener('keydown', function(e){
      // Enter runs, Shift+Enter inserts a newline - so multi-line scripts can be pasted
      // or typed without being fired off half-written.
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submitCommand(); return; }
      if (e.key === 'Enter') return;
      // History only makes sense on a single-line entry; otherwise arrows move the caret.
      if ((e.key === 'ArrowUp' || e.key === 'ArrowDown') && termIn.value.indexOf('\n') >= 0) return;
      if (e.key === 'ArrowUp') {
        if (histPos + 1 < history.length) { histPos++; termIn.value = history[histPos];
          setTimeout(function(){ termIn.selectionStart = termIn.selectionEnd = termIn.value.length; }, 0); }
        e.preventDefault(); return;
      }
      if (e.key === 'ArrowDown') {
        if (histPos > 0) { histPos--; termIn.value = history[histPos]; }
        else { histPos = -1; termIn.value = ''; }
        e.preventDefault(); return;
      }
      if (e.key === 'l' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); termOut.innerHTML = ''; return; }
    });

    document.getElementById('shellCopy').addEventListener('click', function(){
      var text = termOut.innerText || '';
      var btn = document.getElementById('shellCopy');
      (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(function(){
        btn.textContent = 'Copied \u2713'; setTimeout(function(){ btn.textContent = 'Copy output'; }, 1500);
      }).catch(function(){
        // Clipboard API needs a secure context; fall back to a selection the user can copy.
        var r = document.createRange(); r.selectNodeContents(termOut);
        var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
        btn.textContent = 'Selected - press Ctrl+C'; setTimeout(function(){ btn.textContent = 'Copy output'; }, 2500);
      });
    });

    document.getElementById('shellReset').addEventListener('click', function(){
      write('resetting session...', 'term-note');
      run('shell.reset', {}, null).then(function(r){
        cwd = ''; refreshPrompt();
        write(r.output || 'Session reset.', 'term-note');
      }).catch(function(e){ write(e.message, 'term-err'); });
    });

    refreshPrompt();

    // ── generic table renderer with a live filter ──────────────────────────────
    function renderTable(container, rows, cols, filterInput, rowActions){
      if (rows === null) { fail(container, 'Unexpected output from the device.'); return; }
      if (!rows.length) { container.innerHTML = '<p class="muted" style="font-size:12.5px;margin-top:10px;">Nothing returned.</p>'; return; }
      function draw(q){
        var ql = (q || '').toLowerCase();
        var shown = rows.filter(function(r){
          if (!ql) return true;
          return cols.some(function(c){ return String(r[c.k] == null ? '' : r[c.k]).toLowerCase().indexOf(ql) >= 0; });
        });
        var html = '<table class="tool-tbl"><thead><tr>' +
          cols.map(function(c){ return '<th>' + esc(c.t) + '</th>'; }).join('') +
          (rowActions ? '<th></th>' : '') + '</tr></thead><tbody>';
        shown.slice(0, 500).forEach(function(r, i){
          html += '<tr>' + cols.map(function(c){
            return '<td>' + (c.render ? c.render(r) : esc(r[c.k])) + '</td>';
          }).join('') + (rowActions ? '<td style="text-align:right;white-space:nowrap;">' + rowActions(r, i) + '</td>' : '') + '</tr>';
        });
        html += '</tbody></table>';
        if (shown.length > 500) html += '<p class="muted" style="font-size:11.5px;">Showing the first 500 of ' + shown.length + '.</p>';
        else html += '<p class="muted" style="font-size:11.5px;">' + shown.length + ' row' + (shown.length===1?'':'s') + '.</p>';
        container.innerHTML = html;
      }
      draw(filterInput ? filterInput.value : '');
      if (filterInput && !filterInput._wired) {
        filterInput._wired = true;
        filterInput.addEventListener('input', function(){ draw(filterInput.value); });
      }
      container._draw = draw;
    }

    // ── installed software (cached in the Portal) ──────────────────────────────
    var softwareResult = document.getElementById('softwareResult');
    var softwareBusy = document.getElementById('softwareBusy');
    var softAge = document.getElementById('softAge');

    function ageWords(secs){
      if (secs == null) return 'never collected';
      var m = Math.round(secs/60);
      if (m < 2) return 'just now';
      if (m < 60) return m + ' minutes ago';
      var h = Math.round(m/60);
      if (h < 24) return h + ' hour' + (h===1?'':'s') + ' ago';
      return Math.round(h/24) + ' day' + (Math.round(h/24)===1?'':'s') + ' ago';
    }

    // Reads the Portal's stored inventory — no device round trip, so this works with the
    // machine switched off.
    function loadSoftware(){
      var q = document.getElementById('softFilter').value.trim();
      softwareBusy.textContent = 'Loading…';
      jsonFetch(BASE.replace(/\/tools$/, '') + '/software?q=' + encodeURIComponent(q))
        .then(function(j){
          softwareBusy.textContent = '';
          if (!j.ok) throw new Error(j.error || 'Could not load the list.');
          if (j.no_agent) { softAge.textContent = ''; fail(softwareResult, 'No LumenMSP Agent on this device.'); return; }
          softAge.textContent = j.rows.length
            ? 'Stored inventory, collected ' + ageWords(j.age_secs) + ' — searchable whether or not the device is on.'
            : (q ? 'Nothing matches that search.' : 'No inventory stored yet — use "Refresh from device" once it is online.');
          renderTable(softwareResult, j.rows, [
            { k:'name', t:'Name' }, { k:'version', t:'Version' }, { k:'publisher', t:'Publisher' },
            { k:'size_mb', t:'Size (MB)' }
          ], null, function(x){
            if (!x.removable) return '<span class="muted" style="font-size:11px;" title="No silent uninstall command is recorded for this application">no silent uninstall</span>';
            return '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-uninst="' + esc(x.name) +
                   '" data-code="' + esc(x.product_code || '') + '" data-cmd="' + esc(x.uninstall_cmd || '') + '">Uninstall</button>';
          });
        })
        .catch(function(e){ softwareBusy.textContent = ''; fail(softwareResult, e.message); });
    }

    document.getElementById('softSearch').addEventListener('click', loadSoftware);
    document.getElementById('softFilter').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); loadSoftware(); } });
    document.querySelector('[data-tool="software"]').addEventListener('click', function(){ if (!softwareResult.innerHTML) loadSoftware(); });

    document.getElementById('softRefresh').addEventListener('click', function(){
      run('inventory.software', {}, softwareBusy).then(function(r){
        softAge.textContent = r.output || 'Inventory refreshed.';
        loadSoftware();
      }).catch(function(e){ fail(softwareResult, e.message); });
    });

    softwareResult.addEventListener('click', function(e){
      var b = e.target.closest('[data-uninst]'); if (!b) return;
      var name = b.getAttribute('data-uninst');
      if (!confirm('Uninstall "' + name + '" from <%= asset.hostname %>?\n\nThis runs silently on the device and cannot be undone from here.')) return;
      b.disabled = true;
      run('software.uninstall', { name: name, product_code: b.getAttribute('data-code'), uninstall_cmd: b.getAttribute('data-cmd') }, softwareBusy)
        .then(function(r){
          alert(r.output || 'Done.');
          // The stored list is now stale, so re-read it from the device.
          return run('inventory.software', {}, softwareBusy);
        })
        .then(function(){ loadSoftware(); })
        .catch(function(err){ alert(err.message); b.disabled = false; });
    });

    // ── Install software ───────────────────────────────────────────────────────
    // One search, both managers, results side by side. Each row installs itself — no
    // copying a package id from one box into another, which is what the old three-panel
    // version asked for and nobody did twice.
    var swModal = document.getElementById('swModal');
    var swResults = document.getElementById('swResults');
    var swPending = 0;

    function swOpen(on){
      swModal.style.display = on ? 'flex' : 'none';
      if (!on) return;
      document.getElementById('swQ').focus();
      if (swModal._loaded) return;
      swModal._loaded = true;
      jsonFetch('/agent-packages.json').then(function(j){
        if (!j.ok) return;
        var sel = document.getElementById('pkgSelect');
        j.rows.forEach(function(p){
          var o = document.createElement('option');
          o.value = p.id;
          o.textContent = p.name + (p.version ? ' ' + p.version : '') + (p.file_name ? '' : ' (URL)');
          sel.appendChild(o);
        });
      }).catch(function(){ /* the library is optional */ });
    }
    document.getElementById('softInstall').addEventListener('click', function(){ swOpen(true); });
    document.getElementById('swClose').addEventListener('click', function(){ swOpen(false); });
    swModal.addEventListener('click', function(e){ if (e.target === swModal) swOpen(false); });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && swModal.style.display !== 'none') swOpen(false);
    });

    var SW_SRC = {
      winget: { label: 'WinGet', cls: 'sw-wg', logo:
        '<svg width="12" height="12" viewBox="0 0 16 16"><rect x="0" y="0" width="7" height="7" fill="#00a4ef"/><rect x="9" y="0" width="7" height="7" fill="#7fba00"/><rect x="0" y="9" width="7" height="7" fill="#f25022"/><rect x="9" y="9" width="7" height="7" fill="#ffb900"/></svg>' },
      choco:  { label: 'Chocolatey', cls: 'sw-ch', logo:
        '<svg width="12" height="12" viewBox="0 0 16 16"><rect width="16" height="16" rx="2.5" fill="#804c28"/><path d="M11 5.4a3.4 3.4 0 100 5.2" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>' }
    };

    // WinGet has no machine-readable output for search, so the table is read by COLUMN
    // OFFSET from its own header row. Splitting on whitespace produces nonsense the moment
    // an application name contains a space, which is most of them.
    function swParseWinget(text){
      var lines = String(text || '').replace(/[█░▒▓\-\\|\/]{4,}/g, '').split(/\r?\n/);
      var h = -1;
      for (var i = 0; i < lines.length; i++) { if (/^\s*Name\s+Id\s+Version/.test(lines[i])) { h = i; break; } }
      if (h < 0) return [];
      var head = lines[h];
      var iId = head.indexOf('Id'), iVer = head.indexOf('Version');
      var iSrc = head.indexOf('Source'); var iMatch = head.indexOf('Match');
      var iEnd = iSrc > iVer ? iSrc : (iMatch > iVer ? iMatch : -1);
      var out = [];
      for (var j = h + 1; j < lines.length && out.length < 40; j++) {
        var l = lines[j];
        if (!l.trim() || /^[\s\-]+$/.test(l) || l.length <= iVer) continue;
        var name = l.slice(0, iId).trim();
        var id = l.slice(iId, iVer).trim();
        var ver = (iEnd > iVer ? l.slice(iVer, iEnd) : l.slice(iVer)).trim();
        if (name && id) out.push({ source: 'winget', name: name, id: id, version: ver });
      }
      return out;
    }

    // Chocolatey does offer machine output: id|version, one per line.
    function swParseChoco(text){
      var out = [];
      String(text || '').split(/\r?\n/).forEach(function(l){
        var p = l.split('|');
        if (p.length >= 2 && p[0] && !/^Chocolatey/i.test(p[0]) && out.length < 40) {
          out.push({ source: 'choco', name: p[0].trim(), id: p[0].trim(), version: (p[1] || '').trim() });
        }
      });
      return out;
    }

    function swRender(rows, note){
      if (!rows.length) { return; }
      rows.forEach(function(r){
        var meta = SW_SRC[r.source];
        var row = document.createElement('div');
        row.className = 'sw-row';
        row.innerHTML =
          '<span class="sw-badge ' + meta.cls + '">' + meta.logo + ' ' + meta.label + '</span>' +
          '<span class="sw-name">' + esc(r.name) + '<span class="sw-id">' + esc(r.id) + '</span></span>' +
          '<span class="sw-ver">' + esc(r.version || '') + '</span>';
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'btn btn-primary sw-install'; b.textContent = 'Install';
        b.addEventListener('click', function(){
          if (!confirm('Install "' + r.name + '" on <%= asset.hostname %> via ' + meta.label + '?')) return;
          b.disabled = true; b.textContent = 'Installing…';
          run(r.source === 'choco' ? 'choco.install' : 'winget.install', { id: r.id }, softwareBusy)
            .then(function(res){
              b.textContent = 'Installed';
              row.classList.add('done');
              if (res.output) row.title = res.output.slice(0, 400);
              return run('inventory.software', {}, softwareBusy);
            })
            .then(function(){ loadSoftware(); })
            .catch(function(e){ b.disabled = false; b.textContent = 'Install'; alert(e.message); });
        });
        row.appendChild(b);
        swResults.appendChild(row);
      });
    }

    function swSearch(){
      var q = document.getElementById('swQ').value.trim();
      if (!q) { document.getElementById('swQ').focus(); return; }
      swResults.innerHTML = '';
      swPending = 2;
      var hint = document.getElementById('swHint');
      hint.textContent = 'Asking WinGet and Chocolatey on ' + '<%= asset.hostname %>' + '…';

      function done(label, err){
        swPending--;
        if (err) {
          var w = document.createElement('div');
          w.className = 'sw-note';
          w.textContent = label + ': ' + err;
          swResults.appendChild(w);
        }
        if (swPending <= 0) {
          hint.textContent = swResults.querySelector('.sw-row')
            ? 'Pick a version and press Install. Both managers install machine-wide.'
            : 'Nothing came back for that. Try a shorter word — "adobe" rather than "adobe acrobat reader dc".';
        }
      }

      run('winget.search', { q: q }, softwareBusy)
        .then(function(r){ swRender(swParseWinget(r.output)); done('WinGet'); })
        .catch(function(e){ done('WinGet', e.message); });
      run('choco.search', { q: q }, softwareBusy)
        .then(function(r){ swRender(swParseChoco(r.output)); done('Chocolatey'); })
        .catch(function(e){ done('Chocolatey', e.message); });
    }
    document.getElementById('swGo').addEventListener('click', swSearch);
    document.getElementById('swQ').addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); swSearch(); }
    });

    document.getElementById('pkgGo').addEventListener('click', function(){
      var pkg = document.getElementById('pkgSelect').value;
      var url = document.getElementById('pkgUrl').value.trim();
      var args = document.getElementById('pkgArgs').value.trim() || '/qn /norestart';
      if (!pkg && !url) { alert('Pick a package or paste an MSI URL.'); return; }
      if (!confirm('Install this on <%= asset.hostname %> now?')) return;
      var body = pkg ? { package_id: pkg } : { url: url, args: args };
      run('software.install', body, softwareBusy).then(function(r){
        alert(r.output || 'Done.');
        return run('inventory.software', {}, softwareBusy);
      }).then(function(){ loadSoftware(); }).catch(function(e){ alert(e.message); });
    });

    // Upload straight from here. It joins the package library on the way through, so the
    // next machine that needs the same MSI is one click rather than another upload.
    document.getElementById('pkgUpload').addEventListener('click', function(){
      var f = document.getElementById('pkgFile').files[0];
      var msg = document.getElementById('pkgUpMsg');
      if (!f) { alert('Choose an MSI first.'); return; }
      var fd = new FormData();
      fd.append('msi', f);
      fd.append('name', document.getElementById('pkgFileName').value.trim() || f.name);
      fd.append('args', document.getElementById('pkgArgs').value.trim() || '/qn /norestart');
      msg.textContent = 'Uploading…';
      fetch('/agent-packages?json=1', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function(res){ return res.json(); })
        .then(function(j){
          if (!j.ok) throw new Error(j.error || 'Upload failed.');
          msg.textContent = 'Uploaded. Installing…';
          var sel = document.getElementById('pkgSelect');
          var o = document.createElement('option');
          o.value = j.id; o.textContent = j.name; sel.appendChild(o); sel.value = j.id;
          return run('software.install', { package_id: j.id }, softwareBusy);
        })
        .then(function(r){
          msg.textContent = '';
          alert(r.output || 'Done.');
          return run('inventory.software', {}, softwareBusy);
        })
        .then(function(){ loadSoftware(); })
        .catch(function(e){ msg.textContent = ''; alert(e.message); });
    });

    // ── services ───────────────────────────────────────────────────────────────
    var servicesResult = document.getElementById('servicesResult');
    function loadServices(){
      servicesResult.innerHTML = '';
      run('services.list', {}, document.getElementById('servicesBusy')).then(function(r){
        renderTable(servicesResult, parseRows(r.output), [
          { k:'display', t:'Service' }, { k:'name', t:'Name' },
          { k:'status', t:'Status', render:function(x){
              var ok = String(x.status) === 'Running';
              return '<span style="font-weight:600;color:' + (ok ? 'var(--ok)' : 'var(--muted)') + ';">' + esc(x.status) + '</span>';
            } },
          { k:'start', t:'Startup' }
        ], document.getElementById('svcFilter'), function(x){
          return '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-svc="' + esc(x.name) + '" data-act="restart">Restart</button> ' +
                 '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-svc="' + esc(x.name) + '" data-act="' + (String(x.status)==='Running'?'stop':'start') + '">' +
                 (String(x.status)==='Running'?'Stop':'Start') + '</button> ' +
                 '<select class="input" style="width:auto;font-size:11px;padding:1px 4px;" data-startup="' + esc(x.name) + '" title="Change the startup type">' +
                   '<option value="">startup\u2026</option>' +
                   '<option value="Automatic">Automatic</option>' +
                   '<option value="AutomaticDelayed">Automatic (delayed)</option>' +
                   '<option value="Manual">Manual</option>' +
                   '<option value="Disabled">Disabled</option>' +
                 '</select>';
        });
      }).catch(function(e){ fail(servicesResult, e.message); });
    }
    document.querySelector('[data-load="services"]').addEventListener('click', loadServices);
    servicesResult.addEventListener('change', function(e){
      var sel = e.target.closest('[data-startup]'); if (!sel || !sel.value) return;
      var name = sel.getAttribute('data-startup'), mode = sel.value;
      if (!confirm('Set "' + name + '" startup type to ' + mode + ' on <%= asset.hostname %>?')) { sel.value = ''; return; }
      sel.disabled = true;
      run('services.startup', { name: name, startup: mode }, document.getElementById('servicesBusy')).then(function(r){
        alert(r.output || 'Done.');
        loadServices();
      }).catch(function(err){ alert(err.message); sel.disabled = false; sel.value = ''; });
    });

    servicesResult.addEventListener('click', function(e){
      var b = e.target.closest('[data-svc]'); if (!b) return;
      var name = b.getAttribute('data-svc'), act = b.getAttribute('data-act');
      if (!confirm(act.charAt(0).toUpperCase() + act.slice(1) + ' the "' + name + '" service on <%= asset.hostname %>?')) return;
      b.disabled = true;
      run('services.' + act, { name: name }, document.getElementById('servicesBusy')).then(function(r){
        alert(r.output || 'Done.');
        loadServices();
      }).catch(function(err){ alert(err.message); b.disabled = false; });
    });

    // ── users (local + AD) ─────────────────────────────────────────────────────
    var usersResult = document.getElementById('usersResult');
    var usersBusy = document.getElementById('usersBusy');
    var usersMode = 'local';

    function showPassword(container, pw, who){
      var d = document.createElement('div');
      d.className = 'pw-reveal';
      d.innerHTML = '<strong>New password for ' + esc(who) + ':</strong> <code>' + esc(pw) + '</code>' +
        '<div class="muted" style="font-size:11.5px;margin-top:4px;">Shown once &mdash; not stored anywhere and never written to the audit log. Copy it now.</div>';
      container.insertBefore(d, container.firstChild);
    }

    function loadLocalUsers(){
      usersMode = 'local';
      usersResult.innerHTML = '';
      run('users.list', {}, usersBusy).then(function(r){
        renderTable(usersResult, parseRows(r.output), [
          { k:'name', t:'User' }, { k:'full', t:'Full name' },
          { k:'enabled', t:'Enabled', render:function(x){
              return x.enabled ? '<span style="color:var(--ok);font-weight:600;">Yes</span>' : '<span style="color:var(--bad-fg);font-weight:600;">No</span>';
            } },
          { k:'last_logon', t:'Last logon' }, { k:'pw_set', t:'Password set' }
        ], null, function(x){
          return '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-user="' + esc(x.name) + '" data-act="' + (x.enabled?'disable':'enable') + '">' +
                 (x.enabled?'Disable':'Enable') + '</button> ' +
                 '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-user="' + esc(x.name) + '" data-act="resetpw">Reset password</button>';
        });
      }).catch(function(e){ fail(usersResult, e.message); });
    }

    function loadAdUsers(){
      usersMode = 'ad';
      usersResult.innerHTML = '';
      run('ad.users.list', { q: document.getElementById('adQuery').value.trim() }, usersBusy).then(function(r){
        var rows = parseRows(r.output);
        if (rows === null) { fail(usersResult, r.output || 'The AD agent returned no usable data.'); return; }
        renderTable(usersResult, rows, [
          { k:'name', t:'Name' }, { k:'sam', t:'Username' }, { k:'email', t:'Email' },
          { k:'enabled', t:'Enabled', render:function(x){
              return x.enabled ? '<span style="color:var(--ok);font-weight:600;">Yes</span>' : '<span style="color:var(--bad-fg);font-weight:600;">No</span>';
            } },
          { k:'last_logon', t:'Last logon' }
        ], null, function(x){
          return '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-ad="' + esc(x.sam) + '" data-act="' + (x.enabled?'disable':'enable') + '">' +
                 (x.enabled?'Disable':'Enable') + '</button> ' +
                 '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-ad="' + esc(x.sam) + '" data-act="resetpw">Reset password</button>';
        });
        if (r.routedTo) {
          var n = document.createElement('p');
          n.className = 'muted'; n.style.fontSize = '11.5px';
          n.textContent = 'Routed via the AD agent: ' + r.routedTo;
          usersResult.insertBefore(n, usersResult.firstChild);
        }
      }).catch(function(e){ fail(usersResult, e.message); });
    }

    document.querySelector('[data-load="users"]').addEventListener('click', loadLocalUsers);
    document.getElementById('adLoad').addEventListener('click', loadAdUsers);
    document.getElementById('adQuery').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); loadAdUsers(); } });

    usersResult.addEventListener('click', function(e){
      var b = e.target.closest('[data-user],[data-ad]'); if (!b) return;
      var isAd = b.hasAttribute('data-ad');
      var who = isAd ? b.getAttribute('data-ad') : b.getAttribute('data-user');
      var act = b.getAttribute('data-act');
      var kind = isAd ? ('ad.user.' + act) : ('users.' + act);
      var body = isAd ? { sam: who } : { name: who };
      if (act === 'resetpw') {
        // Leave it blank for a generated one, or type the password you want to set.
        var chosen = window.prompt(
          'Reset the password for "' + who + '"' + (isAd ? ' in Active Directory' : ' on <%= asset.hostname %>') + '.\n\n' +
          'Leave blank to generate a strong one, or type the password to set (8 characters minimum):', '');
        if (chosen === null) return;
        chosen = chosen.trim();
        if (chosen && chosen.length < 8) { alert('That password is too short - 8 characters minimum.'); return; }
        body.password = chosen;
        body.must_change = confirm('Require a password change at next sign-in?\n\nOK = yes, Cancel = no') ? '1' : '0';
      } else {
        if (!confirm(act.charAt(0).toUpperCase() + act.slice(1) + ' the account "' + who + '"' + (isAd ? ' in Active Directory' : ' on <%= asset.hostname %>') + '?')) return;
      }
      b.disabled = true;
      run(kind, body, usersBusy).then(function(r){
        if (r.status !== 'done') { alert(r.output || 'That did not complete.'); b.disabled = false; return; }
        var reload = isAd ? loadAdUsers : loadLocalUsers;
        reload();
        if (act === 'resetpw' && r.password) {
          setTimeout(function(){ showPassword(usersResult, r.password, who); }, 400);
        }
      }).catch(function(err){ alert(err.message); b.disabled = false; });
    });

    // ── file system ────────────────────────────────────────────────────────────
    var filesResult = document.getElementById('filesResult');
    var filesBusy = document.getElementById('filesBusy');
    var filesPath = document.getElementById('filesPath');

    function browse(path){
      filesPath.value = path || '';
      filesResult.innerHTML = '';
      run('files.list', { path: path || '' }, filesBusy).then(function(r){
        if (r.status !== 'done') { fail(filesResult, r.output || 'Could not read that path.'); return; }
        var rows = parseRows(r.output);
        if (rows === null) { fail(filesResult, r.output); return; }
        var up = '';
        if (path && /[\\\/]/.test(path.replace(/[\\\/]+$/, ''))) {
          var parent = path.replace(/[\\\/]+$/, '').replace(/[\\\/][^\\\/]*$/, '');
          if (/^[A-Za-z]:$/.test(parent)) parent += '\\';
          up = '<button class="btn" style="padding:2px 10px;font-size:11.5px;margin-bottom:6px;" data-path="' + esc(parent) + '">&uarr; Up</button>';
        }
        var holder = document.createElement('div');
        holder.innerHTML = up;
        filesResult.appendChild(holder);
        var tblHost = document.createElement('div');
        filesResult.appendChild(tblHost);
        renderTable(tblHost, rows, [
          { k:'name', t:'Name', render:function(x){
              if (!x.dir) return '&#128196; ' + esc(x.name);
              var full = path ? (path.replace(/[\\\/]+$/, '') + '\\' + x.name) : x.name;
              return '&#128193; <a href="#" class="row-link" data-path="' + esc(full) + '">' + esc(x.name) + '</a>';
            } },
          { k:'size', t:'Size', render:function(x){
              if (x.size == null) return '';
              var n = Number(x.size);
              return n >= 1048576 ? (n/1048576).toFixed(1) + ' MB' : n >= 1024 ? (n/1024).toFixed(1) + ' KB' : n + ' B';
            } },
          { k:'modified', t:'Modified' }
        ], null, function(x){
          var full = (path ? path.replace(/[\\\/]+$/, '') + '\\' + x.name : x.name);
          return '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-dl="' + esc(full) + '">Download</button> ' +
                 '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-del="' + esc(full) + '" data-isdir="' + (x.dir ? '1' : '0') + '">Delete</button>';
        });
      }).catch(function(e){ fail(filesResult, e.message); });
    }

    filesResult.addEventListener('click', function(e){
      var dl = e.target.closest('[data-dl]');
      if (dl) {
        var target = dl.getAttribute('data-dl');
        dl.disabled = true;
        run('files.download', { path: target }, filesBusy).then(function(r){
          dl.disabled = false;
          var out = String(r.output || '');
          var k = out.indexOf('___LMA_FILE___');
          if (k < 0) { alert(out || 'Could not fetch that file.'); return; }
          var parts = out.slice(k + 14).trim().split('|');
          // The device pushed it to the Portal; now pull it into the browser.
          window.location.href = BASE + '/file/' + parts[0];
        }).catch(function(err){ dl.disabled = false; alert(err.message); });
        return;
      }
      var del = e.target.closest('[data-del]');
      if (del) {
        var p2 = del.getAttribute('data-del');
        var isDir = del.getAttribute('data-isdir') === '1';
        if (!confirm('Permanently delete ' + (isDir ? 'the folder' : 'the file') + ':\n\n' + p2 +
                     '\n\nThere is no recycle bin - this runs as SYSTEM and cannot be undone.')) return;
        run('files.delete', { path: p2 }, filesBusy).then(function(r){
          if (r.exit_code) alert(r.output || 'Delete failed.');
          browse(filesPath.value.trim());
        }).catch(function(err){ alert(err.message); });
        return;
      }
      var a = e.target.closest('[data-path]'); if (!a) return;
      e.preventDefault();
      browse(a.getAttribute('data-path'));
    });

    // Upload: stage the file on the Portal first, then tell the device to collect it.
    document.getElementById('filesUpload').addEventListener('change', function(){
      var file = this.files && this.files[0];
      if (!file) return;
      var dest = filesPath.value.trim();
      if (!dest) { alert('Open the folder you want to upload into first.'); this.value = ''; return; }
      var isZip = /\.zip$/i.test(file.name);
      var expand = isZip && confirm('Extract "' + file.name + '" into ' + dest + ' after upload?\n\nOK = extract, Cancel = leave the zip as-is.');
      var fd = new FormData(); fd.append('file', file);
      filesBusy.textContent = 'Uploading to the portal…';
      var input = this;
      jsonFetch(BASE + '/stage', { method: 'POST', body: fd }).then(function(j){
        if (!j.ok) throw new Error(j.error || 'Upload failed.');
        return run('files.upload', {
          transfer_id: j.id,
          dest: dest.replace(/[\\\/]+$/, '') + '\\' + file.name,
          expand: expand ? '1' : '0'
        }, filesBusy);
      }).then(function(r){
        alert(r.output || 'Uploaded.');
        browse(filesPath.value.trim());
      }).catch(function(e){ filesBusy.textContent = ''; alert(e.message); })
        .then(function(){ input.value = ''; });
    });
    // ── file search ────────────────────────────────────────────────────────────
    document.getElementById('filesFind').addEventListener('click', function(){
      var path = filesPath.value.trim();
      var pattern = document.getElementById('filesPattern').value.trim();
      if (!path || !pattern) { alert('Give a folder and something to search for, e.g. *.log'); return; }
      filesResult.innerHTML = '';
      run('files.search', { path: path, pattern: pattern, depth: document.getElementById('filesDepth').value }, filesBusy)
        .then(function(r){
          if (r.status !== 'done') { fail(filesResult, r.output || 'Search failed.'); return; }
          var rows = parseRows(r.output);
          if (rows === null) { fail(filesResult, r.output || 'No matches.'); return; }
          renderTable(filesResult, rows, [
            { k:'name', t:'Name' }, { k:'path', t:'Folder' },
            { k:'size', t:'Size', render:function(x){
                var n = Number(x.size);
                return n >= 1048576 ? (n/1048576).toFixed(1) + ' MB' : n >= 1024 ? (n/1024).toFixed(1) + ' KB' : n + ' B';
              } },
            { k:'modified', t:'Modified' }
          ]);
        }).catch(function(e){ fail(filesResult, e.message); });
    });

    // ── registry (regedit-style) ───────────────────────────────────────────────
    // Display uses the long hive names people recognise (HKEY_LOCAL_MACHINE\...);
    // the agent needs PowerShell provider paths (HKLM:\...). Convert at the boundary
    // so neither side has to care about the other's convention.
    var BS = String.fromCharCode(92);
    var regOut = document.getElementById('regOut');
    var regBusy = document.getElementById('regBusy');
    var regPath = document.getElementById('regPath');
    var regTree = document.getElementById('regTree');
    var regValues = document.getElementById('regValues');
    var regCur = '';                     // current key, provider form
    var HIVES = [
      { disp: 'HKEY_CLASSES_ROOT',   prov: 'HKCR:' },
      { disp: 'HKEY_CURRENT_USER',   prov: 'HKCU:' },
      { disp: 'HKEY_LOCAL_MACHINE',  prov: 'HKLM:' },
      { disp: 'HKEY_USERS',          prov: 'HKU:'  },
      { disp: 'HKEY_CURRENT_CONFIG', prov: 'HKCC:' }
    ];
    function toDisplay(p){
      for (var i = 0; i < HIVES.length; i++) {
        if (p === HIVES[i].prov || p.indexOf(HIVES[i].prov + BS) === 0) {
          return HIVES[i].disp + p.slice(HIVES[i].prov.length);
        }
      }
      return p;
    }
    function toProvider(p){
      p = (p || '').trim().replace(/^Computer[\\\/]/i, '');
      for (var i = 0; i < HIVES.length; i++) {
        if (p === HIVES[i].disp || p.indexOf(HIVES[i].disp + BS) === 0) {
          return HIVES[i].prov + p.slice(HIVES[i].disp.length);
        }
        // tolerate the short form typed by hand
        var shortP = HIVES[i].prov.slice(0, -1);
        if (p === shortP || p.indexOf(shortP + BS) === 0) return HIVES[i].prov + p.slice(shortP.length);
      }
      return p;
    }
    function regParent(p){
      var t = p.replace(/\\+$/, '');
      var i = t.lastIndexOf(BS);
      return i < 0 ? '' : t.slice(0, i);
    }

    // --- tree ---------------------------------------------------------------
    function makeNode(displayName, providerPath, hasChildren){
      var li = document.createElement('li');
      li.className = 'reg-node';
      var row = document.createElement('div');
      row.className = 'row';
      row.setAttribute('data-key', providerPath);
      var tw = document.createElement('span');
      tw.className = 'tw';
      tw.textContent = hasChildren ? '\u25B8' : '';
      var label = document.createElement('span');
      label.textContent = displayName;
      row.appendChild(tw); row.appendChild(label);
      li.appendChild(row);
      var ul = document.createElement('ul');
      ul.style.display = 'none';
      li.appendChild(ul);
      li._tw = tw; li._ul = ul; li._loaded = false; li._has = hasChildren;
      tw.addEventListener('click', function(e){ e.stopPropagation(); toggleNode(li, providerPath); });
      row.addEventListener('click', function(){ selectKey(providerPath); });
      return li;
    }
    function toggleNode(li, key){
      if (!li._has) return;
      if (li._ul.style.display === 'none') {
        li._ul.style.display = '';
        li._tw.textContent = '\u25BE';
        if (!li._loaded) { li._loaded = true; loadChildren(li, key); }
      } else {
        li._ul.style.display = 'none';
        li._tw.textContent = '\u25B8';
      }
    }
    function loadChildren(li, key){
      li._ul.innerHTML = '<li class="reg-node muted" style="padding-left:16px;">loading…</li>';
      run('reg.list', { key: key }, null).then(function(r){
        var p = parseRows(r.output);
        li._ul.innerHTML = '';
        if (p === null || !p.length) { li._has = false; li._tw.textContent = ''; return; }
        var subs = p[0].subkeys || [];
        if (!subs.length) { li._has = false; li._tw.textContent = ''; return; }
        subs.forEach(function(sk){
          li._ul.appendChild(makeNode(sk.name, key.replace(/\\+$/, '') + BS + sk.name, sk.children !== false));
        });
      }).catch(function(e){ li._ul.innerHTML = '<li class="reg-node term-err" style="padding-left:16px;">' + esc(e.message) + '</li>'; });
    }
    function buildRoot(){
      regTree.innerHTML = '';
      var ul = document.createElement('ul');
      ul.style.paddingLeft = '2px';
      HIVES.forEach(function(h){ ul.appendChild(makeNode(h.disp, h.prov, true)); });
      regTree.appendChild(ul);
    }

    // --- values pane --------------------------------------------------------
    function selectKey(key){
      regCur = key;
      regPath.value = toDisplay(key);
      regTree.querySelectorAll('.row.sel').forEach(function(r){ r.classList.remove('sel'); });
      var row = regTree.querySelector('.row[data-key="' + (window.CSS && CSS.escape ? CSS.escape(key) : key.replace(/"/g, '\\"')) + '"]');
      if (row) row.classList.add('sel');
      regOut.textContent = '';
      regValues.innerHTML = '';
      run('reg.list', { key: key }, regBusy).then(function(r){
        if (r.status !== 'done' || r.exit_code) { fail(regValues, r.output || 'Could not read that key.'); return; }
        var p = parseRows(r.output);
        if (p === null || !p.length) { fail(regValues, r.output || 'Nothing there.'); return; }
        renderTable(regValues, p[0].values || [], [
          { k:'name', t:'Name', render:function(x){ return '&#128459; ' + esc(x.name); } },
          { k:'type', t:'Type' },
          { k:'data', t:'Data', render:function(x){ return '<span style="font-family:ui-monospace,Consolas,monospace;">' + esc(x.data || '') + '</span>'; } }
        ], null, function(x){
          if (x.data === '(value not set)' && x.name === '(Default)') return '';
          return '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-regedit="' + esc(x.name) + '" data-type="' + esc(x.type || 'String') + '" data-data="' + esc(x.data || '') + '">Modify</button> ' +
                 '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-regren="' + esc(x.name) + '">Rename</button> ' +
                 '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-regdelval="' + esc(x.name) + '">Delete</button>';
        });
      }).catch(function(e){ fail(regValues, e.message); });
    }
    function regReload(){ if (regCur) selectKey(regCur); }

    // --- value + key actions ------------------------------------------------
    regValues.addEventListener('click', function(e){
      var edit = e.target.closest('[data-regedit]');
      if (edit) {
        var nm = edit.getAttribute('data-regedit');
        var type = edit.getAttribute('data-type');
        var hint = type === 'MultiString' ? ' (one entry per line — use \\n between entries)'
                 : type === 'Binary' ? ' (hex bytes, e.g. 00 ff 1a)'
                 : (type === 'DWord' || type === 'QWord') ? ' (a number)' : '';
        var val = window.prompt('Value data for "' + nm + '" [' + type + ']' + hint + ':', edit.getAttribute('data-data'));
        if (val === null) return;
        run('reg.set', { key: regCur, name: nm === '(Default)' ? '' : nm, type: type, data: val }, regBusy)
          .then(function(r){ if (r.exit_code) alert(r.output || 'Failed.'); regReload(); })
          .catch(function(err){ alert(err.message); });
        return;
      }
      var ren = e.target.closest('[data-regren]');
      if (ren) {
        var old = ren.getAttribute('data-regren');
        if (old === '(Default)') { alert('The default value cannot be renamed.'); return; }
        var to = window.prompt('Rename value "' + old + '" to:', old);
        if (!to || to === old) return;
        run('reg.rename', { key: regCur, name: old, to: to }, regBusy)
          .then(function(r){ if (r.exit_code) alert(r.output || 'Failed.'); regReload(); })
          .catch(function(err){ alert(err.message); });
        return;
      }
      var del = e.target.closest('[data-regdelval]');
      if (del) {
        var vn = del.getAttribute('data-regdelval');
        if (!confirm('Delete the value "' + vn + '"?')) return;
        run('reg.deleteValue', { key: regCur, name: vn === '(Default)' ? '' : vn }, regBusy)
          .then(function(r){ if (r.exit_code) alert(r.output || 'Failed.'); regReload(); })
          .catch(function(err){ alert(err.message); });
      }
    });

    document.getElementById('regNewValue').addEventListener('change', function(){
      var type = this.value; this.value = '';
      if (!type) return;
      if (!regCur) { alert('Select a key first.'); return; }
      var nm = window.prompt('New ' + type + ' value name:');
      if (nm === null || !nm) return;
      var data = window.prompt('Data for "' + nm + '":', (type === 'DWord' || type === 'QWord') ? '0' : '');
      if (data === null) return;
      run('reg.set', { key: regCur, name: nm, type: type, data: data }, regBusy)
        .then(function(r){ if (r.exit_code) alert(r.output || 'Failed.'); regReload(); })
        .catch(function(e){ alert(e.message); });
    });

    document.getElementById('regNewKey').addEventListener('click', function(){
      if (!regCur) { alert('Select a parent key first.'); return; }
      var nm = window.prompt('New key name:');
      if (!nm) return;
      run('reg.newKey', { key: regCur.replace(/\\+$/, '') + BS + nm }, regBusy)
        .then(function(r){ if (r.exit_code) alert(r.output || 'Failed.'); buildRoot(); selectKey(regCur); })
        .catch(function(e){ alert(e.message); });
    });

    document.getElementById('regExport').addEventListener('click', function(){
      if (!regCur) { alert('Select a key first.'); return; }
      regOut.textContent = 'Exporting…';
      run('reg.export', { key: regCur }, regBusy).then(function(r){
        var out = String(r.output || '');
        var k = out.indexOf('___LMA_FILE___');
        if (k < 0) { regOut.textContent = out || 'Export failed.'; return; }
        var parts = out.slice(k + 14).trim().split('|');
        regOut.textContent = 'Exported ' + (parts[1] || 'key') + ' — download starting.';
        window.location.href = BASE + '/file/' + parts[0];
      }).catch(function(e){ regOut.textContent = e.message; });
    });

    document.getElementById('regImport').addEventListener('change', function(){
      var file = this.files && this.files[0];
      var input = this;
      if (!file) return;
      if (!confirm('Import "' + file.name + '" into the registry on <%= asset.hostname %>?\n\nA .reg file can change anything on the machine. This cannot be undone.')) { input.value = ''; return; }
      var fd = new FormData(); fd.append('file', file);
      regOut.textContent = 'Uploading…';
      jsonFetch(BASE + '/stage', { method: 'POST', body: fd }).then(function(j){
        if (!j.ok) throw new Error(j.error || 'Upload failed.');
        return run('reg.import', { transfer_id: j.id }, regBusy);
      }).then(function(r){
        regOut.textContent = r.output || 'Imported.';
        regReload();
      }).catch(function(e){ regOut.textContent = e.message; })
        .then(function(){ input.value = ''; });
    });

    document.getElementById('regAcl').addEventListener('click', function(){
      if (!regCur) { alert('Select a key first.'); return; }
      regOut.textContent = 'Reading permissions…';
      run('reg.acl', { key: regCur }, regBusy)
        .then(function(r){ regOut.textContent = r.output || '(none)'; })
        .catch(function(e){ regOut.textContent = e.message; });
    });

    document.getElementById('regCopy').addEventListener('click', function(){
      var t = toDisplay(regCur || '');
      if (!t) return;
      (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject())
        .then(function(){ regOut.textContent = 'Copied: ' + t; })
        .catch(function(){ window.prompt('Copy the key name:', t); });
    });

    document.getElementById('regFindGo').addEventListener('click', function(){
      var term = document.getElementById('regFind').value.trim();
      if (!term) { alert('Type something to search for.'); return; }
      if (!regCur) { alert('Select the key to search under first.'); return; }
      regOut.textContent = 'Searching under ' + toDisplay(regCur) + '… this can take a while on a big hive.';
      run('reg.find', {
        key: regCur, term: term,
        keys: document.getElementById('regFindKeys').checked ? '1' : '0',
        values: document.getElementById('regFindValues').checked ? '1' : '0',
        data: document.getElementById('regFindData').checked ? '1' : '0'
      }, regBusy).then(function(r){ regOut.textContent = r.output || 'No matches.'; })
        .catch(function(e){ regOut.textContent = e.message; });
    });
    document.getElementById('regFind').addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); document.getElementById('regFindGo').click(); }
    });

    function regGo(){
      var p = toProvider(regPath.value);
      if (!p) return;
      selectKey(p);
    }
    document.getElementById('regGo').addEventListener('click', regGo);
    regPath.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); regGo(); } });
    document.getElementById('regRefresh').addEventListener('click', regReload);
    document.getElementById('regUp').addEventListener('click', function(){
      var up = regParent(regCur);
      if (up) selectKey(up);
    });
    document.querySelector('[data-tool="registry"]').addEventListener('click', function(){
      if (!regTree.innerHTML) { buildRoot(); selectKey('HKLM:' + BS + 'SOFTWARE'); }
    });

    document.getElementById('filesRoot').addEventListener('click', function(){ browse(''); });
    document.getElementById('filesGo').addEventListener('click', function(){ browse(filesPath.value.trim()); });
    filesPath.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); browse(filesPath.value.trim()); } });

    // ══ Lightbox framework + Manage menu ════════════════════════════════════════
    var lbOverlay = document.getElementById('lbOverlay');
    var lbSheet = document.getElementById('lbSheet');
    var lbTitle = document.getElementById('lbTitle');
    var TOOL_TITLES = { console:'Console', software:'Software inventory', services:'Service Manager',
      users:'Users & passwords', files:'File system', registry:'Registry Editor', patching:'Patch management',
      taskmgr:'Task Manager', events:'Event Viewer', script:'Run script', activity:'User activity' };
    var _showTool = showTool;
    showTool = function(k){ _showTool(k); if (lbTitle && TOOL_TITLES[k]) lbTitle.textContent = TOOL_TITLES[k]; };
    function openTool(k){
      lbOverlay.classList.add('on');
      document.body.style.overflow = 'hidden';
      // Route through the nav button so every tool's lazy first-load fires exactly as it
      // did when these were tabs.
      var b = document.querySelector('.tool-tabs [data-tool="' + k + '"]');
      if (b) b.click(); else showTool(k);
    }
    function closeLb(){ lbOverlay.classList.remove('on'); document.body.style.overflow = ''; }
    document.getElementById('lbClose').addEventListener('click', closeLb);
    document.getElementById('lbMax').addEventListener('click', function(){ lbSheet.classList.toggle('max'); });
    lbOverlay.addEventListener('mousedown', function(e){ if (e.target === lbOverlay) closeLb(); });
    document.addEventListener('keydown', function(e){
      if (e.key !== 'Escape') return;
      if (swModal.style.display !== 'none') return;   // the install-software sheet closes itself first
      if (lbOverlay.classList.contains('on')) closeLb();
    });
    window.lmaOpenTool = openTool;
    window.lmaRun = run;

    // The Manage ▾ dropdown, positioned under the button in the page header.
    var mgMenu = document.getElementById('mgMenu');
    var mgBtn = document.getElementById('manageBtn');
    if (mgBtn && mgMenu) {
      document.body.appendChild(mgMenu);
      var mgOpen = false;
      var mgClose = function(){ mgMenu.classList.remove('on'); mgOpen = false; };
      mgBtn.addEventListener('click', function(e){
        e.stopPropagation();
        if (mgOpen) { mgClose(); return; }
        mgMenu.classList.add('on');
        var r = mgBtn.getBoundingClientRect();
        mgMenu.style.left = Math.max(8, window.scrollX + r.right - mgMenu.offsetWidth) + 'px';
        mgMenu.style.top = (window.scrollY + r.bottom + 3) + 'px';
        mgOpen = true;
      });
      document.addEventListener('click', function(e){ if (mgOpen && !mgMenu.contains(e.target)) mgClose(); });
      mgMenu.addEventListener('click', function(e){
        var b = e.target.closest('[data-mg]'); if (!b) return;
        var k = b.getAttribute('data-mg');
        mgClose();
        if (k === 'power') {
          // Open the shared power LIGHTBOX directly. (The old synthetic pw.click() died
          // instantly: this same click bubbled on to the document and the dropdown's
          // outside-click handler closed it in the same tick — "nothing happens".)
          var pw = document.querySelector('.pw-btn');
          if (pw && window.pwOpen) window.pwOpen(pw);
          else alert('No live agent on this machine, so there is nothing to restart or shut down remotely.');
          return;
        }
        if (k === 'software-install') { openTool('software'); swOpen(true); return; }
        if (k === 'console-cmd' || k === 'console-ps') {
          var v = k === 'console-cmd' ? 'shell.cmd' : 'shell.powershell';
          var radio = document.querySelector('input[name="shellKind"][value="' + v + '"]');
          if (radio && !radio.checked) { radio.checked = true; radio.dispatchEvent(new Event('change')); }
          openTool('console');
          setTimeout(function(){ termIn.focus(); }, 50);
          return;
        }
        openTool(k);
      });
    }

    // Security tab "Refresh from device" (the button lives on the Security tab, outside
    // this partial, so it reaches in through this hook).
    window.lmaSecurityRefresh = function(btn){
      var busy = document.getElementById('secBusy');
      if (btn) btn.disabled = true;
      run('security.status', {}, busy).then(function(r){
        if (busy) busy.textContent = '';
        if (r.status === 'done' && !r.exit_code) { location.reload(); return; }
        alert(r.output || 'The device did not respond.');
        if (btn) btn.disabled = false;
      }).catch(function(e){
        if (busy) busy.textContent = '';
        alert(e.message);
        if (btn) btn.disabled = false;
      });
    };

    // ── Patch management: sub-tabs + installed history ─────────────────────────
    (function(){
      var tabA = document.getElementById('ptTabAvail'), tabI = document.getElementById('ptTabInst');
      if (!tabA) return;   // no agent on this device
      var paneA = document.getElementById('ptAvail'), paneI = document.getElementById('ptInst');
      function ptShow(inst){
        tabA.classList.toggle('active', !inst); tabI.classList.toggle('active', inst);
        paneA.style.display = inst ? 'none' : ''; paneI.style.display = inst ? '' : 'none';
      }
      tabA.addEventListener('click', function(){ ptShow(false); });
      tabI.addEventListener('click', function(){ ptShow(true); });
      var all = document.getElementById('ptAll');
      if (all) all.addEventListener('change', function(){
        Array.prototype.slice.call(document.querySelectorAll('.pt-one')).forEach(function(t){ t.checked = all.checked; });
      });
      var instResult = document.getElementById('ptInstResult');
      document.getElementById('ptInstLoad').addEventListener('click', function(){
        instResult.innerHTML = '';
        run('patch.history', {}, document.getElementById('patchhistBusy')).then(function(r){
          renderTable(instResult, parseRows(r.output), [
            { k:'date', t:'Installed' }, { k:'title', t:'Update' }, { k:'kb', t:'KB' },
            { k:'result', t:'Result', render:function(x){
                var bad = /fail/i.test(String(x.result));
                return '<span style="font-weight:600;color:' + (bad ? 'var(--bad-fg)' : 'var(--ok)') + ';">' + esc(x.result) + '</span>';
              } }
          ], document.getElementById('ptInstFilter'));
        }).catch(function(e){ fail(instResult, e.message); });
      });
    })();

    // ── Task Manager ───────────────────────────────────────────────────────────
    var taskmgrResult = document.getElementById('taskmgrResult');
    function loadProcesses(){
      taskmgrResult.innerHTML = '';
      run('process.list', {}, document.getElementById('taskmgrBusy')).then(function(r){
        renderTable(taskmgrResult, parseRows(r.output), [
          { k:'name', t:'Name' }, { k:'pid', t:'PID' }, { k:'user', t:'User' },
          { k:'cpu_s', t:'CPU (s)' }, { k:'mem_mb', t:'Memory (MB)' }, { k:'started', t:'Started' }
        ], document.getElementById('tmFilter'), function(x){
          return '<button class="btn" style="padding:2px 8px;font-size:11.5px;" data-kill="' + esc(x.pid) + '" data-pname="' + esc(x.name) + '">End process</button>';
        });
      }).catch(function(e){ fail(taskmgrResult, e.message); });
    }
    document.querySelector('[data-load="taskmgr"]').addEventListener('click', loadProcesses);
    document.querySelector('[data-tool="taskmgr"]').addEventListener('click', function(){ if (!taskmgrResult.innerHTML) loadProcesses(); });
    taskmgrResult.addEventListener('click', function(e){
      var b = e.target.closest('[data-kill]'); if (!b) return;
      var pid = b.getAttribute('data-kill'), nm = b.getAttribute('data-pname');
      if (!confirm('End "' + nm + '" (PID ' + pid + ') on <%= asset.hostname %>?\n\nUnsaved work in that program is lost.')) return;
      b.disabled = true;
      run('process.kill', { pid: pid, name: nm }, document.getElementById('taskmgrBusy'))
        .then(function(r){ if (r.exit_code) alert(r.output || 'Failed.'); loadProcesses(); })
        .catch(function(err){ alert(err.message); b.disabled = false; });
    });

    // ── Event Viewer ───────────────────────────────────────────────────────────
    var eventsResult = document.getElementById('eventsResult');
    var EV_COLOR = { Critical: 'var(--bad-fg)', Error: 'var(--bad-fg)', Warning: 'var(--warn-fg)' };
    function loadEvents(){
      eventsResult.innerHTML = '';
      run('events.list', {
        log: document.getElementById('evLog').value,
        level: document.getElementById('evLevel').value,
        hours: document.getElementById('evRange').value,
        q: document.getElementById('evQ').value.trim()
      }, document.getElementById('eventsBusy')).then(function(r){
        renderTable(eventsResult, parseRows(r.output), [
          { k:'time', t:'Time' },
          { k:'level', t:'Level', render:function(x){
              var c = EV_COLOR[x.level];
              return '<span style="font-weight:600;' + (c ? 'color:' + c + ';' : '') + '">' + esc(x.level) + '</span>';
            } },
          { k:'source', t:'Source' }, { k:'id', t:'Event ID' },
          { k:'message', t:'Message', render:function(x){
              return '<span style="white-space:pre-wrap;overflow-wrap:anywhere;">' + esc(x.message || '') + '</span>';
            } }
        ]);
      }).catch(function(e){ fail(eventsResult, e.message); });
    }
    document.getElementById('evLoad').addEventListener('click', loadEvents);
    document.getElementById('evQ').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); loadEvents(); } });
    document.querySelector('[data-tool="events"]').addEventListener('click', function(){ if (!eventsResult.innerHTML) loadEvents(); });

    // ── Run script ─────────────────────────────────────────────────────────────
    var SCRIPTS = <%- JSON.stringify((typeof agentScripts !== 'undefined' && agentScripts) ? agentScripts : []).replace(/</g, '\\u003c') %>;
    var scLib = document.getElementById('scLib');
    var scName = document.getElementById('scName');
    var scBody = document.getElementById('scBody');
    var scOut = document.getElementById('scOut');
    var scDeleteBtn = document.getElementById('scDelete');
    function scFillLib(keepId){
      scLib.innerHTML = '<option value="">— new script —</option>';
      SCRIPTS.forEach(function(s){
        var o = document.createElement('option');
        o.value = s.id; o.textContent = s.name;
        scLib.appendChild(o);
      });
      if (keepId) scLib.value = String(keepId);
    }
    scFillLib();
    scLib.addEventListener('change', function(){
      var s = SCRIPTS.filter(function(x){ return String(x.id) === scLib.value; })[0];
      scDeleteBtn.style.display = s ? '' : 'none';
      if (!s) { scName.value = ''; scBody.value = ''; return; }
      scName.value = s.name; scBody.value = s.script;
      var sh = document.querySelector('input[name="scShell"][value="' + (s.shell === 'cmd' ? 'shell.cmd' : 'shell.powershell') + '"]');
      if (sh) sh.checked = true;
      var ra = document.querySelector('input[name="scRunAs"][value="' + (s.run_as === 'user' ? 'user' : 'system') + '"]');
      if (ra) ra.checked = true;
    });
    document.getElementById('scSave').addEventListener('click', function(){
      var name = scName.value.trim(), body = scBody.value;
      if (!name) { alert('Give the script a name first.'); scName.focus(); return; }
      if (!body.trim()) { alert('There is no script to save.'); return; }
      var payload = {
        id: scLib.value || null, name: name, script: body,
        shell: (document.querySelector('input[name="scShell"]:checked') || {}).value === 'shell.cmd' ? 'cmd' : 'powershell',
        run_as: (document.querySelector('input[name="scRunAs"]:checked') || {}).value === 'user' ? 'user' : 'system'
      };
      jsonFetch('/agent-scripts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
        .then(function(j){
          if (!j.ok) throw new Error(j.error || 'Could not save.');
          var existing = SCRIPTS.filter(function(x){ return String(x.id) === String(j.script.id); })[0];
          if (existing) Object.assign(existing, j.script); else SCRIPTS.push(j.script);
          SCRIPTS.sort(function(a, b){ return String(a.name).localeCompare(String(b.name)); });
          scFillLib(j.script.id);
          scDeleteBtn.style.display = '';
          scOut.textContent = 'Saved "' + j.script.name + '" to the library.';
        }).catch(function(e){ alert(e.message); });
    });
    scDeleteBtn.addEventListener('click', function(){
      var id = scLib.value; if (!id) return;
      var s = SCRIPTS.filter(function(x){ return String(x.id) === id; })[0];
      if (!confirm('Delete "' + (s ? s.name : 'this script') + '" from the library?\n\nEvery device loses it — running copies are not affected.')) return;
      jsonFetch('/agent-scripts/' + id + '/delete', { method: 'POST' }).then(function(j){
        if (!j.ok) throw new Error(j.error || 'Could not delete.');
        SCRIPTS = SCRIPTS.filter(function(x){ return String(x.id) !== id; });
        scFillLib(); scLib.value = ''; scName.value = ''; scBody.value = '';
        scDeleteBtn.style.display = 'none';
        scOut.textContent = 'Deleted.';
      }).catch(function(e){ alert(e.message); });
    });
    document.getElementById('scRun').addEventListener('click', function(){
      var body = scBody.value;
      if (!body.trim()) { alert('Type or pick a script first.'); return; }
      var kind = (document.querySelector('input[name="scShell"]:checked') || {}).value || 'shell.powershell';
      var runAs = (document.querySelector('input[name="scRunAs"]:checked') || {}).value || 'system';
      scOut.textContent = '';
      run(kind, { script: body, run_as: runAs }, document.getElementById('scriptBusy')).then(function(r){
        var out = String(r.output || '');
        var k = out.lastIndexOf('___LMA_CWD___');
        if (k >= 0) out = out.slice(0, k).replace(/\s+$/, '');
        scOut.textContent = out || '(no output)';
      }).catch(function(e){ scOut.textContent = e.message; });
    });

    // ── User activity ──────────────────────────────────────────────────────────
    var activityResult = document.getElementById('activityResult');
    function loadActivity(){
      activityResult.innerHTML = '';
      run('useractivity.list', { days: document.getElementById('uaDays').value }, document.getElementById('activityBusy'))
        .then(function(r){
          renderTable(activityResult, parseRows(r.output), [
            { k:'time', t:'Time' }, { k:'user', t:'User' },
            { k:'action', t:'Action', render:function(x){
                var bad = /fail/i.test(String(x.action));
                return '<span style="font-weight:600;' + (bad ? 'color:var(--bad-fg);' : '') + '">' + esc(x.action) + '</span>';
              } },
            { k:'type', t:'Type' }
          ]);
        }).catch(function(e){ fail(activityResult, e.message); });
    }
    document.querySelector('[data-load="activity"]').addEventListener('click', loadActivity);
    document.querySelector('[data-tool="activity"]').addEventListener('click', function(){ if (!activityResult.innerHTML) loadActivity(); });
  })();
  </script>
  <% } %>
</div>
