<%- include('../partials/header', { title: 'Questionnaires', user }) %>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/marketing">← Marketing</a></p>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
    <div>
      <h1 style="margin:0;">Questionnaires &amp; Polls</h1>
      <p class="muted" style="margin:4px 0 0;">Write them off-portal as JSON, import here, then attach a poll to a campaign or send a questionnaire to a customer.</p>
    </div>
    <a class="btn" href="/marketing/questionnaires/import">📥 Import JSON</a>
  </div>
</div>

<% if (notice) { %><div class="flash ok"><%= notice %></div><% } %>

<% if (!items.length) { %>
  <div class="panel" style="text-align:center;padding:44px 24px;">
    <p style="font-size:16px;font-weight:600;margin:0 0 6px;">Nothing imported yet</p>
    <p class="muted" style="margin:0 0 18px;">Ask Claude for a <code>lits.questionnaire/1</code> file, then paste it into the importer.</p>
    <a class="btn" href="/marketing/questionnaires/import">Import your first questionnaire</a>
  </div>
<% } else { %>
  <div class="panel table-lift">
    <table class="table">
      <thead>
        <tr>
          <th>Questionnaire</th><th>Mode</th><th>Version</th>
          <th class="num">Invited</th><th class="num">Answered</th><th class="num">Rate</th><th>Closes</th>
        </tr>
      </thead>
      <tbody>
      <% items.forEach(function (it) {
           var rate = it.invited ? Math.round((it.responded / it.invited) * 100) : null; %>
        <tr>
          <td>
            <a class="row-link" href="/marketing/questionnaires/<%= it.id %>"><strong><%= it.title %></strong></a>
            <div class="muted" style="font-size:12px;"><code><%= it.key %></code><% if (it.kind !== 'general') { %> · <%= it.kind.replace('_', ' ') %><% } %></div>
          </td>
          <td><span class="pill <%= it.mode === 'poll' ? 'pill-teal' : '' %>"><%= it.mode === 'poll' ? 'One-click poll' : 'Form' %></span></td>
          <td>v<%= it.current_version %><% if (it.versions > 1) { %> <span class="muted">of <%= it.versions %></span><% } %></td>
          <td class="num"><%= it.invited %></td>
          <td class="num"><%= it.responded %></td>
          <td class="num"><%= rate === null ? '—' : rate + '%' %></td>
          <td><%= it.closes_at ? new Date(it.closes_at).toISOString().slice(0, 10) : '—' %></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
