<%- include('../partials/header', { title: script.name, user }) %>
<%
  var isAdmin = user.role === 'admin';
  function kb(n){ return n < 1024 ? n + ' B' : (n/1024).toFixed(1) + ' KB'; }
%>
<style>
  .sc-meta { display:flex; gap:14px; flex-wrap:wrap; align-items:center; color:var(--muted); font-size:12px; margin:6px 0 14px; }
  .sc-form label { font-size:11.5px; font-weight:700; color:var(--muted); display:block; margin:10px 0 3px; }
  .sc-form input, .sc-form select, .sc-form textarea { width:100%; font:inherit; font-size:12.5px;
    padding:6px 9px; border:1px solid var(--line-strong); border-radius:7px;
    background:var(--card,#fff); color:var(--ink); box-sizing:border-box; }
  .sc-form textarea { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12.5px; line-height:1.5; }
  .sc-two { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .sc-four { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
  @media (max-width:900px){ .sc-four { grid-template-columns:1fr 1fr; } }
  .sc-code { background:var(--surface-2,#f8fafc); border:1px solid var(--line); border-radius:10px;
    padding:12px 14px; overflow:auto; max-height:60vh; }
  .sc-code pre { margin:0; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    font-size:12.5px; line-height:1.55; white-space:pre; }
  .pill { display:inline-block; font-size:10.5px; font-weight:700; padding:1px 7px; border-radius:999px; }
  .pill.plain { background:var(--surface-2,#f1f5f9); color:var(--muted); }
  .pill.info { background:var(--tint-info,#eff6ff); color:var(--info-fg,#1d4ed8); }
  .pill.bad { background:var(--tint-bad,#fef2f2); color:var(--bad-fg,#b91c1c); }
  .pill.warn { background:var(--tint-warn,#fffbeb); color:var(--warn-fg,#b45309); }
  .pill.ok { background:var(--tint-ok,#f0fdf4); color:var(--ok-fg,#15803d); }
  .rv { border:1px solid var(--line); border-radius:12px; padding:14px; margin-bottom:16px; background:var(--surface,#fff); }
  .rv h3 { margin:0 0 4px; font-size:14px; display:flex; align-items:center; gap:8px; }
  .rv .sum { font-size:13px; margin:6px 0 0; }
  .rv ul { margin:10px 0 0; padding-left:0; list-style:none; }
  .rv li { border-top:1px dashed var(--line); padding:8px 0; font-size:12.5px; display:flex; gap:9px; align-items:flex-start; }
  .rv li .ln { color:var(--muted); font-family:ui-monospace,Menlo,Consolas,monospace; font-size:11.5px; white-space:nowrap; padding-top:1px; }
</style>

<p style="margin:0 0 6px;"><a href="/scripts" style="font-size:12.5px;">&larr; All scripts</a></p>
<h1 style="margin:0;font-size:22px;"><%= script.name %></h1>
<div class="sc-meta">
  <span class="pill plain"><%= script.fileType %></span>
  <% if (script.source === 'atera') { %><span class="pill info">from Atera</span><% } %>
  <span><%= script.lines %> lines · <%= kb(script.bytes) %></span>
  <span>runs as <%= String(script.runAs).replace('_',' ') %></span>
  <% if (script.sourceRef) { %><span title="Atera script id"><%= script.sourceRef %></span><% } %>
  <a href="/scripts/<%= script.id %>/raw">Download</a>
</div>

<% if (notice) { %><div class="alert alert-success" style="margin-bottom:12px;"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-error" style="margin-bottom:12px;"><%= error %></div><% } %>

<% if (isAdmin) { %>
<div class="rv">
  <h3>
    Claude's review
    <% if (!script.reviewedAt) { %><span class="pill plain">not reviewed</span>
    <% } else if (script.reviewVerdict === 'broken') { %><span class="pill bad">broken</span>
    <% } else if (script.reviewVerdict === 'warn') { %><span class="pill warn">carries a risk</span>
    <% } else { %><span class="pill ok">ok</span><% } %>
    <% if (stale) { %><span class="pill warn">stale — edited since</span><% } %>
    <button class="btn btn-ghost" type="button" id="rvRun" style="margin-left:auto;font-size:12px;">
      <%= script.reviewedAt ? 'Review again' : 'Review this script' %></button>
  </h3>
  <% if (script.reviewedAt) { %>
    <p class="sum"><strong><%= script.reviewHeadline %></strong></p>
    <% if (script.reviewSummary) { %><p class="sum"><%= script.reviewSummary %></p><% } %>
    <% var fs = script.reviewFindings || []; %>
    <% if (fs.length) { %>
      <ul>
      <% fs.forEach(function(f){ %>
        <li>
          <span class="pill <%= f.severity === 'broken' ? 'bad' : (f.severity === 'risk' ? 'warn' : 'plain') %>"><%= f.severity %></span>
          <span class="ln"><%= f.line ? ('line ' + f.line) : '—' %></span>
          <span><%= f.note %></span>
        </li>
      <% }) %>
      </ul>
    <% } else { %><p class="sum" style="color:var(--muted);">No findings.</p><% } %>
    <p class="sum" style="color:var(--muted);font-size:11.5px;">
      Reviewed <%= new Date(script.reviewedAt).toLocaleString('en-GB',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %><%= stale ? ' — the script has changed since, so treat this as out of date.' : '' %>
    </p>
  <% } else { %>
    <p class="sum" style="color:var(--muted);">Nobody has had Claude read this one yet.</p>
  <% } %>
  <div id="rvMsg" style="font-size:12px;color:var(--muted);margin-top:8px;"></div>
</div>
<% } %>

<% if (script.description) { %><p style="margin:0 0 14px;font-size:13px;"><%= script.description %></p><% } %>

<% if (isAdmin) { %>
  <form method="post" action="/scripts/<%= script.id %>" class="sc-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="sc-two">
      <div><label>Name</label><input name="name" value="<%= script.name %>" required maxlength="200"></div>
      <div><label>Category</label><input name="category" value="<%= script.category || '' %>" maxlength="120"></div>
    </div>
    <label>Description</label><input name="description" value="<%= script.description || '' %>" maxlength="2000">
    <div class="sc-four">
      <div><label>File type</label><select name="file_type"><% fileTypes.forEach(function(t){ %><option value="<%= t %>" <%= script.fileType === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div>
      <div><label>OS</label><select name="os_type"><% osTypes.forEach(function(t){ %><option value="<%= t %>" <%= script.osType === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div>
      <div><label>Runs as</label><select name="run_as"><% runAs.forEach(function(t){ %><option value="<%= t %>" <%= script.runAs === t ? 'selected' : '' %>><%= t.replace('_',' ') %></option><% }) %></select></div>
      <div><label>Max runtime (mins)</label><input name="max_runtime_minutes" type="number" min="1" max="1440" value="<%= script.maxRuntimeMinutes || '' %>"></div>
    </div>
    <label>Arguments</label><input name="arguments" value="<%= script.arguments || '' %>" maxlength="2000">
    <label>Script</label>
    <textarea name="body" rows="26" spellcheck="false" required><%= script.body %></textarea>
    <div style="margin-top:12px;display:flex;gap:10px;align-items:center;">
      <button class="btn" type="submit">Save</button>
      <a class="btn btn-ghost" href="/scripts">Cancel</a>
    </div>
  </form>

  <form method="post" action="/scripts/<%= script.id %>/delete" style="margin-top:14px;"
        onsubmit="return confirm('Remove &quot;<%= script.name %>&quot; from the library?');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-ghost" type="submit" style="color:var(--bad-fg,#b91c1c);">Remove script</button>
  </form>
<% } else { %>
  <div class="sc-code"><pre><%= script.body %></pre></div>
<% } %>

<% if (isAdmin) { %>
<script>
document.getElementById('rvRun').addEventListener('click', async function(){
  var b = this, m = document.getElementById('rvMsg');
  b.disabled = true; m.textContent = 'Reading the script…';
  try {
    var r = await (await fetch('/scripts/<%= script.id %>/review', {
      method: 'POST', headers: { 'x-csrf-token': '<%= csrfToken %>' } })).json();
    if (!r.ok) { m.textContent = r.error || 'Review failed.'; b.disabled = false; return; }
    m.textContent = 'Done — reloading.'; setTimeout(function(){ location.reload(); }, 700);
  } catch (e) { m.textContent = 'Review failed: ' + e.message; b.disabled = false; }
});
</script>
<% } %>

<%- include('../partials/footer') %>
