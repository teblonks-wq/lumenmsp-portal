<%
  // Shared activity timeline for quotes, contracts and invoices.
  var LABEL = {
    sent:'Sent', reminder_sent:'Reminder sent', email_opened:'Email opened', opened:'Document opened',
    downloaded:'PDF downloaded', printed:'Printed', signed:'Signed by customer',
    countersigned:'Counter-signed', accepted:'Accepted', declined:'Declined'
  };
  var DOT = {
    sent:'var(--accent)', reminder_sent:'var(--accent)', email_opened:'var(--line-strong)', opened:'var(--indigo)',
    downloaded:'var(--indigo)', printed:'var(--indigo)', signed:'var(--ok)', countersigned:'var(--ok)',
    accepted:'var(--ok)', declined:'var(--bad)'
  };
  function evTime(d){ return new Date(d).toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}); }
%>
<div class="card" style="padding:0;">
  <div class="card-header" style="padding:18px 22px 0;">
    <h2>Activity <span class="muted" style="font-weight:500;font-size:12px;">— <%= events.length %> event<%= events.length===1?'':'s' %></span></h2>
  </div>
  <div style="padding:14px 22px 20px;">
    <% if (!events.length) { %>
      <div class="empty-state">Nothing recorded yet. Activity appears here once this has been sent.</div>
    <% } else { %>
      <ul style="list-style:none;margin:0;padding:0;">
        <% events.forEach(function(e, i){
             var meta = e.meta || {};
             var prefetch = e.event === 'email_opened' && meta.prefetch; %>
          <li style="display:flex;gap:12px;padding:9px 0;<%= i ? 'border-top:1px solid var(--line);' : '' %>">
            <span style="flex:none;width:9px;height:9px;border-radius:50%;margin-top:6px;background:<%= DOT[e.event] || 'var(--faint)' %>;
                         <%= e.confidence === 'indicative' ? 'box-shadow:0 0 0 2px #fff, 0 0 0 3px ' + (DOT[e.event]||'var(--faint)') + ';background:var(--surface);' : '' %>"></span>
            <div style="flex:1;min-width:0;">
              <div style="font-size:13.5px;font-weight:600;color:var(--lumen-dark);">
                <%= LABEL[e.event] || e.event %>
                <% if (e.confidence === 'indicative') { %>
                  <span class="muted" style="font-weight:500;font-size:11px;border:1px solid var(--line);border-radius:4px;padding:1px 5px;margin-left:5px;">
                    <%= prefetch ? 'likely automatic' : 'indicative' %></span>
                <% } %>
              </div>
              <div class="muted" style="font-size:12px;margin-top:1px;">
                <%= evTime(e.created_at) %><% if (e.actor) { %> · <%= e.actor %><% } %><% if (e.ip) { %> · <%= e.ip %><% } %>
                <% if (meta.version) { %> · v<%= meta.version %><% } %>
              </div>
              <% if (prefetch) { %>
                <div class="muted" style="font-size:11.5px;margin-top:2px;">
                  Fired <%= meta.secondsAfterSend %>s after sending — most likely the mail server or app fetching images, not a person.
                </div>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ul>
      <p class="muted" style="font-size:11.5px;margin:12px 0 0;padding-top:10px;border-top:1px solid var(--line);">
        Solid dots are things we served ourselves — a page load, a download, a signature. Hollow dots are
        email-open signals, which are unreliable: many clients block the tracking image entirely, and some
        fetch it automatically before anyone reads the message.
      </p>
    <% } %>
  </div>
</div>
