<%
// Shared OneBoard body — rendered by BOTH the customer page (/my/oneboard) and the
// staff preview (/insights/oneboard). Callers pass: obAction (form URL), obExportBase
// (PDF/CSV URL base), obShowSave (per-user layout button), obExtraHidden (extra hidden
// inputs, e.g. staff customer id), obExtraQs (extra export query, e.g. &customer=ID).
// Everything else (sites, hours, maxHeat, maxHeatAll, state, insName, from, to,
// compare, weeks, weekSel, months, monthSel) comes from buildOneBoard + parseOneBoardRange.
%>
<%
  function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c];}); }
  // LumenMSP scheme: missed = sequential single-hue RED (deeper red = more missed);
  // all-calls = the brand TEAL ramp. Status trio everywhere: var(--ok) / var(--warn) / var(--bad).
  var HEAT_STEPS = ['var(--surface-2)','var(--bad-bg)','var(--bad-line2)','var(--bad-soft)','var(--bad)','#7f1d1d'];
  function heatBg(n){ if(!maxHeat || !n) return HEAT_STEPS[0]; var i = Math.min(5, Math.max(1, Math.ceil(n / maxHeat * 5))); return HEAT_STEPS[i]; }
  function heatInk(n){ if(!maxHeat || !n) return 'var(--faint)'; return (Math.ceil(n / maxHeat * 5) >= 4) ? '#ffffff' : 'var(--ink)'; }
  // Brand-teal sequential ramp for the ALL-calls heatmap (magnitude, no polarity).
  var HEAT_ALL = ['var(--surface-2)','#d7eef3','var(--accent-line)','#5cb8ca','#1f8fa6','var(--accent-deep)'];
  function heatAllBg(n){ if(!maxHeatAll || !n) return HEAT_ALL[0]; var i = Math.min(5, Math.max(1, Math.ceil(n / maxHeatAll * 5))); return HEAT_ALL[i]; }
  function heatAllInk(n){ if(!maxHeatAll || !n) return 'var(--faint)'; return (Math.ceil(n / maxHeatAll * 5) >= 4) ? '#ffffff' : 'var(--ink)'; }
  // Day-of-week ramp. Scaled against the busiest weekday cell on the board rather than
  // the hourly max - a whole day always dwarfs a single hour, and reusing maxHeat here
  // would leave every cell the same shade of nearly-nothing.
  var DOW_SHORT = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  var DOW_FULL  = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  var maxDow = 0;
  (typeof sites !== 'undefined' ? sites : []).forEach(function(s){
    if (!s.included || !s.missedByDow) return;
    for (var d = 0; d < 7; d++) maxDow = Math.max(maxDow, s.missedByDow[d] || 0);
  });
  function dowBg(n){ if(!maxDow || !n) return HEAT_STEPS[0]; var i = Math.min(5, Math.max(1, Math.ceil(n / maxDow * 5))); return HEAT_STEPS[i]; }
  function dowInk(n){ if(!maxDow || !n) return 'var(--faint)'; return (Math.ceil(n / maxDow * 5) >= 4) ? '#ffffff' : 'var(--ink)'; }
  function per(n, d){ return d > 0 ? (n / d).toFixed(1) : '0.0'; }
  function delta(cur, prev, invert){
    if (prev == null) return '';
    var d = cur - prev;
    if (d === 0) return '<span style="font-size:11px;color:var(--faint);font-weight:600;">·&nbsp;no change</span>';
    var good = invert ? d < 0 : d > 0;
    var col = good ? 'var(--ok)' : 'var(--bad)';
    return '<span style="font-size:11px;color:'+col+';font-weight:700;">' + (d>0?'▲':'▼') + '&nbsp;' + Math.abs(d) + '</span>';
  }
  // The board now carries TWO comparisons and they mean different things. delta() above
  // is "vs the previous period" - direction of travel. These are "vs a normal day" - is
  // this level normal at all. Volume against a mean is neither good nor bad, so it stays
  // neutral; missed calls and answer rate keep their polarity.
  function pctVs(cur, exp){ return (exp > 0) ? Math.round((cur - exp) / exp * 100) : null; }
  function baseChip(cur, exp, mode){
    var p = pctVs(cur, exp);
    if (p === null) return '';
    var col = (mode === 'neutral') ? 'var(--muted)'
            : (mode === 'low' ? (p <= 0 ? 'var(--ok)' : 'var(--bad)') : (p >= 0 ? 'var(--ok)' : 'var(--bad)'));
    return '<span style="font-size:11px;font-weight:700;color:' + col + ';">' + (p > 0 ? '+' : '') + p + '%</span>';
  }
  // An answer rate is already a percentage - the honest difference between two of them is
  // percentage POINTS, not a percentage of a percentage.
  function ppChip(cur, exp){
    var d = Math.round(cur - exp);
    var col = (d === 0) ? 'var(--muted)' : (d > 0 ? 'var(--ok)' : 'var(--bad)');
    return '<span style="font-size:11px;font-weight:700;color:' + col + ';">' + (d > 0 ? '+' : '') + d + 'pp</span>';
  }
  function hh(h){ return ('0' + h).slice(-2) + ':00'; }
  function n1(v){ return (v >= 10) ? v.toFixed(0) : v.toFixed(1); }
  var obTarget   = (typeof target !== 'undefined' && target) ? target : 90;
  var obBaseName = (typeof baselineName !== 'undefined' && baselineName) ? baselineName : 'Year average';
  var included = sites.filter(function(s){ return s.included && s.configured && s.metrics; });
  var obExportQs = 'from=' + from + '&to=' + to + (compare ? '&cmp=1' : '') + '&met=' + obTarget +
    sites.filter(function(s){ return s.included; }).map(function(s){ return '&sites=' + s.id; }).join('') +
    (typeof obExtraQs !== 'undefined' ? obExtraQs : '');
%>

<% if (state === 'down') { %>
  <div class="card"><p class="muted" style="margin:0;">Call analytics is temporarily unavailable — please try again shortly.</p></div>
<% } else if (state === 'unlinked') { %>
  <div class="card"><p class="muted" style="margin:0;">Your company isn't linked to call analytics yet. Please contact Lumen IT.</p></div>
<% } else { %>

<!-- Controls: week / range / compare / sites — one row, remembered per user -->
<div class="card" style="margin-bottom:16px;">
  <form method="get" action="<%= obAction %>" id="obForm" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;margin:0;">
    <%- obExtraHidden || '' %>
    <div>
      <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);margin-bottom:4px;">Week</label>
      <select class="input" id="obWeek" onchange="obSyncWeek()" style="min-width:180px;">
        <option value="">Custom range…</option>
        <% weeks.forEach(function(w){ %><option value="<%= w.mon %>" <%= w.mon===weekSel ? 'selected' : '' %>><%= w.label %></option><% }); %>
      </select>
    </div>
    <div>
      <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);margin-bottom:4px;">Month</label>
      <select class="input" id="obMonth" onchange="obSyncMonth()" style="min-width:160px;">
        <option value="">Custom range…</option>
        <% months.forEach(function(m){ %><option value="<%= m.first %>" data-last="<%= m.last %>" <%= m.first===monthSel ? 'selected' : '' %>><%= m.label %></option><% }); %>
      </select>
    </div>
    <div><label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);margin-bottom:4px;">From</label><input class="input" type="date" name="from" id="obFrom" value="<%= from %>"></div>
    <div><label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);margin-bottom:4px;">To</label><input class="input" type="date" name="to" id="obTo" value="<%= to %>"></div>
    <label style="display:flex;align-items:center;gap:7px;font-size:14px;padding-bottom:9px;cursor:pointer;">
      <input type="checkbox" name="cmp" value="1" <%= compare ? 'checked' : '' %> style="width:auto;"> Compare with previous period
    </label>
    <div style="flex-basis:100%;height:0;"></div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Sites</span>
      <% sites.forEach(function(s){ %>
        <label style="display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border:1px solid <%= s.included ? 'var(--accent)' : 'var(--line)' %>;border-radius:999px;font-size:13px;cursor:pointer;background:<%= s.included ? 'var(--accent-soft)' : '#fff' %>;">
          <input type="checkbox" class="ob-site" name="sites" value="<%= s.id %>" <%= s.included ? 'checked' : '' %> style="width:auto;min-width:auto;" onchange="this.parentElement.style.borderColor=this.checked?'var(--accent)':'var(--line)';this.parentElement.style.background=this.checked?'var(--accent-soft)':'#fff';">
          <%= esc(s.label) %><% if (!s.configured) { %> <span title="This site's call logic isn't set up yet" style="color:var(--warn-fg);font-size:11px;">⚠</span><% } %>
        </label>
      <% }); %>
    </div>
    <div style="display:flex;gap:8px;margin-left:auto;">
      <button class="btn btn-primary" type="submit">Update</button>
      <% if (obShowSave) { %><button class="btn" type="button" id="obSave" onclick="obSaveLayout()">Save as my layout</button><% } %>
      <a class="btn" href="<%= obExportBase %>.pdf?<%- obExportQs %>" title="Download this view as a PDF document">&#11015; PDF</a>
      <a class="btn" href="<%= obExportBase %>.csv?<%- obExportQs %>" title="Download the data behind this view as CSV">&#11015; CSV</a>
    </div>
  </form>
</div>

<% if (typeof compareNote !== 'undefined' && compareNote) { %>
  <div class="card" style="margin-bottom:16px;border-left:3px solid var(--warn);"><p class="muted" style="margin:0;font-size:13px;">&#9888; <%= compareNote %></p></div>
<% } %>

<% if (!included.length) { %>
  <div class="card"><p class="muted" style="margin:0;">No sites selected<%= sites.some(function(s){return !s.configured;}) ? ' — sites marked ⚠ need their call logic set up by Lumen IT before they can appear' : '' %>. Tick a site above and press Update.</p></div>
<% } else { %>

<!-- Branch scorecards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:16px;">
  <% included.forEach(function(s){ var m = s.metrics, p = s.prev; %>
  <div class="card" style="margin:0;">
    <div style="font-size:13px;font-weight:700;color:var(--ink);margin-bottom:10px;"><%= esc(s.label) %></div>
    <div style="display:flex;gap:18px;flex-wrap:wrap;">
      <div><div style="font-size:26px;font-weight:700;line-height:1;color:var(--ink);"><%= m.total %></div><div style="font-size:11px;color:var(--muted);margin-top:4px;">Calls <%- delta(m.total, p ? p.total : null, false) %></div></div>
      <div><div style="font-size:26px;font-weight:700;line-height:1;color:var(--ok);"><%= m.answered %></div><div style="font-size:11px;color:var(--muted);margin-top:4px;">Answered</div></div>
      <div><div style="font-size:26px;font-weight:700;line-height:1;color:var(--bad);"><%= m.missed %></div><div style="font-size:11px;color:var(--muted);margin-top:4px;">Missed <%- delta(m.missed, p ? p.missed : null, true) %></div></div>
      <div><div style="font-size:26px;font-weight:700;line-height:1;color:var(--ink);"><%= m.rate %>%</div><div style="font-size:11px;color:var(--muted);margin-top:4px;">Answer rate <%- p ? delta(m.rate, p.rate, false) : '' %></div></div>
    </div>
    <% if (s.baseline) { var eb = s.baseline.expected; %>
      <div style="font-size:11px;color:var(--muted);margin-top:9px;padding-top:8px;border-top:1px solid var(--line);" title="The mean for these same weekdays across <%= baselineFrom %> to <%= baselineTo %>">
        <%= obBaseName %> for these dates: <strong style="color:var(--ink);"><%= eb.total %></strong> calls <%- baseChip(m.total, eb.total, 'neutral') %>
        &middot; <strong style="color:var(--ink);"><%= eb.rate %>%</strong> answered <%- ppChip(m.rate, eb.rate) %>
        &middot; <%= eb.missed %> missed <%- baseChip(m.missed, eb.missed, 'low') %>
      </div>
    <% } %>
    <% if (p) { %><div style="font-size:11px;color:var(--faint);margin-top:8px;">Previous period: <%= p.total %> calls · <%= p.rate %>% answered</div><% } %>
  </div>
  <% }); %>
</div>

<!-- Daily totals: answered v missed per branch -->
<% var _askUrl = (typeof obAskUrl !== 'undefined' && obAskUrl) ? obAskUrl : ''; %>
<% if (_askUrl) { %>
<!-- Ask Insights: the staffing questions that used to need an export to Excel first -->
<div class="card" style="margin-bottom:16px;border-left:3px solid var(--accent);">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
    <h2 style="margin:0;font-size:16px;">Ask Insights</h2>
    <span class="badge badge-inactive" style="font-size:10px;">Claude</span>
  </div>
  <p class="muted" style="margin:0 0 10px;font-size:12.5px;">
    Ask about the calls on this board — cover, staffing, patterns. It answers from the numbers above and nothing else.
  </p>
  <form id="aiForm" style="display:flex;gap:8px;flex-wrap:wrap;margin:0;">
    <input class="input" id="aiQ" autocomplete="off" style="flex:1;min-width:280px;"
           placeholder="If I got another receptionist, when should they work?">
    <button class="btn btn-primary" type="submit" id="aiGo">Ask</button>
  </form>
  <div id="aiChips" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:9px;">
    <% ['When do we miss the most calls?',
        'If I got another receptionist, when should they work?',
        'Which day of the week is worst, and is it really worse or just more days?',
        'What hours would fix the most missed calls for the least cover?'].forEach(function(q){ %>
      <button type="button" class="ai-chip" data-q="<%= esc(q) %>"
              style="border:1px solid var(--line-strong);background:var(--surface-2);color:var(--muted);border-radius:999px;padding:3px 11px;font-size:11.5px;cursor:pointer;"><%= esc(q) %></button>
    <% }); %>
  </div>
  <div id="aiOut" style="display:none;margin-top:14px;padding-top:13px;border-top:1px solid var(--line);"></div>
</div>
<script>
(function () {
  var form = document.getElementById('aiForm'); if (!form) return;
  var q = document.getElementById('aiQ'), go = document.getElementById('aiGo'), out = document.getElementById('aiOut');
  var URL_ASK = <%- JSON.stringify(_askUrl) %>;
  function csrf(){ var m = document.querySelector('meta[name="csrf-token"]'); return m ? m.getAttribute('content') : ''; }
  function el(tag, css, text){ var e = document.createElement(tag); if (css) e.style.cssText = css; if (text != null) e.textContent = text; return e; }

  document.querySelectorAll('.ai-chip').forEach(function (c) {
    c.addEventListener('click', function () { q.value = c.getAttribute('data-q'); form.dispatchEvent(new Event('submit', { cancelable: true })); });
  });

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var question = (q.value || '').trim();
    if (!question) { q.focus(); return; }
    go.disabled = true; go.textContent = 'Thinking…';
    out.style.display = 'block';
    out.innerHTML = '';
    out.appendChild(el('p', 'margin:0;color:var(--muted);font-size:13px;', 'Reading the board…'));

    // The board's own query string decides the customer, dates and sites, so the answer
    // is always about exactly what is on screen.
    fetch(URL_ASK + window.location.search, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf() },
      body: JSON.stringify({ question: question })
    }).then(function (r) { return r.json(); }).then(function (d) {
      out.innerHTML = '';
      if (!d.ok) { out.appendChild(el('p', 'margin:0;color:var(--bad-fg);font-size:13px;', d.error || 'That did not work.')); return; }
      // Order on the page is the order of usefulness: the decision, the numbers behind it,
      // the reasoning, and only then the arithmetic - folded away, because the working is
      // what makes an answer checkable and also what makes it unreadable.
      if (d.periodWarning) {
        var warn = el('div', 'border:1px solid var(--warn-line);background:var(--tint-warn);color:var(--warn-deep);border-radius:8px;padding:9px 12px;font-size:12.5px;line-height:1.5;margin-bottom:12px;', d.periodWarning);
        out.appendChild(warn);
      }

      if (d.headline) {
        out.appendChild(el('p', 'margin:0 0 12px;font-size:19px;font-weight:700;line-height:1.35;', d.headline));
      }

      if (d.points && d.points.length) {
        var chips = el('div', 'display:flex;gap:8px;flex-wrap:wrap;margin-bottom:13px;');
        d.points.forEach(function (p) {
          var c = el('div', 'border:1px solid var(--line);border-radius:8px;padding:6px 11px;background:var(--surface-2);');
          c.appendChild(el('div', 'font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;color:var(--muted);font-weight:600;', p.label));
          c.appendChild(el('div', 'font-size:13px;font-weight:700;', p.value));
          chips.appendChild(c);
        });
        out.appendChild(chips);
      }

      String(d.answer || '').split(/\n{1,}/).forEach(function (para) {
        if (!para.trim()) return;
        out.appendChild(el('p', 'margin:0 0 8px;font-size:13.5px;line-height:1.55;', para.trim()));
      });

      if (d.working && d.working.trim()) {
        var det = document.createElement('details');
        det.style.cssText = 'margin-top:10px;border-top:1px solid var(--line);padding-top:9px;';
        var sum = document.createElement('summary');
        sum.style.cssText = 'cursor:pointer;font-size:12px;font-weight:600;color:var(--muted);';
        sum.textContent = 'Show the working';
        det.appendChild(sum);
        var pre = el('div', 'margin-top:8px;font-size:12.5px;line-height:1.6;white-space:pre-wrap;color:var(--muted);');
        pre.textContent = d.working.trim();
        det.appendChild(pre);
        out.appendChild(det);
      }

      var foot = [];
      if (d.period) foot.push('based on ' + d.period.from + ' to ' + d.period.to);
      if (d.cost) foot.push(d.cost);
      if (foot.length) out.appendChild(el('p', 'margin:11px 0 0;font-size:11px;color:var(--faint);', foot.join(' · ')));
    }).catch(function () {
      out.innerHTML = '';
      out.appendChild(el('p', 'margin:0;color:var(--bad-fg);font-size:13px;', 'Could not reach the Portal.'));
    }).then(function () { go.disabled = false; go.textContent = 'Ask'; });
  });
})();
</script>
<% } %>

<div class="card" style="padding:0;margin-bottom:16px;">
  <div class="card-header" style="padding:14px 18px;"><h2 style="margin:0;">Daily calls — answered v missed</h2></div>
  <div class="table-wrap"><table class="table" style="margin:0;">
    <thead><tr><th style="min-width:110px;">Day</th>
      <% included.forEach(function(s){ %><th colspan="2" style="text-align:center;border-left:1px solid var(--line);"><%= esc(s.label) %></th><% }); %>
    </tr><tr><th></th>
      <% included.forEach(function(){ %><th class="muted" style="text-align:right;font-size:11px;border-left:1px solid var(--line);">Calls</th><th class="muted" style="font-size:11px;min-width:120px;">Ans / Miss</th><% }); %>
    </tr></thead>
    <tbody>
      <% (included[0] ? included[0].daily : []).forEach(function(_, di){ %>
      <tr>
        <td class="muted" style="white-space:nowrap;font-size:13px;"><%= included[0].daily[di].label %></td>
        <% included.forEach(function(s){ var d = s.daily[di] || {total:0,answered:0,missed:0}; var aw = d.total ? Math.round(d.answered/d.total*100) : 0; %>
          <td class="num" style="text-align:right;font-weight:600;border-left:1px solid var(--surface-3);"><%= d.total || '—' %></td>
          <td>
            <% if (d.total) { %>
            <div title="<%= d.answered %> answered · <%= d.missed %> missed" style="display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--bad-bg);min-width:110px;">
              <div style="width:<%= aw %>%;background:#22c55e;border-right:<%= (d.answered && d.missed) ? '2px solid #fff' : '0' %>;"></div>
            </div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px;"><%= d.answered %> · <span style="color:var(--bad);"><%= d.missed %></span></div>
            <% } else { %><span class="muted" style="font-size:12px;">—</span><% } %>
          </td>
        <% }); %>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<!-- Compiled heatmap: missed calls per hour per branch -->
<div class="card" style="padding:0;">
  <div class="card-header" style="padding:14px 18px;"><h2 style="margin:0;">Missed calls by hour</h2>
    <span class="muted" style="font-size:12px;">Each cell = missed calls in that hour across the selected dates (business hours, local time)</span></div>
  <div class="table-wrap"><table class="table" style="margin:0;">
    <thead><tr><th style="min-width:110px;"></th><% hours.forEach(function(h){ %><th class="muted" style="text-align:center;font-size:11px;"><%= ('0'+h).slice(-2) %>:00</th><% }); %></tr></thead>
    <tbody>
      <% included.forEach(function(s){ %>
      <tr>
        <td style="font-weight:600;font-size:13px;white-space:nowrap;"><%= esc(s.label) %></td>
        <% hours.forEach(function(h){ var n = s.missedByHour[h] || 0; %>
          <td title="<%= esc(s.label) %> · <%= ('0'+h).slice(-2) %>:00 — <%= n %> missed" style="text-align:center;background:<%= heatBg(n) %>;color:<%= heatInk(n) %>;font-size:12px;font-weight:600;min-width:34px;"><%= n || '' %></td>
        <% }); %>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
  <div style="display:flex;align-items:center;gap:6px;padding:10px 18px;font-size:11px;color:var(--muted);">
    Fewer <% ['var(--surface-2)','var(--bad-bg)','var(--bad-line2)','var(--bad-soft)','var(--bad)','#7f1d1d'].forEach(function(c){ %><span style="width:18px;height:10px;background:<%= c %>;border:1px solid var(--line);border-radius:2px;display:inline-block;"></span><% }); %> More missed
  </div>
</div>

<!-- Missed calls by day of the week -->
<div class="card" style="padding:0;margin-top:16px;">
  <div class="card-header" style="padding:14px 18px;"><h2 style="margin:0;">Missed calls by day of the week</h2>
    <span class="muted" style="font-size:12px;">Total missed, and the per-day average — the range rarely holds the same number of each weekday, so the average is the fair comparison</span></div>
  <div class="table-wrap"><table class="table" style="margin:0;">
    <thead><tr><th style="min-width:110px;"></th>
      <% for (var d = 0; d < 7; d++) { %><th class="muted" style="text-align:center;font-size:11px;"><%= DOW_SHORT[d] %></th><% } %>
      <th class="muted" style="text-align:center;font-size:11px;">Worst day</th></tr></thead>
    <tbody>
      <% included.forEach(function(s){
           var worst = -1, worstAvg = -1;
           for (var d = 0; d < 7; d++) {
             var seen = (s.daysSeenByDow || [])[d] || 0; if (!seen) continue;
             var a = ((s.missedByDow || [])[d] || 0) / seen;
             if (a > worstAvg) { worstAvg = a; worst = d; }
           }
      %>
      <tr>
        <td style="font-weight:600;font-size:13px;white-space:nowrap;"><%= esc(s.label) %></td>
        <% for (var d = 0; d < 7; d++) { var seen = (s.daysSeenByDow || [])[d] || 0;
             var n = (s.missedByDow || [])[d] || 0; var tot = (s.totalByDow || [])[d] || 0; %>
          <% if (!seen) { %>
            <td class="muted" style="text-align:center;font-size:12px;opacity:.4;" title="The selected range contains no <%= DOW_FULL[d] %>">—</td>
          <% } else { %>
            <td title="<%= esc(s.label) %> · <%= DOW_FULL[d] %> — <%= n %> missed of <%= tot %> calls over <%= seen %> <%= DOW_FULL[d] %><%= seen === 1 ? '' : 's' %> (<%= per(n, seen) %> missed per day)" style="text-align:center;background:<%= dowBg(n) %>;color:<%= dowInk(n) %>;font-size:12px;font-weight:600;min-width:42px;line-height:1.25;">
              <%= n || '' %><% if (n) { %><div style="font-size:10px;font-weight:500;opacity:.85;"><%= per(n, seen) %>/day</div><% } %>
            </td>
          <% } %>
        <% } %>
        <td style="text-align:center;font-size:12px;font-weight:600;white-space:nowrap;"><%= worst >= 0 && worstAvg > 0 ? DOW_SHORT[worst] + ' (' + worstAvg.toFixed(1) + '/day)' : '—' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
  <div style="display:flex;align-items:center;gap:6px;padding:10px 18px;font-size:11px;color:var(--muted);">
    Fewer <% ['var(--surface-2)','var(--bad-bg)','var(--bad-line2)','var(--bad-soft)','var(--bad)','#7f1d1d'].forEach(function(c){ %><span style="width:18px;height:10px;background:<%= c %>;border:1px solid var(--line);border-radius:2px;display:inline-block;"></span><% }); %> More missed
  </div>
</div>

<!-- Compiled heatmap: ALL incoming calls per hour per branch -->
<div class="card" style="padding:0;margin-top:16px;">
  <div class="card-header" style="padding:14px 18px;"><h2 style="margin:0;">All incoming calls by hour</h2>
    <span class="muted" style="font-size:12px;">Each cell = every incoming call in that hour across the selected dates (business hours, local time)</span></div>
  <div class="table-wrap"><table class="table" style="margin:0;">
    <thead><tr><th style="min-width:110px;"></th><% hours.forEach(function(h){ %><th class="muted" style="text-align:center;font-size:11px;"><%= ('0'+h).slice(-2) %>:00</th><% }); %></tr></thead>
    <tbody>
      <% included.forEach(function(s){ %>
      <tr>
        <td style="font-weight:600;font-size:13px;white-space:nowrap;"><%= esc(s.label) %></td>
        <% hours.forEach(function(h){ var n = s.totalByHour[h] || 0; %>
          <td title="<%= esc(s.label) %> · <%= ('0'+h).slice(-2) %>:00 — <%= n %> calls" style="text-align:center;background:<%= heatAllBg(n) %>;color:<%= heatAllInk(n) %>;font-size:12px;font-weight:600;min-width:34px;"><%= n || '' %></td>
        <% }); %>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
  <div style="display:flex;align-items:center;gap:6px;padding:10px 18px;font-size:11px;color:var(--muted);">
    Fewer <% ['var(--surface-2)','#d7eef3','var(--accent-line)','#5cb8ca','#1f8fa6','var(--accent-deep)'].forEach(function(c){ %><span style="width:18px;height:10px;background:<%= c %>;border:1px solid var(--line);border-radius:2px;display:inline-block;"></span><% }); %> More calls
  </div>
</div>

<% } %>
<% } %>

<script>
function obSyncWeek(){
  var w = document.getElementById('obWeek');
  if (!w || !w.value) return;
  var m = document.getElementById('obMonth'); if (m) m.value = '';
  var f = document.getElementById('obFrom'), t = document.getElementById('obTo');
  f.value = w.value;                                  // Monday
  var d = new Date(w.value + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + 6);
  t.value = d.toISOString().slice(0, 10);             // Sunday — BOTH dates, always
}
function obSyncMonth(){
  var m = document.getElementById('obMonth');
  if (!m || !m.value) return;
  var w = document.getElementById('obWeek'); if (w) w.value = '';
  var opt = m.options[m.selectedIndex];
  document.getElementById('obFrom').value = m.value;                       // 1st of month
  document.getElementById('obTo').value = opt.getAttribute('data-last');   // last day — BOTH dates, always
}
function obSaveLayout(){
  var ids = Array.prototype.slice.call(document.querySelectorAll('.ob-site:checked')).map(function(c){ return parseInt(c.value, 10); });
  var btn = document.getElementById('obSave'); btn.disabled = true; btn.textContent = 'Saving…';
  var m = document.querySelector('meta[name="csrf-token"]');
  fetch('/my/oneboard/prefs', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': m ? m.getAttribute('content') : '' }, body: JSON.stringify({ sites: ids }) })
    .then(function(r){ return r.json(); })
    .then(function(j){ btn.disabled = false; btn.textContent = j.ok ? '✓ Saved' : 'Save as my layout'; if (!j.ok) alert(j.error || 'Could not save.'); setTimeout(function(){ btn.textContent = 'Save as my layout'; }, 2000); })
    .catch(function(){ btn.disabled = false; btn.textContent = 'Save as my layout'; alert('Could not save.'); });
}
</script>

