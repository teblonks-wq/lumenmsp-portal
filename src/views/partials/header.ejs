<!doctype html>
<html lang="en-GB" class="theme-<%= (typeof portalTheme !== 'undefined' && portalTheme) ? portalTheme : 'aurora' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Lumen MSP Portal</title>
  <link rel="icon" type="image/png" href="/static/lumen-crest.png">
  <link rel="apple-touch-icon" href="/static/icon-192.png">
  <meta name="theme-color" content="#0ea5b7">
  <meta name="application-name" content="Lumen MSP Portal">
  <link rel="manifest" href="/portal.webmanifest">
  <link rel="stylesheet" href="/static/app.css?v=<%= typeof assetV !== 'undefined' ? assetV : '0' %>">
  <style>
    /* Flash the Chat nav red while a website chat is waiting to be claimed. */
    @keyframes navChatFlash { 0%, 100% { background: transparent; } 50% { background: var(--bad-bright); } }
    .nav-item.chat-flash { animation: navChatFlash 1s ease-in-out infinite; border-radius: 8px; }
    .nav-item.chat-flash .nav-label, .nav-item.chat-flash svg { color: #fff !important; stroke: #fff; }
  </style>
  <script>try { if (localStorage.getItem('portalNavCollapsed') === '1') document.documentElement.classList.add('nav-collapsed'); } catch (e) {}</script>
  <script>
  // V4 zoom-proof nav: browser zoom (Ctrl +/-) multiplies devicePixelRatio; we counter-scale
  // the sidebar by 1/zoom so it holds its physical size while the content zooms normally.
  // Baseline DPR persists per device (high-DPI screens have a native DPR > 1) so a page
  // opened while already zoomed still compensates correctly on later visits.
  (function () {
    var base;
    try { base = parseFloat(localStorage.getItem('portalBaseDPR') || '') || null; } catch (e) { base = null; }
    if (!base) {
      base = window.devicePixelRatio || 1;
      try { localStorage.setItem('portalBaseDPR', String(base)); } catch (e) {}
    }
    function apply() {
      var z = (window.devicePixelRatio || 1) / base;
      if (!(z > 0)) z = 1;
      if (z < 0.25) z = 0.25; if (z > 5) z = 5;
      document.documentElement.style.setProperty('--nav-inv', String(1 / z));
    }
    window.addEventListener('resize', apply);
    apply();
  })();
  </script>
</head>
