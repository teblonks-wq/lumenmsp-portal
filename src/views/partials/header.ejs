      <button class="btn btn-theme" id="themeBtn" type="button" title="Portal theme — your choice, saved to your account">
        <span class="theme-dot"></span>Theme <span style="font-size:10px;">▾</span>
      </button>
      <div class="theme-menu" id="themeMenu">
        <div class="tm-head">Portal theme — just for you</div>
        <button class="theme-opt" type="button" data-theme="aurora"><span class="sw sw-aurora"></span><span>Aurora<small>Light · brand glow</small></span><span class="tick">✓</span></button>
        <button class="theme-opt" type="button" data-theme="carbon"><span class="sw sw-carbon"></span><span>Carbon<small>Dark command centre</small></span><span class="tick">✓</span></button>
        <button class="theme-opt" type="button" data-theme="solstice"><span class="sw sw-solstice"></span><span>Solstice<small>Editorial light · calm</small></span><span class="tick">✓</span></button>
      </div>
      <% if (!(typeof portalThemeSet !== 'undefined' && portalThemeSet)) { %>
      <div class="theme-nudge" id="themeNudge">
        <span>✨ <strong>New</strong> — pick your Portal theme</span>
        <button type="button" id="themeNudgeX" title="Don't show this again" aria-label="Dismiss">×</button>
      </div>
      <% } %>
    </div>
  <% } %>
  </div>
  <div class="topbar-notif">
    <button id="notifBell" type="button" class="btn" style="display:flex;align-items:center;gap:6px;">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      Notifications <span id="notifCount" class="notif-count"></span>
    </button>
    <span id="notifLatest" class="muted notif-latest"></span>
    <a href="/notifications" class="row-link" style="font-size:12px;">View all</a>
    <a href="#" id="notifClearAll" class="row-link" style="font-size:12px;margin-left:8px;" title="Take everything off the list. Nothing is deleted — the full panel still has it.">Clear all</a>
