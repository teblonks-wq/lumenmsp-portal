</div>
<script>
// Portal clock — shows the time the PORTAL is working from (server clock, Europe/London),
// not the browser's own clock. Seeded from the server at render; ticks locally using the
// offset, so any drift between the server and the user's machine stays visible.
(function(){
  var t=document.getElementById('portalClockTime'), d=document.getElementById('portalClockDate');
  if(!t) return;
  var offset = <%= Date.now() %> - Date.now();
  var tf = new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/London',hour:'2-digit',minute:'2-digit',second:'2-digit'});
  var df = new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/London',weekday:'short',day:'numeric',month:'short'});
  function tick(){ var now=new Date(Date.now()+offset); t.textContent=tf.format(now); d.textContent=df.format(now); }
  tick(); setInterval(tick, 1000);
})();
</script>
<script>
// V4 theme picker — applies instantly, saves to the account (POST /me/theme).
(function(){
  var btn = document.getElementById('themeBtn'), menu = document.getElementById('themeMenu');
  if (!btn || !menu) return;
  var THEMES = ['aurora','carbon','solstice'];
  function current(){
    var m = (document.documentElement.className || '').match(/theme-(\w+)/);
    return m ? m[1] : 'aurora';
  }
  function mark(){
    var c = current();
    menu.querySelectorAll('.theme-opt').forEach(function(o){ o.classList.toggle('on', o.getAttribute('data-theme') === c); });
  }
  function setTheme(t){
    if (THEMES.indexOf(t) === -1) return;
    THEMES.forEach(function(x){ document.documentElement.classList.remove('theme-' + x); });
    document.documentElement.classList.add('theme-' + t);
    mark();
    var meta = document.querySelector('meta[name="csrf-token"]');
    fetch('/me/theme', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': meta ? meta.content : '' },
      body: JSON.stringify({ theme: t })
    }).catch(function(){});
  }
  // One-time nudge bubble: hidden forever once dismissed (X) or once a theme is picked.
  var nudge = document.getElementById('themeNudge');
  function killNudge(){
    try { localStorage.setItem('themeNudgeDone', '1'); } catch (err) {}
    if (nudge && nudge.parentNode) { nudge.parentNode.removeChild(nudge); nudge = null; }
  }
  try { if (nudge && localStorage.getItem('themeNudgeDone') === '1') killNudge(); } catch (err) {}
  var nx = document.getElementById('themeNudgeX');
  if (nx) nx.addEventListener('click', function(e){ e.stopPropagation(); killNudge(); });
  btn.addEventListener('click', function(e){ e.stopPropagation(); menu.classList.toggle('open'); mark(); killNudge(); });
  document.addEventListener('click', function(e){ if (!e.target.closest || !e.target.closest('.theme-wrap')) menu.classList.remove('open'); });
  menu.querySelectorAll('.theme-opt').forEach(function(o){
    o.addEventListener('click', function(){ setTheme(o.getAttribute('data-theme')); menu.classList.remove('open'); });
  });
  mark();
})();
</script>
<script>
(function(){
  var bell=document.getElementById('notifBell'), dd=document.getElementById('notifDropdown'),
      cnt=document.getElementById('notifCount'), latest=document.getElementById('notifLatest');
  if(!bell) return;
  function esc(s){return (s||'').replace(/[&<>"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c];});}
  var clearAll = document.getElementById('notifClearAll');
  if (clearAll) clearAll.addEventListener('click', function(e){
    e.preventDefault();
    // No confirm: clearing is not destructive — cleared_at is a timestamp and /notifications
    // still shows everything. A dialog for a reversible action just trains people past it.
    fetch('/notifications/clear-all', { method: 'POST' })
      .then(function(){ load(); if (dd) dd.style.display = 'none'; })
      .catch(function(){});
  });

  function load(){
    fetch('/notifications.json').then(function(r){return r.json();}).then(function(d){
      var items=d.items||[];
      if(d.unread>0){cnt.style.display='';cnt.textContent=d.unread;}else{cnt.style.display='none';}
      latest.textContent = items.length ? items[0].title : '';
      dd.innerHTML = items.length ? items.map(function(n){
        return '<div class="notif-item'+(n.read_at?'':' unread')+'">'
          +'<div style="font-weight:600;font-size:13px;">'+(n.link?'<a class="row-link" href="'+esc(n.link)+'">'+esc(n.title)+'</a>':esc(n.title))+'</div>'
          +(n.body?'<div class="muted" style="font-size:12px;margin:2px 0 6px;">'+esc(n.body)+'</div>':'')
          +'<div style="display:flex;gap:8px;margin-top:4px;">'
          +'<button class="btn" data-snooze="'+n.id+'" style="padding:1px 8px;font-size:11px;">Snooze 1h</button>'
          +'<button class="btn" data-clear="'+n.id+'" style="padding:1px 8px;font-size:11px;">Clear</button>'
          +'</div></div>';
      }).join('') : '<div class="muted" style="padding:14px;text-align:center;">No notifications</div>';
    }).catch(function(){});
  }
  bell.addEventListener('click', function(){
    dd.style.display = dd.style.display==='block' ? 'none' : 'block';
    if(dd.style.display==='block'){ fetch('/notifications/read-all',{method:'POST'}).then(load); }
  });
  document.addEventListener('click', function(e){
    var sn=e.target.closest && e.target.closest('[data-snooze]');
    var cl=e.target.closest && e.target.closest('[data-clear]');
    if(sn){ e.preventDefault(); fetch('/notifications/'+sn.getAttribute('data-snooze')+'/snooze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({minutes:60})}).then(load); return; }
    if(cl){ e.preventDefault(); fetch('/notifications/'+cl.getAttribute('data-clear')+'/clear',{method:'POST'}).then(load); return; }
    if(dd && dd.style.display==='block' && !e.target.closest('#notifDropdown') && !e.target.closest('#notifBell')){ dd.style.display='none'; }
  });
  load(); setInterval(load, 60000);
})();
</script>
<script>
// Desktop PWA install — Edge/Chrome offer "Install app" once the SW is registered and the
// desktop manifest is present. Uses /portal.webmanifest (kept separate from the mobile /m app).
(function(){
  if ('serviceWorker' in navigator) { navigator.serviceWorker.register('/sw.js').catch(function(){}); }
  var btn = document.getElementById('installApp');
  if (!btn) return;
  // Already running as an installed app → never show the button.
  if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) return;
  var deferred = null;
  window.addEventListener('beforeinstallprompt', function(e){ e.preventDefault(); deferred = e; btn.style.display = 'inline-flex'; });
  btn.addEventListener('click', function(){
    if (!deferred) return;
    deferred.prompt();
    deferred.userChoice.then(function(){ deferred = null; btn.style.display = 'none'; });
  });
  window.addEventListener('appinstalled', function(){ btn.style.display = 'none'; });
})();
</script>
