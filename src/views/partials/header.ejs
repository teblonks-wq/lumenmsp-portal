<%# ── Tools launcher ─────────────────────────────────────────────────────────────
    The other apps - Insights, Learn, Back Office, Purchases, Marketing, Luminate -
    used to sit in a Tools section in the sidebar, where they competed with the pages
    you actually work out of all day. They now live behind the square next to the
    Portal wordmark: a wider nav that opens when you want it and is out of the way
    when you don't. It MUST live outside <aside class="sidebar"> - that element is
    overflow:hidden and would clip the panel. -%>
<% if (typeof user !== 'undefined' && (user.role === 'admin' || user.role === 'staff')) { %>
<div class="tl-backdrop" id="toolsBackdrop" hidden></div>
<div class="tools-launcher" id="toolsLauncher" role="dialog" aria-label="Tools" aria-modal="false" hidden>
  <div class="tl-head">
    <h2>Tools</h2>
    <button type="button" class="tl-close" id="toolsClose" aria-label="Close tools">&times;</button>
  </div>
  <div class="tl-grid">
    <a href="/insights" class="tl-tile">
      <span class="tool-word w-insights">Insights</span>
      <span class="tl-desc">Reporting &amp; call analytics</span>
    </a>
    <a href="https://learn.lumenmsp.co.uk" target="_blank" rel="noopener" class="tl-tile">
      <span class="tool-word w-learn">Learn</span>
      <span class="tl-desc">Staff training &amp; onboarding <span class="tl-ext">&#8599;</span></span>
    </a>
    <% if (user.role === 'admin') { %>
    <a href="/bureau" class="tl-tile">
      <span class="tool-word w-bo">Back Office</span>
      <span class="tl-desc">Allocate imported services &amp; billing</span>
      <% if (typeof bureauCount !== 'undefined' && bureauCount > 0) { %><span class="nav-badge tl-badge"><%= bureauCount %></span><% } %>
    </a>
    <a href="/purchases" class="tl-tile">
      <span class="tool-word w-purch">Purchases</span>
      <span class="tl-desc">Purchase ledger &amp; expense reconciliation</span>
    </a>
    <a href="/marketing" class="tl-tile">
      <span class="tool-word w-mkt">Marketing</span>
      <span class="tl-desc">Socials, website stats &amp; chatbot</span>
    </a>
    <a href="/leavers" class="tl-tile">
      <span class="tool-word">Leavers</span>
      <span class="tl-desc">Cut someone&rsquo;s access at a set time, then raise the procedure</span>
    </a>
    <a href="https://apps.lumenmsp.co.uk" target="_blank" rel="noopener" class="tl-tile">
      <span class="tool-word w-lum">Luminate</span>
      <span class="tl-desc">Customer app platform <span class="tl-ext">&#8599;</span></span>
    </a>
    <% } %>
  </div>
</div>
<script>
(function () {
  var btn = document.getElementById('toolsLaunch');
  var panel = document.getElementById('toolsLauncher');
  var back = document.getElementById('toolsBackdrop');
  if (!btn || !panel) return;
  function setOpen(on) {
    panel.hidden = !on;
    back.hidden = !on;
    btn.setAttribute('aria-expanded', on ? 'true' : 'false');
    btn.classList.toggle('on', on);
    if (on) { var f = panel.querySelector('.tl-tile'); if (f) f.focus(); }
  }
  btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(panel.hidden); });
  document.getElementById('toolsClose').addEventListener('click', function () { setOpen(false); btn.focus(); });
  back.addEventListener('click', function () { setOpen(false); });
  // Esc shuts it wherever focus happens to be.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) { setOpen(false); btn.focus(); }
  });
})();
</script>
<% } %>
<script>
(function () {
  // Collapsible nav groups. The state is per browser, not per session — you set the
  // sidebar up how you like it once and it stays that way.
  var KEY = 'lumen.nav.collapsed';
  // Every group remembers whether you left it open. (Tools used to be forced shut on every
  // load because it was the section you dip into rather than work out of - it now lives in
  // the launcher panel off the Portal wordmark instead, so there is nothing to force.)
  var ALWAYS_SHUT = {};
  // What a brand-new browser sees: Operations open, everything else closed (Terry,
  // 1 Sep — "when a user logs into portal all needs to be closed apart from operations").
  // Only the DEFAULT changes: once somebody opens Finance, Finance stays open for them.
  // This script runs on every page render, not on sign-in, so forcing every group shut
  // here would re-collapse the sidebar on every click rather than once per login.
  var DEFAULT_OPEN = { operations: true };
  var shut = {};
  try { shut = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { shut = {}; }
  document.querySelectorAll('.nav-section-btn').forEach(function (btn) {
    var name = btn.getAttribute('data-nav-group');
    var grp = document.getElementById('nav-group-' + name);
    if (!grp) return;
    function apply(on) {
      grp.classList.toggle('shut', on);
      btn.classList.toggle('shut', on);
      btn.setAttribute('aria-expanded', on ? 'false' : 'true');
    }
    apply(ALWAYS_SHUT[name] ? true
      : Object.prototype.hasOwnProperty.call(shut, name) ? !!shut[name] : !DEFAULT_OPEN[name]);
    btn.addEventListener('click', function () {
      var next = !grp.classList.contains('shut');
      apply(next);
      if (ALWAYS_SHUT[name]) return;                 // opened for now, shut again next load
      shut[name] = next;
      try { localStorage.setItem(KEY, JSON.stringify(shut)); } catch (e) { /* private browsing */ }
    });
  });
})();
</script>

