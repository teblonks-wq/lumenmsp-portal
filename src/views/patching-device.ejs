<%- include('partials/header', { title: device.hostname + ' — Patching', user }) %>
<%
function sev(s) {
  var t = String(s || '').toLowerCase();
  if (t === 'critical') return 'badge-failed';
  if (t === 'important') return 'badge-primary';
  return 'badge-inactive';
}
function ago(s) {
  if (s == null) return 'never';
  var h = Math.round(Number(s) / 3600);
  if (h < 24) return h + 'h ago';
  return Math.round(h / 24) + 'd ago';
}
// A driver is still a Windows Update, but it behaves differently enough — and gets
// blamed often enough — to be worth spotting without reading the title.
function isDriver(p) { return /driver/i.test(String(p.categories || '')); }
function srcOf(p) { return isDriver(p) ? 'driver' : String(p.source || 'windows'); }
var counts = { windows: 0, driver: 0, app: 0 };
patches.forEach(function (p) {
  var s = srcOf(p);
  if (s === 'driver') counts.driver++;
  else if (s === 'winget' || s === 'choco') counts.app++;
  else counts.windows++;
});
%>

<style>
  td.tick, th.tick { width:34px; text-align:center; }
  #pBar { display:none; align-items:center; gap:8px; flex-wrap:wrap; background:var(--tint-accent);
          border:1px solid var(--info-line); border-radius:10px; padding:10px 14px; margin:0 0 12px; }
  #pBar.on { display:flex; }
</style>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/patching">← Patching</a></p>
  <h1 style="margin:0;"><%= device.hostname %></h1>
  <p class="muted" style="margin:4px 0 0;">
    <% if (device.customer_id) { %><a class="row-link" href="/customers/<%= device.customer_id %>"><%= device.customer_name %></a> · <% } %>
    <%= device.os || 'Windows' %> · scanned <%= device.patch_scan_at ? ago(device.scan_age_secs) : 'never' %>
    <% if (device.patch_last_installed) { %> · last update installed <%= device.patch_last_installed %><% } %>
    · <a class="row-link" href="/ce/device/<%= device.id %>">Cyber Essentials</a>
  </p>
</div>

<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>

<div class="card">
  <div class="card-header"><h2>Policy</h2></div>
  <p class="muted" style="margin:0 0 12px;font-size:13px;">
    <% if (resolved) { %>
      Currently governed by <strong><%= resolved.name %></strong>
      (<%= resolved.source === 'device' ? 'set on this machine' : resolved.source === 'customer' ? 'inherited from the customer' : 'the built-in default' %>)
      — <%= resolved.enabled ? 'patching enabled' : 'patching off' %>.
      <% if (!resolved.enabled) { %><br><span>Automatic patching being off does not stop you deploying by hand below — it only means nothing happens on its own.</span><% } %>
    <% } else { %>
      No policy resolves for this machine.
    <% } %>
    <% if (device.patch_excluded) { %> <strong style="color:var(--warn-fg);">This machine is excluded from patching entirely.</strong><% } %>
  </p>

  <form method="post" action="/patching/device/<%= device.id %>" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;align-items:end;">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="form-group" style="margin:0;">
      <label>Override policy</label>
      <select class="input" name="patch_policy_id" style="width:100%;">
        <option value="">Inherit from customer</option>
        <% policies.forEach(function (p) { %>
          <option value="<%= p.id %>" <%= device.patch_policy_id === p.id ? 'selected' : '' %>><%= p.name %><%= p.enabled ? '' : ' (off)' %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group" style="margin:0;">
      <label>Treat as</label>
      <select class="input" name="patch_class" style="width:100%;">
        <option value="">Work it out from the OS (<%= deviceClass %>)</option>
        <option value="workstation" <%= device.patch_class === 'workstation' ? 'selected' : '' %>>Workstation</option>
        <option value="server" <%= device.patch_class === 'server' ? 'selected' : '' %>>Server</option>
      </select>
    </div>
    <div class="form-group" style="margin:0;">
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;">
        <input type="checkbox" name="patch_excluded" value="1" <%= device.patch_excluded ? 'checked' : '' %>>
        Skip this machine entirely
      </label>
    </div>
    <div><button class="btn btn-primary" type="submit">Save</button></div>
  </form>
</div>

<% if (device.reboot_required) { %>
<div class="alert" style="border:1px solid var(--warn-line);">
  <strong>A restart is outstanding.</strong>
  <span class="muted">Updates have installed but won't take effect — and further updates often won't install — until this machine is restarted.</span>
</div>
<% } %>

<form method="post" action="/patching/device/<%= device.id %>/install" id="pForm">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

<div style="display:flex;gap:8px;margin:0 0 12px;flex-wrap:wrap;align-items:center;">
  <button class="btn btn-primary" type="submit" name="when" value="now" <%= patches.length ? '' : 'disabled' %>
    onclick="return confirm('Install all <%= patches.length %> pending update(s) on <%= device.hostname %> now?\n\nNothing will be restarted — Windows will report if a restart is needed and it will show here.');">
    ⬇ Install everything now
  </button>
  <button class="btn" type="submit" name="when" value="window" <%= patches.length ? '' : 'disabled' %>
    onclick="return confirm('Hold these until this machine\'s maintenance window?');">
    Install in the maintenance window
  </button>
  <span class="muted" style="font-size:12px;">
    <%= counts.windows %> Windows · <%= counts.driver %> driver<%= counts.driver === 1 ? '' : 's' %> · <%= counts.app %> application
  </span>
</div>

<div id="pBar">
  <span><strong id="pCount">0</strong> selected</span>
  <button class="btn btn-primary" type="submit" name="when" value="now">Install selected now</button>
  <button class="btn" type="submit" name="when" value="window">Install in the window</button>
  <a class="btn" href="#" onclick="pAll(false);return false;" style="margin-left:auto;">Clear</a>
</div>

<div class="card" style="padding:0;">
  <div class="card-header" style="padding:20px 24px 0;"><h2><%= patches.length %> update<%= patches.length === 1 ? '' : 's' %> pending</h2></div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr>
        <th class="tick"><input type="checkbox" id="pTickAll" onclick="pAll(this.checked)" title="Select all"></th>
        <th>Update</th><th>Source</th><th>Version</th><th>Severity</th><th style="text-align:right;">Size</th><th style="text-align:right;">Outstanding</th>
      </tr></thead>
      <tbody>
        <% if (!patches.length) { %>
          <tr><td colspan="7"><div class="empty-state"><%= device.patch_scan_at ? 'Nothing pending — this machine is up to date.' : 'Not scanned yet. The agent scans on its daily inventory pass.' %></div></td></tr>
        <% } %>
        <% patches.forEach(function (p) { %>
          <tr>
            <td class="tick"><input type="checkbox" class="p-one" name="update_ids" value="<%= p.update_id %>" onclick="pSync()"></td>
            <td><%= p.title %><% if (p.categories) { %><div class="muted" style="font-size:11px;margin-top:2px;"><%= p.categories %></div><% } %></td>
            <td><%- include('partials/srcbadge', { s: srcOf(p), small: true }) %></td>
            <td class="muted" style="font-size:12px;"><% if (p.available_version) { %><%= p.current_version || '?' %> → <%= p.available_version %><% } else { %><%= p.kb ? 'KB' + String(p.kb).replace(/^KB/i, '') : '—' %><% } %></td>
            <td><% if (p.severity) { %><span class="badge <%= sev(p.severity) %>"><%= p.severity %></span><% } else { %><span class="muted">—</span><% } %></td>
            <td style="text-align:right;"><%= p.size_mb != null ? Number(p.size_mb).toFixed(1) + ' MB' : '—' %></td>
            <td style="text-align:right;"><%= p.age_days %>d</td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
</form>

<p class="muted" style="margin:14px 0 0;font-size:12px;">
  "Outstanding" is how long we have known about it, not how long since Microsoft released it —
  it starts when this machine first reported the update as missing. Windows updates are installed as one
  batch, which Windows handles far better than the same updates one at a time; applications go through
  WinGet or Chocolatey, whichever reported them.
</p>

<script>
function pTicks() { return Array.prototype.slice.call(document.querySelectorAll('.p-one')); }
function pSync() {
  var on = pTicks().filter(function (t) { return t.checked; }).length;
  document.getElementById('pCount').textContent = on;
  document.getElementById('pBar').classList.toggle('on', on > 0);
  var all = document.getElementById('pTickAll');
  all.checked = on > 0 && on === pTicks().length;
  all.indeterminate = on > 0 && on < pTicks().length;
}
function pAll(on) { pTicks().forEach(function (t) { t.checked = on; }); pSync(); }
pSync();
</script>

<%- include('partials/footer') %>
