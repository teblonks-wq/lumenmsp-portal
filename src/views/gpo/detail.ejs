<%- include('../partials/header', { title: g.name + ' - Group Policy', user }) %>
<%
// Settings arrive as a flat list; grouping them by area is the difference between a wall
// of registry names and something you can scan.
var byArea = {};
settings.forEach(function (s) {
  var k = (s.scope || 'Computer') + ' / ' + (s.area || 'Other');
  (byArea[k] = byArea[k] || []).push(s);
});
var areas = Object.keys(byArea).sort();
%>

<style>
  .gpo-flag { display:inline-block; font-size:11px; font-weight:600; border-radius:5px; padding:1px 7px;
              margin:1px 3px 1px 0; border:1px solid var(--warn-line); color:var(--warn-fg); background:var(--warn-bg); }
  .gpo-area { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em;
              color:var(--muted); padding:10px 0 4px; }
  .gpo-set td { font-size:13px; vertical-align:top; }
</style>

<div class="page-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 3px;font-size:12.5px;"><a class="row-link" href="/gpo">Group Policy</a> &rsaquo;
      <% if (g.customer_id) { %><a class="row-link" href="/gpo?customer=<%= g.customer_id %>"><%= g.customer_name %></a><% } else { %>Unknown customer<% } %></p>
    <h1 style="margin:0;"><%= g.name %></h1>
    <p class="muted" style="margin:4px 0 0;">
      <%= g.domain || 'unknown domain' %> &middot;
      <%= g.setting_count %> setting<%= Number(g.setting_count) === 1 ? '' : 's' %> &middot;
      last modified <%= g.modified_on ? String(g.modified_on).slice(0, 10) : 'unknown' %> &middot;
      collected <%= g.collected_at ? new Date(g.collected_at).toLocaleString('en-GB') : 'never' %>
    </p>
  </div>
  <button class="btn btn-remote" type="button" id="gpoAskBtn">&#10022; Ask Claude what this does</button>
</div>

<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div class="card" id="gpoAskPanel" style="display:none;">
  <div style="display:flex;align-items:flex-start;gap:10px;">
    <div style="flex:1;">
      <p class="muted" style="margin:0 0 3px;font-size:11px;text-transform:uppercase;letter-spacing:.04em;font-weight:700;">Asked Claude</p>
      <h2 id="gpoAskQ" style="margin:0;font-size:16px;"></h2>
    </div>
    <button type="button" id="gpoAskClose" style="border:none;background:none;font-size:22px;line-height:1;cursor:pointer;color:var(--muted);">&times;</button>
  </div>
  <form id="gpoAskForm" style="display:flex;gap:8px;margin-top:12px;">
    <input class="input" id="gpoAskInput" style="flex:1;" autocomplete="off" placeholder="What does this policy actually do?">
    <button class="btn btn-primary" type="submit" id="gpoAskGo">Ask</button>
  </form>
  <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;" id="gpoAskChips"></div>
  <div id="gpoAskBody" style="margin-top:12px;"></div>
</div>

<% if (findings.length) { %>
<div class="card">
  <div class="card-header"><h2>Worth a look</h2></div>
  <% findings.forEach(function (f) { %>
    <div style="padding:7px 0;border-bottom:1px solid var(--surface-3);font-size:13.5px;">
      <span style="font-weight:700;color:<%= f.level === 'bad' ? 'var(--bad-fg)' : 'var(--warn-fg)' %>;"><%= f.level === 'bad' ? '&#9650;' : '&#9679;' %> <%= f.title %></span>
      <% if (f.detail) { %><span style="color:var(--text-2);"> <%= f.detail %></span><% } %>
    </div>
  <% }); %>
</div>
<% } %>

<div class="card-grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
  <div class="card">
    <div class="card-header"><h2>Linked to</h2></div>
    <% if (!links.length) { %>
      <p class="muted" style="margin:0;font-size:13px;">Nowhere. This policy applies to nothing &mdash; it is either a leftover, or somebody unlinked it and expects it to still work.</p>
    <% } else { %>
      <% links.forEach(function (l) { %>
        <div style="padding:6px 0;border-bottom:1px solid var(--surface-3);font-size:13px;">
          <span style="font-weight:600;"><%= l.target %></span>
          <% if (l.enabled === false) { %><span class="gpo-flag">Link disabled</span><% } %>
          <% if (l.enforced) { %><span class="gpo-flag">Enforced</span><% } %>
          <% if (l.order) { %><span class="muted" style="font-size:12px;"> &middot; order <%= l.order %></span><% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><h2>Applies to</h2></div>
    <% if (!appliesTo.length) { %>
      <p class="muted" style="margin:0;font-size:13px;">Not reported. Normally that means the default &mdash; Authenticated Users.</p>
    <% } else { %>
      <% appliesTo.forEach(function (a) { %>
        <div style="padding:5px 0;border-bottom:1px solid var(--surface-3);font-size:13px;"><%= a %></div>
      <% }); %>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><h2>The object itself</h2></div>
    <div style="font-size:13px;line-height:1.9;">
      <div><span class="muted">Status</span> &middot; <%= g.status || 'unknown' %></div>
      <div><span class="muted">Created</span> &middot; <%= g.created_on ? String(g.created_on).slice(0, 10) : 'unknown' %></div>
      <div><span class="muted">GUID</span> &middot; <span style="font-family:monospace;font-size:11.5px;"><%= g.gpo_id %></span></div>
      <% if (g.description) { %><div style="margin-top:6px;"><span class="muted">Description</span><br><%= g.description %></div><% } %>
    </div>
  </div>
</div>

<div class="card" style="padding:0;">
  <div class="card-header" style="padding:16px 20px 0;"><h2>Settings</h2></div>
  <% if (g.report_error) { %>
    <p style="margin:10px 20px 16px;font-size:13px;color:var(--bad-fg);">Could not read the settings: <%= g.report_error %></p>
  <% } else if (!settings.length) { %>
    <p class="muted" style="margin:10px 20px 16px;font-size:13px;">No settings in this policy.</p>
  <% } else { %>
    <% if (settings.length < Number(g.setting_count)) { %>
      <p class="muted" style="margin:6px 20px 0;font-size:12px;">Showing the first <%= settings.length %> of <%= g.setting_count %> &mdash; the collector caps the list so a large policy cannot flood the database.</p>
    <% } %>
    <div class="table-wrap">
      <table class="table">
        <tbody>
          <% areas.forEach(function (area) { %>
            <tr><td colspan="3" class="gpo-area"><%= area %></td></tr>
            <% byArea[area].forEach(function (s) { %>
              <tr class="gpo-set">
                <td style="width:55%;"><%= s.name %></td>
                <td style="width:15%;font-weight:600;"><%= s.state || '' %></td>
                <td class="muted"><%= s.value ? String(s.value).slice(0, 300) : '' %></td>
              </tr>
            <% }); %>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('_ask-script') %>
<script>
(function () {
  var GID = <%= g.id %>;
  var panel = document.getElementById('gpoAskPanel');
  var form = document.getElementById('gpoAskForm');
  var input = document.getElementById('gpoAskInput');
  var go = document.getElementById('gpoAskGo');
  var head = document.getElementById('gpoAskQ');
  var body = document.getElementById('gpoAskBody');

  function ask(question) { input.value = question; window.gpoAsk({ id: GID }, question, head, body, go); }

  // The three questions actually asked of a policy, so nobody has to think of the wording.
  var chips = document.getElementById('gpoAskChips');
  ['What does this policy do?',
   'Does anything in here weaken security?',
   'Who does this apply to, and is it doing anything at all?'].forEach(function (t) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'btn'; b.style.cssText = 'font-size:12px;padding:3px 10px;';
    b.textContent = t;
    b.addEventListener('click', function () { ask(t); });
    chips.appendChild(b);
  });

  document.getElementById('gpoAskBtn').addEventListener('click', function () {
    panel.style.display = 'block';
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    // Straight to the answer - this is the question nine times out of ten.
    if (!body.textContent.trim()) ask('What does this policy do?');
    else input.focus();
  });
  document.getElementById('gpoAskClose').addEventListener('click', function () { panel.style.display = 'none'; });

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var question = (input.value || '').trim();
    if (question) window.gpoAsk({ id: GID }, question, head, body, go);
  });
})();
</script>

<%- include('../partials/footer') %>
