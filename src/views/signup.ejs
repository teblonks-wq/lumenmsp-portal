<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create an account — Lumen MSP Portal</title>
  <link rel="icon" type="image/png" href="/static/lumen-crest.png">
  <meta name="theme-color" content="#0f172a">
  <link rel="stylesheet" href="/static/app.css">
  <style>
    .login-card { max-width: 720px !important; width: 92%; padding: 48px 64px !important; text-align: left; }
    .login-card h1 { font-size: 32px; margin-bottom: 6px; }
    .login-card > .muted { font-size: 17px; }
    .login-card .form-group label { font-size: 15px; }
    .login-card input { font-size: 17px; padding: 13px 15px; }
    .login-card .btn { font-size: 17px; padding: 14px 20px; }
    .signup-head { text-align: center; }
    .signup-or { display: flex; align-items: center; gap: 14px; margin: 26px 0 20px; color: var(--faint); font-size: 14px; }
    .signup-or::before, .signup-or::after { content: ""; flex: 1; height: 1px; background: var(--line); }
    .hint { color: var(--faint); font-size: 13px; margin: 4px 0 0; }
    .signup-foot { margin-top: 26px; text-align: center; font-size: 15px; }
  </style>
</head>
<body class="login-body">
  <div class="login-card">
    <div class="signup-head">
      <img src="/static/lumen-crest.png" alt="Lumen" style="height:48px;width:auto;margin-bottom:14px;">
      <h1>Create an account</h1>
      <p class="muted">So you can raise a support request and follow it through.</p>
    </div>

    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>

    <% if (done) { %>
      <div class="alert-success" style="margin:18px 0;"><%= done %></div>
      <p class="signup-foot"><a href="/login-page">Back to sign in</a></p>

    <% } else if (locals.resend) { %>
      <form method="post" action="/signup/resend">
        <div class="form-group">
          <label>Email address</label>
          <input type="email" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send me a new link</button>
      </form>
      <p class="signup-foot"><a href="/signup">Start again</a> &middot; <a href="/login-page">Sign in</a></p>

    <% } else { %>
      <form method="post" action="/signup" autocomplete="on">
        <div class="form-group">
          <label>Your name</label>
          <input type="text" name="name" value="<%= values.name || '' %>" autocomplete="name" maxlength="120" required>
        </div>
        <div class="form-group">
          <label>Company</label>
          <input type="text" name="company" value="<%= values.company || '' %>" autocomplete="organization" maxlength="200" required>
          <p class="hint">Tell us who you work for. We use this to help route your request &mdash; it does not give you access to any company's account.</p>
        </div>
        <div class="form-group">
          <label>Work email address</label>
          <input type="email" name="email" value="<%= values.email || '' %>" autocomplete="email" maxlength="200" required>
        </div>

        <!-- Microsoft first: it needs no password and proves the address on the spot.
             It posts rather than links so the company name above travels with it. -->
        <button type="submit" class="btn btn-primary btn-block" formaction="/signup/microsoft" formnovalidate>
          Continue with Microsoft
        </button>

        <div class="signup-or">or set a password</div>

        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" autocomplete="new-password" minlength="10" required>
          <p class="hint">At least 10 characters. Length matters more than symbols.</p>
        </div>
        <div class="form-group">
          <label>Confirm password</label>
          <input type="password" name="password2" autocomplete="new-password" minlength="10" required>
        </div>
        <button type="submit" class="btn btn-block">Create account</button>
      </form>

      <p class="signup-foot">Already have an account? <a href="/login-page">Sign in</a></p>
    <% } %>
  </div>
</body>
</html>
