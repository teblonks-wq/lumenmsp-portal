<%
// All of these locals are always supplied by the route (see GET /insights/number),
// so reference them directly — do NOT redeclare with the same name (that shadows
// the EJS `with(locals)` binding and throws a TDZ ReferenceError at render).
const isConnected = (typeof connected === 'undefined') ? true : connected;

const fmtDt = d => d ? new Date(d).toLocaleString('en-GB', {
  day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'
}) : '—';
const fmtD  = s => s ? new Date(s).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : '';
const fmtSecs = s => s >= 60 ? `${Math.floor(s/60)}m ${s%60}s` : `${s}s`;

const statusColour = s => ({
  'Answered':  'color:var(--ok);background:var(--tint-ok);border-color:var(--ok-line)',
  'Missed':    'color:var(--bad);background:var(--tint-bad);border-color:var(--bad-line)',
  'Abandoned': 'color:var(--amber);background:var(--tint-warn);border-color:var(--warn-line)',
  'Voicemail': 'color:var(--violet-deep);background:#faf5ff;border-color:var(--violet-line)',
  'Overflowed':'color:var(--accent-dark);background:var(--tint-accent);border-color:var(--info-line)',
}[s] || 'color:var(--muted);background:var(--surface-2);border-color:var(--line)');

const total = stats ? stats.total : 0;

// Data freshness. Call data is a cached copy of Tollring, refreshed by the sync job every
// 10 minutes; admins get an "Update now" button to pull the newest calls on demand.
const lastSyncTxt = lastSynced
  ? new Date(lastSynced).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' })
  : null;
// Where "Update now" returns to, so the admin lands back on this exact search.
const returnUrl = `/insights/number?customer=${cid}${number ? '&q=' + encodeURIComponent(number) : ''}`;

// Everything below is built as a template literal, so nothing is auto-escaped by EJS.
// `number`, `notice` and `qerr` all come off the query string — escape them.
const esc = v => String(v == null ? '' : v)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

// Customer dropdown for the search bar.
const customerOptions = customers.map(c => `<option value="${c.id}" ${cid === c.id ? 'selected' : ''}>${esc(c.name)}</option>`).join('');
%>
<%- include('_layout', { title: number ? `Number: ${number}` : 'Find a call', user, csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '', body: `
<div class="page-header">
  <h1 style="font-family:monospace;letter-spacing:1px;">${esc(number) || 'Find a call'}</h1>
  <div style="font-size:12.5px;color:var(--muted);margin-top:4px;">${number ? `Showing the last 4 weeks &middot; ${fmtD(fromDate)} - ${fmtD(toDate)}` : 'Enter a phone number to see every call it made or received, and how each one went.'}</div>
  ${cid ? `<div style="font-size:11.5px;color:var(--muted);margin-top:3px;">Call data updates every 10 minutes${lastSyncTxt ? ` &middot; last updated ${lastSyncTxt}` : ' &middot; never synced'}</div>` : ''}
</div>

<div class="ins-search">
  <p class="lead">Pick the customer, then the number you want to follow.</p>
  <form method="GET" action="/insights/number">
    <div class="fg" style="min-width:220px;">
      <label>Customer</label>
      <select name="customer" class="input" required style="width:100%;">
        <option value="">- choose -</option>
        ${customerOptions}
      </select>
    </div>
    <div class="fg" style="min-width:190px;">
      <label>Number</label>
      <input type="text" name="q" id="np-number" value="${esc(number)}" list="numList" class="input" placeholder="e.g. 07700 900123" style="width:100%;font-family:monospace;" autocomplete="off">
      <datalist id="numList"></datalist>
    </div>
    <button type="submit" class="btn-primary">Search</button>
    <div class="ins-actions">
      ${number ? `<a href="/insights/number?customer=${cid}&q=${encodeURIComponent(number)}&format=pdf" target="_blank" class="btn-secondary" style="padding:9px 16px;font-size:13px;border-radius:8px;text-decoration:none;">&var(--ok); PDF report</a>
      <button type="button" id="mrMake" class="btn-primary" style="padding:9px 16px;font-size:13px;border-radius:8px;">&#10024; Make report</button>` : ''}
    </div>
  </form>
  <p class="hint">Click any answering extension in the results to see everything that person picked up.</p>
</div>

${isAdmin && cid ? `
<form method="POST" action="/insights/customer/${cid}/sync-now" style="margin:0 0 16px;" onsubmit="var b=this.querySelector('button');setTimeout(function(){b.disabled=true;b.textContent='Updating...';},0);">
  <input type="hidden" name="return_to" value="${esc(returnUrl)}">
  <button type="submit" class="btn-secondary" style="padding:7px 14px;font-size:13px;" title="Pull this customer's newest calls from Tollring right now, instead of waiting for the next 10-minute sync">&#8635; Update now</button>
</form>` : ''}

${notice ? `<div class="alert alert-success">${esc(notice)}</div>` : ''}
${qerr ? `<div class="alert alert-error">${esc(qerr)}</div>` : ''}
<div class="mr-panel" id="mrPanel" data-cid="${cid}" data-url="/insights/number?customer=${cid}&q=${encodeURIComponent(number)}">
  <div class="mr-head">
    <h2>Make report</h2>
    <button type="button" class="btn-secondary" id="mrClose" style="padding:5px 12px;font-size:12.5px;border-radius:8px;">Close</button>
  </div>
  <div class="mr-body">
    <div><iframe id="mrPreview" title="Report preview"></iframe></div>
    <div class="mr-side">
      <div class="fg">
        <label>Who asked for this report?</label>
        <select id="mrContact"><option value="">- choose a contact -</option></select>
        <p class="mr-note" id="mrContactNote">Their name appears on the report as the requester.</p>
      </div>
      <div class="fg">
        <label>Note to include <span style="font-weight:400;color:var(--faint);">(optional)</span></label>
        <textarea id="mrNote" rows="4" placeholder="Anything you want to say alongside it..."></textarea>
      </div>
      <button type="button" class="btn-primary" id="mrSend" style="width:100%;padding:10px;border-radius:8px;">Email this report</button>
      <a class="btn-secondary" id="mrOpen" href="#" target="_blank" style="display:block;text-align:center;margin-top:8px;padding:9px;border-radius:8px;text-decoration:none;font-size:13.5px;">Open / download instead</a>
      <p class="mr-msg" id="mrMsg"></p>
      <p class="mr-note">Nothing is sent until you press Email. The preview above is exactly what they receive.</p>
    </div>
  </div>
</div>

${error ? `<div class="alert alert-error">${esc(error)}</div>` : ''}

${!isConnected ? `
<div class="card"><div class="card-header"><h2>Insights database not connected</h2></div>
  <p class="muted" style="margin:0;">Set <code>INSIGHTS_DATABASE_URL</code> in the portal's <code>.env</code>.</p></div>
` : !number ? '' : total === 0 ? `
  <div class="card">
    <div class="empty-state"><p class="muted">No call records found for this number.</p></div>
  </div>
` : `

<div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:24px;">
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--accent);">${stats.total}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Total Calls</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--ok);">${stats.answered}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Answered</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--bad);">${stats.missed}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Missed</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--accent);">${stats.ansRate}%</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Answer Rate</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--accent);">${fmtSecs(stats.avgWait)}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Avg Wait</div>
  </div>
</div>

<div class="card">
  <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
    <h2>Call History</h2>
    <span class="muted" style="font-size:13px;">Most recent first</span>
  </div>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="border-bottom:2px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Date / Time</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Outcome</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Wait</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Journey</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Answered By</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">DDI</th>
        </tr>
      </thead>
      <tbody>
        ${journeys.map((j, idx) => `
        <tr style="border-bottom:1px solid var(--border);${idx % 2 === 1 ? 'background:var(--surface-2);' : ''}">
          <td style="padding:10px 12px;white-space:nowrap;font-weight:500;">${fmtDt(j.datetime)}</td>
          <td style="padding:10px 12px;">
            <span style="display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;border:1px solid;${statusColour(j.is_voicemail ? 'Voicemail' : j.status)}">
              ${j.status}
            </span>
          </td>
          <td style="padding:10px 12px;font-family:monospace;font-size:12px;">${j.wait || ''}</td>
          <td style="padding:10px 12px;font-size:12px;color:var(--muted);">${j.route || ''}</td>
          <td style="padding:10px 12px;font-size:12px;font-family:monospace;color:var(--ink);">${j.answered_by ? `<a href="/insights/reverse?customer=${cid}&ext=${encodeURIComponent(j.answered_by)}" title="Who answered it - every call ${j.answered_by} picked up" style="color:inherit;text-decoration:underline dotted;">${j.answered_by}</a>` : '—'}</td>
          <td style="padding:10px 12px;font-size:12px;color:var(--muted);">${j.ddi || ''}</td>
        </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>
`}

<script>
(function(){
  var inp = document.getElementById('np-number');
  var list = document.getElementById('numList');
  var sel = document.querySelector('select[name="customer"]');
  if (!inp || !sel) return;
  var t;
  inp.addEventListener('input', function(){
    clearTimeout(t); var q = inp.value.trim(); var cid = sel.value;
    if (!cid || q.length < 3) return;
    t = setTimeout(function(){
      fetch('/insights/number-search?customer=' + encodeURIComponent(cid) + '&q=' + encodeURIComponent(q))
        .then(function(r){ return r.json(); })
        .then(function(rows){ list.innerHTML = (rows||[]).map(function(x){ return '<option value="' + x.number_normalised + '">' + x.call_count + ' calls</option>'; }).join(''); })
        .catch(function(){});
    }, 250);
  });
})();
</script>

<style>
@media print {
  nav, .page-header form, .page-header button { display: none !important; }
  .page-header { padding-bottom: 8px; border-bottom: 2px solid #000; margin-bottom: 16px; }
  body { font-size: 11px; padding-top: 0; }
  .card { box-shadow: none; border: 1px solid #ddd; page-break-inside: avoid; }
  table { font-size: 10px; }
  @page { margin: 15mm; }
}
</style>

<script>
// Make Report: build the same document the PDF button produces, preview it, then send it
// only if someone presses Email. The preview IS the sent file - same URL, same render.
(function(){
  var panel=document.getElementById('mrPanel'); if(!panel) return;
  var btn=document.getElementById('mrMake'), frame=document.getElementById('mrPreview');
  var sel=document.getElementById('mrContact'), note=document.getElementById('mrNote');
  var send=document.getElementById('mrSend'), msg=document.getElementById('mrMsg');
  var open=document.getElementById('mrOpen'), close=document.getElementById('mrClose');
  var csrf=(document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  var baseUrl=panel.getAttribute('data-url')||'', cid=panel.getAttribute('data-cid')||'';

  function reportUrl(){
    var u=baseUrl;
    var opt=sel.options[sel.selectedIndex];
    var who=(opt&&opt.getAttribute('data-name'))||'';
    if(who) u+='&requested_by='+encodeURIComponent(who);
    return u;
  }
  function refresh(){ var u=reportUrl(); frame.src=u+'&format=pdf'; open.href=u+'&format=pdf'; }

  if(btn) btn.addEventListener('click', function(){
    panel.classList.add('on');
    panel.scrollIntoView({behavior:'smooth', block:'start'});
    refresh();
    if(sel.options.length<=1 && cid){
      fetch('/insights/report-contacts?customer='+encodeURIComponent(cid))
        .then(function(r){return r.json();}).then(function(j){
          (j.contacts||[]).forEach(function(c){
            if(!c.email) return;
            var o=document.createElement('option');
            o.value=c.email; o.setAttribute('data-name', c.full_name||'');
            o.textContent=c.full_name+(c.job_title?' - '+c.job_title:'')+' ('+c.email+')';
            sel.appendChild(o);
          });
          if(!(j.contacts||[]).filter(function(c){return c.email;}).length){
            document.getElementById('mrContactNote').textContent =
              j.reason || 'No contacts with an email address on this customer.';
          }
        }).catch(function(){});
    }
  });
  if(close) close.addEventListener('click', function(){ panel.classList.remove('on'); });
  sel.addEventListener('change', refresh);

  send.addEventListener('click', function(){
    var to=sel.value, opt=sel.options[sel.selectedIndex];
    if(!to){ msg.style.color='var(--warn-fg)'; msg.textContent='Choose who asked for it first.'; return; }
    send.disabled=true; msg.style.color=''; msg.textContent='Sending...';
    fetch('/insights/report-send',{method:'POST',
      headers:{'Content-Type':'application/json','x-csrf-token':csrf},
      body:JSON.stringify({to:to, name:(opt&&opt.getAttribute('data-name'))||'', url:reportUrl(), note:note.value})})
      .then(function(r){return r.json();}).then(function(j){
        send.disabled=false;
        if(!j||!j.ok){ msg.style.color='var(--bad)'; msg.textContent=(j&&j.error)||'Could not send.'; return; }
        msg.style.color='var(--ok-fg)'; msg.textContent='Sent to '+to+'.';
      }).catch(function(){ send.disabled=false; msg.style.color='var(--bad)'; msg.textContent='Could not send.'; });
  });
})();
</script>
` }) %>
