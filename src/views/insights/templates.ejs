<%
  function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  var rowsHtml = (templates || []).map(function(t){
    var mods = Array.isArray(t.modules) ? t.modules : [];
    var del = t.is_system ? '' : '<form method="post" action="/insights/templates/' + t.id + '/delete" style="display:inline;margin-left:6px;" onsubmit="return confirm(\'Delete this template?\');"><button class="btn-secondary" type="submit" style="font-size:12px;padding:4px 10px;">Delete</button></form>';
    var act = t.is_system
      ? '<span class="muted" style="font-size:12px;" title="System reports are locked — modules are fixed in code.">🔒 locked</span>'
      : '<a class="btn-secondary" href="/insights/templates/' + t.id + '/edit" style="font-size:12px;padding:4px 10px;">Edit</a>' + del;
    return '<tr style="border-bottom:1px solid var(--line);">'
      + '<td style="padding:10px 12px;"><strong>' + esc(t.name) + '</strong>' + (t.is_system ? ' <span style="font-size:10px;background:var(--tint-indigo);color:var(--indigo-deep);padding:2px 7px;border-radius:20px;">system</span>' : '') + '</td>'
      + '<td style="padding:10px 12px;color:var(--muted);font-size:12px;">' + (mods.length ? esc(mods.join(', ')) : '—') + '</td>'
      + '<td style="padding:10px 12px;text-align:right;white-space:nowrap;">' + act + '</td>'
      + '</tr>';
  }).join('');
  if (!(templates || []).length) rowsHtml = '<tr><td colspan="3" style="padding:20px;color:var(--muted);">No templates yet — create one.</td></tr>';
%>
<%- include('_layout', { title: 'Reports', user, csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : ''), body: `
  <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
    <div><h1>Report Pool</h1><p style="color:var(--muted);margin:4px 0 0;">Reusable report templates — a name + a set of modules, available to every customer. The site's logic drives the numbers.</p></div>
    <span class="muted" style="font-size:12px;">Fixed catalogue — system reports are locked; new custom templates are retired (Explore replaces them).</span>
  </div>
  ${msg ? '<div style="background:var(--tint-ok);border:1px solid var(--ok-line);color:var(--ok-fg);padding:10px 14px;border-radius:8px;margin-bottom:14px;">' + esc(msg) + '</div>' : ''}
  ${err ? '<div style="background:var(--tint-bad);border:1px solid var(--bad-line);color:var(--bad-fg);padding:10px 14px;border-radius:8px;margin-bottom:14px;">' + esc(err) + '</div>' : ''}
  <div class="card" style="padding:0;">
    <table style="width:100%;border-collapse:collapse;font-size:14px;">
      <thead><tr style="border-bottom:2px solid var(--line);">
        <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Template</th>
        <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Modules</th>
        <th></th></tr></thead>
      <tbody>${rowsHtml}</tbody>
    </table>
  </div>
` }) %>
