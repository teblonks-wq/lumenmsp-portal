<%
// "Who called them" - the third call tool. All locals are always supplied by the route
// (see GET /insights/outbound) - reference them directly, do NOT redeclare with the same
// name (that shadows the EJS `with(locals)` binding and throws a TDZ ReferenceError).
const isConnected = (typeof connected === 'undefined') ? true : connected;

const esc = s => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const fmtDt = d => d ? new Date(d).toLocaleString('en-GB', {
  day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'
}) : '—';
const fmtD  = s => s ? new Date(s).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : '';
const fmtSecs = s => s >= 60 ? `${Math.floor(s/60)}m ${s%60}s` : `${s}s`;
const allDay = fromTime === '00:00' && toTime === '23:59';

const customerOptions = customers.map(c => `<option value="${c.id}" ${cid === c.id ? 'selected' : ''}>${esc(c.name)}</option>`).join('');
%>
<%- include('_layout', { title: num ? `Calls to ${num}` : 'Who called them', user, csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '', body: `
<div class="page-header">
  <h1 style="font-family:monospace;letter-spacing:1px;">${num ? esc(num) : 'Who called them'}</h1>
  <div style="font-size:12.5px;color:var(--muted);margin-top:4px;">${searched
    ? `Calls placed TO this number &middot; ${fmtD(fromDate)} - ${fmtD(toDate)}${allDay ? '' : ` &middot; ${esc(fromTime)}-${esc(toTime)}`}`
    : 'Enter a number you rang to see who called it, when, and whether it connected.'}</div>
</div>

<div class="ins-search">
  <p class="lead">Pick the customer and the number they rang, then narrow the window.</p>
  <form method="GET" action="/insights/outbound">
    <div class="fg" style="min-width:200px;">
      <label>Customer</label>
      <select name="customer" class="input" required style="width:100%;">
        <option value="">- choose -</option>
        ${customerOptions}
      </select>
    </div>
    <div class="fg" style="min-width:190px;">
      <label>Number called</label>
      <input type="text" name="num" value="${esc(num)}" class="input" placeholder="e.g. 07700 900123" style="width:100%;font-family:monospace;" autocomplete="off">
    </div>
    <div class="fg"><label>From</label><input type="date" name="from" value="${esc(fromDate)}" class="input"></div>
    <div class="fg"><label>To</label><input type="date" name="to" value="${esc(toDate)}" class="input"></div>
    <div class="fg"><label>Between</label><input type="time" name="from_time" value="${esc(fromTime)}" class="input"></div>
    <div class="fg"><label>And</label><input type="time" name="to_time" value="${esc(toTime)}" class="input"></div>
    <button type="submit" class="btn-primary">Search</button>
    <div class="ins-actions">
      ${searched && stats && stats.total ? `<a href="/insights/outbound?customer=${cid}&num=${encodeURIComponent(num)}&from=${esc(fromDate)}&to=${esc(toDate)}&from_time=${esc(fromTime)}&to_time=${esc(toTime)}&format=pdf" target="_blank" class="btn-secondary" style="padding:9px 16px;font-size:13px;border-radius:8px;text-decoration:none;">&var(--ok); PDF report</a>
      <button type="button" id="mrMake" class="btn-primary" style="padding:9px 16px;font-size:13px;border-radius:8px;">&#10024; Make report</button>` : ''}
    </div>
  </form>
  <p class="hint">Click a caller to see everything they answered, or the number to see its full history both ways.</p>
</div>

<div class="mr-panel" id="mrPanel" data-cid="${cid}" data-url="/insights/outbound?customer=${cid}&num=${encodeURIComponent(num)}&from=${esc(fromDate)}&to=${esc(toDate)}&from_time=${esc(fromTime)}&to_time=${esc(toTime)}">
  <div class="mr-head">
    <h2>Make report</h2>
    <button type="button" class="btn-secondary" id="mrClose" style="padding:5px 12px;font-size:12.5px;border-radius:8px;">Close</button>
  </div>
  <div class="mr-body">
    <div><iframe id="mrPreview" title="Report preview"></iframe></div>
    <div class="mr-side">
      <div class="fg">
        <label>Who asked for this report?</label>
        <select id="mrContact"><option value="">- choose a contact -</option></select>
        <p class="mr-note" id="mrContactNote">Their name appears on the report as the requester.</p>
      </div>
      <div class="fg">
        <label>Note to include <span style="font-weight:400;color:var(--faint);">(optional)</span></label>
        <textarea id="mrNote" rows="4" placeholder="Anything you want to say alongside it..."></textarea>
      </div>
      <button type="button" class="btn-primary" id="mrSend" style="width:100%;padding:10px;border-radius:8px;">Email this report</button>
      <a class="btn-secondary" id="mrOpen" href="#" target="_blank" style="display:block;text-align:center;margin-top:8px;padding:9px;border-radius:8px;text-decoration:none;font-size:13.5px;">Open / download instead</a>
      <p class="mr-msg" id="mrMsg"></p>
      <p class="mr-note">Nothing is sent until you press Email. The preview above is exactly what they receive.</p>
    </div>
  </div>
</div>

${error ? `<div class="alert alert-error">${esc(error)}</div>` : ''}

${!isConnected ? `
<div class="card"><div class="card-header"><h2>Insights database not connected</h2></div>
  <p class="muted" style="margin:0;">Set <code>INSIGHTS_DATABASE_URL</code> in the portal's <code>.env</code>.</p></div>
` : !searched ? '' : stats.total === 0 ? `
  <div class="card">
    <div class="empty-state"><p class="muted">No outbound calls to <strong>${esc(num)}</strong> in this window.</p>
    <p class="muted" style="font-size:12px;margin-top:6px;">If you know this number was called, the carrier feed may label direction differently - tell Claude what values <code>tollring_calls.direction</code> holds.</p></div>
  </div>
` : `

<div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:24px;">
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--accent);">${stats.total}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Calls Out</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--ok);">${stats.connected}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Connected (${stats.connRate}%)</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--warn-fg);">${stats.noAnswer}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">No Answer</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--accent);">${stats.callers}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">People Who Called</div>
  </div>
  <div style="text-align:center;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">
    <div style="font-size:26px;font-weight:800;color:var(--accent);">${fmtSecs(stats.avgTalk)}</div>
    <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;">Avg Talk Time</div>
  </div>
</div>

<div class="card">
  <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
    <h2>Calls Placed</h2>
    <span class="muted" style="font-size:13px;">Most recent first &middot; click an extension to see what they answered</span>
  </div>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="border-bottom:2px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Date / Time</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Called By</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Number</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Outcome</th>
          <th style="text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);">Talk Time</th>
        </tr>
      </thead>
      <tbody>
        ${calls.map(c => `
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:9px 12px;white-space:nowrap;color:var(--muted);">${fmtDt(c.datetime)}</td>
            <td style="padding:9px 12px;font-family:monospace;">${c.extno
              ? `<a href="/insights/reverse?customer=${cid}&ext=${encodeURIComponent(c.extno)}&from=${esc(fromDate)}&to=${esc(toDate)}" title="Everything ${esc(c.extno)} answered">${esc(c.extno)}</a>`
              : '<span class="muted">-</span>'}</td>
            <td style="padding:9px 12px;font-family:monospace;">
              <a href="/insights/number?customer=${cid}&q=${encodeURIComponent(c.number)}" title="Full history for this number">${esc(c.number)}</a></td>
            <td style="padding:9px 12px;">${c.connected
              ? '<span style="color:var(--ok-fg);font-weight:600;">Connected</span>'
              : '<span style="color:var(--warn-fg);font-weight:600;">No answer</span>'}</td>
            <td style="padding:9px 12px;white-space:nowrap;">${c.connected ? fmtSecs(c.dur) : '-'}</td>
          </tr>`).join('')}
      </tbody>
    </table>
  </div>
</div>
`}

<script>
// Make Report: build the same document the PDF button produces, preview it, then send it
// only if someone presses Email. The preview IS the sent file - same URL, same render.
(function(){
  var panel=document.getElementById('mrPanel'); if(!panel) return;
  var btn=document.getElementById('mrMake'), frame=document.getElementById('mrPreview');
  var sel=document.getElementById('mrContact'), note=document.getElementById('mrNote');
  var send=document.getElementById('mrSend'), msg=document.getElementById('mrMsg');
  var open=document.getElementById('mrOpen'), close=document.getElementById('mrClose');
  var csrf=(document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  var baseUrl=panel.getAttribute('data-url')||'', cid=panel.getAttribute('data-cid')||'';

  function reportUrl(){
    var u=baseUrl;
    var opt=sel.options[sel.selectedIndex];
    var who=(opt&&opt.getAttribute('data-name'))||'';
    if(who) u+='&requested_by='+encodeURIComponent(who);
    return u;
  }
  function refresh(){ var u=reportUrl(); frame.src=u+'&format=pdf'; open.href=u+'&format=pdf'; }

  if(btn) btn.addEventListener('click', function(){
    panel.classList.add('on');
    panel.scrollIntoView({behavior:'smooth', block:'start'});
    refresh();
    if(sel.options.length<=1 && cid){
      fetch('/insights/report-contacts?customer='+encodeURIComponent(cid))
        .then(function(r){return r.json();}).then(function(j){
          (j.contacts||[]).forEach(function(c){
            if(!c.email) return;
            var o=document.createElement('option');
            o.value=c.email; o.setAttribute('data-name', c.full_name||'');
            o.textContent=c.full_name+(c.job_title?' - '+c.job_title:'')+' ('+c.email+')';
            sel.appendChild(o);
          });
          if(!(j.contacts||[]).filter(function(c){return c.email;}).length){
            document.getElementById('mrContactNote').textContent =
              j.reason || 'No contacts with an email address on this customer.';
          }
        }).catch(function(){});
    }
  });
  if(close) close.addEventListener('click', function(){ panel.classList.remove('on'); });
  sel.addEventListener('change', refresh);

  send.addEventListener('click', function(){
    var to=sel.value, opt=sel.options[sel.selectedIndex];
    if(!to){ msg.style.color='var(--warn-fg)'; msg.textContent='Choose who asked for it first.'; return; }
    send.disabled=true; msg.style.color=''; msg.textContent='Sending...';
    fetch('/insights/report-send',{method:'POST',
      headers:{'Content-Type':'application/json','x-csrf-token':csrf},
      body:JSON.stringify({to:to, name:(opt&&opt.getAttribute('data-name'))||'', url:reportUrl(), note:note.value})})
      .then(function(r){return r.json();}).then(function(j){
        send.disabled=false;
        if(!j||!j.ok){ msg.style.color='var(--bad)'; msg.textContent=(j&&j.error)||'Could not send.'; return; }
        msg.style.color='var(--ok-fg)'; msg.textContent='Sent to '+to+'.';
      }).catch(function(){ send.disabled=false; msg.style.color='var(--bad)'; msg.textContent='Could not send.'; });
  });
})();
</script>
` }) %>
