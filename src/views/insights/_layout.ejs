<%
// Insights section layout — NATIVE Portal chrome (2026-07-07).
// Previously this was a standalone HTML shell (own topnav + insights.css) iframed into the
// Portal via /tools/insights. Now every insights page renders inside the real Portal
// sidebar/header/footer like any other section, with a section tab strip for insights nav.
// All component classes (card, table, badge, tabs, …) come from app.css — insights.css is
// no longer loaded. CSRF + sortable tables + sidebar active-state come from the footer partial.
%>
<%- include('../partials/header', { title: (typeof title !== 'undefined' ? title + ' · Insights' : 'Insights'), user: user }) %>

<div class="tabs" id="insightsTabs" style="margin-bottom:24px;">
  <a class="tab-btn" href="/insights" data-exact="1">Dashboard</a>
  <a class="tab-btn" href="/insights/oneboard">OneBoard</a>
  <a class="tab-btn" href="/insights/reports">Reports</a>
  <a class="tab-btn" href="/insights/templates">Templates</a>
  <a class="tab-btn" href="/insights/run">Run</a>
  <a class="tab-btn" href="/insights/customers">Customers</a>
  <span class="tab-sep" aria-hidden="true"></span>
  <a class="tab-btn" href="/insights/number">Find a call</a>
  <a class="tab-btn" href="/insights/reverse">Who answered it</a>
  <a class="tab-btn" href="/insights/outbound">Who called them</a>
</div>

<style>
  /* The three call tools are one group — separated from the reporting tabs so the strip
     reads as two sets rather than nine equal items. */
  #insightsTabs { align-items:center; }
  .tab-sep { width:1px; height:20px; background:var(--line,#e2e8f0); margin:0 8px; display:inline-block; }

  /* Search panel — the treatment from the customer portal, where the fields are labelled
     in plain English at a readable size instead of 11px uppercase in the page header. */
  .ins-search { background:#fff; border:1px solid var(--line,#e2e8f0); border-radius:12px; padding:18px 20px; margin-bottom:18px; }
  .ins-search .lead { margin:0 0 13px; font-size:13.5px; color:#64748b; }
  .ins-search form { display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap; margin:0; }
  .ins-search .fg { margin:0; }
  .ins-search label { display:block; font-size:12px; font-weight:600; color:#475569; margin:0 0 5px; letter-spacing:0; text-transform:none; }
  .ins-search .input { padding:9px 11px; font-size:14px; border-radius:8px; }
  .ins-search .input:focus { outline:2px solid #99f6e4; border-color:var(--accent,#0ea5b7); }
  .ins-search .btn-primary { padding:9px 20px; font-size:14px; border-radius:8px; }
  .ins-search .hint { margin:12px 0 0; font-size:12.5px; color:#94a3b8; }
  .ins-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-left:auto; }
  @media print { .ins-search { display:none !important; } }
  /* Make Report — preview first, send second. */
  .mr-panel { background:#fff; border:1px solid var(--line,#e2e8f0); border-radius:12px; padding:0; margin-bottom:18px; overflow:hidden; display:none; }
  .mr-panel.on { display:block; }
  .mr-head { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; padding:14px 18px; border-bottom:1px solid var(--line,#e2e8f0); }
  .mr-head h2 { margin:0; font-size:15px; }
  .mr-body { padding:16px 18px; display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,340px); gap:18px; align-items:start; }
  @media (max-width:900px){ .mr-body { grid-template-columns:1fr; } }
  .mr-body iframe { width:100%; height:620px; border:1px solid var(--line,#e2e8f0); border-radius:8px; background:#f8fafc; }
  .mr-side label { display:block; font-size:12px; font-weight:600; color:#475569; margin:0 0 5px; }
  .mr-side .fg { margin-bottom:13px; }
  .mr-side input, .mr-side textarea, .mr-side select { width:100%; border:1px solid #cbd5e1; border-radius:8px; padding:9px 11px; font-size:14px; font-family:inherit; }
  .mr-note { font-size:12px; color:#64748b; margin:10px 0 0; }
  .mr-msg { font-size:12.5px; margin:9px 0 0; min-height:16px; }
</style>

<%- body %>

<script>
  // Highlight the current insights tab (exact match for the dashboard, prefix for the rest).
  (function () {
    var path = window.location.pathname;
    document.querySelectorAll('#insightsTabs .tab-btn').forEach(function (a) {
      var href = a.getAttribute('href');
      var active = a.hasAttribute('data-exact') ? (path === href) : path.indexOf(href) === 0;
      if (active) a.classList.add('active');
    });
    // Detail pages (customer/site/config) belong to the Customers tab.
    if (!document.querySelector('#insightsTabs .tab-btn.active') &&
        /^\/insights\/(customer|site|report-config)/.test(path)) {
      var c = document.querySelector('#insightsTabs a[href="/insights/customers"]');
      if (c) c.classList.add('active');
    }
  })();
</script>

<%- include('../partials/footer') %>
