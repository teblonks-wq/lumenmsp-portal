<%- include('../partials/header', { title: 'Customers', user }) %>

<div class="page-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <h1>Customers</h1>
    <p class="muted"><%= customers.length %> shown</p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <form method="get" action="/customers" style="display:flex;gap:8px;align-items:center;">
      <input class="input" type="search" name="search" value="<%= search %>" placeholder="Search name, account, domain, contact…" style="min-width:260px;">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
      <button class="btn" type="submit">Search</button>
      <% if (search) { %><a class="btn" href="/customers<%= status ? '?status=' + status : '' %>">Clear</a><% } %>
    </form>
    <form method="post" action="/customers/graph-consent/refresh" style="margin:0;"><button class="btn" type="submit" title="Re-probe every recorded tenant's Graph consent now (also runs daily at 06:15)">↻ Check Graph access</button></form>
    <a class="btn" href="/customers/data-missing" title="Editable sheet of customers with missing default domain, address, phone or key contacts">⚠️ Data missing</a>
    <a class="btn btn-primary" href="/customers/new">+ New customer</a>
  </div>
</div>

<%
  // Stat band - the book at a glance, tiles into the matching tab. Graph health is
  // computed from the rows shown, the same way the badge in the column is.
  var _gOk = 0, _gBad = 0;
  customers.forEach(function (c) {
    if (!c.entra_tenant_id) return;
    if (c.graph_status === 'ok') _gOk++; else _gBad++;
  });
  function _chref(st){ return '/customers' + (st ? '?status=' + st : '') + (search ? (st ? '&' : '?') + 'search=' + encodeURIComponent(search) : ''); }
%>
<div class="stat-band acc-customers">
  <a class="tile<%= status==='active' ? ' on' : '' %>" href="<%= _chref(status==='active' ? '' : 'active') %>">
    <div class="n good"><%= statusCounts.active||0 %></div><div class="l">active customers</div><div class="h"><%= status==='active' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= status==='lead' ? ' on' : '' %>" href="<%= _chref(status==='lead' ? '' : 'lead') %>">
    <div class="n info"><%= statusCounts.lead||0 %></div><div class="l">leads</div><div class="h"><%= status==='lead' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <a class="tile acc-plain<%= status==='inactive' ? ' on' : '' %>" href="<%= _chref(status==='inactive' ? '' : 'inactive') %>">
    <div class="n"><%= statusCounts.inactive||0 %></div><div class="l">inactive</div><div class="h"><%= status==='inactive' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <span class="tile" title="Tenants with full Graph access, of those with a tenant recorded (rows shown)">
    <div class="n <%= _gBad ? 'warn' : 'good' %>"><%= _gOk %><small> of <%= _gOk + _gBad %></small></div><div class="l">graph connected</div></span>
  <a class="tile acc-warn" href="/customers/data-missing" title="Customers missing a default domain, address, phone or key contact">
    <div class="n">&#9998;</div><div class="l">data missing sheet</div><div class="h">open the sheet</div></a>
</div>

<div class="tabs" style="margin-bottom:16px;">
  <a class="tab-btn <%= status === '' ? 'active' : '' %>" href="/customers<%= search ? '?search=' + encodeURIComponent(search) : '' %>">All <span class="muted">(<%= (statusCounts.active||0)+(statusCounts.lead||0)+(statusCounts.inactive||0) %>)</span></a>
  <a class="tab-btn <%= status === 'active' ? 'active' : '' %>" href="/customers?status=active<%= search ? '&search=' + encodeURIComponent(search) : '' %>">Active <span class="muted">(<%= statusCounts.active || 0 %>)</span></a>
  <a class="tab-btn <%= status === 'lead' ? 'active' : '' %>" href="/customers?status=lead<%= search ? '&search=' + encodeURIComponent(search) : '' %>">Leads <span class="muted">(<%= statusCounts.lead || 0 %>)</span></a>
  <a class="tab-btn <%= status === 'inactive' ? 'active' : '' %>" href="/customers?status=inactive<%= search ? '&search=' + encodeURIComponent(search) : '' %>">Inactive <span class="muted">(<%= statusCounts.inactive || 0 %>)</span></a>
</div>

<div class="card" style="padding:0;border-top:3px solid var(--blue-bright);">
  <div class="table-wrap">
    <table class="table table-lift">
      <thead>
        <tr>
          <th>Account</th>
          <th>Name</th>
          <th>Status</th>
          <th>Services</th>
          <th>Graph</th>
          <th>Primary contact</th>
          <th>Location</th>
          <th style="text-align:center;">Contacts</th>
          <th style="text-align:center;">Sites</th>
        </tr>
      </thead>
      <tbody>
        <% if (customers.length === 0) { %>
          <tr><td colspan="9"><div class="empty-state">No customers match.</div></td></tr>
        <% } %>
        <% customers.forEach(function (c) {
             var _re = c.status==='lead' ? 're-info' : c.status==='inactive' ? 're-dim'
                     : (c.entra_tenant_id && c.graph_status && c.graph_status !== 'ok') ? 're-warn' : ''; %>
          <tr class="<%= _re %>">
            <td class="muted"><%= c.account_number || '—' %></td>
            <td><a class="row-link" href="/customers/<%= c.id %>"><%= c.name %></a></td>
            <td>
              <% if (c.status === 'active') { %><span class="badge badge-sent">Active</span>
              <% } else if (c.status === 'lead') { %><span class="badge badge-primary">Lead</span>
              <% } else { %><span class="badge badge-inactive">Inactive</span><% } %>
            </td>
            <td>
              <% if (c.is_itsm) { %><span class="badge badge-primary" title="Support">SUP</span> <% } %>
              <% if (c.has_internet) { %><span class="badge badge-primary" title="Internet">NET</span> <% } %>
              <% if (c.has_phones) { %><span class="badge badge-primary" title="Phones">TEL</span> <% } %>
              <% if (c.has_cloud) { %><span class="badge badge-primary" title="Cloud">CLD</span> <% } %>
            </td>
            <td>
              <% if (!c.entra_tenant_id) { %><span class="muted" style="opacity:.45;" title="No Entra tenant ID recorded — set it in the customer's user-sync settings">—</span>
              <% } else if (c.graph_status === 'ok') { %><span class="badge badge-sent" title="Graph fully granted — Intune & Secure Score data flowing (checked <%= c.graph_checked_at ? new Date(c.graph_checked_at).toLocaleDateString('en-GB') : 'recently' %>)">Graph ✓</span>
              <% } else if (c.graph_status === 'partial') { %><a class="badge" style="background:var(--warn-bg, #fef3c7);color:var(--warn-fg, #b45309);text-decoration:none;" href="<%= graphConsentUrl(c.entra_tenant_id) %>" target="_blank" rel="noopener" title="App consented but the Intune permission is missing — click to re-run the grant (sign in as one of THEIR global admins)">Partial — re-grant</a>
              <% } else if (c.graph_status === 'error') { %><span class="badge badge-inactive" title="Consent check failed — will retry automatically">Check failed</span>
              <% } else { %><a class="badge badge-failed" style="text-decoration:none;" href="<%= graphConsentUrl(c.entra_tenant_id) %>" target="_blank" rel="noopener" title="Graph app not consented in this tenant — click to open the grant (sign in as one of THEIR global admins)">Grant access</a><% } %>
            </td>
            <td><%= c.primary_contact_name || '—' %></td>
            <td class="muted"><%= [c.city, c.county].filter(Boolean).join(', ') || c.postcode || '—' %></td>
            <td style="text-align:center;"><%= c.contact_count %></td>
            <td style="text-align:center;"><%= c.site_count %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
