<%- include('../partials/header', { title: 'Endpoint Security', user }) %>
<%
  function dt(x){ return x ? new Date(x).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '—'; }
  var isAdmin = user.role === 'admin';
%>

<div class="doc-hero" style="--hero-accent:linear-gradient(90deg,var(--accent),var(--violet));margin-bottom:14px;">
<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <p class="doc-kicker">Managed antivirus &middot; Bitdefender</p>
    <h1>Endpoint Security</h1>
    <p class="doc-sub">The customers who are <strong>on</strong> Bitdefender &mdash; one row each, machines one click in.
      A customer joins this list when you map them to their GravityZone company and an installation package.</p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <% if (isAdmin) { %>
      <form method="post" action="/security/sync" style="margin:0;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="back" value="/security">
        <button class="btn" type="submit" <%= configured ? '' : 'disabled' %>>&#8635; Sync from GravityZone</button>
      </form>
      <a class="btn" href="/security/mapping">Customers &amp; packages</a>
      <button class="btn btn-primary" type="button" onclick="secAdd(true)">+ Add customer</button>
    <% } %>
  </div>
</div>
<% if (lastSync) { %><p class="muted" style="font-size:12px;margin:10px 0 0;">Last synced <%= dt(lastSync) %>.</p><% } %>
</div>

<% if (notice) { %><div class="alert alert-success" style="margin-bottom:12px;"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-error" style="margin-bottom:12px;"><%= error %></div><% } %>

<% if (!configured) { %>
<div class="card" style="border-left:3px solid var(--warn-fg);margin-bottom:14px;">
  <h3 style="margin-top:0;">Not connected to GravityZone yet</h3>
  <p class="muted" style="font-size:13px;margin:0 0 10px;">Add the API key, then map customers to their GravityZone companies.</p>
  <% if (isAdmin) { %><a class="btn btn-primary" href="/security/settings">Connect it</a><% } %>
</div>
<% } %>

<%- include('_add-customer', { add: add, back: '/security', open: false }) %>

<div class="stat-band">
  <div class="tile"><span class="n" style="display:block;"><%= totals.enabled %></span><span class="l" style="display:block;">customers on Bitdefender</span></div>
  <div class="tile"><span class="n good" style="display:block;"><%= totals.protectedCount %></span><span class="l" style="display:block;">machines protected</span></div>
  <div class="tile"><span class="n info" style="display:block;"><%= totals.installing %></span><span class="l" style="display:block;">installing</span></div>
  <a class="tile <%= show === 'todo' ? 'on' : '' %>" href="?show=todo" style="text-decoration:none;">
    <span class="n <%= totals.notDeployed ? 'warn' : '' %>" style="display:block;"><%= totals.notDeployed %></span><span class="l" style="display:block;">still to deploy</span></a>
  <div class="tile"><span class="n <%= totals.failed ? 'bad' : '' %>" style="display:block;"><%= totals.failed %></span><span class="l" style="display:block;">failed</span></div>
  <a class="tile" href="/security/infections" style="text-decoration:none;">
    <span class="n <%= totals.infected ? 'bad' : '' %>" style="display:block;"><%= totals.infected %></span><span class="l" style="display:block;">infected &rsaquo;</span></a>
  <a class="tile <%= show === 'blocked' ? 'on' : '' %>" href="?show=blocked" style="text-decoration:none;">
    <span class="n <%= totals.blocked ? 'warn' : '' %>" style="display:block;"><%= totals.blocked %></span><span class="l" style="display:block;">blocked</span></a>
</div>

<% if (show) { %>
<div class="toolbar" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:14px 0;">
  <a class="btn" href="/security">Show all <%= enrolledCount %></a>
  <span class="muted" style="font-size:12px;">Showing <%= rows.length %> of <%= enrolledCount %>.</span>
</div>
<% } %>

<div class="card" style="padding:0;border-top:3px solid var(--accent);margin-top:14px;">
  <div class="table-wrap">
    <table class="table table-lift">
      <thead><tr>
        <th>Customer</th><th>GravityZone</th><th>Progress</th><th>Package</th><th></th>
      </tr></thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="5"><div class="empty-state">
            <% if (show) { %>
              Nothing in that state. <a class="row-link" href="/security">Show all <%= enrolledCount %></a>.
            <% } else { %>
              No customers on Bitdefender yet. Use <strong>Add customer</strong> above &mdash; it lists the
              companies in your GravityZone tenant so you can point one at a Portal customer.
            <% } %>
          </div></td></tr>
        <% } %>
        <% rows.forEach(function(r){
             var done = r.protectedCount;
             var total = Math.max(0, r.devices - r.noAgent);
             var pct = total ? Math.round((done / total) * 100) : 0;
        %>
        <tr class="<%= r.infected ? 're-bad' : (r.blocker ? 're-warn' : (total && done === total ? 're-ok' : '')) %>">
          <td>
            <a class="row-link" href="/security/customer/<%= r.customerId %>" style="font-weight:650;"><%= r.customerName %></a>
            <div class="muted" style="font-size:11.5px;">
              <%= r.devices %> machine<%= r.devices === 1 ? '' : 's' %><% if (r.noAgent) { %>, <%= r.noAgent %> with no agent<% } %>
            </div>
          </td>
          <td class="muted" style="font-size:12.5px;"><%= r.gzCompanyName || r.gzCompanyId %></td>
          <td style="min-width:200px;">
            <% if (r.blocker) { %>
              <span style="color:var(--warn-fg);font-weight:600;"><%= r.blocker %></span>
            <% } else if (!total) { %>
              <span class="muted">nothing to deploy to</span>
            <% } else { %>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="flex:1;height:7px;border-radius:4px;background:var(--line);overflow:hidden;min-width:90px;">
                  <div style="width:<%= pct %>%;height:100%;background:<%= pct === 100 ? 'var(--ok)' : 'var(--accent)' %>;"></div>
                </div>
                <span class="muted" style="font-size:12px;white-space:nowrap;"><%= done %>/<%= total %></span>
              </div>
              <div class="muted" style="font-size:11px;">
                <% if (r.installing) { %><%= r.installing %> installing<% } %>
                <% if (r.failed) { %><span style="color:var(--bad-fg);"> <%= r.failed %> failed</span><% } %>
                <% if (r.infected) { %><a class="row-link" style="color:var(--bad-fg);" href="/security/customer/<%= r.customerId %>?tab=infections"> <%= r.infected %> flagged</a><% } %>
              </div>
            <% } %>
          </td>
          <td class="muted" style="font-size:12.5px;">
            <%= r.packageName || '—' %>
            <% if (r.packageName && !r.packageReady) { %><div style="font-size:11px;color:var(--warn-fg);">still building</div><% } %>
          </td>
          <td style="text-align:right;">
            <a class="btn" href="/security/customer/<%= r.customerId %>" style="padding:2px 12px;font-size:12px;">Open</a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<p class="muted" style="font-size:12px;margin:12px 0 0;">
  Customers who are not on Bitdefender are deliberately not listed &mdash; there is nothing to do to them here.
  <% if (isAdmin) { %>To put one on, use <a class="row-link" href="#" onclick="secAdd(true);return false;">Add customer</a>,
  or see the whole configuration under <a class="row-link" href="/security/mapping">Customers &amp; packages</a>.<% } %>
</p>

<%- include('../partials/footer') %>
