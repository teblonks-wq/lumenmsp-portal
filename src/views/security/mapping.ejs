<%- include('../partials/header', { title: 'Bitdefender — customers & packages', user }) %>
<%
  // Which GravityZone company is already claimed by which customer. The pickers SHOW
  // these rather than dropping them: a company that vanishes from the list looks like a
  // company that does not exist, which is exactly how "Lumen MSP is not even selectable
  // from the list" happened. Greyed out and labelled with who has it is the honest answer.
  var claimed = {}, claimedBy = {}, ownCompany = {};
  add.companies.forEach(function(c){
    if (c.customerId) { claimed[c.gzId] = c.customerId; claimedBy[c.gzId] = c.customerName || ('customer #' + c.customerId); }
    if (c.ownCompany) ownCompany[c.gzId] = true;
  });
%>

<div class="doc-hero" style="--hero-accent:linear-gradient(90deg,var(--accent),var(--violet));margin-bottom:14px;">
<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/security">&larr; Endpoint Security</a></p>
    <p class="doc-kicker">Bitdefender GravityZone</p>
    <h1>Customers &amp; packages</h1>
    <p class="doc-sub">The customers who are <strong>on</strong> Bitdefender, and what each one deploys.
      Mapping a company and a package is what enables a customer &mdash; there is no separate switch,
      because the mapping already names the company and the installer, which is the whole of the decision.</p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <form method="post" action="/security/sync" style="margin:0;">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="back" value="/security/mapping">
      <button class="btn" type="submit" <%= configured ? '' : 'disabled' %>>&#8635; Sync from GravityZone</button>
    </form>
    <button class="btn btn-primary" type="button" onclick="secAdd(true)">+ Add company</button>
  </div>
</div>
</div>

<% if (notice) { %><div class="alert alert-success" style="margin-bottom:12px;"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-error" style="margin-bottom:12px;"><%= error %></div><% } %>

<% if (!configured) { %>
<div class="card" style="border-left:3px solid var(--warn-fg);margin-bottom:14px;">
  <h3 style="margin-top:0;">No API key yet</h3>
  <p class="muted" style="font-size:13px;margin:0 0 10px;">Nothing can be mapped until the Portal can read your tenant.</p>
  <a class="btn btn-primary" href="/security/settings">Add the API key</a>
</div>
<% } %>

<%- include('_add-customer', { add: add, back: '/security/mapping', open: !rows.length }) %>

<div class="card" style="padding:0;border-top:3px solid var(--accent);">
  <div class="table-wrap">
    <table class="table table-lift">
      <thead><tr>
        <th>Customer</th><th>GravityZone company</th><th>Installation package</th><th>Status</th><th></th>
      </tr></thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="5"><div class="empty-state">
            Nothing mapped yet. Use <strong>Add company</strong> above &mdash; it lists what is in your
            GravityZone tenant, and you say which Lumen customer each one is.
          </div></td></tr>
        <% } %>
        <% rows.forEach(function(r){
             var pkgs = (packagesByCompany[r.gzCompanyId] || []);
        %>
        <tr class="<%= r.enabled ? 're-ok' : 're-warn' %>">
          <td>
            <a class="row-link" href="/security/customer/<%= r.customerId %>" style="font-weight:650;"><%= r.customerName %></a>
            <div class="muted" style="font-size:11.5px;"><%= r.devices %> machine<%= r.devices === 1 ? '' : 's' %></div>
          </td>

          <td>
            <form method="post" action="/security/companies/map" style="display:flex;gap:6px;align-items:center;margin:0;">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <input type="hidden" name="customer_id" value="<%= r.customerId %>">
              <input type="hidden" name="back" value="/security/mapping">
              <select class="input" name="gz_id" style="width:auto;font-size:12.5px;" onchange="this.form.submit();">
                <option value="">&mdash; remove from Endpoint Security &mdash;</option>
                <% add.companies.forEach(function(c){
                     var takenBy = claimed[c.gzId];
                     var mine = takenBy === r.customerId;
                %>
                <option value="<%= c.gzId %>" <%= mine ? 'selected' : '' %> <%= (takenBy && !mine) ? 'disabled' : '' %>><%= c.name %><%= c.ownCompany ? ' (partner root)' : '' %><%= (takenBy && !mine) ? ' — ' + claimedBy[c.gzId] : '' %></option>
                <% }); %>
              </select>
            </form>
            <div class="muted" style="font-size:11px;">
              <% if (ownCompany[r.gzCompanyId]) { %>your own tenant &mdash; the partner root<% } else { %>a managed company in your tenant<% } %>
            </div>
          </td>

          <td>
            <form method="post" action="/security/customer/<%= r.customerId %>/package" style="display:flex;gap:6px;align-items:center;margin:0;">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <input type="hidden" name="back" value="/security/mapping">
              <select class="input" name="package_name" style="width:auto;font-size:12.5px;" onchange="this.form.submit();">
                <option value="">&mdash; not mapped &mdash;</option>
                <% pkgs.forEach(function(n){ %>
                <option value="<%= n %>" <%= r.packageName === n ? 'selected' : '' %>><%= n %></option>
                <% }); %>
              </select>
            </form>
            <% if (packageErrors[r.gzCompanyId]) { %>
              <div style="font-size:11px;color:var(--bad-fg);">
                Could not read this company's packages &mdash; <%= packageErrors[r.gzCompanyId] %>
              </div>
              <div class="muted" style="font-size:11px;">
                "a managed company is expected" means this customer is mapped to the partner root rather
                than to a managed company underneath it. Bitdefender will not serve a package list from the root.
              </div>
            <% } else if (!pkgs.length) { %>
              <div class="muted" style="font-size:11px;">none in GravityZone yet &mdash; build one under <em>Network &rarr; Packages</em></div>
            <% } else if (r.packageName && !r.packageReady) { %>
              <div style="font-size:11px;color:var(--warn-fg);">installer still building</div>
            <% } %>
          </td>

          <td style="font-size:12.5px;">
            <% if (r.enabled) { %>
              <span style="color:var(--ok);font-weight:600;">Ready to deploy</span>
            <% } else { %>
              <span style="color:var(--warn-fg);"><%= r.blocker || 'no package mapped' %></span>
            <% } %>
          </td>

          <td style="text-align:right;">
            <a class="btn" href="/security/customer/<%= r.customerId %>" style="padding:2px 12px;font-size:12px;">Open</a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<p class="muted" style="font-size:12px;margin:12px 0 0;">
  Showing the <%= rows.length %> customer<%= rows.length === 1 ? '' : 's' %> mapped to a GravityZone company.
  The other <%= unmappedCount %> are not on Bitdefender, so there is nothing to configure for them &mdash;
  put one on with <a class="row-link" href="#" onclick="secAdd(true);return false;">Add company</a>.
  <br>
  Companies appear once the Bitdefender service is added to that customer in Giacom Cloud Market and you have synced.
  Packages are the ones you built under <em>Network &rarr; Packages</em>.
  <strong>Check each package removes existing antivirus</strong>, or the old product stays put alongside Bitdefender.
</p>

<%- include('../partials/footer') %>
