<%- include('../partials/header', { title: 'Endpoint Security settings', user }) %>
<% function dt(x){ return x ? new Date(x).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'; } %>

<div class="doc-hero" style="--hero-accent:linear-gradient(90deg,var(--accent),var(--violet));margin-bottom:14px;">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/security">← Endpoint Security</a></p>
  <p class="doc-kicker">Bitdefender GravityZone</p>
  <h1>Connection &amp; scope</h1>
  <p class="doc-sub">The API key is a credential to every customer's security console. It is stored server-side, never shown back, and never belongs in a repo, a URL or a chat window.</p>
</div>

<% if (notice) { %><div class="alert alert-success" style="margin-bottom:12px;"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-error" style="margin-bottom:12px;"><%= error %></div><% } %>

<div class="card" style="margin-bottom:14px;">
  <h3 style="margin-top:0;">API key</h3>
  <p class="muted" style="font-size:13px;margin:0 0 12px;">
    In GravityZone: <strong>My Account → API keys → Add</strong>. Tick at least <strong>Companies</strong>,
    <strong>Network</strong> and <strong>Incidents</strong> (add <strong>Packages</strong> too and the deploy
    pipeline will not need a second trip). The access URL is shown beside the key.
    <% if (keyTail) { %><br>A key ending <strong>…<%= keyTail %></strong> is stored. Leave the field blank to keep it.<% } %>
  </p>
  <form method="post" action="/security/settings" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <label style="flex:2;min-width:280px;">API key
      <input class="input" type="password" name="api_key" autocomplete="off" spellcheck="false"
             placeholder="<%= keyTail ? 'leave blank to keep the stored key' : 'paste the key here' %>">
    </label>
    <label style="flex:2;min-width:280px;">Access URL
      <input class="input" type="url" name="base_url" value="<%= baseUrl %>">
    </label>
    <button class="btn btn-primary" type="submit">Save</button>
  </form>
  <form method="post" action="/security/test" style="margin-top:12px;">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <button class="btn" type="submit" <%= configured ? '' : 'disabled' %>>Test connection</button>
    <span class="muted" style="font-size:12px;margin-left:8px;">Harmless — it only reads. Shows exactly what the key can reach, and the first raw record from each service.</span>
  </form>
  <% if (lastSync) { %><p class="muted" style="font-size:12px;margin:12px 0 0;">Last sync: <%= dt(lastSync) %>.</p><% } %>
</div>

<% if (probes) { %>
<div class="card" style="margin-bottom:14px;border-left:3px solid <%= probes.some(function(p){return p.ok;}) ? 'var(--ok)' : 'var(--bad-fg)' %>;">
  <h3 style="margin-top:0;">What the key can reach</h3>
  <p class="muted" style="font-size:12.5px;margin:0 0 10px;">
    A failure here is usually a missing scope on the key, or a service this tenant does not expose — both are
    worth knowing before we build on them. The raw record is the real field names from <em>your</em> tenant.
  </p>
  <% probes.forEach(function(p){ %>
  <div style="border:1px solid var(--line);border-left:4px solid <%= p.ok ? 'var(--ok)' : 'var(--bad-fg)' %>;border-radius:9px;padding:9px 12px;margin-bottom:8px;">
    <div style="font-weight:700;font-size:13px;">
      <%= p.ok ? '✓' : '✗' %> <%= p.service %> · <%= p.method %>
    </div>
    <div class="muted" style="font-size:12.5px;margin-top:2px;"><%= p.note %></div>
    <% if (p.ok && p.sample) { %>
    <details style="margin-top:6px;">
      <summary style="cursor:pointer;font-size:12px;color:var(--muted);">raw record</summary>
      <pre style="font-size:11px;overflow:auto;max-height:280px;background:var(--surface-2,#f8fafc);padding:8px;border-radius:6px;margin:6px 0 0;"><%= JSON.stringify(p.sample, null, 2) %></pre>
    </details>
    <% } %>
  </div>
  <% }); %>
</div>
<% } %>

<%# ── What the last sync found ─────────────────────────────────────────────────────
    These used to travel back in a query string, truncated to three. The findings that
    cost money — a company on a trial, a company on a tier four times the standard — are
    exactly the ones that fell off the end. %>
<% if (typeof syncWarnings !== 'undefined' && syncWarnings && syncWarnings.length) { %>
<div class="card" style="margin-bottom:14px;border-left:3px solid var(--warn-fg);">
  <div class="card-header" style="display:flex;align-items:baseline;gap:10px;">
    <h2 style="margin:0;">What the last sync found</h2>
    <span class="muted" style="font-size:12px;"><%= syncWarnings.length %> thing<%= syncWarnings.length === 1 ? '' : 's' %> worth a look</span>
  </div>
  <ul style="margin:8px 0 0;padding-left:18px;font-size:13px;">
    <% syncWarnings.forEach(function(w){ %><li style="margin-bottom:4px;"><%= w %></li><% }); %>
  </ul>
</div>
<% } %>

<div class="card" style="margin-bottom:14px;">
  <div class="card-header" style="display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap;">
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
      <h2 style="margin:0;">GravityZone companies → Portal customers</h2>
      <span class="muted" style="font-size:12px;">an exact name match is suggested; a human confirms it</span>
    </div>
    <%# The Sync button belongs HERE as well as on the estate page. This card is empty until
        a sync has run, and sending someone to another page to make the page they are on
        useful is exactly how "still can find how to map" happens. %>
    <form method="post" action="/security/sync" style="margin:0;">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="back" value="/security/settings">
      <button class="btn <%= companies.length ? '' : 'btn-primary' %>" type="submit" <%= configured ? '' : 'disabled' %>
              title="Pull companies and endpoints from GravityZone">&#8635; Sync from GravityZone</button>
    </form>
  </div>
  <p class="muted" style="font-size:12.5px;margin:0 0 10px;">
    Mapping is deliberately not a guess: getting it wrong would show one client another client's machines.
    Confirming a mapping moves that company's endpoints with it.
  </p>
  <% if (!companies.length) { %>
    <div class="empty-state" style="text-align:left;">
      <strong>Nothing to map yet.</strong>
      <p class="muted" style="font-size:12.5px;margin:6px 0 0;">
        Testing the key only asks what it can reach &mdash; it does not pull anything down. Press
        <strong>&#8635; Sync from GravityZone</strong> above and every company in the tenant appears here
        with a customer picker beside it.
      </p>
      <% if (!configured) { %>
        <p class="muted" style="font-size:12.5px;margin:6px 0 0;">Save the API key first.</p>
      <% } %>
    </div>
  <% } else { %>
  <div class="table-wrap"><table class="table table-lift">
    <thead><tr><th>GravityZone company</th><th style="text-align:right;">Endpoints</th><th>Portal customer</th><th></th></tr></thead>
    <tbody>
      <% companies.forEach(function(c){ %>
      <tr class="<%= c.customer_id ? 're-ok' : 're-warn' %>">
        <td><%= c.name %><div class="muted" style="font-size:11px;">id <%= c.gz_id %></div></td>
        <td class="money"><%= c.endpoints %></td>
        <td colspan="2">
          <form method="post" action="/security/companies/<%= encodeURIComponent(c.gz_id) %>/map" style="display:flex;gap:8px;align-items:center;margin:0;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <select class="input" name="customer_id" style="width:auto;">
              <option value="">— not mapped —</option>
              <% customers.forEach(function(x){ %>
              <option value="<%= x.id %>" <%= Number(c.customer_id) === Number(x.id) ? 'selected' : '' %>><%= x.name %></option>
              <% }); %>
            </select>
            <button class="btn" type="submit" style="padding:3px 12px;font-size:12px;">Save</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
  <% } %>
</div>

<%# ── Licence audit ────────────────────────────────────────────────────────────────
    The tier is chosen in Giacom, not here, so this is read back rather than assumed.
    Endpoint Security is £0.99/endpoint/month; the dearer tiers run to £5.07. %>
<% if (typeof licences !== 'undefined' && licences && licences.length) {
     var costed = licences.filter(function(l){ return l.monthlyCost != null; });
     var estate = costed.reduce(function(n,l){ return n + l.monthlyCost; }, 0);
     var flagged = licences.filter(function(l){ return l.problems && l.problems.length; });
%>
<div class="card" style="margin-bottom:14px;">
  <div class="card-header" style="display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap;">
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
      <h2 style="margin:0;">Licence audit</h2>
      <span class="muted" style="font-size:12px;">what each company is actually licensed as &mdash; the tier is set in Giacom, so this is read back, never assumed</span>
    </div>
    <span class="muted" style="font-size:12.5px;">
      <strong>£<%= estate.toFixed(2) %></strong>/month across <%= costed.length %> compan<%= costed.length === 1 ? 'y' : 'ies' %>
      <% if (costed.length !== licences.length) { %><span style="color:var(--warn-fg);"> (<%= licences.length - costed.length %> not priced)</span><% } %>
    </span>
  </div>
  <div class="table-wrap"><table class="table table-lift">
    <thead><tr>
      <th>Company</th><th>Portal customer</th><th>Subscription</th><th>Tier</th>
      <th style="text-align:right;">Seats used</th><th style="text-align:right;">£/endpoint</th><th style="text-align:right;">£/month</th>
    </tr></thead>
    <tbody>
      <% licences.forEach(function(l){ %>
      <tr class="<%= l.problems && l.problems.length ? 're-warn' : 're-ok' %>">
        <td><%= l.name %>
          <% if (l.problems && l.problems.length) { %>
            <% l.problems.forEach(function(p){ %><div class="muted" style="font-size:11.5px;color:var(--warn-fg);"><%= p %></div><% }); %>
          <% } %>
        </td>
        <td class="muted"><% if (l.customerName) { %><%= l.customerName %><% } else { %><span style="color:var(--warn-fg);">not mapped</span><% } %></td>
        <td class="muted" style="font-size:12.5px;"><%= l.subscriptionLabel %></td>
        <td class="muted" style="font-size:12.5px;"><%= l.protectionModel || '—' %></td>
        <td class="money"><%= l.usedSlots == null ? '—' : l.usedSlots %></td>
        <td class="money"><%= l.costPerEndpoint == null ? '—' : '£' + l.costPerEndpoint.toFixed(2) %></td>
        <td class="money"><%= l.monthlyCost == null ? '—' : '£' + l.monthlyCost.toFixed(2) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
  <p class="muted" style="font-size:12px;margin:10px 0 0;">
    Endpoint Security is the standard tier at £0.99 per endpoint per month; the bundled tiers run to £5.07.
    Sold to the public at £3.00, and included free inside some support packages &mdash; so where a company is
    included, the figure above is what that contract absorbs.
    <% if (flagged.length) { %><strong style="color:var(--warn-fg);"><%= flagged.length %> compan<%= flagged.length === 1 ? 'y needs' : 'ies need' %> a look.</strong><% } %>
  </p>
</div>
<% } %>

<div class="card">
  <div class="card-header" style="display:flex;align-items:baseline;gap:10px;">
    <h2 style="margin:0;">Who is in scope</h2>
    <span class="muted" style="font-size:12px;">antivirus is included with Managed IT, so those customers are in by default</span>
  </div>
  <div class="table-wrap"><table class="table table-lift">
    <thead><tr><th>Customer</th><th>In scope</th><th>Why</th><th></th></tr></thead>
    <tbody>
      <% scope.forEach(function(sc){ %>
      <tr class="<%= sc.inScope ? 're-ok' : 're-dim' %>">
        <td><a class="row-link" href="/security/assessment/<%= sc.id %>"><%= sc.name %></a></td>
        <td style="font-weight:700;color:<%= sc.inScope ? 'var(--ok)' : 'var(--muted)' %>;"><%= sc.inScope ? 'Yes' : 'No' %></td>
        <td class="muted" style="font-size:12.5px;"><%= sc.reason %></td>
        <td>
          <form method="post" action="/security/scope/<%= sc.id %>" style="display:flex;gap:6px;margin:0;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="back" value="/security/settings">
            <button class="btn" name="in_scope" value="<%= sc.inScope ? 'off' : 'on' %>" type="submit" style="padding:2px 10px;font-size:12px;">
              <%= sc.inScope ? 'Take out of scope' : 'Put in scope' %>
            </button>
            <% if (sc.reason.indexOf('by hand') > -1) { %>
            <button class="btn" name="in_scope" value="auto" type="submit" style="padding:2px 10px;font-size:12px;" title="Go back to following their contract">Follow contract</button>
            <% } %>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<%- include('../partials/footer') %>
