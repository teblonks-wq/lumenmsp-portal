<%- include('../partials/header', { title: 'Endpoint Security', user }) %>
<%
  function ago(ep){
    if (!ep) return '—';
    var s = Math.floor(Date.now()/1000) - Number(ep);
    if (s < 120) return 'just now';
    if (s < 5400) return Math.round(s/60) + ' min ago';
    if (s < 172800) return Math.round(s/3600) + ' h ago';
    return Math.round(s/86400) + ' days ago';
  }
  function dt(x){ return x ? new Date(x).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'; }
  var CAT = {
    clean:       { label: 'Defender only',  cls: 're-ok'   },
    auto_remove: { label: 'Auto-removable', cls: 're-info' },
    manual:      { label: 'Manual removal', cls: 're-warn' },
    unknown:     { label: 'No agent data',  cls: 're-dim'  },
  };
  var ST = {
    protected: { label: 'Protected',   cls: 're-ok',   colour: 'var(--ok)' },
    infected:  { label: 'Infected',    cls: 're-bad',  colour: 'var(--bad-fg)' },
    outdated:  { label: 'Out of date', cls: 're-warn', colour: 'var(--warn-fg)' },
    todo:      { label: 'To deploy',   cls: 're-info', colour: 'var(--blue-bright, #2563eb)' },
    unknown:   { label: 'Unknown',     cls: 're-dim',  colour: 'var(--muted)' },
  };
  var isAdmin = user.role === 'admin';
%>

<div class="doc-hero" style="--hero-accent:linear-gradient(90deg,var(--accent),var(--violet));margin-bottom:14px;">
<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <p class="doc-kicker">Managed antivirus · Bitdefender</p>
    <h1>Endpoint Security</h1>
    <p class="doc-sub">Antivirus ships free with the Managed IT package, so scope follows the contract — enable a customer once and every machine of theirs is picked up from then on. Two sources side by side: what our agent says is protecting each machine today, and what GravityZone says about it.</p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <% if (isAdmin) { %>
      <form method="post" action="/security/sync" style="display:inline;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="back" value="/security">
        <button class="btn btn-primary" type="submit" <%= configured ? '' : 'disabled' %> title="Pull companies, endpoints and detections from GravityZone">&#8635; Sync from GravityZone</button>
      </form>
      <a class="btn" href="/security/settings">Settings</a>
    <% } %>
  </div>
</div>
<% if (lastSync) { %><p class="muted" style="font-size:12px;margin:10px 0 0;">Last synced <%= dt(lastSync) %>.</p><% } %>
</div>

<% if (notice) { %><div class="alert alert-success" style="margin-bottom:12px;"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-error" style="margin-bottom:12px;"><%= error %></div><% } %>

<% if (!configured) { %>
<div class="card" style="border-left:3px solid var(--warn-fg);margin-bottom:14px;">
  <h3 style="margin-top:0;">Not connected to GravityZone yet</h3>
  <p class="muted" style="font-size:13px;margin:0 0 10px;">
    The device figures below still work — they come from our own agent, which already reports what is protecting every
    machine. Bitdefender's side of the picture needs an API key from the GravityZone Control Center
    (My Account → API keys, with Companies, Network and Incidents access).
  </p>
  <% if (isAdmin) { %><a class="btn btn-primary" href="/security/settings">Add the API key</a>
  <% } else { %><p class="muted" style="font-size:12.5px;margin:0;">Ask an admin to add it.</p><% } %>
</div>
<% } %>

<div class="stat-band">
  <a class="tile <%= state==='protected' ? 'on' : '' %>" href="?state=protected<%= customerId ? '&customer='+customerId : '' %>" style="text-decoration:none;">
    <span class="n good" style="display:block;"><%= stats.protected %></span><span class="l" style="display:block;">protected by Bitdefender</span></a>
  <a class="tile <%= state==='infected' ? 'on' : '' %>" href="?state=infected<%= customerId ? '&customer='+customerId : '' %>" style="text-decoration:none;">
    <span class="n <%= stats.infected ? 'bad' : '' %>" style="display:block;"><%= stats.infected %></span><span class="l" style="display:block;">infected right now</span></a>
  <a class="tile <%= state==='outdated' ? 'on' : '' %>" href="?state=outdated<%= customerId ? '&customer='+customerId : '' %>" style="text-decoration:none;">
    <span class="n <%= stats.outdated ? 'warn' : '' %>" style="display:block;"><%= stats.outdated %></span><span class="l" style="display:block;">agent out of date</span></a>
  <a class="tile <%= state==='todo' ? 'on' : '' %>" href="?state=todo<%= customerId ? '&customer='+customerId : '' %>" style="text-decoration:none;">
    <span class="n info" style="display:block;"><%= stats.todo %></span><span class="l" style="display:block;">in scope, still to deploy</span></a>
  <a class="tile acc-plain <%= state==='unknown' ? 'on' : '' %>" href="?state=unknown<%= customerId ? '&customer='+customerId : '' %>" style="text-decoration:none;">
    <span class="n" style="display:block;"><%= stats.unknown %></span><span class="l" style="display:block;">no agent data yet</span></a>
</div>

<div class="toolbar" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:14px 0;">
  <form method="get" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0;">
    <% if (state) { %><input type="hidden" name="state" value="<%= state %>"><% } %>
    <select class="input" name="customer" style="width:auto;" onchange="this.form.submit();">
      <option value="">Every customer</option>
      <% customers.forEach(function(c){ %>
      <option value="<%= c.id %>" <%= customerId === c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }); %>
    </select>
  </form>
  <% if (state || customerId) { %><a class="btn" href="/security">Clear filters</a><% } %>
  <span class="muted" style="font-size:12px;">Showing <%= devices.length %> of <%= allCount %> devices.</span>
  <% if (customerId) { %>
    <a class="btn" href="/security/assessment/<%= customerId %>">Migration assessment for this customer &rarr;</a>
  <% } %>
</div>

<div class="card" style="padding:0;border-top:3px solid var(--accent);">
  <div class="table-wrap">
    <table class="table table-lift">
      <thead><tr>
        <th>Device</th><th>Customer</th><th>Protecting it today</th><th>Bitdefender</th><th>Last seen</th>
      </tr></thead>
      <tbody>
        <% if (!devices.length) { %>
          <tr><td colspan="5"><div class="empty-state">No devices match that filter.</div></td></tr>
        <% } %>
        <% devices.forEach(function(d){ var st = ST[d.state] || ST.unknown; %>
        <tr class="<%= st.cls %>">
          <td>
            <a class="row-link" href="/assets/<%= d.assetId %>"><%= d.hostname %></a>
            <% if (d.deviceType) { %><div class="muted" style="font-size:11.5px;"><%= d.deviceType %></div><% } %>
          </td>
          <td class="muted">
            <%= d.customerName || '—' %>
            <% if (d.customerName && !d.inScope) { %><div style="font-size:11px;color:var(--muted);">not in scope</div><% } %>
          </td>
          <td>
            <%= d.currentAv || '—' %>
            <% if (d.state === 'todo' && CAT[d.migrationCategory]) { %>
              <div class="muted" style="font-size:11.5px;"><%= CAT[d.migrationCategory].label %></div>
            <% } %>
          </td>
          <td>
            <span style="display:inline-flex;align-items:center;gap:6px;font-weight:600;color:<%- st.colour %>;">
              <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:<%- st.colour %>;"></span>
              <%= st.label %>
            </span>
            <% if (d.policyName) { %><div class="muted" style="font-size:11.5px;">policy: <%= d.policyName %></div><% } %>
            <% if (d.modulesOn) { %><div class="muted" style="font-size:11px;"><%= d.modulesOn %></div><% } %>
          </td>
          <td class="muted" style="font-size:12px;">
            <% if (d.gzId) { %>GravityZone <%= ago(d.gzSeen) %><br><% } %>
            <span style="font-size:11.5px;">our agent <%= ago(d.agentSeen) %></span>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (unmatched && unmatched.length) { %>
<details class="card" style="margin-top:14px;">
  <summary style="cursor:pointer;font-weight:700;">In GravityZone but not matched to one of our devices (<%= unmatched.length %>)</summary>
  <p class="muted" style="font-size:12.5px;margin:10px 0;">
    Either the hostname differs between the two systems, or the machine is not in our asset register at all —
    which is worth knowing on its own.
  </p>
  <div class="table-wrap"><table class="table table-lift">
    <thead><tr><th>Endpoint</th><th>GravityZone company</th><th>OS</th><th>Policy</th><th>Last seen</th></tr></thead>
    <tbody>
      <% unmatched.forEach(function(u){ %>
      <tr><td><%= u.name %></td><td class="muted"><%= u.company_name || '—' %></td>
        <td class="muted"><%= u.os_name || '—' %></td><td class="muted"><%= u.policy_name || '—' %></td>
        <td class="muted"><%= ago(u.gz_seen) %></td></tr>
      <% }); %>
    </tbody>
  </table></div>
</details>
<% } %>

<% if (seats && seats.length) { %>
<div class="card" style="margin-top:14px;">
  <div class="card-header" style="display:flex;align-items:baseline;gap:10px;">
    <h2 style="margin:0;">Licence headroom</h2>
    <span class="muted" style="font-size:12px;">we give this away with Managed IT, so the number that matters is what is left</span>
  </div>
  <div class="table-wrap"><table class="table table-lift">
    <thead><tr><th>GravityZone company</th><th>Portal customer</th>
      <th style="text-align:right;">Endpoints</th><th style="text-align:right;">Seats used</th><th style="text-align:right;">Seats total</th></tr></thead>
    <tbody>
      <% seats.forEach(function(s){ var over = s.license_total && Number(s.license_used) > Number(s.license_total); %>
      <tr class="<%= over ? 're-bad' : '' %>">
        <td><%= s.name %></td>
        <td class="muted"><% if (s.customer_name) { %><%= s.customer_name %><% } else { %><span style="color:var(--warn-fg);">not mapped</span><% } %></td>
        <td class="money"><%= s.endpoints %></td>
        <td class="money"><%= s.license_used == null ? '—' : s.license_used %></td>
        <td class="money"><%= s.license_total == null ? '—' : s.license_total %></td>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
<% } %>

<%- include('../partials/footer') %>
