<%- include('../partials/header', { title: 'Quotes', user }) %>
<% function money(v){ return '£' + (Number(v)||0).toFixed(2); } %>
<% function badge(s){ return s==='invoiced'?'badge-active':s==='accepted'?'badge-sent':s==='sent'?'badge-primary':s==='lost'?'badge-failed':'badge-inactive'; } %>

<style>
  /* The bar only appears once something is ticked — an always-visible row of destructive
     buttons is an invitation to press one by accident. */
  #bulkBar { display:none; align-items:center; gap:8px; flex-wrap:wrap;
             background:var(--tint-accent); border:1px solid var(--info-line);
             border-radius:10px; padding:10px 14px; margin:0 0 12px; }
  #bulkBar.on { display:flex; }
  #bulkBar .n { font-weight:600; }
  td.tick, th.tick { width:34px; text-align:center; }
</style>

<div class="page-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div><h1>Quotes</h1><p class="muted"><%= quotes.length %> shown</p></div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <form method="get" action="/quotes" style="display:flex;gap:8px;align-items:center;">
      <input class="input" type="search" name="search" value="<%= search %>" placeholder="Search number, title, customer…" style="min-width:240px;">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
      <button class="btn" type="submit">Search</button>
      <% if (search) { %><a class="btn" href="/quotes<%= status ? '?status=' + status : '' %>">Clear</a><% } %>
    </form>
    <a class="btn btn-primary" href="/quotes/new">+ New quote</a>
  </div>
</div>

<% if (typeof msg !== 'undefined' && msg) { %><div class="alert alert-success"><%= msg %></div><% } %>

<%
  var _pipe = 0, _won = 0, _openN = 0;
  quotes.forEach(function (q) {
    var t = Number(q.total) || 0;
    if (q.status === 'sent') { _pipe += t; _openN++; }
    else if (q.status === 'draft') { _openN++; }
    else if (q.status === 'accepted' || q.status === 'invoiced') { _won += t; }
  });
  function _qhref(st){ return '/quotes' + (st ? '?status=' + st : '') + (search ? (st ? '&' : '?') + 'search=' + encodeURIComponent(search) : ''); }
%>
<div class="stat-band acc-quotes">
  <a class="tile" href="<%= _qhref('') %>" title="Everything shown">
    <div class="n violet">&pound;<%= (Number(_pipe)||0).toLocaleString('en-GB', {maximumFractionDigits:0}) %></div><div class="l">pipeline · sent</div><div class="h">show all</div></a>
  <a class="tile acc-invoices" href="<%= _qhref('accepted') %>" title="Accepted or invoiced, in the rows shown">
    <div class="n good">&pound;<%= (Number(_won)||0).toLocaleString('en-GB', {maximumFractionDigits:0}) %></div><div class="l">won value</div><div class="h">show accepted</div></a>
  <a class="tile acc-plain<%= status==='draft' ? ' on' : '' %>" href="<%= _qhref(status==='draft' ? '' : 'draft') %>">
    <div class="n"><%= statusCounts.draft||0 %></div><div class="l">draft</div><div class="h"><%= status==='draft' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= status==='sent' ? ' on' : '' %>" href="<%= _qhref(status==='sent' ? '' : 'sent') %>">
    <div class="n info"><%= statusCounts.sent||0 %></div><div class="l">sent</div><div class="h"><%= status==='sent' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <a class="tile<%= status==='accepted' ? ' on' : '' %>" href="<%= _qhref(status==='accepted' ? '' : 'accepted') %>">
    <div class="n good"><%= statusCounts.accepted||0 %></div><div class="l">accepted</div><div class="h"><%= status==='accepted' ? 'filtering — click to clear' : 'click to filter' %></div></a>
  <a class="tile acc-bad<%= status==='lost' ? ' on' : '' %>" href="<%= _qhref(status==='lost' ? '' : 'lost') %>">
    <div class="n"><%= statusCounts.lost||0 %></div><div class="l">lost</div><div class="h"><%= status==='lost' ? 'filtering — click to clear' : 'click to filter' %></div></a>
</div>

<div class="tabs" style="margin-bottom:16px;">
  <a class="tab-btn <%= status==='' ? 'active' : '' %>" href="/quotes">All</a>
  <% ['draft','sent','accepted','invoiced','lost'].forEach(function(s){ %>
    <a class="tab-btn <%= status===s ? 'active' : '' %>" href="/quotes?status=<%= s %>"><%= s.charAt(0).toUpperCase()+s.slice(1) %> <span class="muted">(<%= statusCounts[s]||0 %>)</span></a>
  <% }); %>
</div>

<form method="post" action="/quotes/bulk" id="bulkForm">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

<div id="bulkBar">
  <span class="n"><span id="bulkCount">0</span> selected</span>
  <button class="btn btn-primary" type="submit" name="bulk_action" value="invoice"
    onclick="return confirm('Create an invoice from each selected quote?\n\nEach one is a draft dated today — nothing is emailed, sent to QuickBooks or put in for Direct Debit until you press Complete in Invoices.');">
    Convert to invoice
  </button>
  <button class="btn" type="submit" name="bulk_action" value="lost"
    onclick="return confirm('Mark the selected quotes as lost?');">Mark as lost</button>
  <button class="btn" type="submit" name="bulk_action" value="delete" style="color:var(--lumen-dark);"
    onclick="return confirm('Move the selected quotes to the recycle bin?');">Delete</button>
  <a class="btn" href="#" onclick="bulkClear();return false;" style="margin-left:auto;">Clear</a>
</div>

<div class="card" style="padding:0;border-top:3px solid var(--violet);">
  <div class="table-wrap">
    <table class="table table-lift">
      <thead>
        <tr>
          <th class="tick"><input type="checkbox" id="tickAll" onclick="bulkAll(this.checked)" title="Select all"></th>
          <th>Number</th><th>Title</th><th>Customer</th><th>Status</th>
          <th style="text-align:right;">Total</th><th>Invoice</th><th>Issued</th><th>Valid until</th>
        </tr>
      </thead>
      <tbody>
        <% if (quotes.length===0) { %><tr><td colspan="9"><div class="empty-state">No quotes.</div></td></tr><% } %>
        <% quotes.forEach(function(q){
             var _re = (q.status==='accepted'||q.status==='invoiced') ? 're-ok'
                     : q.status==='sent' ? 're-info' : q.status==='lost' ? 're-dim' : ''; %>
          <tr class="<%= _re %>">
            <td class="tick"><input type="checkbox" class="tick-one" name="ids" value="<%= q.id %>" onclick="bulkSync()"></td>
            <td><a class="row-link" href="/quotes/<%= q.id %>"><%= q.quote_number %></a></td>
            <td><%= q.title %></td>
            <td class="muted"><% if (q.customer_id) { %><a class="row-link" href="/customers/<%= q.customer_id %>"><%= q.customer_name %></a><% } else { %>—<% } %></td>
            <td><span class="badge <%= badge(q.status) %>"><%= q.status.charAt(0).toUpperCase()+q.status.slice(1) %></span></td>
            <td class="money"><%= money(q.total) %></td>
            <td>
              <% if (q.invoice_id) { %>
                <a class="row-link" href="/invoices/<%= q.invoice_id %>"><%= q.invoice_number || 'draft' %></a>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
            <td class="muted"><%= q.issue_date ? new Date(q.issue_date).toLocaleDateString('en-GB') : '—' %></td>
            <td class="muted"><%= q.valid_until ? new Date(q.valid_until).toLocaleDateString('en-GB') : '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
</form>

<p class="muted" style="margin:14px 0 0;font-size:12px;">
  Converting sets the quote to Invoiced and creates a draft invoice dated today, for both issue and due.
  A quote that already has an invoice is skipped rather than billed twice.
</p>

<script>
function bulkTicks() { return Array.prototype.slice.call(document.querySelectorAll('.tick-one')); }
function bulkSync() {
  var on = bulkTicks().filter(function (t) { return t.checked; }).length;
  document.getElementById('bulkCount').textContent = on;
  document.getElementById('bulkBar').classList.toggle('on', on > 0);
  var all = document.getElementById('tickAll');
  all.checked = on > 0 && on === bulkTicks().length;
  all.indeterminate = on > 0 && on < bulkTicks().length;
}
function bulkAll(on) { bulkTicks().forEach(function (t) { t.checked = on; }); bulkSync(); }
function bulkClear() { bulkAll(false); }
bulkSync();
</script>

<%- include('../partials/footer') %>
