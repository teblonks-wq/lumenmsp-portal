<%- include('../partials/header', { title: quote.quote_number, user }) %>
<% function money(v){ return '£' + (Number(v)||0).toFixed(2); } %>
<% function badge(s){ return s==='invoiced'?'badge-active':s==='accepted'?'badge-sent':s==='sent'?'badge-primary':s==='lost'?'badge-failed':'badge-inactive'; } %>
<% function dt(x){ return x ? new Date(x).toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'; } %>
<% function mcol(p){ return p>=20 ? 'var(--ok-fg)' : p>0 ? 'var(--warn-fg)' : 'var(--bad-fg)'; } %>

<div class="doc-hero" style="--hero-accent:linear-gradient(90deg,var(--violet),var(--accent));">
<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <% var _back = (typeof back !== 'undefined' && back) ? back : null; %>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="<%= _back || '/quotes' %>">← <%= _back ? (_back.indexOf('/customers/') === 0 ? 'Back to customer' : 'Back') : 'Quotes' %></a></p>
    <p class="doc-kicker">Quote</p>
    <h1><%= quote.quote_number %> <span class="badge <%= badge(quote.status) %>"><%= quote.status.charAt(0).toUpperCase()+quote.status.slice(1) %></span></h1>
    <p class="doc-sub"><%= quote.title %><% if (quote.customer_name) { %> · <a class="row-link" href="/customers/<%= quote.customer_id %>"><%= quote.customer_name %></a><% } %><% if (quote.ticket_number) { %> · <a class="row-link" href="/tickets/<%= quote.inbox_ticket_id %>">Case <%= quote.ticket_number %></a><% } %></p>
  </div>
  <div style="display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;">
    <a class="btn" href="/quotes/<%= quote.id %>/edit">Edit</a>
    <a class="btn" href="/quotes/<%= quote.id %>/pdf" target="_blank">Preview PDF</a>
    <a class="btn" href="/quotes/<%= quote.id %>/pdf?dl=1">Download</a>
    <% var _inv = (typeof invoices !== 'undefined' ? invoices : []); %>
    <% if (_inv.length) { %>
      <a class="btn btn-primary" href="/invoices/<%= _inv[0].id %>">Go to invoice <%= _inv[0].invoice_number || '' %></a>
    <% } else { %>
      <a class="btn btn-primary" href="/invoices/new?quote=<%= quote.id %>">Create invoice</a>
    <% } %>
    <form method="post" action="/quotes/<%= quote.id %>/status" style="margin:0;display:flex;gap:6px;align-items:center;">
      <select class="input" name="status"><% if (quote.status==='invoiced') { %><option value="invoiced" selected>Invoiced</option><% } %><% ['draft','sent','accepted','lost'].forEach(function(s){ %><option value="<%= s %>" <%= quote.status===s?'selected':'' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% }); %></select>
      <button class="btn" type="submit">Set status</button>
    </form>
    <form method="post" action="/quotes/<%= quote.id %>/duplicate" style="margin:0;display:flex;gap:6px;align-items:center;">
      <select class="input" name="customer_id" title="Copy this quote to which customer?">
        <% (typeof customers !== 'undefined' ? customers : []).forEach(function(c){ %>
          <option value="<%= c.id %>" <%= quote.customer_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
      <button class="btn" type="submit">Duplicate</button>
    </form>
    <form method="post" action="/quotes/<%= quote.id %>/delete" onsubmit="return confirm('Move this quote to the recycle bin?');" style="margin:0;"><button class="btn" type="submit" style="color:var(--lumen-dark);">Delete</button></form>
  </div>
</div>
<%
  // Margin, judged the same way the profit table below judges it - one definition.
  var _hb=0, _hs=0;
  items.forEach(function(it){ var q=Number(it.quantity)||0; _hb+=(Number(it.buy_price)||0)*q; _hs+=(Number(it.unit_price)||0)*q; });
  var _hm=_hs-_hb, _hp=_hs>0?(_hm/_hs*100):0;
%>
<div class="doc-stats">
  <div class="ds"><div class="n tabnum"><%= money(quote.total) %></div><div class="l">Total inc. VAT</div></div>
  <div class="ds"><div class="n <%= _hm>=0 ? (_hp>=20 ? 'good' : 'warn') : 'bad' %>"><%= _hp.toFixed(1) %>%<% if (_hs) { %> <small style="font-size:12px;font-weight:600;color:var(--muted);"><%= money(_hm) %></small><% } %></div><div class="l">Margin — internal</div></div>
  <div class="ds"><div class="n"><%= quote.issue_date ? new Date(quote.issue_date).toLocaleDateString('en-GB') : '—' %></div><div class="l">Issued</div></div>
  <% var _exp = quote.valid_until && new Date(quote.valid_until) < new Date() && quote.status==='sent'; %>
  <div class="ds"><div class="n <%= _exp ? 'bad' : '' %>"><%= quote.valid_until ? new Date(quote.valid_until).toLocaleDateString('en-GB') : '—' %></div><div class="l"><%= _exp ? 'Valid until — expired' : 'Valid until' %></div></div>
  <% if (quote.accept_token) { %><div class="ds"><div class="n info"><%= quote.view_count||0 %></div><div class="l">Customer views</div></div><% } %>
</div>
</div>

<% if ((typeof invoices !== 'undefined' ? invoices : []).length) { %>
<div class="alert" style="background:var(--tint-teal);border:1px solid var(--ok-line);">
  <strong>Invoiced.</strong>
  <% invoices.forEach(function (iv, ix) { %><%= ix ? ' · ' : ' ' %><a class="row-link" href="/invoices/<%= iv.id %>"><%= iv.invoice_number || ('draft #' + iv.id) %></a>
    <span class="muted"><%= money(iv.total) %> · <%= iv.status %><%= iv.payment_status && iv.payment_status !== 'unpaid' ? ' · ' + iv.payment_status : '' %><%= iv.issue_date ? ' · ' + new Date(iv.issue_date).toLocaleDateString('en-GB') : '' %></span><% }); %>
</div>
<% } %>

<% if (quote.accept_token) { %>
<div class="alert" style="background:var(--tint-teal);border:1px solid var(--ok-line);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;">
  <span>Customer link: <a class="row-link" href="/q/<%= quote.accept_token %>" target="_blank">/q/<%= quote.accept_token %></a></span>
  <span class="muted">Viewed <%= quote.view_count %> time(s)</span>
</div>
<% } %>

<div class="card" style="padding:0;">
  <div class="card-header" style="padding:20px 24px 0;"><h2>Line items</h2></div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Description</th><th style="text-align:right;">Qty</th><th style="text-align:right;">Unit</th><th style="text-align:right;">VAT %</th><th style="text-align:right;">Line total</th></tr></thead>
      <tbody>
        <% if (items.length===0) { %><tr><td colspan="5"><div class="empty-state">No line items.</div></td></tr><% } %>
        <% items.forEach(function(it){ %>
          <tr><td><%= it.description %></td><td style="text-align:right;"><%= Number(it.quantity) %></td><td style="text-align:right;"><%= money(it.unit_price) %></td><td style="text-align:right;"><%= Number(it.tax_rate) %></td><td style="text-align:right;"><%= money(it.line_total) %></td></tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr><td colspan="4" style="text-align:right;" class="muted">Subtotal</td><td style="text-align:right;"><%= money(quote.subtotal) %></td></tr>
        <tr><td colspan="4" style="text-align:right;" class="muted">VAT</td><td style="text-align:right;"><%= money(quote.tax_total) %></td></tr>
        <tr><td colspan="4" style="text-align:right;font-weight:700;">Total</td><td style="text-align:right;font-weight:700;"><%= money(quote.total) %></td></tr>
      </tfoot>
    </table>
  </div>
</div>

<!-- Profit analysis (internal) -->
<% var tBuy=0, tSell=0; %>
<div class="card" style="padding:0;border-top:3px solid var(--accent);">
  <div class="card-header" style="padding:20px 24px 0;"><h2>Profit analysis <span class="badge" style="background:var(--warn-bg);color:var(--warn-deep);">INTERNAL — not visible to customers</span></h2></div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Description</th><th>Supplier</th><th style="text-align:right;">Buy</th><th style="text-align:right;">Sell</th><th style="text-align:right;">Qty</th><th style="text-align:right;">Margin £</th><th style="text-align:right;">Margin %</th></tr></thead>
      <tbody>
        <% items.forEach(function(it){ var q=Number(it.quantity)||0, buy=(Number(it.buy_price)||0)*q, sell=(Number(it.unit_price)||0)*q, mg=sell-buy, mp=sell>0?(mg/sell*100):0; tBuy+=buy; tSell+=sell; %>
          <tr>
            <td><%= it.description %></td>
            <td class="muted"><%= it.supplier_name || '—' %></td>
            <td style="text-align:right;"><%= money(buy) %></td>
            <td style="text-align:right;"><%= money(sell) %></td>
            <td style="text-align:right;"><%= q %></td>
            <td style="text-align:right;color:<%= mg>=0?'var(--ok-fg)':'var(--bad-fg)' %>;"><%= money(mg) %></td>
            <td style="text-align:right;color:<%= mcol(mp) %>;"><%= mp.toFixed(1) %>%</td>
          </tr>
        <% }); %>
      </tbody>
      <% var tMg=tSell-tBuy, tMp=tSell>0?(tMg/tSell*100):0; %>
      <tfoot>
        <tr style="background:var(--tint-yellow);font-weight:700;">
          <td>Totals</td><td></td>
          <td style="text-align:right;"><%= money(tBuy) %></td>
          <td style="text-align:right;"><%= money(tSell) %></td>
          <td></td>
          <td style="text-align:right;color:<%= tMg>=0?'var(--ok-fg)':'var(--bad-fg)' %>;"><%= money(tMg) %></td>
          <td style="text-align:right;color:<%= mcol(tMp) %>;"><%= tMp.toFixed(1) %>%</td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<div class="card-grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));align-items:start;">
  <div class="card">
    <div class="card-header"><h2>Activity</h2></div>
    <div style="margin-bottom:14px;"><div style="font-weight:600;">Created</div><div class="muted" style="font-size:13px;"><%= quote.created_by_name || '—' %> · <%= dt(quote.created_at) %></div></div>
    <div><div style="font-weight:600;">Updated</div><div class="muted" style="font-size:13px;"><%= dt(quote.updated_at) %></div></div>
    <% if (quote.status==='accepted' && quote.accepted_by_name) { %>
    <div style="margin-top:14px;"><div style="font-weight:600;color:var(--ok-fg);">Accepted</div><div class="muted" style="font-size:13px;"><%= quote.accepted_by_name %><% if (quote.accepted_at) { %> · <%= dt(quote.accepted_at) %><% } %><% if (quote.approve_note) { %><br>"<%= quote.approve_note %>"<% } %></div></div>
    <% } %>
  </div>
</div>

<% if (quote.notes || quote.terms) { %>
<div class="card-grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));align-items:start;">
  <% if (quote.notes) { %><div class="card"><div class="card-header"><h2>Notes</h2></div><p style="white-space:pre-wrap;margin:0;"><%= quote.notes %></p></div><% } %>
  <% if (quote.terms) { %><div class="card"><div class="card-header"><h2>Terms</h2></div><p style="white-space:pre-wrap;margin:0;"><%= quote.terms %></p></div><% } %>
</div>
<% } %>

<%- include('../partials/comms', { entityType: 'quote', entityId: quote.id, comms: comms, toEmail: commsTo, toContacts: contacts, commsSubject: quote.quote_number + ' — ' + quote.title, sendQuote: true, quoteStatus: quote.status }) %>

<%- include('../partials/doc-activity', { events: (typeof events !== 'undefined' && events) ? events : [] }) %>

<%- include('../partials/footer') %>
