<%- include('../partials/header', { title: 'Helpdesk review — ' + (ticket.ticket_number || ('#' + ticket.id)), user }) %>
<% function cap(s){ return s ? String(s).replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}) : ''; }
   function sbadge(s){ return s==='resolved'?'badge-sent':(s==='closed'?'badge-inactive':(s && s.indexOf('awaiting')===0?'badge-failed':'badge-primary')); }
   function dt(x){ return x ? new Date(x).toLocaleString('en-GB',{timeZone:'Europe/London',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : ''; }
   var ageDays = Math.floor((Date.now() - new Date(ticket.created_at).getTime()) / 86400000); %>
<style>
  /* Same message rendering as the case screen - tame Outlook's fixed-width tables,
     oversized fonts and stray margins so each email reads like a normal message. */
  .email-body { font-size:14px; line-height:1.55; color:#1f2937; overflow-x:auto; word-break:break-word; }
  .email-body * { max-width:100% !important; }
  .email-body > *:first-child { margin-top:0; }
  .email-body img { height:auto !important; }
  .email-body table { max-width:100% !important; width:auto !important; border-collapse:collapse; }
  .email-body td, .email-body th { word-break:break-word; }
  .email-body p { margin:0 0 10px; }
  .email-body a { word-break:break-word; }
  .email-body blockquote { margin:8px 0; padding-left:10px; border-left:3px solid var(--line); color:var(--text-soft); }
  .email-body font[size] { font-size:14px !important; }
</style>

<div class="page-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/tickets">← Exit review</a></p>
    <h1 style="margin:0;">Helpdesk review <span class="muted" style="font-weight:500;font-size:16px;">· case <%= position %> of <%= total %> (oldest first)</span></h1>
  </div>
  <div style="display:flex;gap:8px;align-items:center;">
    <a class="btn" href="/tickets/<%= ticket.id %>" target="_blank" title="Open the full case screen in a new tab">Open full case ↗</a>
    <a class="btn" href="/tickets/review/<%= ticket.id %>/next" title="Move on without saving anything">Skip →</a>
  </div>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success" style="margin-bottom:14px;"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger" style="margin-bottom:14px;"><%= error %></div><% } %>

<div style="display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:16px;align-items:start;">

  <!-- Case at a glance + recent activity -->
  <div>
    <div class="card" style="margin-bottom:14px;">
      <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-start;">
        <div>
          <div style="font-size:12px;color:var(--muted);font-weight:700;"><%= ticket.ticket_number || ('#' + ticket.id) %></div>
          <h2 style="margin:4px 0 6px;font-size:17px;"><%= ticket.subject || '(no subject)' %></h2>
          <div class="muted" style="font-size:13px;">
            <%= ticket.customer_name || 'No customer linked' %><% if (ticket.contact_name) { %> · <%= ticket.contact_name %><% } %>
          </div>
        </div>
        <div style="text-align:right;">
          <span class="badge <%= sbadge(ticket.status) %>"><%= cap(ticket.status) %></span>
          <div class="muted" style="font-size:12px;margin-top:6px;">Opened <%= dt(ticket.created_at) %> · <strong><%= ageDays %></strong> day<%= ageDays===1?'':'s' %> old</div>
          <div class="muted" style="font-size:12px;"><%= ticket.assigned_name ? ('Assigned: ' + ticket.assigned_name) : 'Unassigned' %></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header" style="display:flex;align-items:baseline;gap:10px;"><h2 style="margin:0;">Conversation</h2><span class="muted" style="font-size:12px;">the full case, newest first - read-only</span></div>
      <% if (timeline.length===0) { %><div class="empty-state">No messages or notes yet.</div><% } %>
      <% timeline.forEach(function(e){ %>
        <% if (e.kind==='note' && e.noteType==='system_log') { %>
          <div class="muted" style="font-size:12px;padding:6px 0;border-bottom:1px solid var(--line);"><%= e.body %> &middot; <%= dt(e.at) %></div>
        <% } else {
             var bg = '#fff', label = '', bd = 'var(--line)';
             if (e.kind==='message') { if (e.direction==='outbound'){bg='var(--tint-info)';label='Sent';} else {label='From '+e.author;} }
             else if (e.noteType==='public_reply') { bg='var(--tint-ok)'; bd='var(--ok-line)'; label='Reply by '+e.author; }
             else if (e.noteType==='side_convo') { bg='#f5f3ff'; bd='var(--violet-line)'; label='🔒 Side conversation · '+e.author; }
             else if (e.noteType==='bot') { bg='var(--surface-2)'; label='Bot'; }
             else { bg='var(--tint-yellow)'; bd='var(--warn-line)'; label='Internal note · '+e.author; }
        %>
          <div style="border:1px solid <%= bd %>;background:<%= bg %>;border-radius:10px;padding:14px 16px;margin:12px 0;">
            <div style="display:flex;justify-content:space-between;gap:12px;margin-bottom:8px;font-size:12px;align-items:center;">
              <span><strong><%= label %></strong>
              <% if (e.channel==='teams' && typeof teamsChatId!=='undefined' && teamsChatId && e.teamsMessageId) { %>
                <a href="https://teams.microsoft.com/l/message/<%= encodeURIComponent(teamsChatId) %>/<%= encodeURIComponent(e.teamsMessageId) %>?context=%7B%22contextType%22%3A%22chat%22%7D" target="_blank" rel="noopener" title="Open this message in Microsoft Teams" style="text-decoration:none;font-size:11px;font-weight:600;border-radius:5px;padding:1px 7px;margin-left:6px;background:var(--tint-indigo);color:#4338ca;">&#128101; Teams &#8599;</a>
              <% } else if (e.channel==='teams' || e.channel==='whatsapp') { %>
                <span style="font-size:11px;font-weight:600;border-radius:5px;padding:1px 7px;margin-left:6px;<%= e.channel==='teams' ? 'background:var(--tint-indigo);color:#4338ca;' : 'background:var(--tint-ok);color:var(--ok-fg);' %>"><%- e.channel==='teams' ? '&#128101; Teams' : '&#128994; WhatsApp' %></span>
              <% } %></span>
              <span class="muted"><%= dt(e.at) %></span>
            </div>
            <% if ((e.kind==='message' && e.direction!=='outbound' && (e.fromEmail || e.to || e.cc)) || ((e.to || e.cc))) { %>
              <div class="muted" style="font-size:12px;margin:-2px 0 8px;border-bottom:1px dashed var(--line);padding-bottom:6px;overflow-wrap:anywhere;">
                <% if (e.kind==='message' && e.direction!=='outbound' && e.fromEmail) { %><span style="margin-right:10px;"><strong>From:</strong> <%= e.fromEmail %></span><% } %>
                <% if (e.to) { %><span style="margin-right:10px;"><strong>To:</strong> <%= e.to %></span><% } %>
                <% if (e.cc) { %><span><strong>Cc:</strong> <%= e.cc %></span><% } %>
              </div>
            <% } %>
            <div class="email-body" style="font-size:14px;line-height:1.6;overflow-wrap:anywhere;"><%- e.body %></div>
          </div>
        <% } %>
      <% }); %>
    </div>
  </div>

  <!-- Review actions -->
  <div class="card" style="position:sticky;top:14px;">
    <h2 style="font-size:15px;margin:0 0 10px;">Review this case</h2>
    <form method="post" action="/tickets/review/<%= ticket.id %>">
      <div class="form-group">
        <label>Private note <span class="muted" style="font-weight:400;">(internal only — never sent to the customer)</span></label>
        <textarea class="input" name="body" id="revNote" rows="6" placeholder="e.g. Chased supplier this morning; awaiting RMA number. Check again Friday." style="width:100%;box-sizing:border-box;"></textarea>
      </div>
      <div class="form-group">
        <label>Status</label>
        <select class="input" name="set_status" id="revStatus" style="width:100%;">
          <% statusList.forEach(function(s){ %>
            <option value="<%= s %>" <%= ticket.status===s?'selected':'' %>><%= cap(s) %><%= ticket.status===s?' (current)':'' %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group" id="revPPWrap" style="display:none;">
        <label>Return date &amp; time</label>
        <input class="input" type="datetime-local" name="postponed_until" id="revPP" style="width:100%;box-sizing:border-box;">
      </div>
      <div style="display:flex;gap:8px;align-items:center;margin-top:12px;">
        <button class="btn btn-primary" type="submit" id="revSave" disabled title="Add the note, apply the status, and open the next oldest case">Save &amp; Next →</button>
        <a class="btn" href="/tickets/review/<%= ticket.id %>/next">Skip →</a>
      </div>
      <p class="muted" style="font-size:11px;margin:10px 0 0;">Save &amp; Next unlocks once you've written a note or changed the status. Notes are always added as <strong>private notes</strong>.</p>
    </form>
  </div>
</div>

<script>
  (function(){
    var note = document.getElementById('revNote'), st = document.getElementById('revStatus'),
        save = document.getElementById('revSave'), ppWrap = document.getElementById('revPPWrap');
    var startStatus = <%- JSON.stringify(ticket.status || '') %>;
    function refresh(){
      var changed = note.value.trim().length > 0 || st.value !== startStatus;
      save.disabled = !changed;
      ppWrap.style.display = (st.value === 'postponed' || st.value === 'awaiting_installation') ? 'block' : 'none';
    }
    note.addEventListener('input', refresh);
    st.addEventListener('change', refresh);
    refresh();
    // Ctrl+Enter = Save & Next
    note.addEventListener('keydown', function(e){ if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && !save.disabled) save.closest('form').submit(); });
  })();
</script>

<%- include('../partials/footer') %>
