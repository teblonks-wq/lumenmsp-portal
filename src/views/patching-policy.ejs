<%- include('partials/header', { title: customer.name + ' — Patch policy', user }) %>
<%
function pol(cls) { return policies.filter(function (p) { return p.device_class === cls; })[0] || {}; }
function hasDay(p, d) { return String(p.window_days || '').split(',').indexOf(String(d)) >= 0; }
function isServer(d) {
  if (d.patch_class) return d.patch_class === 'server';
  return String(d.os || '').toLowerCase().indexOf('server') >= 0;
}
%>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/patching/policies">← Patch policies</a></p>
  <h1 style="margin:0;"><%= customer.name %></h1>
  <p class="muted" style="margin:4px 0 0;"><%= devices.length %> machine<%= devices.length === 1 ? '' : 's' %> with the agent installed.</p>
</div>

<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>

<form method="post" action="/patching/policies/<%= customer.id %>">
  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

  <% ['workstation', 'server'].forEach(function (cls) { var p = pol(cls); %>
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
      <h2><%= cls === 'server' ? 'Servers' : 'Workstations' %></h2>
      <label style="display:flex;align-items:center;gap:8px;font-size:14px;">
        <input type="checkbox" name="<%= cls %>_enabled" value="1" <%= p.enabled ? 'checked' : '' %>>
        <strong>Patching enabled</strong>
      </label>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;">
      <div class="form-group">
        <label>Install</label>
        <select class="input" name="<%= cls %>_scope" style="width:100%;">
          <option value="security" <%= p.install_scope !== 'all' ? 'selected' : '' %>>Security &amp; critical only</option>
          <option value="all" <%= p.install_scope === 'all' ? 'selected' : '' %>>Everything Windows offers</option>
        </select>
        <p class="muted" style="font-size:12px;margin:6px 0 0;">Security-only is the safer default: it is the set that matters and the set least likely to break something.</p>
      </div>

      <div class="form-group">
        <label>Window starts</label>
        <input class="input" type="time" name="<%= cls %>_start" value="<%= p.window_start || '02:00' %>" style="width:100%;">
      </div>

      <div class="form-group">
        <label>Window length (minutes)</label>
        <input class="input" type="number" name="<%= cls %>_minutes" min="30" max="720" value="<%= p.window_minutes || 180 %>" style="width:100%;">
      </div>
    </div>

    <div class="form-group">
      <label>Days</label>
      <div style="display:flex;gap:14px;flex-wrap:wrap;">
        <% dayNames.forEach(function (d, i) { %>
          <label style="display:flex;align-items:center;gap:5px;font-size:13px;">
            <input type="checkbox" name="<%= cls %>_days" value="<%= i %>" <%= hasDay(p, i) ? 'checked' : '' %>> <%= d.slice(0, 3) %>
          </label>
        <% }); %>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;">
      <div class="form-group">
        <label>Restarts</label>
        <select class="input" name="<%= cls %>_reboot" style="width:100%;">
          <option value="never"   <%= (p.reboot_mode || 'never') === 'never' ? 'selected' : '' %>>Never — flag it and leave it to us</option>
          <option value="prompt"  <%= p.reboot_mode === 'prompt' ? 'selected' : '' %>>Ask the user, allow deferrals, then force</option>
          <option value="if_idle" <%= p.reboot_mode === 'if_idle' ? 'selected' : '' %>>Only when nobody is signed in</option>
        </select>
        <p class="muted" style="font-size:12px;margin:6px 0 0;">
          <%= cls === 'server' ? 'For servers, "never" is almost always right — a restart is a change, and changes get scheduled.' : 'Prompting respects the user\'s work without letting a restart drift for weeks.' %>
        </p>
      </div>

      <div class="form-group">
        <label>Deferrals allowed</label>
        <input class="input" type="number" name="<%= cls %>_deferrals" min="0" max="10" value="<%= p.reboot_deferrals == null ? 3 : p.reboot_deferrals %>" style="width:100%;">
        <p class="muted" style="font-size:12px;margin:6px 0 0;">Only applies when restarts are set to ask.</p>
      </div>

      <div class="form-group">
        <label>Force after (hours)</label>
        <input class="input" type="number" name="<%= cls %>_deadline" min="1" max="720" value="<%= p.reboot_deadline_hours == null ? 72 : p.reboot_deadline_hours %>" style="width:100%;">
      </div>

      <div class="form-group">
        <label>Warn user (minutes before)</label>
        <input class="input" type="number" name="<%= cls %>_notify" min="0" max="240" value="<%= p.notify_minutes == null ? 15 : p.notify_minutes %>" style="width:100%;">
      </div>
    </div>

    <div class="form-group">
      <label>Message shown to the user</label>
      <input class="input" type="text" name="<%= cls %>_message" maxlength="500" style="width:100%;"
             value="<%= p.notify_message || '' %>"
             placeholder="Leave blank for the default: 'Your computer needs to restart to finish installing updates.'">
      <p class="muted" style="font-size:12px;margin:6px 0 0;">Shown in the LumenMSP Agent tray prompt — so it reads as you, not as Windows.</p>
    </div>
  </div>
  <% }); %>

  <div class="card">
    <div class="card-header"><h2>Exceptions</h2></div>
    <p class="muted" style="margin:0 0 12px;font-size:13px;">
      Tick any machine that should be left alone entirely — the one running the till, the one with the ancient
      line-of-business app. Class is worked out from the operating system; a ticked machine is excluded whatever its class.
    </p>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th style="width:40px;">Skip</th><th>Machine</th><th>Class</th><th>OS</th></tr></thead>
        <tbody>
          <% if (!devices.length) { %><tr><td colspan="4"><div class="empty-state">No agents for this customer yet.</div></td></tr><% } %>
          <% devices.forEach(function (d) { %>
            <tr>
              <td><input type="checkbox" name="excluded" value="<%= d.id %>" <%= d.patch_excluded ? 'checked' : '' %>></td>
              <td><%= d.hostname %></td>
              <td><span class="badge badge-inactive"><%= isServer(d) ? 'Server' : 'Workstation' %></span></td>
              <td class="muted" style="font-size:12px;"><%= d.os || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div style="display:flex;gap:8px;margin:16px 0 0;">
    <button class="btn btn-primary" type="submit">Save policy</button>
    <a class="btn" href="/patching/policies">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
