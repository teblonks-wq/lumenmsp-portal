<%- include('../partials/header', { title: 'IT Report — ' + c.name, user }) %>
<% var m = (cfg && cfg.manual) || {}; %>

<div class="page-header">
  <p class="muted" style="margin:0 0 4px;"><a class="row-link" href="/it-report">← IT Reports</a></p>
  <h1><%= c.name %> — IT Snapshot</h1>
  <p class="muted">Next report covers <strong><%= periodLabel %></strong>.</p>
</div>

<% if (saved) { %><div class="alert alert-success" style="margin-bottom:16px;">Saved.</div><% } %>
<% if (err) { %><div class="alert alert-error" style="margin-bottom:16px;"><%= err %></div><% } %>
<% if (!c.entra_tenant_id) { %>
  <div class="alert alert-error" style="margin-bottom:16px;">No Entra tenant ID on file for this customer, so Intune / Secure Score can't auto-fill. Set it up via <a class="row-link" href="/customers/<%= c.id %>">the customer's user-sync settings</a>. DNS, tickets and manual sections still work.</div>
<% } %>

<div style="display:flex;gap:12px;margin-bottom:6px;flex-wrap:wrap;align-items:center;">
  <a class="btn btn-primary" href="/it-report/<%= c.id %>/preview" target="_blank">Preview &amp; send — <%= periodLabel %></a>
  <span class="muted" style="font-size:13px;">Opens the finished report. Review it, then click <strong>✉ Send to customer</strong> in the top bar to email the exact copy you're looking at.</span>
</div>
<p class="muted" style="margin:0 0 18px;font-size:13px;">Claude consolidates and proof-reads all your notes for the period into the write-up. Save your settings and add notes first, then preview.</p>

<form method="post" action="/it-report/<%= c.id %>" id="itReportForm">
  <div class="card">
    <div class="card-header"><h2>Delivery</h2></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
      <div class="form-group"><label>Recipient emails (comma or newline separated)</label>
        <textarea class="input" name="recipients" rows="3" style="width:100%;"><%= cfg ? cfg.recipients : '' %></textarea></div>
      <div>
        <div class="form-group"><label>Primary domain — fallback only</label>
          <input class="input" name="primary_domain" value="<%= cfg ? cfg.primary_domain : '' %>" placeholder="leave blank — uses the customer record's primary domain" style="width:100%;">
          <p class="muted" style="margin:4px 0 0;font-size:12px;">DNS &amp; email-security checks use the <strong>customer record's</strong> primary domain. This field is only used when the customer has no domains recorded.</p></div>
        <div style="margin-top:12px;display:flex;gap:20px;">
          <label style="font-weight:600;"><input type="checkbox" name="is_active" <%= cfg && cfg.is_active ? 'checked' : '' %>> Send monthly (auto)</label>
          <label style="font-weight:600;"><input type="checkbox" name="auto_send" <%= !cfg || cfg.auto_send ? 'checked' : '' %>> Auto-send (untick = create draft for review)</label>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Report figures — live values, editable</h2></div>
    <p class="muted" style="margin-top:0;">Every headline number the report prints, <strong>filled in with what would be deployed right now</strong> — straight from Intune, the agents and the backup provider. Leave a figure alone and it keeps tracking live every month, so next month's report is this month's truth, not this month's numbers. Change one and your value wins until you press <span style="font-family:inherit;">&#8630;</span> to put it back — a changed figure is flagged amber here, and the report then says the figures were confirmed by the service delivery manager.</p>
    <p class="muted" id="figLoad" style="margin:0 0 14px;font-size:13px;">Reading the live figures…</p>
    <%
      var groups = {};
      (figKeys || []).forEach(function(f){ (groups[f.group] = groups[f.group] || []).push(f); });
      var ovr = (m && m.ovr) || {};
    %>
    <% Object.keys(groups).forEach(function(g){ %>
      <h3 style="margin:14px 0 8px;font-size:15px;"><%= g %></h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;">
        <% groups[g].forEach(function(f){ %>
          <div class="form-group fig-wrap" data-fig="<%= f.key %>">
            <label style="display:block;"><%= f.label %></label>
            <div style="display:flex;gap:6px;">
              <input class="input fig-input" name="ovr_<%= f.key %>" data-fig-input="<%= f.key %>" value="<%= ovr[f.key] || '' %>" placeholder="—" style="flex:1;" autocomplete="off">
              <button type="button" class="btn fig-clear" title="Use the live figure" style="padding:2px 9px;" onclick="clearFig('<%= f.key %>')">&#8630;</button>
            </div>
            <p class="muted fig-live" data-fig-live="<%= f.key %>" style="margin:4px 0 0;font-size:12px;">&nbsp;</p>
          </div>
        <% }); %>
      </div>
    <% }); %>
  </div>

  <div class="card">
    <div class="card-header"><h2>Service Delivery Manager — standing notes</h2></div>
    <p class="muted" style="margin-top:0;">Persistent commentary that always feeds the report. Month-specific observations go in the running log below. <strong>Prune completed items after each report</strong> — anything left here is fed to Claude every month and can resurface as if it were new.</p>
    <textarea class="input" name="sdm_notes" rows="4" style="width:100%;"><%= cfg ? cfg.sdm_notes : '' %></textarea>
  </div>

  <div class="card">
    <div class="card-header"><h2>Manual sections (interim, until each API is wired)</h2></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
      <div>
        <div class="form-group"><label>Backup &amp; Recovery — bullets <span class="muted" style="font-weight:400;font-size:12px;">(empty = the auto lines shown greyed below)</span></label>
          <textarea class="input auto-text" name="backupBullets" data-auto="backupBullets" rows="4" style="width:100%;" placeholder="Loading the auto bullets…"><%= m.backupBullets || '' %></textarea>
          <p class="muted auto-hint" data-auto-hint="backupBullets" style="margin:4px 0 0;font-size:12px;">&nbsp;</p></div>
        <div class="form-group" style="margin-top:8px;"><label>Backup status</label>
          <input class="input" name="backupStatus" value="<%= m.backupStatus || '' %>" placeholder="Healthy"></div>
        <div class="form-group" style="margin-top:8px;"><label>Patch — extra bullets <span class="muted" style="font-weight:400;font-size:12px;">(empty = the auto lines shown greyed below)</span></label>
          <textarea class="input auto-text" name="patchBullets" data-auto="patchBullets" rows="3" style="width:100%;" placeholder="Loading the auto bullets…"><%= m.patchBullets || '' %></textarea>
          <p class="muted auto-hint" data-auto-hint="patchBullets" style="margin:4px 0 0;font-size:12px;">&nbsp;</p></div>
        <div class="form-group" style="margin-top:8px;"><label>Patch status</label>
          <input class="input" name="patchStatus" value="<%= m.patchStatus || '' %>" placeholder="Healthy"></div>
      </div>
      <div>
        <p class="muted" style="margin:0 0 8px;font-size:12px;">Firewall and endpoint threat counts have moved up to <strong>Report figures</strong> — endpoint threats are counted from the Bitdefender sync; firewall blocks have no source yet and stay typed.</p>
        <div class="form-group" style="margin-top:8px;"><label>Threat protection — extra bullets <span class="muted" style="font-weight:400;font-size:12px;">(empty = the auto lines shown greyed below)</span></label>
          <textarea class="input auto-text" name="threatBullets" data-auto="threatBullets" rows="3" style="width:100%;" placeholder="Loading the auto bullets…"><%= m.threatBullets || '' %></textarea>
          <p class="muted auto-hint" data-auto-hint="threatBullets" style="margin:4px 0 0;font-size:12px;">&nbsp;</p></div>
        <div class="form-group" style="margin-top:8px;"><label>Threat status</label>
          <input class="input" name="threatStatus" value="<%= m.threatStatus || '' %>" placeholder="Healthy"></div>
        <p class="muted" style="margin-top:8px;font-size:12px;">Email authentication % is now drawn automatically from Domain Health (DMARC reports) — no manual entry needed.</p>
      </div>
    </div>

    <div style="border-top:1px solid var(--line);margin-top:20px;padding-top:16px;">
      <h3 style="margin:0 0 4px;font-size:16px;">Vulnerability testing — monthly external scan</h3>
      <p class="muted" style="margin:0 0 12px;font-size:13px;">From your monthly RoboShadow scan (no remote access, so entered here). Leave blank if not run this month.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div>
          <div class="form-group"><label>Provider</label><input class="input" name="vulnProvider" value="<%= m.vulnProvider || '' %>" placeholder="RoboShadow"></div>
          <div class="form-group" style="margin-top:8px;"><label>Target (external IP / host)</label><input class="input" name="vulnTarget" value="<%= m.vulnTarget || '' %>" placeholder="95.141.23.229"></div>
          <div class="form-group" style="margin-top:8px;"><label>Risk level</label><input class="input" name="vulnRiskLevel" value="<%= m.vulnRiskLevel || '' %>" placeholder="Low"></div>
          <div class="form-group" style="margin-top:8px;"><label>Status</label><input class="input" name="vulnStatus" value="<%= m.vulnStatus || '' %>" placeholder="Secured"></div>
        </div>
        <div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <div class="form-group"><label>Critical CVEs</label><input class="input" name="vulnCriticalCves" value="<%= m.vulnCriticalCves || '' %>" placeholder="0"></div>
            <div class="form-group"><label>CVEs</label><input class="input" name="vulnCves" value="<%= m.vulnCves || '' %>" placeholder="0"></div>
            <div class="form-group"><label>Open ports</label><input class="input" name="vulnPorts" value="<%= m.vulnPorts || '' %>" placeholder="3"></div>
            <div class="form-group"><label>Web alerts</label><input class="input" name="vulnWebAlerts" value="<%= m.vulnWebAlerts || '' %>" placeholder="0"></div>
          </div>
          <div class="form-group" style="margin-top:8px;"><label>Extra bullets (one per line)</label>
            <textarea class="input" name="vulnBullets" rows="2" style="width:100%;" placeholder="No critical vulnerabilities identified&#10;Web application secured"><%= m.vulnBullets || '' %></textarea></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Support cases — <%= periodLabel %></h2></div>
    <p class="muted" style="margin-top:0;">These are the cases the report will count and list under "Work carried out this period". Tick any to <strong>exclude</strong> — an excluded case disappears from the totals, timers, case mix and the work table (use for internal noise, e.g. a forwarded copy of last month's report). Save settings to apply.</p>
    <% if (!cases || !cases.length) { %><p class="muted">No cases logged in <%= periodLabel %>.</p><% } else { %>
    <table class="table">
      <thead><tr><th style="width:70px;">Exclude</th><th>Case</th><th>Subject</th><th>Status</th><th>Logged</th></tr></thead>
      <tbody>
      <% cases.forEach(function(t){ var ex = excludedSet.has(String(t.ticket_number || '').toUpperCase()); %>
        <tr<%= ex ? ' style="opacity:.55;"' : '' %>>
          <td style="text-align:center;"><input type="checkbox" name="excludeTicket" value="<%= t.ticket_number %>" <%= ex ? 'checked' : '' %>></td>
          <td style="white-space:nowrap;font-family:monospace;"><%= t.ticket_number %></td>
          <td><%= t.subject %></td>
          <td><span class="badge <%= ['resolved','closed'].includes(String(t.status||'').toLowerCase()) ? 'badge-sent' : 'badge-inactive' %>"><%= t.status %></span></td>
          <td class="muted" style="white-space:nowrap;"><%= new Date(t.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>

  <button class="btn btn-primary" type="submit" style="margin-bottom:24px;">Save settings</button>
</form>

<div class="card" style="padding:14px 20px;">
  <p class="muted" style="margin:0;font-size:13px;">The report's <strong>Backup &amp; Recovery</strong> section draws from the backup providers monitored on the customer panel — manage the links there: <a class="row-link" href="/customers/<%= c.id %>#assets">Customer &rarr; Assets &rarr; Backup</a>.</p>
</div>

<div class="card">
  <div class="card-header"><h2>Running notes log</h2></div>
  <p class="muted" style="margin-top:0;">Drop observations as they happen (e.g. "internet outage on the 12th — considering a supplier review"). Notes within the reporting month are compiled and handed to Claude for the write-up.</p>
  <div style="display:flex;gap:8px;margin-bottom:16px;">
    <input id="noteBody" class="input" placeholder="Add a note… (saved instantly, won't clear the boxes above)" style="flex:1;" onkeydown="if(event.key==='Enter'){event.preventDefault();addNote();}">
    <button class="btn btn-primary" type="button" onclick="addNote()">Add note</button>
  </div>
  <table class="table"><tbody id="notesBody">
    <% if (!notes.length) { %><tr id="noNotesRow"><td class="muted">No notes yet this period.</td></tr><% } %>
    <% notes.forEach(function(n){ %>
    <tr data-note="<%= n.id %>">
      <td style="white-space:nowrap;width:120px;" class="muted"><%= new Date(n.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></td>
      <td><%= n.body %><% if (n.author) { %> <span class="muted" style="font-size:12px;">— <%= n.author %></span><% } %></td>
      <td style="text-align:right;width:60px;">
        <button class="btn" style="padding:2px 8px;font-size:12px;" type="button" onclick="delNote(<%= n.id %>, this)">✕</button>
      </td>
    </tr>
    <% }); %>
  </tbody></table>
</div>

<script>
  var CID_FIG = <%= c.id %>;
  // The live figures arrive after the page, so settings opens instantly and the numbers
  // land a moment later. A box the operator has typed in keeps its value — the live figure
  // is shown underneath it instead, so what was replaced stays visible.
  // A figure counts as OVERRIDDEN when it differs from the live value — not merely when
  // the box has something in it. Once every box is filled in, "non-empty" would mean
  // "everything is an override", which is exactly the wrong answer.
  function figLive(el){ return el.getAttribute('data-fig-live-value'); }
  function figOverridden(el){
    var typed = (el.value || '').trim();
    var live = figLive(el);
    if (live === null) return !!typed;               // no live figure: anything typed is ours
    return typed !== '' && typed !== String(live);
  }
  function markFig(el){
    var wrap = el.closest('.fig-wrap');
    var on = figOverridden(el);
    var live = figLive(el);
    el.style.borderColor = on ? '#d97706' : '';
    el.style.background = on ? '#fffbeb' : '';
    var lbl = wrap.querySelector('.fig-live');
    if (!lbl) return;
    lbl.style.color = on ? '#b45309' : '';
    if (live === null) return;                        // its label is set by the loader
    lbl.textContent = on ? ('Overriding the live figure of ' + live) : ('Live now: ' + live + ' — tracking');
  }
  // The ↺ button puts the live figure back rather than emptying the box, which is what
  // "use the live figure" has always meant.
  function clearFig(key){
    var el = document.querySelector('[data-fig-input="' + key + '"]');
    if (!el) return;
    var live = figLive(el);
    el.value = (live === null) ? '' : String(live);
    markFig(el);
    el.focus();
  }
  (function(){
    document.querySelectorAll('.fig-input').forEach(function(el){
      markFig(el);
      el.addEventListener('input', function(){ markFig(el); });
    });
    // On save, a box still showing its live figure is posted EMPTY. The server contract is
    // unchanged — blank means "keep using the live figure" (routes/it-report.ts,
    // overridesFromBody) — so filling the boxes in is purely what the person sees. Without
    // this, opening the page and pressing Save would freeze every number at today's value
    // and the report would quietly stop tracking live next month.
    var figForm = document.getElementById('itReportForm');
    if (figForm) figForm.addEventListener('submit', function(){
      document.querySelectorAll('.fig-input').forEach(function(el){
        if (!figOverridden(el) && figLive(el) !== null) el.value = '';
      });
    });
    fetch('/it-report/' + CID_FIG + '/figures.json', { headers: { 'Accept': 'application/json' } })
      .then(function(r){ return r.json(); })
      .then(function(j){
        var live = (j && j.live) || {};
        var note = document.getElementById('figLoad');
        var got = 0;
        document.querySelectorAll('.fig-input').forEach(function(el){
          var key = el.getAttribute('data-fig-input');
          var v = live[key];
          var lbl = document.querySelector('[data-fig-live="' + key + '"]');
          if (v === undefined || v === null || v === '') {
            if (lbl) lbl.textContent = 'No live figure — nothing reporting for this one yet. Type one and the report prints it.';
            return;
          }
          got++;
          el.setAttribute('placeholder', v);
          // The live figure is remembered on the element, and the box is FILLED with it
          // unless a saved override already occupies it. The submit hook below blanks any
          // box still equal to its live figure, so a filled box is not the same thing as a
          // stored override — the form looks like a form, and the live tracking survives.
          el.setAttribute('data-fig-live-value', v);
          if (!(el.value || '').trim()) el.value = v;
          markFig(el);
        });
        var bl = (j && j.bullets) || {};
        document.querySelectorAll('.auto-text').forEach(function(ta){
          var key = ta.getAttribute('data-auto');
          var lines = bl[key] || [];
          var hint = document.querySelector('[data-auto-hint="' + key + '"]');
          if (!lines.length) {
            ta.setAttribute('placeholder', 'Nothing to auto-fill for this customer yet — anything you type here is printed as-is.');
            if (hint) hint.textContent = '';
            return;
          }
          ta.setAttribute('placeholder', lines.join('\n'));
          var typed = (ta.value || '').trim();
          ta.style.borderColor = typed ? '#d97706' : '';
          ta.style.background = typed ? '#fffbeb' : '';
          if (hint) {
            hint.textContent = typed ? 'Replacing the auto lines above.' : 'These lines will print. Type here to replace them.';
            hint.style.color = typed ? '#b45309' : '';
          }
        });
        if (note) note.textContent = got
          ? 'Live figures read just now — these are the numbers this month\u2019s report would print.'
          : 'No live figures available for this customer yet (no Intune access, no agents, no backup provider linked). Type the figures in and the report will use them.';
      })
      .catch(function(){
        var note = document.getElementById('figLoad');
        if (note) note.textContent = 'Could not read the live figures just now — anything you type here is still used.';
      });
  })();

  var CID = <%= c.id %>;
  function csrf(){ var m = document.querySelector('meta[name="csrf-token"]'); return m ? m.getAttribute('content') : ''; }
  function esc(s){ var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function addNote(){
    var inp = document.getElementById('noteBody');
    var body = (inp.value || '').trim();
    if (!body) return;
    fetch('/it-report/' + CID + '/note', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'x-csrf-token': csrf() },
      body: JSON.stringify({ body: body })
    }).then(function(r){ return r.json(); }).then(function(j){
      if (!j.ok || !j.note) return;
      var noNotes = document.getElementById('noNotesRow'); if (noNotes) noNotes.remove();
      var d = new Date(j.note.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short' });
      var tr = document.createElement('tr'); tr.setAttribute('data-note', j.note.id);
      tr.innerHTML = '<td style="white-space:nowrap;width:120px;" class="muted">' + d + '</td>' +
        '<td>' + esc(j.note.body) + (j.note.author ? ' <span class="muted" style="font-size:12px;">— ' + esc(j.note.author) + '</span>' : '') + '</td>' +
        '<td style="text-align:right;width:60px;"><button class="btn" style="padding:2px 8px;font-size:12px;" type="button" onclick="delNote(' + j.note.id + ', this)">✕</button></td>';
      var tb = document.getElementById('notesBody'); tb.insertBefore(tr, tb.firstChild);
      inp.value = '';
    }).catch(function(){ alert('Could not add the note — please try again.'); });
  }
  function delNote(id, btn){
    if (!confirm('Delete this note?')) return;
    fetch('/it-report/' + CID + '/note/' + id + '/delete', {
      method: 'POST', headers: { 'Accept': 'application/json', 'x-csrf-token': csrf() }
    }).then(function(r){ return r.json(); }).then(function(j){
      if (j.ok){ var row = btn.closest('tr'); if (row) row.remove(); }
    }).catch(function(){ alert('Could not delete the note.'); });
  }
</script>

<div class="card">
  <div class="card-header"><h2>Recent reports</h2></div>
  <% if (!runs.length) { %><p class="muted">None generated yet.</p><% } else { %>
    <table class="table">
      <thead><tr><th>Period</th><th>Status</th><th>Created</th></tr></thead>
      <tbody>
      <% runs.forEach(function(r){ %>
        <tr>
          <td><a class="row-link" href="/it-report/run/<%= r.id %>" target="_blank"><%= r.period_label %></a></td>
          <td><span class="badge <%= r.status==='sent'?'badge-sent':(r.status==='failed'?'badge-failed':'badge-inactive') %>"><%= r.status %></span></td>
          <td class="muted"><%= new Date(r.created_at).toLocaleDateString('en-GB') %></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
