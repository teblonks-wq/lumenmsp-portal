<%- include('header', { title: title, company: (user && user.displayName) || '', user, active }) %>

<%
  function rtype(t){ return t === 'weekly_call_stats' ? 'Weekly'
    : t === 'site_performance' ? 'Site Performance'
    : t === 'group_call_performance' ? 'Daily' : (t || '—'); }
  function d(x){ return x ? new Date(x).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'; }
  function fmtT(x){ try { return new Date(x).toLocaleString('en-GB', { timeZone: 'Europe/London', weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (e) { return ''; } }
  function fmtWait(s){ s = Number(s) || 0; if (s < 60) return s + 's'; var m = Math.floor(s/60), r = s % 60; return r ? m + 'm ' + r + 's' : m + 'm'; }
%>

<style>
  /* The two call tools are the thing customers actually come here for, so they get real
     estate and weight rather than a label on a small form. Colours come from the existing
     token set (--accent) — no new palette. */
  .ins-tools{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;margin-bottom:20px;}
  .ins-tool{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px;position:relative;overflow:hidden;}
  .ins-tool::before{content:'';position:absolute;inset:0 0 auto 0;height:4px;background:var(--accent,#0ea5b7);opacity:.9;}
  .ins-tool h2{font-size:19px!important;margin:0 0 4px!important;display:flex;align-items:center;gap:9px;}
  .ins-tool h2 svg{width:20px;height:20px;stroke:var(--accent,#0ea5b7);flex:none;}
  .ins-tool .ins-blurb{font-size:13px;color:#64748b;margin:0 0 14px;line-height:1.5;}
  .ins-tool label{margin:0 0 6px!important;font-size:13px!important;}
  .ins-tool .ins-go{display:flex;gap:8px;align-items:stretch;flex-wrap:wrap;}
  .ins-tool .ins-go input{flex:1;min-width:180px;font-size:16px;}
  .ins-tool .ins-go .btn{white-space:nowrap;padding:11px 20px;font-size:15px;}
  .ins-tool .ins-hint{font-size:12px;color:#94a3b8;margin:10px 0 0;}
  .ins-tool.is-active{border-color:var(--accent,#0ea5b7);box-shadow:0 6px 18px rgba(14,165,183,.13);}
</style>

<div class="page-header">
  <h1>Insights</h1>
  <p class="muted" style="margin:4px 0 0;">Track calls to your numbers and run your call-analytics reports.</p>
</div>

<% if (msg) { %><div class="alert alert-success" style="margin-bottom:14px;"><%= msg %></div><% } %>
<% if (err) { %><div class="alert alert-danger" style="margin-bottom:14px;"><%= err %></div><% } %>

<% if (state === 'down') { %>
  <div class="card"><div class="empty">Insights is temporarily unavailable. Please try again shortly.</div></div>
<% } else if (state === 'unlinked') { %>
  <div class="card"><div class="empty">Your call insights aren't switched on yet. Please contact Lumen IT and we'll set them up for you.</div></div>
<% } else { %>

  <!-- Both call tools live above the tabs: they are the reason customers come here,
       and keeping them out of the tab strip means neither is ever a click away. -->
  <div class="ins-tools">
    <form method="get" action="/my/insights" class="ins-tool <%= q ? 'is-active' : '' %>">
        <input type="hidden" name="tab" value="home">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>Find a call</h2>
        <p class="ins-blurb">Follow one caller's journey — every call to or from a number, who it reached, how long they waited and where it went.</p>
        <label for="insQ">Phone number</label>
        <div class="ins-go">
          <input id="insQ" class="input" name="q" value="<%= q %>" placeholder="e.g. 07700 900123 or 01235 …">
          <button class="btn btn-primary" type="submit">Track calls</button>
        </div>
        <p class="ins-hint">Searches the last 28 days of calls involving your numbers.</p>
      </form>

    <form method="get" action="/my/insights" class="ins-tool <%= ext ? 'is-active' : '' %>">
        <input type="hidden" name="tab" value="reverse">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Who answered it</h2>
        <p class="ins-blurb">The other way round — every call a person or extension answered in a window, with the caller's number to follow up.</p>
        <label for="insExt">Extension or person</label>
        <div class="ins-go">
          <input id="insExt" class="input" name="ext" value="<%= ext %>" list="extListHome" placeholder="e.g. 201 or a name" autocomplete="off">
          <datalist id="extListHome"><% (extensions || []).forEach(function(e){ %><option value="<%= e %>"></option><% }); %></datalist>
          <button class="btn btn-primary" type="submit">Show calls</button>
        </div>
        <p class="ins-hint">Defaults to the last 7 days — you can narrow the dates and times on the next screen.</p>
      </form>
  </div>

  <div class="my-tabs">
    <a class="my-tab <%= tab === 'home' ? 'active' : '' %>" href="/my/insights?tab=home">Find a call</a>
    <a class="my-tab <%= tab === 'reverse' ? 'active' : '' %>" href="/my/insights?tab=reverse">Who answered it</a>
    <a class="my-tab <%= tab === 'outbound' ? 'active' : '' %>" href="/my/insights?tab=outbound">Who called them</a>
    <a class="my-tab <%= tab === 'reports' ? 'active' : '' %>" href="/my/insights?tab=reports">Reports</a>
  </div>

  <% if (tab === 'home') { %>

    <% if (q && q.length >= 3) { %>
      <% if (stats && stats.total) { %>
        <div class="grid">
          <div class="stat"><div class="n"><%= stats.total %></div><div class="l">Calls</div></div>
          <div class="stat"><div class="n"><%= stats.answered %></div><div class="l">Answered</div></div>
          <div class="stat"><div class="n"><%= stats.missed %></div><div class="l">Missed</div></div>
          <div class="stat"><div class="n"><%= stats.ansRate %>%</div><div class="l">Answer rate</div></div>
          <div class="stat"><div class="n"><%= fmtWait(stats.avgWait) %></div><div class="l">Avg wait</div></div>
        </div>
        <div class="card" style="padding:0;">
          <div class="table-wrap"><table class="table" style="margin:0;">
            <thead><tr><th>Date / time</th><th>Number</th><th>Outcome</th><th>Wait</th><th>Answered by</th><th>Journey</th></tr></thead>
            <tbody>
              <% journeys.forEach(function(j){ %>
                <tr>
                  <td class="muted" style="white-space:nowrap;"><%= fmtT(j.datetime) %></td>
                  <td style="font-family:monospace;font-size:13px;"><%= j.number || '—' %></td>
                  <td><%= j.status %></td>
                  <td class="num" style="white-space:nowrap;"><%= j.wait %></td>
                  <td style="font-family:monospace;font-size:13px;"><% if (j.answered_by) { %><a href="/my/insights?tab=reverse&ext=<%= encodeURIComponent(j.answered_by) %>" title="See all calls answered by <%= j.answered_by %>"><%= j.answered_by %></a><% } else { %>—<% } %></td>
                  <td class="muted" style="font-size:12px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= j.route || '' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table></div>
        </div>
      <% } else { %>
        <div class="card"><div class="empty">No calls found for &ldquo;<%= q %>&rdquo; in the last 28 days.</div></div>
      <% } %>
    <% } %>

  <% } else if (tab === 'outbound') { %>

    <div class="card">
      <p class="muted" style="margin:0 0 12px;font-size:13px;">Put in a number you rang and see who called it, when, and whether it connected.</p>
      <form method="get" action="/my/insights" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
        <input type="hidden" name="tab" value="outbound">
        <div class="form-group" style="margin:0;min-width:210px;">
          <label>Number called</label>
          <input class="input" name="num" value="<%= outNum %>" placeholder="e.g. 07700 900123" style="width:100%;" autocomplete="off">
        </div>
        <div class="form-group" style="margin:0;"><label>From</label><input class="input" type="date" name="from" value="<%= fromDate %>"></div>
        <div class="form-group" style="margin:0;"><label>To</label><input class="input" type="date" name="to" value="<%= toDate %>"></div>
        <div class="form-group" style="margin:0;"><label>Between</label><input class="input" type="time" name="from_time" value="<%= fromTime %>"></div>
        <div class="form-group" style="margin:0;"><label>And</label><input class="input" type="time" name="to_time" value="<%= toTime %>"></div>
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <p class="ins-hint">Click a caller to see everything they answered, or the number to see its full history both ways.</p>
    </div>

    <% if (outNum) { %>
      <% if (ostats && ostats.total) { %>
        <div class="grid">
          <div class="stat"><div class="n"><%= ostats.total %></div><div class="l">Calls out</div></div>
          <div class="stat"><div class="n"><%= ostats.connected %></div><div class="l">Connected (<%= ostats.connRate %>%)</div></div>
          <div class="stat"><div class="n"><%= ostats.noAnswer %></div><div class="l">No answer</div></div>
          <div class="stat"><div class="n"><%= ostats.callers %></div><div class="l">People who called</div></div>
          <div class="stat"><div class="n"><%= fmtWait(ostats.avgTalk) %></div><div class="l">Avg talk time</div></div>
        </div>
        <div class="card" style="padding:0;">
          <div class="table-wrap"><table class="table" style="margin:0;">
            <thead><tr><th>Date / time</th><th>Called by</th><th>Number</th><th>Outcome</th><th>Talk time</th></tr></thead>
            <tbody>
              <% outCalls.forEach(function(c){ %>
                <tr>
                  <td class="muted" style="white-space:nowrap;"><%= fmtT(c.datetime) %></td>
                  <td style="font-family:monospace;font-size:13px;">
                    <% if (c.extno) { %><a href="/my/insights?tab=reverse&ext=<%= encodeURIComponent(c.extno) %>" title="See all calls <%= c.extno %> answered"><%= c.extno %></a><% } else { %><span class="muted">&mdash;</span><% } %>
                  </td>
                  <td style="font-family:monospace;font-size:13px;">
                    <a href="/my/insights?tab=home&q=<%= encodeURIComponent(c.number) %>" title="Track this number"><%= c.number %></a>
                  </td>
                  <td>
                    <% if (c.connected) { %><span style="color:#166534;font-weight:600;font-size:13px;">Connected</span>
                    <% } else { %><span style="color:#b45309;font-weight:600;font-size:13px;">No answer</span><% } %>
                  </td>
                  <td class="num" style="white-space:nowrap;"><%= c.connected ? fmtWait(c.dur) : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table></div>
        </div>
      <% } else { %>
        <div class="card"><div class="empty">No outbound calls to &ldquo;<%= outNum %>&rdquo; in this window.</div></div>
      <% } %>
    <% } %>

  <% } else if (tab === 'reverse') { %>

    <div class="card">
      <p class="muted" style="margin:0 0 12px;font-size:13px;">Narrow the window — every call <strong><%= ext || 'that person' %></strong> answered between these dates and times.</p>
      <form method="get" action="/my/insights" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
        <input type="hidden" name="tab" value="reverse">
        <div class="form-group" style="margin:0;min-width:210px;">
          <label>Extension / user</label>
          <input class="input" name="ext" value="<%= ext %>" list="extList" placeholder="e.g. 201 or a name" style="width:100%;" autocomplete="off">
          <datalist id="extList"><% (extensions || []).forEach(function(e){ %><option value="<%= e %>"></option><% }); %></datalist>
        </div>
        <div class="form-group" style="margin:0;"><label>From</label><input class="input" type="date" name="from" value="<%= fromDate %>"></div>
        <div class="form-group" style="margin:0;"><label>To</label><input class="input" type="date" name="to" value="<%= toDate %>"></div>
        <div class="form-group" style="margin:0;"><label>Between</label><input class="input" type="time" name="from_time" value="<%= fromTime %>"></div>
        <div class="form-group" style="margin:0;"><label>And</label><input class="input" type="time" name="to_time" value="<%= toTime %>"></div>
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <p class="ins-hint">Click any caller's number in the results to follow that number's full history.</p>
    </div>

    <% if (ext) { %>
      <% if (rstats && rstats.total) { %>
        <div class="grid">
          <div class="stat"><div class="n"><%= rstats.total %></div><div class="l">Calls answered</div></div>
          <div class="stat"><div class="n"><%= rstats.uniqueCallers %></div><div class="l">Unique callers</div></div>
          <div class="stat"><div class="n"><%= fmtWait(rstats.avgWait) %></div><div class="l">Avg caller wait</div></div>
          <div class="stat"><div class="n" style="font-size:18px;line-height:1.6;"><%= rstats.busiestDay ? d(rstats.busiestDay) : '—' %></div><div class="l">Busiest day<%= rstats.busiestN ? ' (' + rstats.busiestN + ' calls)' : '' %></div></div>
        </div>
        <div class="card" style="padding:0;">
          <div class="table-wrap"><table class="table" style="margin:0;">
            <thead><tr><th>Date / time</th><th>Caller</th><th>Wait</th><th>Journey</th></tr></thead>
            <tbody>
              <% calls.forEach(function(j){ var linkableNum = j.number && !/^(anonymous|withheld)$/i.test(String(j.number).trim()); %>
                <tr>
                  <td class="muted" style="white-space:nowrap;"><%= fmtT(j.datetime) %></td>
                  <td style="font-family:monospace;font-size:13px;">
                    <% if (linkableNum) { %><a href="/my/insights?tab=home&q=<%= encodeURIComponent(j.number) %>" title="Track this number"><%= j.number %></a><% } else { %><span class="muted"><%= j.number || 'Withheld' %></span><% } %>
                  </td>
                  <td class="num" style="white-space:nowrap;"><%= j.wait %></td>
                  <td class="muted" style="font-size:12px;max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= j.route || '' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table></div>
        </div>
      <% } else { %>
        <div class="card"><div class="empty">No calls answered by &ldquo;<%= ext %>&rdquo; in this window.</div></div>
      <% } %>
    <% } %>

  <% } else { %>

    <div class="card">
      <h2 style="margin:0 0 10px;font-size:16px;">Run a report</h2>
      <% if (!templates.length || !sites.length) { %>
        <p class="muted" style="margin:0;">No reports available yet — contact Lumen IT.</p>
      <% } else { var todayStr = new Date().toISOString().slice(0,10); %>
        <form method="post" action="/my/insights/run" target="_blank" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="form-group" style="margin:0;min-width:220px;">
            <label>Report</label>
            <select class="input" name="template_id" required style="width:100%;">
              <% templates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
            </select>
          </div>
          <% if (sites.length > 1) { %>
          <div class="form-group" style="margin:0;min-width:180px;">
            <label>Site</label>
            <select class="input" name="site_id" required style="width:100%;">
              <% sites.forEach(function(s){ %><option value="<%= s.id %>"><%= s.site_label %></option><% }); %>
            </select>
          </div>
          <% } else { %><input type="hidden" name="site_id" value="<%= sites[0].id %>"><% } %>
          <div class="form-group" style="margin:0;"><label>From</label><input class="input" type="date" name="date_from" value="<%= todayStr %>"></div>
          <div class="form-group" style="margin:0;"><label>To</label><input class="input" type="date" name="date_to" value="<%= todayStr %>"></div>
          <button class="btn btn-primary" type="submit">Run report ↗</button>
        </form>
        <p class="muted" style="font-size:12px;margin:8px 0 0;">Runs against your own call data for the dates you choose, and opens in a new tab.</p>
      <% } %>
    </div>

    <div class="card" style="padding:0;">
      <div style="padding:14px 20px 4px;"><h2 style="margin:0;font-size:16px;">Recent reports</h2></div>
      <datalist id="custEmails"><% (emails || []).forEach(function(e){ %><option value="<%= e %>"></option><% }); %></datalist>
      <% if (!reports.length) { %>
        <div class="empty" style="padding:14px 20px 20px;">No reports produced yet — run one above.</div>
      <% } else { %>
        <div class="table-wrap"><table class="table" style="margin:0;">
          <thead><tr><th>Report</th><th>Site</th><th>Type</th><th>Period</th><th>Produced</th><th style="text-align:right;">Actions</th></tr></thead>
          <tbody>
            <% reports.forEach(function(r){ %>
              <tr>
                <td><strong><%= r.config_label %></strong></td>
                <td class="muted"><%= r.site_label %></td>
                <td><%= rtype(r.report_type) %></td>
                <td class="muted" style="white-space:nowrap;"><%= d(r.report_start) %><% if (r.report_end) { %> &ndash; <%= d(r.report_end) %><% } %></td>
                <td class="muted" style="white-space:nowrap;"><%= d(r.generated_at || r.created_at) %></td>
                <td style="text-align:right;white-space:nowrap;">
                  <a class="btn" href="/my/insights/report/<%= r.id %>" target="_blank" rel="noopener">View</a>
                  <form method="post" action="/my/insights/report/<%= r.id %>/email" style="display:inline-flex;gap:4px;margin-left:6px;vertical-align:middle;">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input class="input" type="email" name="to" list="custEmails" placeholder="email address…" required style="font-size:12px;padding:5px 8px;min-width:150px;">
                    <button class="btn" type="submit" title="Email this report">&#9993;</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>

  <% } %>
<% } %>

<style>
  .my-tabs { display:flex; gap:2px; margin:0 0 16px; border-bottom:1px solid var(--line); flex-wrap:wrap; }
  .my-tab { text-decoration:none; border-bottom:2px solid transparent; padding:9px 16px; font-size:14px; font-weight:600; color:#64748b; }
  .my-tab.active { color:var(--accent,#0ea5b7); border-bottom-color:var(--accent,#0ea5b7); }
</style>

<%- include('footer', { active }) %>
