<%- include('header', { title: 'My Account', company, user, active }) %>
<% function sbadge(s){ return s==='resolved'?'badge-sent':(s==='closed'?'badge-inactive':(s && s.indexOf('awaiting')===0?'badge-failed':'badge-primary')); } %>
<% function cap(s){ return s ? s.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}) : ''; } %>
<% var P = (typeof perms !== 'undefined' && perms) ? perms : {}; %>

<div class="page-header"><h1><%= greeting %></h1><p class="muted"><%= company %></p></div>

<div class="grid">
  <a class="stat" href="/my/tickets">
    <div class="n"><%= openTickets %></div>
    <div class="l"><%= P.allTickets ? 'Open company tickets' : 'Your open tickets' %></div>
  </a>
  <% if (P.finance) { %>
  <a class="stat" href="/my/invoices">
    <div class="n"><%= unpaidInvoices %></div>
    <div class="l">Outstanding invoices</div>
  </a>
  <% } %>
  <% if (P.services) { %>
  <a class="stat" href="/my/services">
    <div class="n"><%= services %></div>
    <div class="l">Active services</div>
  </a>
  <% } %>
</div>

<% if (P.insights) { %>
<style>
  .call-tools{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 22px;margin-bottom:18px;position:relative;overflow:hidden;}
  .call-tools::before{content:'';position:absolute;inset:0 0 auto 0;height:4px;background:var(--accent,#0ea5b7);opacity:.9;}
  .call-tools .ct-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin-top:14px;}
  .call-tools h3{font-size:14px;margin:0 0 6px;display:flex;align-items:center;gap:7px;}
  .call-tools h3 svg{width:16px;height:16px;stroke:var(--accent,#0ea5b7);flex:none;}
  .call-tools .ct-go{display:flex;gap:8px;align-items:stretch;flex-wrap:wrap;}
  .call-tools .ct-go input{flex:1;min-width:150px;}
  .call-tools .ct-go .btn{white-space:nowrap;}
</style>
<div class="call-tools">
  <h2 style="margin:0;">Track a call</h2>
  <p class="muted" style="margin:4px 0 0;font-size:13px;">Follow a caller's journey, or see everything one person answered — straight from here.</p>
  <div class="ct-grid">
    <form method="get" action="/my/insights">
      <input type="hidden" name="tab" value="home">
      <h3><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>Number Lookup</h3>
      <div class="ct-go">
        <input class="input" name="q" placeholder="e.g. 07700 900123">
        <button class="btn btn-primary" type="submit">Track</button>
      </div>
    </form>
    <form method="get" action="/my/insights">
      <input type="hidden" name="tab" value="reverse">
      <h3><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Answered by</h3>
      <div class="ct-go">
        <input class="input" name="ext" placeholder="e.g. 201 or a name" autocomplete="off">
        <button class="btn btn-primary" type="submit">Show calls</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="card">
  <div class="card-header">
    <h2>Recent support tickets</h2>
    <a class="btn btn-primary" href="/my/tickets/new">+ Raise a ticket</a>
  </div>
  <% if (!recentTickets || recentTickets.length === 0) { %>
    <div class="empty">No tickets yet. Need a hand? <a class="row-link" href="/my/tickets/new">Raise a ticket</a>.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Ref</th><th>Subject</th><th>Status</th><th>Updated</th></tr></thead>
        <tbody>
          <% recentTickets.forEach(function(t){ %>
            <tr>
              <td><a class="row-link" href="/my/tickets/<%= t.id %>"><%= t.ticket_number || ('#' + t.id) %></a></td>
              <td><a class="row-link" href="/my/tickets/<%= t.id %>" style="color:inherit;"><%= t.subject || '(no subject)' %></a></td>
              <td><span class="badge <%= sbadge(t.status) %>"><%= cap(t.status || 'open') %></span></td>
              <td class="muted"><%= t.updated_at ? new Date(t.updated_at).toLocaleDateString('en-GB') : '' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('footer', { active }) %>
