<%- include('header', { title: 'IT Reports', company: (user && user.displayName) || '', user, active }) %>
<%
  function d(x){ return x ? new Date(x).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) : '—'; }
  // A shelf of reports, not a database listing. The newest snapshot is the one anyone came
  // here for, so it gets the space; the rest are a lighter grid underneath (Terry, 2026-09-08).
  // The route orders by period_start DESC, so reports[0] IS the latest — if that ORDER BY
  // ever changes, this page starts featuring the wrong one silently.
  var latest = (reports && reports.length) ? reports[0] : null;
  var older  = (reports && reports.length > 1) ? reports.slice(1) : [];
%>

<div class="page-header" style="margin-bottom:18px;">
  <h1 style="margin:0;font-size:26px;letter-spacing:-.5px;">IT Reports</h1>
  <p class="muted" style="margin:5px 0 0;">Your monthly IT Operations &amp; Security Snapshots from Lumen IT.</p>
</div>

<% if (!latest) { %>
  <div class="card" style="padding:34px 24px;text-align:center;">
    <div style="font-size:28px;margin-bottom:8px;">&#128737;</div>
    <p style="margin:0 0 4px;font-weight:600;">No reports have been issued yet</p>
    <p class="muted" style="margin:0;font-size:13px;">Your first monthly snapshot will appear here as soon as it is published.</p>
  </div>
<% } else { %>

  <!-- The latest snapshot -->
  <div class="card" style="padding:0;overflow:hidden;margin-bottom:22px;">
    <div style="height:5px;background:linear-gradient(90deg,#10b981,#2563eb);"></div>
    <div style="padding:22px 24px;display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
      <div style="min-width:0;flex:1;">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:7px;">
          <span style="width:9px;height:9px;border-radius:50%;background:var(--ok);flex:none;"></span>
          <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);">Latest snapshot</span>
        </div>
        <a class="row-link" href="/my/it-report/<%= latest.id %>" target="_blank"
           style="font-size:24px;font-weight:700;letter-spacing:-.3px;line-height:1.2;display:inline-block;"><%= latest.period_label %></a>
        <p class="muted" style="margin:7px 0 0;font-size:13px;">Issued <%= d(latest.sent_at || latest.created_at) %></p>
      </div>
      <a class="btn btn-primary" href="/my/it-report/<%= latest.id %>" target="_blank"
         style="font-size:15px;padding:11px 24px;white-space:nowrap;">View report</a>
    </div>
  </div>

  <% if (older.length) { %>
    <div style="display:flex;align-items:baseline;gap:10px;margin:0 0 12px;">
      <h2 style="margin:0;font-size:15px;">Earlier reports</h2>
      <span class="muted" style="font-size:12px;"><%= older.length %> in the archive</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;">
      <% older.forEach(function(r){ %>
        <a href="/my/it-report/<%= r.id %>" target="_blank" class="card"
           style="margin:0;padding:16px 18px;display:block;text-decoration:none;border-left:3px solid var(--accent);">
          <div style="font-size:15px;font-weight:700;color:var(--ink);line-height:1.3;"><%= r.period_label %></div>
          <div class="muted" style="font-size:12px;margin-top:5px;">Issued <%= d(r.sent_at || r.created_at) %></div>
        </a>
      <% }); %>
    </div>
  <% } %>

<% } %>

<%- include('footer', { active }) %>
