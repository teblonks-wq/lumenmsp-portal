<%- include('../partials/header', { title: 'Purchase Ledger', user }) %>

<div class="page-header"><h1>Purchase Ledger</h1>
  <p class="muted">Reconcile money out — categorise bank transactions, attach the receipt, push to QuickBooks.</p></div>

<% if (notice) { %><div class="alert alert-success" style="max-width:900px;"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-danger" style="max-width:900px;"><%= error %></div><% } %>

<style>
  .hub-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;}
  .hub-card{display:block;border-radius:14px;padding:22px;text-decoration:none;color:#fff;box-shadow:0 8px 22px rgba(2,6,23,.16);transition:transform .12s ease, box-shadow .12s ease;}
  a.hub-card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(2,6,23,.26);}
  .hub-ico{font-size:30px;line-height:1;} .hub-t{font-weight:800;font-size:18px;margin:10px 0 4px;letter-spacing:-.3px;}
  .hub-card .muted{color:rgba(255,255,255,.9)!important;font-size:13px;}
  .hub-card .badge{background:rgba(255,255,255,.28)!important;color:#fff!important;}
  .hub-green{background:linear-gradient(135deg,var(--ok-deep),var(--green-bright));}
</style>
<div class="hub-grid">
  <a class="hub-card hub-green" href="/purchases/expenses">
    <div class="hub-ico">🧾</div>
    <div class="hub-t">Expense Reconciliation</div>
    <div class="muted">Bank transactions → COS category → receipt → QuickBooks</div>
    <% if (toDo) { %><div style="margin-top:10px;"><span class="badge" style="font-size:11px;"><%= toDo %> to reconcile</span></div><% } %>
  </a>
</div>


<%
  var anoms = anomalies || [];
  var hi  = anoms.filter(function(a){ return a.severity==='high'; });
  var mid = anoms.filter(function(a){ return a.severity==='medium'; });
  var lo  = anoms.filter(function(a){ return a.severity!=='high' && a.severity!=='medium'; });
  function amt(v){ if (v==null) return ''; var n=Math.abs(Number(v)||0); return '£'+n.toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  var KIND = { already_paid:'Already paid', unpaid_invoice:'Not paid', payment_no_invoice:'No invoice',
               price_jump:'Price up', missing_bill:'Bill missing', new_supplier:'New supplier',
               vat_mismatch:'Figures', ai_concern:'Claude' };
%>
<style>
  .an-row{display:flex;gap:12px;align-items:flex-start;padding:12px 16px;border-top:1px solid var(--line);}
  .an-row:first-child{border-top:0;}
  .an-tag{flex:0 0 auto;font-size:10px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;padding:3px 7px;border-radius:5px;white-space:nowrap;}
  .an-high{background:var(--bad-bg,#fde8e8);color:var(--bad-fg,#a12626);}
  .an-mid{background:#fdf3e2;color:#8a5a00;}
  .an-low{background:var(--chip-bg,#eef2f7);color:var(--muted);}
  .an-body{flex:1;min-width:0;}
  .an-title{font-weight:600;font-size:14px;}
  .an-detail{font-size:12.5px;color:var(--muted);margin-top:2px;}
  .an-amt{font-weight:700;font-size:14px;white-space:nowrap;}
</style>

<div class="card" style="padding:0;margin-bottom:18px;<%= hi.length ? 'border-left:3px solid var(--bad-fg);' : '' %>">
  <div class="card-header" style="padding:16px 20px 12px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
    <div>
      <h2 style="margin:0;">What needs looking at <% if (anoms.length) { %><span class="muted">(<%= anoms.length %>)</span><% } %></h2>
      <p class="muted" style="font-size:12px;margin:4px 0 0;">Checked overnight. Bills nobody paid, payments with no bill behind them, prices that moved, and anything Claude noticed while reading an invoice. Reply to one and it comes off this list.</p>
    </div>
    <div style="display:flex;gap:8px;">
      <form method="post" action="/purchases/anomalies/refresh" style="margin:0;"><button class="btn" type="submit" title="Re-check the ledger now instead of waiting for tonight">↻ Check now</button></form>
      <form method="post" action="/purchases/anomalies/digest" style="margin:0;"><button class="btn" type="submit" title="Email the open list now (it also goes out automatically on Monday morning)">✉ Email the list</button></form>
      <a class="btn" href="/purchases/rules" title="Everything you have told the agent">📋 Rules<% var lr=(rules||[]).filter(function(r){return r.status==='active';}); if (lr.length) { %> (<%= lr.length %>)<% } %></a>
    </div>
  </div>

  <% if (!anoms.length) { %>
    <div class="empty-state" style="margin:0;padding:24px;">Nothing outstanding. Every invoice is matched, every payment has a bill behind it, and no supplier has changed its price.</div>
  <% } else { %>
    <% [['high',hi],['medium',mid],['info',lo]].forEach(function(grp){ grp[1].forEach(function(a){ %>
      <div class="an-row">
        <span class="an-tag <%= a.severity==='high'?'an-high':(a.severity==='medium'?'an-mid':'an-low') %>"><%= KIND[a.kind] || a.kind %></span>
        <div class="an-body">
          <div class="an-title"><%= a.title %></div>
          <% if (a.detail) { %><div class="an-detail"><%= a.detail %></div><% } %>
          <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
            <% if (a.document_id) { %><button class="btn" type="button" style="font-size:11px;padding:2px 8px;" onclick="anPeek(<%= a.document_id %>, this)">👁 Preview</button>
            <a class="btn" href="/purchases/doc/<%= a.document_id %>/view" target="_blank" style="font-size:11px;padding:2px 8px;">Open invoice</a><% } %>
            <% if (a.txn_id) { %><a class="btn" href="/purchases/expenses" style="font-size:11px;padding:2px 8px;">Go to expenses</a><% } %>
            <button class="btn" type="button" style="font-size:11px;padding:2px 8px;" onclick="anToggle(<%= a.id %>)" title="Tell it what you know. It will consider what you say and, if it is a standing instruction, offer to remember it.">💬 Reply<% var th=(notes||{})[a.id]||[]; if (th.length) { %> (<%= th.length %>)<% } %></button>
            <form method="post" action="/purchases/anomalies/<%= a.id %>/dismiss" style="margin:0;"><button class="btn" type="submit" style="font-size:11px;padding:2px 8px;" title="Stop showing me this. A REPLY is usually better — it keeps the reason, so the same thing does not come back next month.">Dismiss</button></form>
          </div>

          <% if (a.document_id) { %><div id="an-pk-<%= a.document_id %>" style="display:none;margin-top:8px;"></div><% } %>
          <% var thread = (notes||{})[a.id] || []; %>
          <div id="an-th-<%= a.id %>" style="display:<%= (open === a.id || thread.length) ? 'block' : 'none' %>;margin-top:10px;border-left:2px solid var(--line);padding-left:12px;">
            <% thread.forEach(function(n){ %>
              <div style="margin-bottom:8px;">
                <div style="font-size:11px;font-weight:700;color:<%= n.is_claude ? 'var(--blue)' : 'var(--navy)' %>;"><%= n.is_claude ? 'Claude' : (n.author_name || 'Colleague') %></div>
                <div style="font-size:12.5px;white-space:pre-wrap;"><%= n.body %></div>
                <% if (n.rule_id && n.rule_body) { %>
                  <div style="margin-top:6px;padding:10px 12px;border-radius:8px;background:var(--chip-bg,#eef2f7);">
                    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;color:var(--muted);">
                      Proposed rule<%= n.rule_kind === 'suppress' ? ' — stops a finding' : (n.rule_kind === 'category' ? ' — sets the coding' : ' — adds context') %>
                    </div>
                    <div style="font-size:13px;font-weight:600;margin:3px 0 2px;"><%= n.rule_body %></div>
                    <% if (n.rule_kind === 'category' && n.rule_category) { %><div style="font-size:12.5px;margin-bottom:4px;">Codes to <strong><%= n.rule_category %></strong>.</div><% } %>
                    <% var cl = n.conditionList || []; if (cl.length) { %>
                      <div style="font-size:11px;font-weight:700;color:var(--muted);margin-top:6px;">Applies when all of these are true</div>
                      <ol style="margin:3px 0 8px;padding-left:20px;font-size:12.5px;">
                        <% cl.forEach(function(c){ %><li><%= c %></li><% }); %>
                      </ol>
                    <% } %>
                    <% if (n.rule_status === 'proposed') { %>
                      <% if (n.rule_kind === 'suppress') { %><div class="muted" style="font-size:11px;margin-bottom:6px;">Accepting this creates a deliberate blind spot — you will stop being told about it.</div><% } %>
                      <div class="muted" style="font-size:11px;margin-bottom:6px;">Accepting re-checks the whole list under it straight away.</div>
                      <div style="display:flex;gap:6px;">
                        <form method="post" action="/purchases/rules/<%= n.rule_id %>/accept" style="margin:0;"><button class="btn btn-primary" type="submit" style="font-size:11px;padding:3px 8px;">Add to rules</button></form>
                        <form method="post" action="/purchases/rules/<%= n.rule_id %>/reject" style="margin:0;"><button class="btn" type="submit" style="font-size:11px;padding:3px 8px;">No</button></form>
                      </div>
                    <% } else { %>
                      <span class="badge" style="font-size:10px;"><%= n.rule_status === 'active' ? '✓ in your rules' : 'not added' %></span>
                    <% } %>
                  </div>
                <% } %>
              </div>
            <% }); %>
            <form method="post" action="/purchases/anomalies/<%= a.id %>/reply" class="anReply" style="margin:6px 0 0;display:flex;gap:6px;align-items:flex-start;">
              <textarea class="input" name="text" rows="2" required placeholder="Tell it what you know — e.g. &quot;the rent is collected quarterly, not monthly&quot;" style="flex:1;font-size:12.5px;resize:vertical;"></textarea>
              <button class="btn" type="submit" style="font-size:11px;padding:5px 10px;min-width:74px;">Send</button>
            </form>
          </div>
        </div>
        <% if (a.amount != null) { %><div class="an-amt"><%= amt(a.amount) %></div><% } %>
      </div>
    <% }); }); %>
  <% } %>
</div>

<% var ans = answered || []; %>
<% if (ans.length) { %>
<div class="card" style="padding:0;margin-bottom:18px;">
  <div class="card-header" style="padding:16px 20px 12px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
    <div>
      <h2 style="margin:0;">Answered <span class="muted">(<%= ans.length %>)</span></h2>
      <p class="muted" style="font-size:12px;margin:4px 0 0;">Off the worklist because you replied. Nothing is lost &mdash; the conversation is kept, and any one of these can go back on the list.</p>
    </div>
    <button class="btn" type="button" onclick="var e=document.getElementById('anAnswered');e.style.display=(e.style.display==='none'?'block':'none');this.textContent=(e.style.display==='none'?'Show':'Hide');">Show</button>
  </div>
  <div id="anAnswered" style="display:none;">
    <% ans.forEach(function(a){ var th=(notes||{})[a.id]||[]; var last=th.length?th[th.length-1]:null; %>
    <div class="an-row">
      <span class="an-tag an-low"><%= KIND[a.kind] || a.kind %></span>
      <div class="an-body">
        <div class="an-title" style="font-weight:500;"><%= a.title %></div>
        <% if (last) { %><div class="an-detail"><strong><%= last.is_claude ? 'Claude' : (last.author_name || 'You') %>:</strong> <%= String(last.body).slice(0,180) %><%= String(last.body).length>180?'…':'' %></div><% } %>
        <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
          <% if (a.document_id) { %><button class="btn" type="button" style="font-size:11px;padding:2px 8px;" onclick="anPeek(<%= a.document_id %>, this)">👁 Preview</button><% } %>
          <button class="btn" type="button" style="font-size:11px;padding:2px 8px;" onclick="anToggle(<%= a.id %>)">💬 Conversation (<%= th.length %>)</button>
          <form method="post" action="/purchases/anomalies/<%= a.id %>/reopen" style="margin:0;"><button class="btn" type="submit" style="font-size:11px;padding:2px 8px;" title="That answer did not settle it after all">↩ Back on the list</button></form>
        </div>
        <% if (a.document_id) { %><div id="an-pk-<%= a.document_id %>" style="display:none;margin-top:8px;"></div><% } %>
        <div id="an-th-<%= a.id %>" style="display:none;margin-top:10px;border-left:2px solid var(--line);padding-left:12px;">
          <% th.forEach(function(n){ %>
            <div style="margin-bottom:8px;">
              <div style="font-size:11px;font-weight:700;color:<%= n.is_claude ? 'var(--blue)' : 'var(--navy)' %>;"><%= n.is_claude ? 'Claude' : (n.author_name || 'Colleague') %></div>
              <div style="font-size:12.5px;white-space:pre-wrap;"><%= n.body %></div>
            </div>
          <% }); %>
        </div>
      </div>
      <% if (a.amount != null) { %><div class="an-amt" style="font-weight:500;"><%= amt(a.amount) %></div><% } %>
    </div>
    <% }); %>
  </div>
</div>
<% } %>

<script>
  function anToggle(id){ var el=document.getElementById('an-th-'+id); if(el) el.style.display = (el.style.display==='none'?'block':'none'); }
  // Read the invoice without leaving the list. Judging a finding means looking at the
  // document, and a new tab per finding is not looking at it.
  function anPeek(docId, btn){
    var box = document.getElementById('an-pk-' + docId); if (!box) return;
    if (box.style.display !== 'none') { box.style.display = 'none'; box.innerHTML = ''; btn.textContent = '👁 Preview'; return; }
    box.style.display = 'block';
    btn.textContent = '👁 Hide';
    box.innerHTML = '<iframe src="/purchases/doc/' + docId + '/view#toolbar=0&navpanes=0" ' +
      'style="width:100%;height:460px;border:1px solid var(--line);border-radius:8px;background:#fff;" loading="lazy"></iframe>';
  }
  // Reading the invoice and thinking about it takes a few seconds, and a button that looks
  // idle gets pressed again. On 2 Sep that turned one answer into seven and produced eight
  // rewordings of the same rule. One submission per form, and it says it is working.
  Array.prototype.forEach.call(document.querySelectorAll('form.anReply'), function(f){
    f.addEventListener('submit', function(e){
      if (f.dataset.sent === '1') { e.preventDefault(); return; }
      var ta = f.querySelector('textarea');
      if (ta && !ta.value.trim()) return;              // let the browser's own check speak
      f.dataset.sent = '1';
      var b = f.querySelector('button');
      if (b) { b.disabled = true; b.textContent = 'Thinking…'; }
      if (ta) ta.readOnly = true;
    });
  });
</script>

<% var liveRules = (rules||[]).filter(function(r){ return r.status==='active'; }); %>
<% if (liveRules.length) { %>
<div class="card" style="padding:0;margin-bottom:18px;">
  <div class="card-header" style="padding:16px 20px 12px;">
    <h2 style="margin:0;">Your rules <span class="muted">(<%= liveRules.length %>)</span></h2>
    <p class="muted" style="font-size:12px;margin:4px 0 0;">What you have told the agent, in your words. A <strong>context</strong> rule makes it judge better; a <strong>stops a finding</strong> rule is a deliberate blind spot. Switch one off and whatever it was hiding comes back on the next check.</p>
  </div>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Rule</th><th>Applies to</th><th>Type</th><th>Because you said</th><th></th></tr></thead>
    <tbody>
      <% liveRules.forEach(function(r){ %>
      <tr>
        <td style="font-size:13px;"><%= r.body %></td>
        <td style="font-size:12px;"><%= r.scope === 'global' ? 'the whole ledger' : (r.supplier_key || '—') %><% if (r.anomaly_kind) { %><br><span class="muted" style="font-size:11px;"><%= r.anomaly_kind %></span><% } %></td>
        <td><span class="badge" style="font-size:10px;"><%= r.kind === 'suppress' ? 'stops a finding' : 'context' %></span></td>
        <td class="muted" style="font-size:12px;max-width:280px;"><%= r.reason || '' %></td>
        <td style="white-space:nowrap;">
          <form method="post" action="/purchases/rules/<%= r.id %>/off" style="margin:0;" onsubmit="return confirm('Switch this rule off? Anything it was hiding will start appearing again.');">
            <button class="btn" type="submit" style="font-size:11px;padding:3px 8px;">Switch off</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
<% } %>

<%- include('../partials/footer') %>
